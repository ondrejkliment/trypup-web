{
  "rewrites": [
    {
      "source": "/api/stats.json",
      "destination": "https://europe-west1-trypupapp.cloudfunctions.net/getStats"
    }
  ],
  "headers": [
    {
      "source": "/:lang([a-z]{2})?/join{/}?",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ],
  "redirects": [
    {
      "source": "/v/:k(ig|tz|utulky|blog|fb|igad)",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(iPhone|iPad|iPod).*" }],
      "destination": "https://apps.apple.com/app/trypup-try-a-dog-first/id6775990135?pt=128985087&ct=:k-vanoce2026&mt=8",
      "permanent": false
    },
    {
      "source": "/v/:k(ig|tz|utulky|blog|fb|igad)",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*Android.*" }],
      "destination": "https://play.google.com/store/apps/details?id=app.trypup.mobile&referrer=utm_source%3D:k%26utm_medium%3Dkampan%26utm_campaign%3Dvanoce2026",
      "permanent": false
    },
    {
      "source": "/v/:k(ig|tz|utulky|blog|fb|igad)",
      "destination": "/?utm_source=:k&utm_medium=kampan&utm_campaign=vanoce2026#stahnout",
      "permanent": false
    },
    {
      "source": "/:p(app|obchody|stahnout|download){/}?",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(iPhone|iPad|iPod).*" }],
      "destination": "https://apps.apple.com/app/trypup-try-a-dog-first/id6775990135",
      "permanent": false
    },
    {
      "source": "/:p(app|obchody|stahnout|download){/}?",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*Android.*" }],
      "destination": "https://play.google.com/store/apps/details?id=app.trypup.mobile",
      "permanent": false
    },
    {
      "source": "/:p(app|obchody|stahnout|download){/}?",
      "destination": "/#stahnout",
      "permanent": false
    },
    {
      "source": "/privacy",
      "destination": "/zasady-ochrany/",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/podminky/",
      "permanent": true
    },
    {
      "source": "/support",
