    cookieText: 'Używamy plików cookie do anonimowej analityki (Google Analytics), aby ulepszać Trypup. Analityka działa tylko za Twoją zgodą — możesz ją zmienić w dowolnym momencie za pomocą linku Cookies w stopce.',
    cookieAccept: 'Akceptuj', cookieReject: 'Odrzuć', cookieSettings: 'Cookies',
  },
  es: {
    howItWorks: 'Cómo funciona', about: 'Acerca de', blog: 'Blog',
    privacy: 'Privacidad', terms: 'Términos de uso', support: 'Soporte', contact: 'Contacto',
    switchLabel: 'EN', switchHref: alt ?? '/en/',
    howHref: '/es/#how-it-works', aboutHref: '/es/about/', blogHref: '/blog/', homeHref: '/es/',
    privacyHref: '/es/privacy/', termsHref: '/es/terms/', supportHref: '/es/support/',
    ogLocale: 'es_ES',
    announcePre: '📱 Trypup ya está disponible en ', announcePost: '. Síguenos en ', announceBoth: 'iPhone y Android',
    cookieText: 'Utilizamos cookies para análisis anónimos (Google Analytics) con el fin de mejorar Trypup. El análisis solo funciona con su consentimiento — puede cambiarlo en cualquier momento mediante el enlace Cookies en el pie de página.',
    cookieAccept: 'Aceptar', cookieReject: 'Rechazar', cookieSettings: 'Cookies',
  },
  it: {
    howItWorks: 'Come funziona', about: 'Chi siamo', blog: 'Blog',
    privacy: 'Privacy', terms: 'Termini di utilizzo', support: 'Assistenza', contact: 'Contatto',
    switchLabel: 'EN', switchHref: alt ?? '/en/',
    howHref: '/it/#how-it-works', aboutHref: '/it/about/', blogHref: '/blog/', homeHref: '/it/',
    privacyHref: '/it/privacy/', termsHref: '/it/terms/', supportHref: '/it/support/',
    ogLocale: 'it_IT',
    announcePre: '📱 Trypup è ora disponibile su ', announcePost: '! Seguici su ', announceBoth: 'iPhone e Android',
    cookieText: 'Utilizziamo cookie per analisi anonime (Google Analytics) per migliorare Trypup. L’analisi viene eseguita solo con il tuo consenso — puoi modificarlo in qualsiasi momento tramite il link Cookie nel footer.',
    cookieAccept: 'Accetta', cookieReject: 'Rifiuta', cookieSettings: 'Cookie',
  },
  nl: {
    howItWorks: 'Hoe het werkt', about: 'Over', blog: 'Blog',
    privacy: 'Privacy', terms: 'Gebruiksvoorwaarden', support: 'Ondersteuning', contact: 'Contact',
    switchLabel: 'EN', switchHref: alt ?? '/en/',
    howHref: '/nl/#how-it-works', aboutHref: '/nl/about/', blogHref: '/blog/', homeHref: '/nl/',
    privacyHref: '/nl/privacy/', termsHref: '/nl/terms/', supportHref: '/nl/support/',
    ogLocale: 'nl_NL',
    announcePre: '📱 Trypup is nu beschikbaar voor ', announcePost: '! Volg ', announceBoth: 'iPhone en Android',
    cookieText: 'We gebruiken cookies voor anonieme analyses (Google Analytics) om Trypup te verbeteren. Analyses lopen alleen met uw toestemming — u kunt dit op elk moment wijzigen via de link Cookies in de voettekst.',
    cookieAccept: 'Accepteren', cookieReject: 'Weigeren', cookieSettings: 'Cookies',
  },
  pt: {
    howItWorks: 'Como funciona', about: 'Sobre', blog: 'Blog',
    privacy: 'Privacidade', terms: 'Termos de utilização', support: 'Suporte', contact: 'Contacto',
    switchLabel: 'EN', switchHref: alt ?? '/en/',
    howHref: '/pt/#how-it-works', aboutHref: '/pt/about/', blogHref: '/blog/', homeHref: '/pt/',
    privacyHref: '/pt/privacy/', termsHref: '/pt/terms/', supportHref: '/pt/support/',
    ogLocale: 'pt_PT',
    announcePre: '📱 O Trypup já está disponível para ', announcePost: '! Siga-nos em ', announceBoth: 'iPhone e Android',
    cookieText: 'Utilizamos cookies para análises anónimas (Google Analytics) para melhorar o Trypup. A análise só funciona com o seu consentimento — pode alterá-lo a qualquer momento através da ligação Cookies no rodapé.',
    cookieAccept: 'Aceitar', cookieReject: 'Rejeitar', cookieSettings: 'Cookies',
  },
  sk: {
    howItWorks: 'Ako to funguje', about: 'O aplikácii', blog: 'Blog',
    privacy: 'Súkromie', terms: 'Podmienky používania', support: 'Podpora', contact: 'Kontakt',
    switchLabel: 'EN', switchHref: alt ?? '/en/',
    howHref: '/sk/#how-it-works', aboutHref: '/sk/about/', blogHref: '/blog/', homeHref: '/sk/',
    privacyHref: '/sk/privacy/', termsHref: '/sk/terms/', supportHref: '/sk/support/',
    ogLocale: 'sk_SK',
    announcePre: '📱 Trypup je teraz na ', announcePost: '! Sledujte ', announceBoth: 'iPhone aj Androide',
    cookieText: 'Používame cookies na anonymnú analytiku (Google Analytics), aby sme Trypup vylepšovali. Analytika beží len s vaším súhlasom — kedykoľvek ho zmeníte cez odkaz Cookies v pätičke.',
    cookieAccept: 'Prijať', cookieReject: 'Odmietnuť', cookieSettings: 'Cookies',
  },
  bg: {
    howItWorks: 'Как работи', about: 'За приложението', blog: 'Блог',
    privacy: 'Поверителност', terms: 'Условия за ползване', support: 'Поддръжка', contact: 'Контакт',
    switchLabel: 'EN', switchHref: alt ?? '/en/',
    howHref: '/bg/#how-it-works', aboutHref: '/bg/about/', blogHref: '/blog/', homeHref: '/bg/',
    privacyHref: '/bg/privacy/', termsHref: '/bg/terms/', supportHref: '/bg/support/',
    ogLocale: 'bg_BG',
    announcePre: '📱 Trypup вече е достъпен за ', announcePost: '! Последвайте ', announceBoth: 'iPhone и Android',
    cookieText: 'Използваме бисквитки за анонимна аналитика (Google Analytics), за да подобрим Trypup. Анализите работят само с вашето съгласие — можете да го промените по всяко време чрез връзката Бисквитки в долния колонтитул.',
    cookieAccept: 'Приемам', cookieReject: 'Отказвам', cookieSettings: 'Бисквитки',
  },
  uk: {
    howItWorks: 'Як це працює', about: 'Про застосунок', blog: 'Блог',
    privacy: 'Конфіденційність', terms: 'Умови використання', support: 'Підтримка', contact: 'Контакти',
    switchLabel: 'EN', switchHref: alt ?? '/en/',
    howHref: '/uk/#how-it-works', aboutHref: '/uk/about/', blogHref: '/blog/', homeHref: '/uk/',
    privacyHref: '/uk/privacy/', termsHref: '/uk/terms/', supportHref: '/uk/support/',
    ogLocale: 'uk_UA',
    announcePre: '📱 Trypup вже доступний для ', announcePost: '! Підписуйтесь на ', announceBoth: 'iPhone і Android',
    cookieText: 'Ми використовуємо файли cookie для анонімної аналітики (Google Analytics), щоб покращувати Trypup. Аналітика працює лише за вашою згодою — ви можете змінити її будь-коли через посилання Cookies у нижньому колонтитулі.',
    cookieAccept: 'Прийняти', cookieReject: 'Відхилити', cookieSettings: 'Cookies',
  },
};

const t = STRINGS[lang] ?? STRINGS.en;

// Zákonná identifikace provozovatele v patičce (§ 435 obč. zák.) — na každé stránce.
const opL = operatorLabels(lang);
const opRegistry = operator.spisovaZnacka[lang];

// Plné jazykové menu — jen pro pageKey (home/about/privacy/terms/support), které
// existují ve všech 12 jazycích. LANG_CODE = krátký kód v uzavřené pilulce (stejná
// délka jako dřívější "CZ"/"EN", ať se hlavička nerozjíždí do šířky); LANG_NAME =
// plný název jazyka v sobě samém, zobrazený v rozbalené nabídce. „uk" (ISO kód pro
// ukrajinštinu) se v pilulce záměrně zobrazuje jako „UA" — „UK" by čtenáři splynulo
// se zkratkou United Kingdom.
const ALL_LANGS: Lang[] = ['cs', 'en', 'de', 'fr', 'pl', 'es', 'it', 'nl', 'pt', 'sk', 'bg', 'uk'];
const LANG_CODE: Record<Lang, string> = { cs: 'CZ', en: 'EN', de: 'DE', fr: 'FR', pl: 'PL', es: 'ES', it: 'IT', nl: 'NL', pt: 'PT', sk: 'SK', bg: 'BG', uk: 'UA' };
const LANG_NAME: Record<Lang, string> = { cs: 'Čeština', en: 'English', de: 'Deutsch', fr: 'Français', pl: 'Polski', es: 'Español', it: 'Italiano', nl: 'Nederlands', pt: 'Português', sk: 'Slovenčina', bg: 'Български', uk: 'Українська' };
const PAGE_HREF_KEY: Record<PageKey, keyof Strings> = { home: 'homeHref', about: 'aboutHref', privacy: 'privacyHref', terms: 'termsHref', support: 'supportHref' };
const langLinks = pageKey ? ALL_LANGS.map((code) => ({ code, name: LANG_NAME[code], href: STRINGS[code][PAGE_HREF_KEY[pageKey]] })) : null;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {csHref && <link rel="alternate" hreflang="cs" href={csHref} />}
    {enHref && <link rel="alternate" hreflang="en" href={enHref} />}
    {csHref && <link rel="alternate" hreflang="x-default" href={csHref} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Trypup" />
    <meta property="og:locale" content={t.ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#FDF4EF" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" href="/icon.png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <!-- Google Analytics 4 (gtag.js) — Web stream G-8MWP5X5RPR (veškerý provoz trypup.life).
         GDPR: Consent Mode v2 — analytics_storage je 'denied' (cookieless), dokud
         uživatel nedá souhlas v cookie liště (níže). Souhlas se pamatuje v
         localStorage, takže se default příště rovnou nastaví na 'granted'.
         is:inline = Astro snippet nebundluje, vykreslí ho 1:1 do <head>. -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-8MWP5X5RPR"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      var __tpConsent = 'denied';
      try { if (localStorage.getItem('trypup-consent') === 'granted') __tpConsent = 'granted'; } catch (e) {}
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: __tpConsent,
        wait_for_update: 500,
      });
      gtag('js', new Date());
      gtag('config', 'G-8MWP5X5RPR');
    </script>
  </head>
  <body>
    <div class="announce">{t.announcePre}<a href={dlAnchor} class="announce-play">{t.announceBoth}</a>{t.announcePost}<a href="https://www.instagram.com/trypupapp/" target="_blank" rel="noopener" data-cms-href="common.social.instagram">@trypupapp</a></div>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={t.homeHref} aria-label="trypup">
          <svg class="brand-mark" width="30" height="30" viewBox="0 0 200 200" aria-hidden="true">
            <defs><clipPath id="bm"><ellipse cx="100" cy="92" rx="58" ry="54"/></clipPath></defs>
            <ellipse cx="48" cy="112" rx="20" ry="52" transform="rotate(-10 48 112)" fill="#4A2B45"/>
            <ellipse cx="152" cy="112" rx="20" ry="52" transform="rotate(10 152 112)" fill="#4A2B45"/>
            <ellipse cx="100" cy="92" rx="58" ry="54" fill="#C77A45"/>
            <ellipse cx="68" cy="80" rx="32" ry="34" fill="#9A5A2E" clip-path="url(#bm)"/>
            <ellipse cx="100" cy="127" rx="38" ry="31" fill="#FDF4EF" stroke="#B0682F" stroke-width="2.5"/>
            <circle cx="78" cy="86" r="9" fill="#4A2B45"/><circle cx="122" cy="86" r="9" fill="#4A2B45"/>
            <circle cx="81" cy="83" r="3" fill="#FDF4EF"/><circle cx="125" cy="83" r="3" fill="#FDF4EF"/>
            <path d="M89 113 Q100 106 111 113 Q111 123 100 127 Q89 123 89 113 Z" fill="#4A2B45"/>
            <path d="M100 127 V134" stroke="#4A2B45" stroke-width="3.2" stroke-linecap="round"/>
            <path d="M100 134 Q90 143 82 137" stroke="#4A2B45" stroke-width="3.2" fill="none" stroke-linecap="round"/>
            <path d="M100 134 Q110 143 118 137" stroke="#4A2B45" stroke-width="3.2" fill="none" stroke-linecap="round"/>
          </svg>
          <span><span class="wm-try">try</span><span class="wm-pup">pup</span></span>
        </a>
        <nav class="nav">
          <a href={t.howHref}>{t.howItWorks}</a>
          <a href={t.aboutHref}>{t.about}</a>
          <a href={t.blogHref}>{t.blog}</a>
          {langLinks ? (
            <details class="lang-switch">
              <summary aria-label="Language">{LANG_CODE[lang]}</summary>
              <ul class="lang-menu">
                {langLinks.map((l) => (
                  <li><a href={l.href} aria-current={l.code === lang ? 'page' : undefined}>{l.name}</a></li>
                ))}
              </ul>
            </details>
          ) : (
            <a class="lang-switch" href={t.switchHref} aria-label="Language">{t.switchLabel}</a>
          )}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div>© {year} Trypup · {operator.firma}</div>
        <div class="links">
          <a href={t.aboutHref}>{t.about}</a>
          <a href={t.blogHref}>{t.blog}</a>
          <a href={t.privacyHref}>{t.privacy}</a>
          <a href={t.termsHref}>{t.terms}</a>
          <a href={t.supportHref}>{t.support}</a>
          <a href="mailto:hello@trypup.life">{t.contact}</a>
          <a href="#" id="cookie-settings">{t.cookieSettings}</a>
        </div>
        <div class="legal-id">{operator.sidlo} · {opL.ico} {operator.ico}{operator.dic ? ` · ${opL.dic} ${operator.dic}` : ''} · {opRegistry}</div>
      </div>
    </footer>

    <!-- GDPR cookie souhlas. Default (head) = analytics_storage 'denied'; teprve
         „Přijmout" pošle gtag('consent','update', granted) a uloží volbu. „Cookies"
         odkaz v patičce lištu znovu otevře (uživatel může souhlas změnit). -->
    <div id="cookie-bar" hidden style="position:fixed; left:0; right:0; bottom:0; z-index:50; background:#fff; border-top:1px solid #F2784B; box-shadow:0 -4px 20px rgba(74,43,69,.12); padding:14px 18px;">
      <div style="max-width:860px; margin:0 auto; display:flex; gap:14px; align-items:center; flex-wrap:wrap; justify-content:center;">
        <p style="margin:0; flex:1 1 320px; font-size:.86rem; line-height:1.5; color:#4A2B45;">
          {t.cookieText} <a href={t.privacyHref} style="color:#F2784B; text-decoration:underline;">{t.privacy}</a>
        </p>
        <div style="display:flex; gap:8px; flex:0 0 auto;">
          <button id="cookie-reject" type="button" style="background:none; border:1.5px solid #4A2B45; color:#4A2B45; border-radius:999px; padding:.5rem 1.3rem; font-size:.86rem; font-weight:700; cursor:pointer;">{t.cookieReject}</button>
          <button id="cookie-accept" type="button" style="background:#F2784B; border:1.5px solid #F2784B; color:#fff; border-radius:999px; padding:.5rem 1.3rem; font-size:.86rem; font-weight:700; cursor:pointer;">{t.cookieAccept}</button>
        </div>
      </div>
    </div>
    <script is:inline>
      (function () {
        var KEY = 'trypup-consent';
        var bar = document.getElementById('cookie-bar');
        var saved = null;
        try { saved = localStorage.getItem(KEY); } catch (e) {}
        if (!saved && bar) bar.removeAttribute('hidden');
        function decide(v) {
          try { localStorage.setItem(KEY, v); } catch (e) {}
          if (typeof gtag === 'function') gtag('consent', 'update', { analytics_storage: v === 'granted' ? 'granted' : 'denied' });
          if (bar) bar.setAttribute('hidden', '');
        }
        var a = document.getElementById('cookie-accept');
        var r = document.getElementById('cookie-reject');
        var s = document.getElementById('cookie-settings');
        if (a) a.addEventListener('click', function () { decide('granted'); });
        if (r) r.addEventListener('click', function () { decide('denied'); });
        if (s) s.addEventListener('click', function (e) { e.preventDefault(); if (bar) bar.removeAttribute('hidden'); });
      })();
    </script>

    <!-- Jazykové menu (<details>) — funguje i bez JS (nativní disclosure), skript
         jen dovírá po kliku mimo / na jinou položku, ať nezůstává otevřené. -->
    <script is:inline>
      (function () {
        var el = document.querySelector('details.lang-switch');
        if (!el) return;
        document.addEventListener('click', function (e) {
          if (el.hasAttribute('open') && !el.contains(e.target)) el.removeAttribute('open');
        });
      })();
    </script>

    <!-- CMS hydratace: na stránkách s [data-cms] / [data-cms-href] načte přepisy
         textů (site_content/content, spravováno přes /admin/content) a aplikuje je.
         Čte se přes lehké Firestore REST API (jen nativní fetch, ŽÁDNÝ Firebase SDK
         → minimální zátěž i na stránkách, kde se edituje jen lišta). textContent =
         bezpečné proti injekci; odkazy projdou allowlistem schémat. Když přepis
         chybí (404) nebo fetch selže, zůstane vestavěný text. -->
    <script is:inline>
      (async () => {
        const nodes = document.querySelectorAll('[data-cms],[data-cms-href]');
        if (!nodes.length) return;
        try {
          const KEY = 'AIzaSyCrFi62rqFPVJuyFcS8HHuEGhZ1PfElgAs';
          const res = await fetch('https://firestore.googleapis.com/v1/projects/trypupapp/databases/(default)/documents/site_content/content?key=' + KEY);
          if (!res.ok) return; // 404 = dokument zatím není → necháme výchozí texty
          const raw = ((await res.json()).fields || {}).fields?.mapValue?.fields || {};
          const f = {};
          for (const k in raw) if (typeof raw[k]?.stringValue === 'string') f[k] = raw[k].stringValue;
          const safeUrl = (v) => typeof v === 'string' && /^(https?:\/\/|mailto:|tel:|\/|#)/i.test(v.trim());
          nodes.forEach((el) => {
            const tk = el.getAttribute('data-cms');
            if (tk && typeof f[tk] === 'string' && f[tk].length) el.textContent = f[tk];
            const hk = el.getAttribute('data-cms-href');
            if (hk && safeUrl(f[hk])) el.setAttribute('href', f[hk].trim());
          });
        } catch (e) { /* offline / prázdné — necháme vestavěný text */ }
      })();
    </script>
  </body>
</html>
