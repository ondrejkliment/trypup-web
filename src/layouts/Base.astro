---
import '../styles/global.css';
import { operator, operatorLabels, type Lang } from '../lib/operator';

type PageKey = 'home' | 'about' | 'privacy' | 'terms' | 'support';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: Lang;
  /** Href of the same page in the other language (for the CZ/EN-only fallback switcher + hreflang). */
  alt?: string;
  /** Který typ stránky to je — jen home/about/privacy/terms/support existuje ve všech 12
   * jazycích, takže jen ty dostanou plné 12jazyčné menu (viz `langLinks` níže). Ostatní
   * stránky (blog, admin, smazání účtu…) nemají 12 mutací → zůstává starý CZ/EN přepínač. */
  pageKey?: PageKey;
}
const {
  title = 'Trypup — pes na zkoušku',
  description = 'Trypup je pes na zkoušku — realistický simulátor péče. Vyzkoušejte si procházky, krmení, výcvik i náklady, dřív než si pořídíte opravdového psa.',
  image,
  lang = 'cs',
  alt,
  pageKey,
} = Astro.props;

const year = 2026;
const playUrl = 'https://play.google.com/store/apps/details?id=app.trypup.mobile&pcampaignid=web_trypup';
const appStoreUrl = 'https://apps.apple.com/app/trypup-try-a-dog-first/id6775990135';
const site = Astro.site ?? new URL('https://trypup.life');
const canonical = new URL(Astro.url.pathname, site).href;

// Banner teď míří na sekci "Stáhnout" (obě platformy), NE přímo na jeden konkrétní
// obchod — dřív odkazoval jen na Google Play a musel se kvůli Apple 2.3.10 (appka
// nesmí odkazovat na jinou platformu) schovávat na stránkách linkovaných z iOS appky.
// Neutrální odkaz na "kde appku získat" tenhle problém neřeší jen na 6 stránkách,
// řeší ho úplně — banner je teď bezpečné zobrazit všude. Od 11. 9. má homepage +
// About vlastní verzi ve všech 12 jazycích appky (dřív jen cs+en, ostatní mířily do
// /en/ — matlo to, viz "Über uns" → anglická stránka). Blog zůstává JEN cs+en —
// roste a nemá stejný právní tlak jako Zásady/Podmínky/Podpora, plošný překlad
// zatím neplánujeme.
const dlAnchor = lang === 'cs' ? '/#stahnout' : `/${lang}/#get`;
const resolvedImage = image ?? (lang === 'cs' ? '/og.png?v=4' : '/og-en.png?v=2');
const ogImage = new URL(resolvedImage, site).href;
const altHref = alt ? new URL(alt, site).href : null;

// hreflang pair — zatím jen cs/en (marketingový pár). Ostatních 10 jazyků má od
// 11. 9. vlastní homepage/about, ale nemá vzájemně provázané `alt` na KAŽDÉ stránce
// (jen legal stránky a teď home/about); plný 12jazyčný hreflang graf je budoucí
// vylepšení, ne regrese — bez tagů Google prostě stránku indexuje samostatně.
const csHref = lang === 'cs' ? canonical : (lang === 'en' ? altHref : null);
const enHref = lang === 'en' ? canonical : (lang === 'cs' ? altHref : null);

type Strings = {
  howItWorks: string; about: string; blog: string; privacy: string; terms: string; support: string; contact: string;
  switchLabel: string; switchHref: string;
  howHref: string; aboutHref: string; blogHref: string; privacyHref: string; termsHref: string; supportHref: string; homeHref: string;
  ogLocale: string;
  announcePre: string; announcePost: string; announceBoth: string;
  cookieText: string; cookieAccept: string; cookieReject: string; cookieSettings: string;
};

// Nav na home/about míří do VLASTNÍHO jazyka (od 11. 9. má všech 12 jazyků svou
// verzi); blogHref zůstává /blog/ pro každého — blog má jen cs+en.
const enNav = { howHref: '/en/#how-it-works', aboutHref: '/en/about/', blogHref: '/blog/', homeHref: '/en/' };
const csNav = { howHref: '/#jak-to-funguje', aboutHref: '/o-aplikaci/', blogHref: '/blog/', homeHref: '/' };

const STRINGS: Record<Lang, Strings> = {
  cs: {
    howItWorks: 'Jak to funguje', about: 'O aplikaci', blog: 'Blog',
    privacy: 'Zásady ochrany', terms: 'Podmínky', support: 'Podpora', contact: 'Kontakt',
    switchLabel: 'EN', switchHref: alt ?? '/en/',
    ...csNav, privacyHref: '/zasady-ochrany/', termsHref: '/podminky/', supportHref: '/podpora/',
    ogLocale: 'cs_CZ',
    announcePre: '📱 Trypup je teď na ', announcePost: '! Sledujte ', announceBoth: 'iPhonu i Androidu',
    cookieText: 'Používáme cookies pro anonymní analytiku (Google Analytics), abychom Trypup vylepšovali. Analytika běží jen s vaším souhlasem — kdykoli ho změníte přes odkaz Cookies v patičce.',
    cookieAccept: 'Přijmout', cookieReject: 'Odmítnout', cookieSettings: 'Cookies',
  },
  en: {
    howItWorks: 'How it works', about: 'About', blog: 'Blog',
    privacy: 'Privacy', terms: 'Terms', support: 'Support', contact: 'Contact',
    switchLabel: 'CZ', switchHref: alt ?? '/',
    ...enNav, privacyHref: '/en/privacy/', termsHref: '/en/terms/', supportHref: '/en/support/',
    ogLocale: 'en_US',
    announcePre: '📱 Trypup is now live on ', announcePost: '! Follow ', announceBoth: 'iPhone and Android',
    cookieText: 'We use cookies for anonymous analytics (Google Analytics) to make Trypup better. Analytics runs only with your consent — you can change it anytime via the Cookies link in the footer.',
    cookieAccept: 'Accept', cookieReject: 'Reject', cookieSettings: 'Cookies',
  },
  de: {
    howItWorks: 'Wie es funktioniert', about: 'Über uns', blog: 'Blog',
    privacy: 'Datenschutz', terms: 'Nutzungsbedingungen', support: 'Support', contact: 'Kontakt',
    switchLabel: 'EN', switchHref: alt ?? '/en/',
    howHref: '/de/#how-it-works', aboutHref: '/de/about/', blogHref: '/blog/', homeHref: '/de/',
    privacyHref: '/de/privacy/', termsHref: '/de/terms/', supportHref: '/de/support/',
    ogLocale: 'de_DE',
    announcePre: '📱 Trypup ist jetzt verfügbar für ', announcePost: '! Folge uns auf ', announceBoth: 'iPhone und Android',
