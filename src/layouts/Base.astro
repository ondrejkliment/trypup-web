    cookieAccept: 'Accepter', cookieReject: 'Refuser', cookieSettings: 'Cookies',
  },
  pl: {
    howItWorks: 'Jak to działa', about: 'O aplikacji', blog: 'Blog',
    privacy: 'Prywatność', terms: 'Warunki użytkowania', support: 'Pomoc', contact: 'Kontakt',
