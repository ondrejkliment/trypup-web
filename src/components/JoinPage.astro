    codeLabel: 'Ваш код', copy: '📋 Скопіювати код', copied: '✓ Скопійовано',
    openApp: 'Відкрити в застосунку Trypup',
    noApp: 'Немає застосунку? Завантажте його з [as]App Store[/as] або [gp]Google Play[/gp]. Потім поверніться сюди або введіть код [code] у застосунку вручну. Уперше в Trypup? Одразу на першому екрані натисніть «[first]». Уже маєте собаку в застосунку? [path]. У режимі «Собака вдома» спершу перемкніться в Налаштуваннях на «Собака на пробу».',
    fallback: 'Схоже, Trypup ще не встановлено. Скопіюйте код вище, завантажте застосунок з [as]App Store[/as] або [gp]Google Play[/gp] і одразу на першому екрані натисніть «[first]».',
    noCode: 'Посилання не містить дійсного коду — попросіть нове запрошення.',
    path: 'Профіль → Спільний догляд → Приєднатися',
    first: 'Маю код для спільної турботи',
    inAppIos: 'Застосунок не відкрився? Деякі браузери (наприклад, той, що в Messenger) блокують відкриття застосунків. Торкніться ⋯ або ↗ угорі, виберіть «Відкрити в Safari» чи «Відкрити в браузері» і там торкніться «[open]». Або відкрийте Trypup і введіть код вручну.',
    inAppAndroid: 'Застосунок не відкрився? Деякі браузери (наприклад, той, що в Messenger) блокують відкриття застосунків. Торкніться ⋮ угорі, виберіть «Відкрити в Chrome» чи «Відкрити в браузері» і там торкніться «[open]». Або відкрийте Trypup і введіть код вручну.',
  },
};

const t = T[lang];
const link = (href: string, text: string) => `<a href="${href.replace(/&/g, '&amp;')}" style="color:#F2784B;font-weight:600;">${text}</a>`;
const fill = (s: string, withCode: boolean) => s
  .replace(/\[as\](.*?)\[\/as\]/g, (_m, x) => link(APP_STORE, x))
  .replace(/\[gp\](.*?)\[\/gp\]/g, (_m, x) => link(PLAY, x))
  .replace('[code]', withCode ? '<span id="code-inline" style="font-weight:700;"></span>' : '')
  .replace(/\[path\]/g, `<strong>${t.path}</strong>`)
  .replace(/\[first\]/g, `<strong>${t.first}</strong>`);
const alt = lang === 'en' ? '/join/' : '/en/join/';
---
<Base title={t.title} description={t.description} lang={lang} alt={alt} pageKey="join" noindex>
  <section class="section wrap" style="text-align:center; max-width: 560px; margin-inline: auto;">
    <h1 style="margin-bottom: 0.4rem;">{t.h1}</h1>
    <p class="meta" style="margin-bottom: 2rem;">{t.meta}</p>
    <p id="no-code" hidden style="color: #B91C1C; font-weight: 600; margin-bottom: 1.5rem;">{t.noCode}</p>

    <div id="code-card" style="background: #FDF4EF; border: 2px solid #F2784B; border-radius: 16px; padding: 1.5rem; margin-bottom: 1.5rem;">
      <div style="font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; color: #4A2B45; opacity: .7; margin-bottom: .4rem;">{t.codeLabel}</div>
      <div id="code" style="font-size: 2.6rem; font-weight: 800; letter-spacing: .35em; color: #4A2B45;">······</div>
      <button id="copy" data-copied={t.copied} style="margin-top: 1rem; background: none; border: 1px solid #F2784B; color: #F2784B; border-radius: 999px; padding: .5rem 1.2rem; font-size: .95rem; cursor: pointer;">{t.copy}</button>
    </div>

    <!-- Vestavěný prohlížeč jiné aplikace (Messenger, Instagram…) otevření aplikace často zablokuje: návod až po neúspěšném klepnutí (18. 11. 2026). -->
    <p id="in-app-ios" hidden style="background:#FDF4EF; border:2px solid #F2784B; border-radius:12px; padding:.9rem 1.1rem; font-size:.95rem; color:#4A2B45; line-height:1.5; margin-bottom:1rem;">{t.inAppIos.replace('[open]', t.openApp)}</p>
    <p id="in-app-android" hidden style="background:#FDF4EF; border:2px solid #F2784B; border-radius:12px; padding:.9rem 1.1rem; font-size:.95rem; color:#4A2B45; line-height:1.5; margin-bottom:1rem;">{t.inAppAndroid.replace('[open]', t.openApp)}</p>

    <a id="open-app" href="#" data-play={PLAY} style="display: inline-block; background: #F2784B; color: #fff; border-radius: 999px; padding: .9rem 2rem; font-weight: 700; text-decoration: none; margin-bottom: 1rem;">{t.openApp}</a>

    <p id="join-help" style="font-size: .9rem; opacity: .75; line-height: 1.5;" set:html={fill(t.noApp, true)} />
    <p id="install-fallback" hidden style="background:#FDF4EF; border:1px solid #F2784B; border-radius:12px; padding:.9rem 1.1rem; font-size:.9rem; color:#4A2B45; line-height:1.5;" set:html={fill(t.fallback, false)} />
  </section>
</Base>

<script>
  const params = new URLSearchParams(location.search);
  const raw = (params.get('c') ?? params.get('code') ?? '').trim().toUpperCase();
  const valid = /^[A-Z2-9]{6}$/.test(raw);
  const codeEl = document.getElementById('code');
  const inlineEl = document.getElementById('code-inline');
  const openEl = document.getElementById('open-app') as HTMLAnchorElement | null;
  const copyEl = document.getElementById('copy');
  if (valid && codeEl && openEl) {
    codeEl.textContent = raw;
    if (inlineEl) inlineEl.textContent = raw;
    // Vestavěný prohlížeč jiné aplikace (Messenger, Instagram, TikTok…) otevření aplikace často
    // zablokuje a stránka by lživě tvrdila „nemáte nainstalovaný“. Tlačítko je obyčejný odkaz
    // (skutečné klepnutí, ne přesměrování skriptem – to Meta blokuje); když se aplikace neotevře,
    // návod „Otevřít v Safari / Chrome“. Na Androidu intent:// (bez aplikace Google Play).
    const ua = navigator.userAgent || '';
    const isIOS = /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
    const isAndroid = /Android/i.test(ua);
    const inApp = /FBAN|FBAV|FB_IAB|FBIOS|FBSS|Messenger|Instagram|Line\/|MicroMessenger|BytedanceWebview|musical_ly|TikTok|Snapchat|Pinterest|LinkedInApp/i.test(ua);
    const appUrl = `trypup://join/${raw}`;
    const play = openEl.dataset.play ?? '';
    const intentUrl = `intent://join/${raw}#Intent;scheme=trypup;package=app.trypup.mobile;S.browser_fallback_url=${encodeURIComponent(play)};end`;
    const targetUrl = isAndroid ? intentUrl : appUrl;
    openEl.href = targetUrl;
    const inAppBox = inApp ? document.getElementById(isIOS ? 'in-app-ios' : isAndroid ? 'in-app-android' : '') : null;
    // Přepnutí jazyka musí kód zachovat, jinak by stránka v jiném jazyce ukázala „neplatný kód".
    document.querySelectorAll<HTMLAnchorElement>('.lang-menu a').forEach((a) => {
      try {
        const u = new URL(a.getAttribute('href') ?? '', location.href);
        u.searchParams.set('c', raw);
        a.setAttribute('href', u.pathname + u.search + u.hash);
      } catch {}
    });
    // Když aplikace NENÍ nainstalovaná, custom scheme jen hodí systémovou chybu
    // („Aplikaci nelze otevřít"). Zkusíme aplikaci otevřít a když se po chvíli nic
    // nestane (stránka zůstane viditelná), ukážeme nenápadný návod pro stažení.
    openEl.addEventListener('click', () => {
      // Bez preventDefault: odkaz otevře prohlížeč sám z klepnutí (viz výš).
      let opened = false;
      const onHide = () => { opened = true; };
      document.addEventListener('visibilitychange', onHide, { once: true });
      window.addEventListener('pagehide', onHide, { once: true });
      setTimeout(() => {
        if (opened || document.hidden) return;
        // Ve vestavěném prohlížeči nejde poznat, jestli aplikace chybí → návod, jak ho opustit.
        if (inAppBox) {
          inAppBox.removeAttribute('hidden');
          inAppBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else document.getElementById('install-fallback')?.removeAttribute('hidden');
      }, 1400);
    });
    copyEl?.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(raw); if (copyEl) copyEl.textContent = copyEl.dataset.copied ?? '✓'; } catch {}
    });
  } else {
    // Bez platného kódu: hláška nahoře, pryč karta s kódem, tlačítko i návod s prázdným kódem.
    // Tlačítko má inline `display`, které atribut `hidden` přebije (dřív zůstalo vidět a nic nedělalo).
    document.getElementById('code-card')?.setAttribute('hidden', '');
    document.getElementById('join-help')?.setAttribute('hidden', '');
    if (openEl) openEl.style.display = 'none';
    document.getElementById('no-code')?.removeAttribute('hidden');
  }
</script>
