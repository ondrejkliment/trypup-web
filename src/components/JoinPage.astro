    codeLabel: 'O seu código', copy: '📋 Copiar código', copied: '✓ Copiado',
    openApp: 'Abrir na aplicação Trypup',
    noApp: 'Ainda não tem a aplicação? Descarregue-a na [as]App Store[/as] ou no [gp]Google Play[/gp]. Depois volte aqui, ou introduza o código [code] na aplicação, em [path].',
    fallback: 'Parece que a Trypup ainda não está instalada. Copie o código acima e introduza-o na aplicação, em [path]. Pode obter a aplicação na [as]App Store[/as] ou no [gp]Google Play[/gp].',
    noCode: 'Esta ligação não tem um código válido — peça um novo convite.',
    path: 'Juntos → Juntar-se',
  },
  sk: {
    title: 'trypup 🐾 pozvánka',
    description: 'Pripojte sa k spoločnej starostlivosti o psa v Trypupe.',
    h1: '🐾 Pozvánka k spoločnej starostlivosti',
    meta: 'Niekto vás pozýva, aby ste sa spolu starali o psa v Trypupe.',
    codeLabel: 'Váš kód', copy: '📋 Skopírovať kód', copied: '✓ Skopírované',
    openApp: 'Otvoriť v aplikácii Trypup',
