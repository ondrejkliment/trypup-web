const t = T[lang];
const link = (href: string, text: string) => `<a href="${href.replace(/&/g, '&amp;')}" style="color:#F2784B;font-weight:600;">${text}</a>`;
const fill = (s: string, withCode: boolean) => s
  .replace(/\[as\](.*?)\[\/as\]/g, (_m, x) => link(APP_STORE, x))
  .replace(/\[gp\](.*?)\[\/gp\]/g, (_m, x) => link(PLAY, x))
  .replace('[code]', withCode ? '<span id="code-inline" style="font-weight:700;"></span>' : '')
  .replace(/\[path\]/g, `<strong>${t.path}</strong>`)
  .replace(/\[first\]/g, `<strong>${t.first}</strong>`);
const alt = lang === 'en' ? '/join/' : '/en/join/';
---
<Base title={t.title} description={t.description} lang={lang} alt={alt} pageKey="join">
  <section class="section wrap" style="text-align:center; max-width: 560px; margin-inline: auto;">
    <h1 style="margin-bottom: 0.4rem;">{t.h1}</h1>
    <p class="meta" style="margin-bottom: 2rem;">{t.meta}</p>

    <div id="code-card" style="background: #FDF4EF; border: 2px solid #F2784B; border-radius: 16px; padding: 1.5rem; margin-bottom: 1.5rem;">
      <div style="font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; color: #4A2B45; opacity: .7; margin-bottom: .4rem;">{t.codeLabel}</div>
      <div id="code" style="font-size: 2.6rem; font-weight: 800; letter-spacing: .35em; color: #4A2B45;">······</div>
      <button id="copy" data-copied={t.copied} style="margin-top: 1rem; background: none; border: 1px solid #F2784B; color: #F2784B; border-radius: 999px; padding: .5rem 1.2rem; font-size: .95rem; cursor: pointer;">{t.copy}</button>
    </div>

    <a id="open-app" href="#" style="display: inline-block; background: #F2784B; color: #fff; border-radius: 999px; padding: .9rem 2rem; font-weight: 700; text-decoration: none; margin-bottom: 1rem;">{t.openApp}</a>

    <p style="font-size: .9rem; opacity: .75; line-height: 1.5;" set:html={fill(t.noApp, true)} />
    <p id="install-fallback" hidden style="background:#FDF4EF; border:1px solid #F2784B; border-radius:12px; padding:.9rem 1.1rem; font-size:.9rem; color:#4A2B45; line-height:1.5;" set:html={fill(t.fallback, false)} />
    <p id="no-code" hidden style="color: #B91C1C; font-weight: 600;">{t.noCode}</p>
  </section>
</Base>

<script>
  const params = new URLSearchParams(location.search);
  const raw = (params.get('c') ?? params.get('code') ?? '').trim().toUpperCase();
  const valid = /^[A-Z2-9]{6}$/.test(raw);
  const codeEl = document.getElementById('code');
  const inlineEl = document.getElementById('code-inline');
  const openEl = document.getElementById('open-app') as HTMLAnchorElement | null;
  const copyEl = document.getElementById('copy');
  if (valid && codeEl && openEl) {
    codeEl.textContent = raw;
    if (inlineEl) inlineEl.textContent = raw;
    openEl.href = `trypup://join/${raw}`;
    // Přepnutí jazyka musí kód zachovat, jinak by stránka v jiném jazyce ukázala „neplatný kód".
    document.querySelectorAll<HTMLAnchorElement>('.lang-menu a').forEach((a) => {
      try {
        const u = new URL(a.getAttribute('href') ?? '', location.href);
        u.searchParams.set('c', raw);
        a.setAttribute('href', u.pathname + u.search + u.hash);
      } catch {}
    });
    // Když aplikace NENÍ nainstalovaná, custom scheme jen hodí systémovou chybu
    // („Aplikaci nelze otevřít"). Zkusíme aplikaci otevřít a když se po chvíli nic
    // nestane (stránka zůstane viditelná), ukážeme nenápadný návod pro stažení.
    openEl.addEventListener('click', (ev) => {
      ev.preventDefault();
      let opened = false;
      const onHide = () => { opened = true; };
      document.addEventListener('visibilitychange', onHide, { once: true });
      window.addEventListener('pagehide', onHide, { once: true });
      try { window.location.href = `trypup://join/${raw}`; } catch {}
      setTimeout(() => {
        if (!opened && !document.hidden) document.getElementById('install-fallback')?.removeAttribute('hidden');
      }, 1400);
    });
    copyEl?.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(raw); if (copyEl) copyEl.textContent = copyEl.dataset.copied ?? '✓'; } catch {}
    });
  } else {
    document.getElementById('code-card')?.setAttribute('hidden', '');
    openEl?.setAttribute('hidden', '');
    document.getElementById('no-code')?.removeAttribute('hidden');
  }
</script>
