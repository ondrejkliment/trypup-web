---
// Cíl magic linku z pozvánky ke spoluvlastnictví: https://trypup.life/[<jazyk>/]join?c=KÓD
// Statická stránka — kód čte klientský skript z query parametru. Tlačítko
// „Otevřít v aplikaci" vede na deep link trypup://join/KÓD (zpracuje aplikace).
import Base from '../layouts/Base.astro';
import type { Lang } from '../lib/operator';

interface Props { lang: Lang }
const { lang } = Astro.props;

const APP_STORE = 'https://apps.apple.com/app/trypup-try-a-dog-first/id6775990135';
const PLAY = 'https://play.google.com/store/apps/details?id=app.trypup.mobile&pcampaignid=web_trypup';

type JoinStrings = {
  title: string; description: string; h1: string; meta: string; codeLabel: string;
  copy: string; copied: string; openApp: string; noApp: string; fallback: string; noCode: string;
  path: string;
};

// [as]…[/as] = odkaz do App Storu, [gp]…[/gp] = Google Play, [code] = kód z URL, [path] = cesta
// v aplikaci. `path` musí sedět s aplikací: nav.friends → friends.join v pawprint-mobile/src/locales.
// cs: titulek a popis zůstávají dvojjazyčné — starší verze aplikace posílají /join všem jazykům.
const T: Record<Lang, JoinStrings> = {
