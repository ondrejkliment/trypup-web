        };
        if (elig.length) wz4 = laterClear(elig.flatMap(([c, [sa, sb, rg]]) => (rg
          ? [campWhen(c.a.n, sa, rg, rg.live), campWhen(c.b.n, sb, rg, !rg.live)]
          : [whenClear(c.a.n, sa, today, youngSrc), whenClear(c.b.n, sb, today, youngSrc)])));
        else if (topChannel) wz4 = whenClear(getKey(qChannel, topChannel.key).d1.n, addedD1(idx, chanGroups.get(topChannel.key)), today, youngSrc);
        else wz4 = whenClear(0, 0, today, youngSrc);
      }
      // Z2 „Málo dat“ (uplnost-2): kdy bude 10 měřitelných; tempo = noví z měřitelných za 7 dní.
      const wz2 = measured.length < R.SMALL_N ? whenClear(measured.length, measured.filter((d) => d.firstMs > w7).length, today, { target: R.SMALL_N, since: srcSince, lag: 0 }) : null;
      return {
        new: { h24: byPlat(n24), d7: byPlat(n7), prev7: byPlat(p7), d30: byPlat(n30) },
        trend, byDay,
        store: { lastDay: { ios: st.last.ios, android: st.last.android } },
        channel: { measured: measured.length, of: and30.length, byChannel, unmeasured: and30.length - measured.length, ios: n30.length - and30.length },
        quality: { all: qAll, channel: qChannel, campaign: qCampaign, comparisons, topChannel, lateMeasured: qRow(lateMeasured) },
        campaigns,
        share: {
          active: active30.length, shared: { k: sharers.length, n: active30.length }, kind: breakdown(kinds),
