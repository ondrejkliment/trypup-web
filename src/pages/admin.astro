     *  hloubky 20. Časové razítko → ms (toMillis); cizí třídy (odkaz na dokument, bajty, GPS bod…) → značka
     *  neplatné hodnoty. Prostý objekt = prototyp bez dalšího předka (platí i v node:vm). */
    function toPlain(v, depth = 0) {
      if (v === null || typeof v === 'string' || typeof v === 'boolean') return v;
      if (typeof v === 'number') return Number.isFinite(v) ? v : null;
      if (v === undefined) return null;
      if (typeof v !== 'object') return BAD_VALUE;
      if (depth >= 20) return BAD_VALUE;
      if (Array.isArray(v)) return v.map((x) => toPlain(x, depth + 1));
      const pr = Object.getPrototypeOf(v);
      if (pr !== null && Object.getPrototypeOf(pr) !== null) {
        if (typeof v.toMillis === 'function') { try { const t = v.toMillis(); return Number.isFinite(t) ? t : null; } catch { return BAD_VALUE; } }
