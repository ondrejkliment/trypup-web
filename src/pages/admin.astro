          const e = (a.to === null ? Infinity : a.to) < (b.to === null ? Infinity : b.to) ? (a.to === null ? Infinity : a.to) : (b.to === null ? Infinity : b.to);
          if (s <= e) { const ra = find(i), rb = find(j); if (ra !== rb) { if (ra < rb) parent[rb] = ra; else parent[ra] = rb; } }
        }
        const members = new Map();
        camps.forEach((c, i) => { const r = find(i); const l = members.get(r); if (l) l.push(i); else members.set(r, [i]); });
        const groupOf = (i) => { const r = find(i); return members.get(r).length > 1 ? camps[r].id : null; };
        const list = camps.map((c, i) => {
          const [f, t] = counted(c), days = Math.max(0, t - f + 1), nw = days > 0 ? newIn(c.platform, [[f, t]]) : 0;
          const base = baselineOf(c.platform, c.from), aboveRaw = aboveOf(nw, base, days);
          const spend = c.spendEur;
          const cost = aboveRaw !== null && aboveRaw > 0 && spend !== null ? roundTo(spend / aboveRaw, 2) : null;
          const inGroup = members.get(find(i)).length > 1;
          let verdict, note = null;
          if (days < R.CAMPAIGN_MIN_DAYS) verdict = 'Běží krátce';
          else if (spend === null) verdict = 'Chybí útrata';
          else if (inGroup) verdict = 'Nelze oddělit';
          else if (base.state) { verdict = 'Málo dat'; note = 'noBaseline'; }
          else if (aboveRaw <= 0) { verdict = 'Nevyplatí se'; note = 'nothingExtra'; }
          else verdict = cost <= R.CAMPAIGN_MAX_EUR ? 'Vyplatí se' : 'Nevyplatí se';
          const tight = (verdict === 'Vyplatí se' || verdict === 'Nevyplatí se') && cost !== null && cost >= R.CAMPAIGN_TIGHT[0] && cost <= R.CAMPAIGN_TIGHT[1];
          return { id: c.id, name: c.name, network: c.network, platform: c.platform, from: c.fromIso, to: c.toIso,
            days, new: nw, baseline: base, above: aboveRaw === null ? null : roundTo(aboveRaw, 2), spendEur: spend, spendAt: c.spendAt,
            cost, verdict, note, tight, group: groupOf(i),
            countedTo: days > 0 ? dayIso(t) : null, spendBound: c.spendDay !== null && c.spendDay < reach(c) };
        });
        const joint = [];
        for (const [r, ids] of members) {
          if (ids.length < 2) continue;
          // Společný konec J: nejdřívější spendAt členů, které útratu za celou dobu nemají (spendAt < to, běžící vždy),
          // nejvýš včera. Skončený člen s celou útratou (to ≤ spendAt) J neomezuje. Schválně konzervativní: jeho
          // útrata se počítá celá, i když běžel i po J, takže cena vyjde spíš vyšší.
          let J = yesterday;
          for (const i of ids) { const c = camps[i]; if (c.spendDay !== null && (c.to === null || c.spendDay < c.to) && c.spendDay < J) J = c.spendDay; }
          const p = camps[r].platform, ranges = ids.map((i) => { const [a, b] = counted(camps[i]); return [a, Math.min(b, J)]; })
            .filter(([a, b]) => b >= a).sort((x, y) => x[0] - y[0]);
          // spendBound = útrata zkrátila aspoň jeden neprázdný rozsah člena proti oknu bez útraty [from, min(to, včera)].
          const spendBound = ids.some((i) => { const c = camps[i], e = reach(c); return c.from <= e && Math.min(counted(c)[1], J) < e; });
          let days = 0, curA = null, curB = null, end = null;
          for (const [a, b] of ranges) {
            if (end === null || b > end) end = b;
            if (curB !== null && a <= curB + 1) { if (b > curB) curB = b; continue; }
            if (curB !== null) days += curB - curA + 1;
            curA = a; curB = b;
          }
          if (curB !== null) days += curB - curA + 1;
          let minFrom = camps[ids[0]].from;
          for (const i of ids) if (camps[i].from < minFrom) minFrom = camps[i].from;
          const nw = ranges.length ? newIn(p, ranges) : 0, base = baselineOf(p, minFrom), aboveRaw = aboveOf(nw, base, days);
          const spends = ids.map((i) => camps[i].spendEur);
          const spend = spends.every(isNum) ? roundTo(spends.reduce((a, v) => a + v, 0), 2) : null;
          joint.push({ group: camps[r].id, ids: ids.map((i) => camps[i].id), names: ids.map((i) => camps[i].name), platform: p, days, new: nw, baseline: base,
            above: aboveRaw === null ? null : roundTo(aboveRaw, 2), spendEur: spend,
            cost: aboveRaw !== null && aboveRaw > 0 && spend !== null ? roundTo(spend / aboveRaw, 2) : null,
            countedTo: end === null ? null : dayIso(end), spendBound });
        }
        campaigns = { state: 'ok', updatedAt: D.adCampaigns.updatedAt ?? null, list, joint,
          upcoming: upcoming.map((c) => ({ id: c.id, name: c.name, network: c.network, platform: c.platform, from: c.fromIso, to: c.toIso, spendEur: c.spendEur })) };
        let newest = -1;
        camps.forEach((c, i) => { if (newest < 0 || c.from >= camps[newest].from) newest = i; });
        // Patří-li nejnovější kampaň do skupiny překryvu, karta ukáže větu skupiny, a tedy i její verdikt Nelze oddělit
        // (i když má kampaň sama Běží krátce nebo Chybí útrata; oprava po revizi 20. 11.).
        if (newest >= 0) z3 = list[newest].group !== null ? 'Nelze oddělit' : list[newest].verdict;
      } else campaigns = { state: 'missing' };

      // Z5 šíření: aktivní za 30 dní. Klepnutí na získaný odznak (badge_opened, starý share_initiated s kind 'badge'
      // bez source 'detail' i pochlubení z detailu) se počítá zvlášť (badge.k) a samo do sdílení nevstupuje; sdílení
      // tlačítkem „Pochlubit se“ v detailu (kind 'badge', source 'detail') je sdílení, moment Odznak (rozhodnutí
      // zakladatele 20. 11.). Chybějící nebo neznámý kind je sdílení. badge.ios jen ze starého toku: zmizí, až ho
      // žádný aktivní iPhone za 30 dní nepošle (starší verze bez aktualizace ho posílají dál).
      const active30 = real.filter((d) => inWin(d.lastMs, w30, now));
      const set30 = (name) => idx.byName30.get(name) || CORE_EMPTY_SET;
      const isIos = (d) => d.platform === 'ios';
      const sharers = activeWith(idx, w30, 'share_initiated', isShareEv);
      const badgeTappers = activeWith(idx, w30, BADGE_TAP_NAMES, isBadgeTap);
      const badgeSharers = activeWith(idx, w30, 'share_initiated', isBadgeShared);
      const oldTapIos = activeWith(idx, w30, 'share_initiated', isBadgeOldTap).filter(isIos);
      const kinds = new Map();
      for (const d of sharers) {
        const seen = new Set();
        scanDev(d, w30, now, (e, p) => { if (isShareEv(e, p)) seen.add(valKey(p.kind)); return false; });
        for (const k of seen) addCount(kinds, k);
      }
      // Kterými odznaky se chlubí (od verze 355 nese pochlubení z detailu id odznaku): každé id u zařízení jednou,
      // stejný rozpad jako momenty; chybějící id → '_none'. Součet může být vyšší než badge.shared (víc odznaků).
      const badgeIds = new Map();
      for (const d of badgeSharers) {
        const seen = new Set();
        scanDev(d, w30, now, (e, p) => { if (isBadgeShared(e, p)) seen.add(valKey(p.id)); return false; });
        for (const k of seen) addCount(badgeIds, k);
      }
      const iosSent = iosWith(idx, sharers, w30, isShareSent).length;
      const iosBadgeSent = iosWith(idx, oldTapIos, w30, isBadgeOldSent).length;

      // Z6 odkud: noví za 30 dní podle ledgeru; obchody podle země za posledních 30 pražských dnů.
      const geoKey = (v) => (v === null || v === undefined || v === '' || v === 'none' || v === 'unknown' ? '_none' : String(v));
      const geo = (field) => { const m = new Map(); for (const d of n30) addCount(m, geoKey(d.inst[field])); return breakdown(m); };
      const storeRegion = new Map(), fromIso = dayIso(today - 29), toIso = dayIso(today);
      for (const x of st.docs) {
        if (x.date < fromIso || x.date > toIso) continue;
        const m = x.platform === 'ios' ? x.byTerritory : x.byCountry;
        if (!m || typeof m !== 'object') continue;
        for (const k of Object.keys(m)) if (isNum(m[k])) addCount(storeRegion, k, m[k]);
      }

      // Verdikty a „kdy bude jasno“.
      const elig = comparisons.map((c, i) => [c, sides[i]]).filter(([c]) => c.eligible);
      const z4 = elig.some(([c]) => c.verdict === 'Průkazný rozdíl') ? 'Průkazný rozdíl'
        : elig.some(([c]) => c.verdict === 'Zatím neprůkazné') ? 'Zatím neprůkazné' : 'Málo dat';
      // Kanály se měří od install_source.od: tempo D1 (zralost 2 dny) ze necelého týdne by datum posunulo o měsíce.
