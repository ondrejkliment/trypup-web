      const O = (d) => onb.get(d.id);
      const saved = (d) => d.names.has('owner_activated') || d.dogScreen;
      const onbL = K.filter((d) => O(d).has);
      const forkL = onbL.filter((d) => O(d).reached.has('fork') || O(d).lastChoice !== null);
