        },
        region: geo('region'), locale: geo('locale'), deviceLocale: geo('deviceLocale'),
        storeRegion30: breakdown(storeRegion),
        verdicts: { z1: trend, z2: measured.length < R.SMALL_N ? 'Málo dat' : 'Zjištění', z3, z4, z5: 'Zjištění', z6: 'Zjištění' },
        whenClear: { z4: wz4 },
      };
    }
    const getKey = (o, k) => (Object.hasOwn(o, k) ? o[k] : undefined);

    // ── Cesta (SPEC C.2)
    function computeJourney(idx) {
      const R = VERDICT_RULES, { now, today, w7, w14, w30, real, ci } = idx;
      const K = real.filter((d) => inWin(d.firstMs, w30, now));
      const matureAt = now - R.MATURE_DAYS * CORE_DAY;

      // A1 a A2: úvod po zařízeních (všechny události zařízení, seřazené podle času).
      const side = (v) => (valKey(v) === '_none' ? '?' : String(v));
      const onb = new Map();
      for (const d of K) {
        const o = { has: false, lastChoice: null, reached: new Set(), lastStep: null, back: false };
        for (const e of d.evs) {
