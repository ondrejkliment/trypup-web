      // B3 Pes doma: místa (obrazovky, u vets a family i akce) a akce s měřitelností podle R8.
      const opened = {}, ownerTwo = {};
      for (const [place, test, action] of OWNER_PLACES) {
        const scans = new Map(mOwner.map((d) => [d.id, in30(d, (e, p) => { const s = screenOf(e, p); return (s !== null && test(s)) || (action !== null && e.name === action); })]));
        opened[place] = { k: mOwner.filter((d) => scans.get(d.id).n > 0).length, n: mOwner.length };
        ownerTwo[place] = twoDaysOf(mOwner, (d) => scans.get(d.id), matureAt);
      }
      const b30 = (d) => d.b30;
      const did = (place, sb, pred) => ({ place, sb, ...measuredFraction(measurable(mOwner, b30, sb), (d) => in30(d, pred).n > 0) });
      const walkSb = catalogSb(ci, 'walk_started', 'mode', 'owner', 338);
      const owner = {
        base: mOwner.length, opened, twoDays: ownerTwo,
        did: {
          planItem: did('plan', catalogSb(ci, 'plan_item', null, undefined, 337), isName('plan_item')),
          calendar: did('plan', catalogSb(ci, 'calendar_event_opened', null, undefined, 292), isName('calendar_event_opened')),
          entry: did('diary', catalogSb(ci, 'diary_entry', null, undefined, 337), (e) => e.name === 'diary_entry' || e.name === 'weight_entry'),
          document: did('docs', catalogSb(ci, 'dog_document', null, undefined, 304), isName('dog_document')),
          trainingSession: did('training', catalogSb(ci, 'training_logged', null, undefined, 312), (e) => e.name === 'training_logged' || e.name === 'training_stage_confirmed'),
          walkStarted: did('walk', walkSb, (e, p) => e.name === 'walk_started' && p.mode === 'owner'),
          walkCompleted: did('walk', walkSb, (e, p) => e.name === 'walk_completed' && p.mode === 'owner'),
          family: { place: 'family', state: 'testers' },
        },
      };

      // B4 přepnutí režimu (zařízení, ne přepnutí).
      const sw = { total: 0, onbOwner: 0, onbTrial: 0, laterOwner: 0, laterTrial: 0, ownerBy: new Map(), trialBy: new Map() };
      for (const d of active) {
        let any = false, oo = false, ot = false, lo = false, lt = false;
        const srcO = new Set(), srcT = new Set();
        in30(d, (e, p) => {
          if (e.name !== 'mode_switched') return false;
          any = true;
          const src = valKey(p.source), onbSrc = src === 'onboarding';
          if (p.to === 'owner') { if (onbSrc) oo = true; else { lo = true; srcO.add(src); } }
          else if (p.to === 'trial') { if (onbSrc) ot = true; else { lt = true; srcT.add(src); } }
          return false;
        });
        if (any) sw.total++;
        if (oo) sw.onbOwner++; if (ot) sw.onbTrial++; if (lo) sw.laterOwner++; if (lt) sw.laterTrial++;
        for (const s of srcO) addCount(sw.ownerBy, s);
        for (const s of srcT) addCount(sw.trialBy, s);
      }

      // B5 vstupy (7 dní), upozornění a připomínky péče (30 dní).
      const active7 = real.filter((d) => inWin(d.lastMs, w7, now));
      const mEntry = measurable(active7, (d) => d.b7, catalogSb(ci, 'app_entry', null, undefined, 342));
      let entry;
      if (mEntry.unmeasured) entry = { state: 'unmeasured', x: mEntry.x, y: mEntry.y };
      else {
        const bySrc = new Map(), cnt = new Map(); let devices = 0;
        for (const d of mEntry.base) {
          const r = scanDev(d, w7, now, (e, p) => { if (e.name !== 'app_entry') return false; const k = valKey(p.source); addCount(cnt, k); addToSet(bySrc, k, d.id); return true; });
          if (r.n > 0) devices++;
        }
        entry = { x: mEntry.x, y: mEntry.y, n: mEntry.base.length, devices, bySource: breakdownSets(bySrc), countBySource: breakdown(cnt) };
      }
      const notifStatus = new Map(); let answered = 0;
      for (const d of active) {
        const r = in30(d, isName('notification_permission'));
        if (!r.last) continue;
        answered++; addCount(notifStatus, valKey(propsOf(r.last).status));
      }
      const notif = { answered, granted: notifStatus.get('granted') || 0, denied: notifStatus.get('denied') || 0, byStatus: breakdown(notifStatus) };
      const mCare = measurable(mTrial, b30, catalogSb(ci, 'care_reminder_opened', null, undefined, 335));
      let care, b5 = 'Zatím neměříme', wb5 = null;
      if (mCare.unmeasured) care = { state: 'unmeasured', x: mCare.x, y: mCare.y };
      else {
        const slot = new Map(), variant = new Map(), timing = new Map(), firstByVar = new Map();
        let openedN = 0, doneN = 0;
        for (const d of mCare.base) {
          if (in30(d, isName('care_reminder_opened')).n > 0) openedN++;
          const r = in30(d, (e, p) => {
            if (e.name !== 'care_reminder_done') return false;
            addToSet(slot, valKey(p.slot), d.id); addToSet(variant, valKey(p.variant), d.id); addToSet(timing, valKey(p.timing), d.id);
            const k = valKey(p.variant) + '\u0000' + d.id;
            if (!firstByVar.has(k)) firstByVar.set(k, e.ts);
            return true;
          });
          if (r.n > 0) doneN++;
        }
        const byVar = breakdownSets(variant);
        care = { x: mCare.x, y: mCare.y, n: mCare.base.length, opened: openedN, done: doneN,
          doneBySlot: breakdownSets(slot), doneByVariant: byVar, doneByTiming: breakdownSets(timing) };
        if (!byVar.some(([, c]) => c >= R.SURE_N)) {
          b5 = 'Zatím neprůkazné';
          if (!byVar.length) wb5 = { state: 'unknown' };
          else {
            const [top, base] = byVar[0];
            const added = [...variant.get(top)].filter((id) => firstByVar.get(top + '\u0000' + id) > idx.w7).length;
            wb5 = whenClear(base, added, today);
          }
        } else { b5 = 'Zjištění'; care.best = byVar[0][0]; }
      }

      // B6 mise (jen počty zařízení za 30 dní).
      const has30 = (d, name) => (idx.byName30.get(name) || CORE_EMPTY_SET).has(d.id);
      const decision = new Map(), shelterBy = new Map();
      let shelterDev = 0, clicks = 0;
      for (const d of active) {
        const r = in30(d, isName('challenge_decision'));
        if (r.last) addCount(decision, valKey(propsOf(r.last).choice));
        const s = in30(d, (e, p) => {
          if (e.name !== 'shelter_opened' && e.name !== 'graduation_shelter_cta') return false;
          const v = valKey(p.shelter);
          addCount(shelterBy, v === '_none' ? '_graduation' : v.split(' - ').join(' – '));
          return true;
        });
        if (s.n > 0) { shelterDev++; clicks += s.n; }
      }
      const mission = {
        started: active.filter((d) => has30(d, 'challenge_started')).length,
        graduation: active.filter((d) => has30(d, 'graduation_reached')).length,
        completed: active.filter((d) => has30(d, 'challenge_completed')).length,
        decided: active.filter((d) => has30(d, 'challenge_decision')).length,
        decision: breakdown(decision),
        wait: active.filter((d) => has30(d, 'graduation_wait_cta')).length,
        shelter: { devices: shelterDev, clicks, byShelter: breakdown(shelterBy) },
      };

      // B7 odpovědi v úvodu: poslední záznam za zařízení v období (aktivní za 30 dní).
      const lastOf = (name) => active.map((d) => in30(d, isName(name)).last).filter(Boolean);
      const brk = (list, field) => { const m = new Map(); for (const e of list) addCount(m, valKey(propsOf(e)[field])); return breakdown(m); };
      const rc = lastOf('readiness_completed'), qc = lastOf('quiz_completed'), bs = lastOf('breed_selected');
      const q = {};
      for (const k of ['q1', 'q2', 'q3', 'q4', 'q5', 'q6']) q[k] = { yes: rc.filter((e) => propsOf(e)[k] === 'yes').length, no: rc.filter((e) => propsOf(e)[k] === 'no').length, na: rc.filter((e) => propsOf(e)[k] === 'na').length };
      const offer = (action) => active.filter((d) => in30(d, (e, p) => e.name === 'onboarding_premium_offer' && p.action === action).n > 0).length;
      const answers = {
        readiness: { n: rc.length, tier: brk(rc, 'tier'), phase: brk(rc, 'phase'), q },
        quiz: { n: qc.length, hours: brk(qc, 'hours'), housing: brk(qc, 'housing'), activity: brk(qc, 'activity') },
        breed: { n: bs.length, matched: bs.filter((e) => propsOf(e).matchedRecommendation === true).length, other: bs.filter((e) => propsOf(e).matchedRecommendation === false).length, breed: brk(bs, 'breed') },
        premiumOffer: { shown: offer('shown'), tapped: offer('tapped') },
      };

      // „Kdy bude jasno“.
      const wa4 = a4 === 'Málo dat' ? whenClear(ret.all.d1.n, addedD1(idx, K), today) : null;
      let wa5 = null;
      if (a5 === 'Málo dat' || a5 === 'Zatím neprůkazné') {
        wa5 = abGroups.size < 2 ? { state: 'unknown' } : laterClear([...abGroups].map(([v, list]) => whenClear(getKey(variants, v).d1.n, addedD1(idx, list), today)));
      }
      let wb1 = null;
      if (b1c.verdict === 'Málo dat' || b1c.verdict === 'Zatím neprůkazné') {
        const addedSig = (list, k) => list.filter((d) => d.mode[k].first > w14 && d.mode[k].first <= w7).length;
        wb1 = laterClear([tdTrial.n < R.SURE_N ? whenClear(tdTrial.n, addedSig(mTrial, 'trial'), today) : null,
          tdOwner.n < R.SURE_N ? whenClear(tdOwner.n, addedSig(mOwner, 'owner'), today) : null]);
      }
      return {
        cohort: K.length, onb: onbL.length, noOnb: K.length - onbL.length,
        fork: { n: forkL.length, choice: breakdown(forkChoice) },
        branch: {
          trial: { entered: trialB.length, quiz: reached(trialB, 'quiz'), quiz_result: reached(trialB, 'quiz_result'), name: reached(trialB, 'name'), activated: trialB.filter((d) => d.names.has('activated')).length },
          owner: { entered: ownerB.length, owner_setup: reached(ownerB, 'owner_setup'), saved: ownerSaved.length, savedEvent: ownerB.filter((d) => d.names.has('owner_activated')).length,
            notSaved: ownerNot.length, closed: ownerNot.filter((d) => d.names.has('owner_setup_exit')).length },
        },
        dogAny: { k: K.filter(hasDog).length, n: K.length },
        noDog: breakdown(noDog), dwell,
        back: { devices: backDevices, transitions: breakdown(backT) },
        week, ret,
        retMarket: { d1Range: wr ? [Math.round(100 * wr[0]), Math.round(100 * wr[1])] : null },
        ab: { variants, review: abReview },
        modes: { active: active.length, trial: mTrial.length, owner: mOwner.length,
          both: active.filter((d) => d.mode.trial && d.mode.owner).length, neither: active.filter((d) => !d.mode.trial && !d.mode.owner).length,
          twoDays: { trial: tdTrial, owner: tdOwner, z: b1c.z, ranges: { trial: pctRange(tdTrial), owner: pctRange(tdOwner) } } },
        trialUse, owner,
        switch: { total: sw.total, onboarding: { owner: sw.onbOwner, trial: sw.onbTrial },
          later: { owner: sw.laterOwner, trial: sw.laterTrial, ownerBySource: breakdown(sw.ownerBy), trialBySource: breakdown(sw.trialBy) } },
        entry, notif, care, mission, answers,
        verdicts: { a1: 'Zjištění', a2: 'Zjištění', a3: 'Zjištění', a4, a5, b1: b1c.verdict, b2: 'Zjištění', b3: 'Zjištění', b4: 'Zjištění', b5, b6: 'Jen počty' },
        whenClear: { a4: wa4, a5: wa5, b1: wb1, b5: wb5 },
      };
    }

    // ── Technika (SPEC C.3). Čísla jako se zaškrtávátkem testerů vypnutým; kontrola zápisů ze všech zařízení.
    function computeTech(idx) {
      const L = CORE_LIMITS, { D, now, w7, w30, real, ci } = idx;
      const raw = Array.isArray(D.raw) ? D.raw : [], loaded = D.loaded || {};
      const dups = isNum(loaded.dups) ? loaded.dups : 0, dupLog = Array.isArray(loaded.dupLog) ? loaded.dupLog : [];
      let oldest = Infinity;
      for (const e of raw) if (e && isNum(e.ts) && e.ts < oldest) oldest = e.ts;
      const dupsReal = dupLog.filter(([iid]) => idx.devs.has(iid)).length;
      const dupsReal30 = dupLog.filter(([iid, ts]) => idx.devs.has(iid) && isNum(ts) && inWin(ts, w30, now)).length;
      let kept30 = 0;
      for (const d of real) kept30 += d.end - d.i30;
      const dups30 = { k: dupsReal30, n: kept30 + dupsReal30 };

      // T2 pokrytí verzí (aktivní za 7 dní, verze v 7denním okně).
      const active7 = real.filter((d) => inWin(d.lastMs, w7, now));
      const onStore = active7.filter((d) => d.b7 === L.STORE_BUILD);
      const atLeast = {};
      for (const sb of L.VERSION_MARKS) atLeast[sb] = active7.filter((d) => d.b7 >= sb).length;
      const oneDay = onStore.filter((d) => { const s = new Set(); for (let j = d.i30; j < d.end; j++) s.add(d.days[j]); return s.size === 1; }).length;

      // T3 kontroly: neznámé a neplatné názvy, zařízení mimo ledger (všechna načtená zařízení).
      const unknownAll = new Set(); let invalidAll = 0, outRec = 0;
      const outDev = new Set();
      for (const e of raw) {
        if (!e || !isNum(e.ts) || !inWin(e.ts, w30, now)) continue;
        if (!validActionName(e.name)) invalidAll++;
        else if (!ci.ev.has(e.name)) unknownAll.add(e.name);
        if (!idx.ledger.has(e.installId)) { outRec++; outDev.add(e.installId); }
      }
      const unknownNames = [...unknownAll].sort(cmpStr);
      const unknownReal = new Set(); let invalidReal = 0;
      const valid30 = new Set();
      for (const [nm, c] of idx.rec30) {
        if (!validActionName(nm)) { invalidReal += c; continue; }
        valid30.add(nm);
        if (!ci.ev.has(nm)) unknownReal.add(nm);
      }
      const events30 = real.filter((d) => d.end > d.i30).length, ledger30 = real.filter((d) => inWin(d.lastMs, w30, now)).length;
      const noRc = purchaseNoRcInfo(idx);
      const all = cohortRetention(real.map((d) => ({ id: d.id, firstMs: d.firstMs })), idx.activity, now).segments.all.d1;
      const srv = D.retention && D.retention.segments && D.retention.segments.all && D.retention.segments.all.d1;
      const server = srv && typeof srv === 'object' ? { k: Number(srv.k), n: Number(srv.n) } : null;
      const complete = loaded.complete === true;
      const d1State = !complete ? 'incomplete' : server === null ? null
        : !Number.isFinite(server.k) || !Number.isFinite(server.n) || Math.abs(all.k - server.k) > L.D1_DIFF_WARN || Math.abs(all.n - server.n) > L.D1_DIFF_WARN ? 'warn' : 'ok';

      // T4 k ověření, T5 Expo.
      const rv = reviewInfo(idx);
      const byModel = new Map(), byReason = new Map();
      for (const r of rv.rows) { addCount(byModel, valKey(r.d.inst.model)); for (const x of r.reasons) addCount(byReason, x); }
      let expo = 0;
      for (const i of idx.ledger.values()) if ((i.platform === 'ios' || i.platform === 'android') && isNum(i.lastMs) && inWin(i.lastMs, w30, now)) expo++;

      // T6 akce podle skupin.
      const rows = {}, groupRows = new Map();
      let seen30 = 0;
      const addRow = (nm, e) => {
        const r30 = idx.rec30.get(nm) || 0;
        const g = e ? (typeof e.g === 'string' ? e.g : 'unknown') : 'unknown';
        const state = !e ? 'unknown' : e.st === 'removed' ? 'removed' : e.st === 'testers' ? 'testers' : r30 === 0 ? 'noData' : e.auto === 1 ? 'auto' : 'live';
        setKey(rows, nm, { g, d7: (idx.byName7.get(nm) || CORE_EMPTY_SET).size, d30: (idx.byName30.get(nm) || CORE_EMPTY_SET).size, r30,
          sb: e && isNum(e.sb) ? e.sb : null, od: e && typeof e.od === 'string' ? e.od : null, state });
        addCount(groupRows, g);
      };
      for (const [nm, e] of ci.ev) { addRow(nm, e); if ((idx.rec30.get(nm) || 0) > 0) seen30++; }
      for (const nm of [...unknownReal].sort(cmpStr)) addRow(nm, null);
      const groupOrder = ci.groups.includes('unknown') ? ci.groups : [...ci.groups, 'unknown'];
      const byGroup = groupOrder.filter((g) => (groupRows.get(g) || 0) > 0).map((g) => [g, groupRows.get(g)]);
      for (const [g, c] of groupRows) if (!groupOrder.includes(g)) byGroup.push([g, c]);

      const warnIf = (c) => (c ? 'warn' : 'ok');
      const check = {
        dups30: { ...dups30, state: dups30.n && dups30.k * 100 > L.DUPS_WARN_PCT * dups30.n ? 'warn' : 'ok' },
        unknown: { count: unknownNames.length, names: unknownNames.slice(0, L.UNKNOWN_NAMES_MAX), state: warnIf(unknownNames.length > 0) },
        invalid: { count: invalidAll, state: warnIf(invalidAll > 0) },
        active30: { events: events30, ledger: ledger30, state: warnIf(Math.abs(events30 - ledger30) > L.ACTIVE_DIFF_WARN) },
        outsideLedger: { records: outRec, devices: outDev.size, state: warnIf(outRec > 0) },
        purchaseNoRc: { count: noRc.rows.length, rows: noRc.rows, state: warnIf(noRc.rows.length > 0) },
        d1Server: { admin: all, server, state: d1State },
      };
      return {
        loaded: { records: raw.length + dups, kept: raw.length, dups, batches: isNum(loaded.batches) ? loaded.batches : null,
          oldestDay: oldest === Infinity ? null : dayIso(pragueDay(oldest)), complete },
        dupsAll: dups, dupsAllReal: dupsReal, dups30,
        versions7: { active: active7.length, store: { build: L.STORE_BUILD, devices: onStore.length, oneDay }, atLeast },
        check,
        unknown: check.unknown.count, invalid: check.invalid.count, actions30: valid30.size, purchaseNoRc: check.purchaseNoRc.count,
        review: { active30: rv.rows.length, byModel: breakdown(byModel), byReason: breakdown(byReason),
          rows: rv.rows.map((r) => ({ iid: r.d.id.slice(0, 10), model: r.d.inst.model ?? null, firstDay: r.d.firstMs === null ? null : dayIso(pragueDay(r.d.firstMs)), build: r.d.inst.appBuild ?? null, reasons: r.reasons })) },
        expo: { active30: expo, limit: L.EXPO_LIMIT, level: expo >= L.EXPO_PLAN ? 'plan' : expo >= L.EXPO_WARN ? 'warn' : 'ok' },
        actions: { catalog: ci.ev.size, seen30, unknown30: unknownReal.size, invalid30: invalidReal, dups30: dups30.k, rows, byGroup },
      };
    }
    /** Informační hlavička výpočtu (kontrola jádra ji neporovnává). */
    function computeMeta(idx) {
      return { now: new Date(idx.now).toISOString(), nowMs: idx.now, today: dayIso(idx.today), schema: 1,
        cohortFrom: dayIso(pragueDay(idx.w30)), cohortTo: dayIso(idx.today), realDevices: idx.real.length, campaignsDoc: !!campaignsOf(idx.D.adCampaigns) };
    }
    // == ADMIN CORE END ==

    // --- Popisky akcí (SPEC D.1, D.2, D.5): katalog vložený do stránky (#admin-labels), jedno JSON.parse,
    //     hledání jen přes Map a Object.hasOwn. Jádro dostává tentýž objekt (LABELS) jako vstup.
    let LABELS = null;
    try { const el = $('admin-labels'); LABELS = el ? JSON.parse(el.textContent || 'null') : null; }
    catch (e) { console.warn('katalog popisků nenačten', e); }
    const EV = new Map(), SCREENS = new Map(), GROUPS = new Map(), PLACES = new Map();
    if (LABELS && typeof LABELS === 'object') {
      const ownMap = (src, m, ok) => { if (src && typeof src === 'object') for (const k of Object.keys(src)) if (ok(src[k])) m.set(k, src[k]); };
      ownMap(LABELS.ev, EV, (e) => !!e && typeof e === 'object');
      ownMap(LABELS.screens, SCREENS, Array.isArray);
      ownMap(LABELS.places, PLACES, Array.isArray);
      if (Array.isArray(LABELS.groups)) for (const g of LABELS.groups) if (Array.isArray(g) && typeof g[0] === 'string') GROUPS.set(g[0], g);
    }
    // Jazyk popisků (D.3): Čeština · English · Technické názvy. Úložiště jen v try/catch; bez něj čeština.
    const LANG_KEY = 'trypup-admin-labels', LANGS = ['cs', 'en', 'raw'];
    let LANG = 'cs';
    try { const v = localStorage.getItem(LANG_KEY); if (LANGS.includes(v)) LANG = v; } catch { /* bez úložiště platí čeština */ }
    const pickLang = (pair, raw, lang) => (lang === 'raw' ? raw : lang === 'en' ? String(pair[1] || pair[0] || raw) : String(pair[0] || raw));
    /** Popisek { text, raw, known, tip }; tip = technický zápis do title (L.html). */
    const lab = (text, raw, known, tip) => ({ text: String(text), raw: String(raw), known: !!known, tip: tip === undefined ? String(raw) : String(tip) });
    const propOf = (name, key) => {
      const e = EV.get(name);
      return e && e.p && typeof e.p === 'object' && Object.hasOwn(e.p, key) && e.p[key] && typeof e.p[key] === 'object' ? e.p[key] : null;
    };
    const L = {
      /** Akce: katalog, jinak „Neznámá akce (název)“; název mimo vzor = „neplatný záznam“ (D.5). */
      event(name, lang = LANG) {
        if (!validActionName(name)) return lab(lang === 'en' ? 'invalid record' : 'neplatný záznam', typeof name === 'string' ? name : '', false, '');
        const e = EV.get(name);
        if (!e) return lab(lang === 'raw' ? name : lang === 'en' ? `Unknown action (${name})` : `Neznámá akce (${name})`, name, false);
        let t = pickLang([e.cs, e.en], name, lang);
        if (e.st === 'removed' && lang !== 'raw') t += lang === 'en' ? ' (no longer sent)' : ' (už se neposílá)';
        return lab(t, name, true);
      },
      prop(name, key, lang = LANG) {
        const p = propOf(name, key), k = String(key);
        return p ? lab(pickLang([p.cs, p.en], k, lang), k, true, `${name} · ${k}`) : lab(k, k, false, `${name} · ${k}`);
      },
      /** Hodnota vlastnosti. Klíč z jádra '_none' = prázdná hodnota. Volný text (f: 1) bez „(bez překladu)“. */
      value(name, key, val, lang = LANG) {
        const vk = val === null || val === undefined ? '' : String(val), k2 = vk === '_none' ? '' : vk;
        const p = propOf(name, key), vals = p && p.v && typeof p.v === 'object' ? p.v : null;
        const hit = vals && Object.hasOwn(vals, k2) && Array.isArray(vals[k2]) ? vals[k2] : null;
        const tip = `${name} · ${key} = ${k2}`;
        if (lang === 'raw') return lab(k2 === '' ? '(prázdné)' : k2, k2, !!hit, tip);
        if (hit) return lab(pickLang(hit, k2, lang), k2, true, tip);
        if (k2 === '') return lab(lang === 'en' ? 'not given' : 'bez údaje', k2, false, tip);
        if (p && p.f === 1) return lab(k2.split(' - ').join(' – '), k2, false, tip);
        return lab(`${k2} ${lang === 'en' ? '(no translation)' : '(bez překladu)'}`, k2, false, tip);
      },
      screen(route, lang = LANG) {
        const r = String(route ?? ''), s = SCREENS.get(r);
        return s ? lab(pickLang(s, r, lang), r, true) : lab(lang === 'raw' ? r : `${r} ${lang === 'en' ? '(no translation)' : '(bez překladu)'}`, r, false);
      },
      group(id, lang = LANG) { const g = GROUPS.get(id), k = String(id ?? ''); return g ? lab(pickLang([g[1], g[2]], k, lang), k, true) : lab(k, k, false); },
      place(id, lang = LANG) { const p = PLACES.get(id), k = String(id ?? ''); return p ? lab(pickLang(p, k, lang), k, true) : lab(k, k, false); },
      /** Země a jazyky přes Intl.DisplayNames (cs / en), v režimu Technické názvy kód; '_none' = bez údaje. */
      region(code, lang = LANG) { return L.intl('region', code, lang); },
      lang(code, lang = LANG) { return L.intl('language', code, lang); },
      intl(type, code, lang) {
        const c = String(code ?? '');
        if (c === '' || c === '_none') return lab(lang === 'en' ? 'not given' : 'bez údaje', c, false);
        if (lang === 'raw') return lab(c, c, true);
        let t = c;
        try { t = intlNames(type, lang).of(c) || c; } catch { t = c; }
        return lab(t, c, t !== c);
      },
      /** Bezpečné HTML: text i technický název přes esc() (R12). */
      html(x) { return `<span title="Technický název: ${esc(x.tip)}">${esc(x.text)}</span>`; },
    };
    const INTL_CACHE = new Map();
    function intlNames(type, lang) {
      const k = type + '|' + lang;
      if (!INTL_CACHE.has(k)) INTL_CACHE.set(k, new Intl.DisplayNames([lang === 'en' ? 'en' : 'cs'], { type, fallback: 'code' }));
      return INTL_CACHE.get(k);
    }
    /** Popisek ukazatele, který není jedna akce z katalogu (např. „Denní péče“ = task_done): cs, en, technický zápis. */
    const ml = (cs, en, raw) => L.html(lab(LANG === 'raw' ? raw : LANG === 'en' ? en : cs, raw, true));
    const lv = (name, key, val) => L.html(L.value(name, key, val));
    /** Český popisek do vět „Co z toho plyne“ (D.3: věty jsou vždy česky), escapovaný. */
    const csv = (name, key, val) => esc(L.value(name, key, val, 'cs').text);

    // --- Data load (stránkování – drží data od začátku měření) ---
    const PAGE = 500;
    let RAW = [];          // ploché eventy ze všech načtených dávek (po deduplikaci R3)
    let lastDoc = null;    // cursor pro startAfter
    let batches = 0;       // počet načtených dávek
    let exhausted = false; // už není co načítat
    let loading = false;
    // Zdvojené záznamy z telefonů (R3): stejná funkce ve fetchPage i v setData; nuluje se ve firstLoad.
    const DEDUP = makeDeduper();
    // „Teď“ pro výpočty (R4): v produkci Date.now(), v demu čas výpisu (setData NOW / meta.dumpedAt).
    let NOW_FIXED = null;
    const nowMs = () => (NOW_FIXED !== null ? NOW_FIXED : Date.now());
    // Verze dat pro mezipaměť jádra (C.5): zvýší se při každém načtení nebo podstrčení dat.
    let DATA_VER = 0, OVERRIDES_VER = 0;

    async function fetchPage() {
      if (loading || exhausted) return 0;
      loading = true;
      try {
        const base = [collection(db, 'analytics_events'), orderBy('lastTs', 'desc')];
        const q = lastDoc ? query(...base, startAfter(lastDoc), limit(PAGE)) : query(...base, limit(PAGE));
        const snap = await getDocs(q);
        snap.forEach((d) => {
          const b = d.data() || {};
          const dev = b.device || {};
          (Array.isArray(b.events) ? b.events : []).forEach((e) => {
            if (!e || typeof e !== 'object') return;
            const x = { name: e.name, props: e.props || {}, ts: e.ts, session: e.session, installId: b.installId, dev };
            if (DEDUP.add(x)) RAW.push(x);
          });
        });
        lastDoc = snap.docs.length ? snap.docs[snap.docs.length - 1] : lastDoc;
        batches += snap.size;
        DATA_VER++;
        if (snap.size < PAGE) exhausted = true;
        return snap.size;
      } finally { loading = false; }
    }

    // Společný zámek načítání (C.5, E.12): Souhrn, Nákupy, nové záložky i Načíst starší / vše čtou
    // stránky po jednom. Kdo přijde během načítání, počká na konec; nikdy nedostane „hotovo“ předčasně.
    let LOAD_CHAIN = Promise.resolve();
    function withLoadLock(fn) {
      const run = LOAD_CHAIN.then(fn, fn);
      LOAD_CHAIN = run.then(() => {}, () => {});
      return run;
    }
    /** Dočítá stránky, dokud needMore() platí (nejvýš maxPages); vrací, jestli je pokryto. */
    function ensureCoverageWhile(needMore, maxPages = 40) {
      return withLoadLock(async () => {
        let pages = 0;
        while (!exhausted && needMore() && pages < maxPages) {
          const n = await fetchPage(); pages++;
          if (!n) break;
        }
        return exhausted || !needMore();
      });
    }

    // --- Ledger instalací + testeři (docs/ANALYTICS_DASHBOARD_PLAN.md) ---
    let INSTALLS = [];                 // [{id, platform, firstMs, lastMs, locale, deviceLocale, region, installKind, model, os, osVersion, appBuild, cls}]
    let OVERRIDES = new Map();         // installId → {kind: 'tester'|'robot'|'real', note}
    const CLS_BY_ID = new Map();       // installId → 'real' | 'tester' | 'robot'
    const tsMs = (v) => (v && typeof v.toMillis === 'function') ? v.toMillis() : (typeof v === 'number' ? v : null);
    // ── Klasifikace = ZRCADLO functions/installClass.js (pawprint-mobile). Při změně upravit obě místa.
    //    Robot = Google Play pre-launch report (Firebase Test Lab): emulátory sdk_gphone* a OnePlus8Pro
    //    na Androidu 11 s krátkou aktivitou (< 60 min). Tester = simulátor / vývoj / Expo Go / ručně.
    //    Blok mezi značkami čte i scripts/check-admin-core.mjs (klasifikace jako vstup jádra).
    // == ADMIN CLASSIFY START ==
    const TESTER_KINDS = new Set(['simulator', 'development', 'ad_hoc', 'enterprise', 'expo_go']);
    const ROBOT_KINDS = new Set(['emulator', 'test_lab']);
    const ROBOT_RULES = [
      { id: 'kind', test: (d) => ROBOT_KINDS.has(String(d.installKind || '')) },
      { id: 'sdk_gphone', test: (d) => /^sdk_gphone/i.test(String(d.model || '')) },
      { id: 'oneplus8pro_android11_short', test: (d, span) => String(d.model || '') === 'OnePlus8Pro' && (/^11(\.|$)/.test(String(d.osVersion || '')) || /android\s*11\b/i.test(String(d.osVersion || ''))) && span !== null && span < 60 },
    ];
    const TESTER_RULES = [
      { id: 'kind', test: (d) => TESTER_KINDS.has(String(d.installKind || '')) },
      { id: 'ios_simulator_model', test: (d) => /simulator/i.test(String(d.model || '')) },
    ];
    function classifyInstall(d, o) {
      if (o) return { kind: o.kind === 'robot' ? 'robot' : o.kind === 'real' ? 'real' : 'tester', source: 'manual', rule: null };
      const span = (d.firstMs !== null && d.lastMs !== null) ? Math.max(0, Math.round((d.lastMs - d.firstMs) / 60000)) : null;
      for (const r of ROBOT_RULES) if (r.test(d, span)) return { kind: 'robot', source: 'auto', rule: r.id };
      for (const r of TESTER_RULES) if (r.test(d, span)) return { kind: 'tester', source: 'auto', rule: r.id };
      return { kind: 'real', source: 'none', rule: null };
    }
    // == ADMIN CLASSIFY END ==
    const clsOf = (iid) => CLS_BY_ID.get(iid) || 'real';
    // Eventy bez záznamu v ledgeru (čerstvá dávka) posuzujeme podle device kontextu dávky.
    const isExcluded = (iid, dev) => {
      const k = CLS_BY_ID.get(iid);
      if (k) return k !== 'real';
      return dev ? classifyInstall({ installKind: dev.installKind, model: dev.model, osVersion: dev.osVersion, firstMs: null, lastMs: null }, null).kind !== 'real' : false;
    };
    const isTester = (iid, kind) => isExcluded(iid, kind ? { installKind: kind } : null);
    function reclassify() {
      CLS_BY_ID.clear();
      INSTALLS.forEach((i) => { i.cls = classifyInstall(i, OVERRIDES.get(i.id) || null); CLS_BY_ID.set(i.id, i.cls.kind); });
    }
    // --- Nákupy z RevenueCatu (rc_events, functions/rcEvents.js) ---
    let RC_EVENTS = [];
    async function loadRcEvents() {
      const snap = await getDocs(collection(db, 'rc_events'));
      RC_EVENTS = snap.docs.map((d) => d.data()).filter((x) => x && x.type);
      DATA_VER++;
    }
    let STORE = [];
    // Hodnocení v obchodech: dokument store_stats/ratings_summary (stejná kolekce, nemá date/platform,
    // takže do STORE nespadne). {updatedAt, ios:{avg,count,byCountry}, android:{avg,count}, reviews:{ios,android}}
    let RATINGS = { state: 'missing', data: null };
    // Retence po režimech: store_stats/retention_summary (functions/cohortRetention.js, denně se syncStoreStats).
    // {updatedAt, method, segments:{all|challenge|trial|owner|notActivated:{installs, d1:{k,n}, d7, d30}}}
    let RETENTION = { state: 'missing', data: null };
    // Zápis placených kampaní (Z3): store_stats/ad_campaigns ze stejného dotazu, žádné nové čtení.
    // {updatedAt, campaigns:[{id, name, network, platform, country, from, to, spendEur, spendAt}]}; null = chybí.
    let AD_CAMPAIGNS = null;
    async function loadStoreStats() {
      const snap = await getDocs(collection(db, 'store_stats'));
      STORE = snap.docs.filter((d) => d.id !== 'ad_campaigns').map((d) => d.data()).filter((x) => x && x.date && (x.platform === 'ios' || x.platform === 'android'));
      const rs = snap.docs.find((d) => d.id === 'ratings_summary');
      RATINGS = rs ? { state: 'ok', data: rs.data() || {} } : { state: 'missing', data: null };
      const rt = snap.docs.find((d) => d.id === 'retention_summary');
      RETENTION = rt ? { state: 'ok', data: rt.data() || {} } : { state: 'missing', data: null };
      const ac = snap.docs.find((d) => d.id === 'ad_campaigns');
      const acd = ac ? ac.data() || null : null;
      AD_CAMPAIGNS = acd ? { ...acd, updatedAt: anyMs(acd.updatedAt) !== null ? new Date(anyMs(acd.updatedAt)).toISOString() : null } : null;
      DATA_VER++;
    }
    // Stažení podle obchodu: iOS = první stažení (firstTime), Android = nové instalace (installs).
    const storeN = (x) => x.platform === 'ios' ? (Number(x.firstTime) || 0) : (Number(x.installs) || 0);
    function renderStoreStats() {
      if (!$('st-kpis')) return;
      if (!STORE.length) { $('st-sub').textContent = '· zatím žádná data'; $('st-kpis').innerHTML = ''; $('st-panels').innerHTML = ''; return; }
      const n = storeN;
      const today = new Date(); const DAY = 86400000;
      const iso = (ms) => new Date(ms).toISOString().slice(0, 10);
      const since = (d) => iso(today.getTime() - d * DAY);
      const sum = (rows) => rows.reduce((a, x) => a + n(x), 0);
      const ios = STORE.filter((x) => x.platform === 'ios'), and = STORE.filter((x) => x.platform === 'android');
      const last = (rows) => rows.map((x) => x.date).sort().slice(-1)[0] || '–';
      // Obchody vydávají data se zpožděním (Apple 1–2 dny, Google i 5 dní). Den po posledním dni
      // s daty není nula, jen ho obchod ještě nevydal. Apple dny bez stažení nezapisuje, takže
      // „má data“ = den nejpozději poslední den, který obchod vydal.
      const lastIos = last(ios), lastAnd = last(and);
      const hasIos = (d) => lastIos !== '–' && d <= lastIos, hasAnd = (d) => lastAnd !== '–' && d <= lastAnd;
      const k = (label, v, sub) => `<div class="card"><div class="kpi">${v}<small>${label}${sub ? ' · ' + sub : ''}</small></div></div>`;
      $('st-sub').textContent = `· App Store data do ${last(ios)} · Google Play do ${last(and)}`;
      $('st-kpis').innerHTML = [
        k('stažení celkem', sum(STORE), `App Store ${sum(ios)} · Google Play ${sum(and)}`),
        k('za 30 dní', sum(STORE.filter((x) => x.date >= since(30))), `7 dní ${sum(STORE.filter((x) => x.date >= since(7)))} · jen dny, které obchody už vydaly`),
        k('odinstalace Google Play', and.reduce((a, x) => a + (x.uninstalls || 0), 0), 'celkem'),
      ].join('');
      const byDay = new Map();
      for (let d = 29; d >= 0; d--) byDay.set(iso(today.getTime() - d * DAY), 0);
      STORE.forEach((x) => { if (byDay.has(x.date)) byDay.set(x.date, byDay.get(x.date) + n(x)); });
      const regionName = (c) => { try { return new Intl.DisplayNames(['cs'], { type: 'region' }).of(c) + ' (' + c + ')'; } catch { return c; } };
      const country = new Map();
      STORE.forEach((x) => { for (const [c, v] of Object.entries(x.platform === 'ios' ? (x.byTerritory || {}) : (x.byCountry || {}))) country.set(regionName(c), (country.get(regionName(c)) || 0) + v); });
      const plat = [['App Store', sum(ios)], ['Google Play', sum(and)]];
      $('st-panels').innerHTML = [
        barPanel('Stažení za den (30 dní, oba obchody)', [...byDay.entries()].map(([d, v]) => {
          const lbl = d.slice(5).split('-').reverse().join('. ') + '.';
          if (!hasIos(d) && !hasAnd(d)) return [lbl + ' · čeká na data', 0, '–'];
          if (!hasAnd(d)) return [lbl + ' · jen App Store', v];
          if (!hasIos(d)) return [lbl + ' · jen Google Play', v];
          return [lbl, v];
        }), 'var(--apricot)', 0, 'čeká na data = obchod den ještě nevydal, není to nula'),
        barPanel('Země (oba obchody, celkem)', [...country.entries()].sort((a, b) => b[1] - a[1]), 'var(--plum)', 12),
        barPanel('Obchod', plat, 'var(--water)'),
      ].join('');
    }
    async function loadInstalls() {
      const [inst, over] = await Promise.all([getDocs(collection(db, 'install_platforms')), getDocs(collection(db, 'tester_installs'))]);
      // srcChannel … srcAds = zdroj instalace (Android od verze 352, Z2 a Z4; E.11).
      INSTALLS = inst.docs.map((d) => { const x = d.data(); return { id: d.id, platform: x.platform || null, firstMs: tsMs(x.firstSeenAt), lastMs: tsMs(x.lastSeenAt), locale: x.locale, deviceLocale: x.deviceLocale, region: x.region, installKind: x.installKind || 'unknown', model: x.model, os: x.os, osVersion: x.osVersion, appBuild: x.appBuild,
        srcChannel: x.srcChannel ?? null, srcSource: x.srcSource ?? null, srcMedium: x.srcMedium ?? null, srcCampaign: x.srcCampaign ?? null, srcAds: x.srcAds ?? null }; });
      OVERRIDES = new Map(over.docs.map((d) => [d.id, d.data() || {}]));
      DATA_VER++; OVERRIDES_VER++;
      reclassify();
    }
    /** kind: 'tester' | 'robot' | 'real' (ruční přepis) | null (zrušit přepis → automatika). */
    async function setOverride(iid, kind) {
      if (kind) {
        const note = prompt(kind === 'real' ? 'Poznámka (proč není robot/tester):' : 'Poznámka (např. „můj iPhone“):', (OVERRIDES.get(iid) || {}).note || '');
        if (note === null) return;
        await setDoc(doc(db, 'tester_installs', iid), { kind, note, at: serverTimestamp() }); OVERRIDES.set(iid, { kind, note });
      } else { await deleteDoc(doc(db, 'tester_installs', iid)); OVERRIDES.delete(iid); }
      OVERRIDES_VER++;
      reclassify(); render();
    }

    async function firstLoad() {
      // Dočítání nových záložek začne znovu (staré běhy už stav nepřepíšou).
      COVER_GEN++; COVER_RUNS.clear();
      // Reset dat pod zámkem: běžící dočítání (Souhrn, Nákupy, Načíst vše) nejdřív doběhne.
      await withLoadLock(() => { RAW = []; lastDoc = null; batches = 0; exhausted = false; DEDUP.reset(); DATA_VER++; });
      // Obnovit (dashboard) volá firstLoad znovu → dočítání starší analytiky musí proběhnout znovu.
      dataReady = false; dashCoverage = false; purchaseCoverage = false;
      $('loadOlder').textContent = 'Načíst starší'; $('loadAll').textContent = 'Načíst vše';
      $('status').classList.remove('hidden');
      $('status').textContent = 'Načítám…';
      try {
        await loadInstalls().catch((e) => console.warn('ledger instalací nenačten', e));
        await loadStoreStats().catch((e) => { console.warn('store_stats nenačteny', e); RATINGS = { state: 'error', data: null }; RETENTION = { state: 'error', data: null }; AD_CAMPAIGNS = null; });
        await loadRcEvents().catch((e) => console.warn('rc_events nenačteny', e));
        await withLoadLock(() => fetchPage());
        dataReady = true; LOADED_AT = Date.now();
        buildFilterOptions();
        render();
        $('status').classList.add('hidden');
      } catch (e) {
        $('dash-updated').textContent = 'Načtení selhalo';
        $('status').innerHTML = '<span class="err">Chyba: ' + esc(e.message || e) +
          '</span><br><span style="color:var(--muted)">Pravděpodobně nejsou nasazené Firestore rules pro <code>analytics_events</code>, nebo je kolekce prázdná.</span>';
      }
    }

    // Načíst starší / vše: přes společný zámek (E.12), „Vše načteno“ až po skutečném konci historie.
    $('loadOlder').onclick = async () => {
      const n = await withLoadLock(() => fetchPage());
      buildFilterOptions(); render();
      if (!n || exhausted) $('loadOlder').textContent = 'Historie kompletní';
    };
    $('loadAll').onclick = async () => {
      $('loadAll').textContent = 'Načítám…';
      await ensureCoverageWhile(() => true, 200).catch((e) => console.warn('načtení celé historie selhalo', e));
      buildFilterOptions(); render();
      $('loadAll').textContent = exhausted ? 'Vše načteno' : 'Načíst vše';
    };

    // --- Filtry ---
    const FILTERS = { text:'', installId:'', event:'', platform:'', locale:'', build:'', type:'', from:'', to:'', testers:false };
    $('f-testers').onchange = (ev) => { FILTERS.testers = ev.target.checked; render(); };

    function buildFilterOptions() {
      const fill = (id, vals, label) => {
        const sel = $(id); const cur = sel.value;
        const opts = [...new Set(vals.filter(Boolean))].sort();
        sel.innerHTML = '<option value="">' + label + ': vše</option>' +
          opts.map((v) => '<option value="' + esc(v) + '">' + esc(v) + '</option>').join('');
        sel.value = cur; // zachovej výběr po reloadu
      };
      fill('f-event', RAW.map((e) => e.name), 'Event');
      fill('f-platform', RAW.map((e) => e.dev.platform), 'Platforma');
      fill('f-locale', RAW.map((e) => e.dev.locale), 'Jazyk');
      fill('f-build', RAW.map((e) => e.dev.appBuild != null ? String(e.dev.appBuild) : ''), 'Build');
      fill('f-type', RAW.map((e) => e.dev.type), 'Typ');
    }

    function applyFilters(arr) {
      const text = FILTERS.text.trim().toLowerCase();
      const iid = FILTERS.installId.trim();
      const fromTs = FILTERS.from ? new Date(FILTERS.from).getTime() : null;
      const toTs = FILTERS.to ? new Date(FILTERS.to).getTime() + 86400000 : null; // celý „do" den včetně
      return arr.filter((e) => {
        if (!Number.isFinite(e.ts)) return false;
        if (!FILTERS.testers && isExcluded(e.installId, e.dev)) return false;
        if (FILTERS.event && e.name !== FILTERS.event) return false;
        if (FILTERS.platform && e.dev.platform !== FILTERS.platform) return false;
        if (FILTERS.locale && e.dev.locale !== FILTERS.locale) return false;
        if (FILTERS.build && String(e.dev.appBuild) !== FILTERS.build) return false;
        if (FILTERS.type && e.dev.type !== FILTERS.type) return false;
        if (iid && !String(e.installId || '').startsWith(iid)) return false;
        if (fromTs && e.ts < fromTs) return false;
        if (toTs && e.ts >= toTs) return false;
        if (text) {
          const hay = (e.name + ' ' + JSON.stringify(e.props) + ' ' + (e.dev.model || '') + ' ' + (e.dev.locale || '')).toLowerCase();
          if (!hay.includes(text)) return false;
        }
        return true;
      });
    }

    // filter event wiring
