      };
      const qAll = qRow(n30);
      const qChannel = {};
      const comparisons = [], sides = [];
      for (const [k, cnt] of byChannel) {
        const list = chanGroups.get(k), ids = new Set(list.map((d) => d.id)), rest = n30.filter((d) => !ids.has(d.id));
        const row = qRow(list); setKey(qChannel, k, row);
        const b = d1Of(idx, rest), c = compareGroups(row.d1, b);
        comparisons.push({ group: 'channel:' + k, eligible: cnt >= R.SURE_N, a: row.d1, b, verdict: c.verdict, z: c.z, aRange: pctRange(row.d1), bRange: pctRange(b) });
        sides.push([list, rest]);
      }
      let qCampaign = null;
      if (camps) {
        qCampaign = {};
        for (const p of PLATFORMS) {
          if (!camps.some((k) => k.platform === p)) continue;
          const list = n30.filter((d) => d.platform === p);
          const isIn = (d) => { const f = firstDayOf(d); return f !== null && camps.some((k) => k.platform === p && campaignRuns(k, f)); };
          const inL = list.filter(isIn), outL = list.filter((d) => !isIn(d));
          const row = { in: qRow(inL), out: qRow(outL) };
          qCampaign[p] = row;
          const c = compareGroups(row.in.d1, row.out.d1);
          comparisons.push({ group: 'campaign:' + p, eligible: true, a: row.in.d1, b: row.out.d1, verdict: c.verdict, z: c.z, aRange: pctRange(row.in.d1), bRange: pctRange(row.out.d1) });
          sides.push([inL, outL]);
        }
      }
      const topChannel = byChannel.length ? { key: byChannel[0][0], devices: byChannel[0][1] } : null;

      // Z3 kampaně: nová zařízení nad běžný stav a cena za zařízení.
      let campaigns, z3 = 'Chybí útrata';
      if (camps) {
        const yesterday = today - 1;
        const newIn = (p, ranges) => { let s = 0; for (const [f, c] of newByDay) if (ranges.some(([a, b]) => f >= a && f <= b)) s += c[p]; return s; };
        const counted = (c) => [c.from, c.to === null ? yesterday : Math.min(c.to, yesterday)];
        const baselineOf = (p, from) => {
          let days = 0, devices = 0;
          for (let n = from - R.BASELINE_DAYS; n < from; n++) {
            if (camps.some((k) => k.platform === p && campaignRuns(k, n))) continue;
            days++; devices += (newByDay.get(n) || { [p]: 0 })[p];
          }
          return days < R.BASELINE_MIN_DAYS ? { state: 'missing', days, devices } : { days, devices, perDay: roundTo(devices / days, 4) };
        };
        const aboveOf = (nw, base, days) => (base.state ? null : nw - (base.devices * days) / base.days);
        // Skupiny překryvu: kampaně stejné platformy se společným dnem (to null = bez konce).
        const parent = camps.map((_, i) => i);
        const find = (i) => { while (parent[i] !== i) i = parent[i] = parent[parent[i]]; return i; };
        for (let i = 0; i < camps.length; i++) for (let j = i + 1; j < camps.length; j++) {
          const a = camps[i], b = camps[j];
          if (a.platform !== b.platform) continue;
          const s = a.from > b.from ? a.from : b.from;
          const e = (a.to === null ? Infinity : a.to) < (b.to === null ? Infinity : b.to) ? (a.to === null ? Infinity : a.to) : (b.to === null ? Infinity : b.to);
          if (s <= e) { const ra = find(i), rb = find(j); if (ra !== rb) { if (ra < rb) parent[rb] = ra; else parent[ra] = rb; } }
        }
        const members = new Map();
        camps.forEach((c, i) => { const r = find(i); const l = members.get(r); if (l) l.push(i); else members.set(r, [i]); });
        const groupOf = (i) => { const r = find(i); return members.get(r).length > 1 ? camps[r].raw.id ?? null : null; };
        const list = camps.map((c, i) => {
          const [f, t] = counted(c), days = Math.max(0, t - f + 1), nw = days > 0 ? newIn(c.platform, [[f, t]]) : 0;
          const base = baselineOf(c.platform, c.from), aboveRaw = aboveOf(nw, base, days);
          const spend = isNum(c.raw.spendEur) ? c.raw.spendEur : null;
          const cost = aboveRaw !== null && aboveRaw > 0 && spend !== null ? roundTo(spend / aboveRaw, 2) : null;
          const inGroup = members.get(find(i)).length > 1;
          let verdict, note = null;
          if (days < R.CAMPAIGN_MIN_DAYS) verdict = 'Běží krátce';
          else if (spend === null) verdict = 'Chybí útrata';
          else if (inGroup) verdict = 'Nelze oddělit';
          else if (base.state) { verdict = 'Málo dat'; note = 'noBaseline'; }
          else if (aboveRaw <= 0) { verdict = 'Nevyplatí se'; note = 'nothingExtra'; }
          else verdict = cost <= R.CAMPAIGN_MAX_EUR ? 'Vyplatí se' : 'Nevyplatí se';
          const tight = (verdict === 'Vyplatí se' || verdict === 'Nevyplatí se') && cost !== null && cost >= R.CAMPAIGN_TIGHT[0] && cost <= R.CAMPAIGN_TIGHT[1];
          return { id: c.raw.id ?? null, name: c.raw.name ?? null, network: c.raw.network ?? null, platform: c.platform, from: c.raw.from, to: c.raw.to ?? null,
            days, new: nw, baseline: base, above: aboveRaw === null ? null : roundTo(aboveRaw, 2), spendEur: spend, spendAt: c.raw.spendAt ?? null,
            cost, verdict, note, tight, group: groupOf(i) };
        });
        const joint = [];
        for (const [r, ids] of members) {
          if (ids.length < 2) continue;
          const p = camps[r].platform, ranges = ids.map((i) => counted(camps[i])).filter(([a, b]) => b >= a).sort((x, y) => x[0] - y[0]);
          let days = 0, curA = null, curB = null;
          for (const [a, b] of ranges) {
            if (curB !== null && a <= curB + 1) { if (b > curB) curB = b; continue; }
            if (curB !== null) days += curB - curA + 1;
            curA = a; curB = b;
          }
          if (curB !== null) days += curB - curA + 1;
          let minFrom = camps[ids[0]].from;
          for (const i of ids) if (camps[i].from < minFrom) minFrom = camps[i].from;
          const nw = ranges.length ? newIn(p, ranges) : 0, base = baselineOf(p, minFrom), aboveRaw = aboveOf(nw, base, days);
          const spends = ids.map((i) => camps[i].raw.spendEur);
          const spend = spends.every(isNum) ? roundTo(spends.reduce((a, v) => a + v, 0), 2) : null;
          joint.push({ group: camps[r].raw.id ?? null, ids: ids.map((i) => camps[i].raw.id ?? null), platform: p, days, new: nw, baseline: base,
            above: aboveRaw === null ? null : roundTo(aboveRaw, 2), spendEur: spend,
            cost: aboveRaw !== null && aboveRaw > 0 && spend !== null ? roundTo(spend / aboveRaw, 2) : null });
        }
        campaigns = { state: 'ok', updatedAt: D.adCampaigns.updatedAt ?? null, list, joint };
        let newest = -1;
        camps.forEach((c, i) => { if (newest < 0 || c.from >= camps[newest].from) newest = i; });
        if (newest >= 0) z3 = list[newest].verdict;
      } else campaigns = { state: 'missing' };

      // Z5 šíření: aktivní za 30 dní.
      const active30 = real.filter((d) => inWin(d.lastMs, w30, now));
      const set30 = (name) => idx.byName30.get(name) || CORE_EMPTY_SET;
      const sharers = active30.filter((d) => set30('share_initiated').has(d.id));
      const kinds = new Map();
      for (const d of sharers) {
        const seen = new Set();
        scanDev(d, w30, now, (e, p) => { if (e.name === 'share_initiated') seen.add(valKey(p.kind)); return false; });
        for (const k of seen) addCount(kinds, k);
      }
      const iosSent = active30.filter((d) => d.platform === 'ios' && scanDev(d, w30, now, (e, p) => e.name === 'share_completed' && p.action === 'shared').n > 0).length;

      // Z6 odkud: noví za 30 dní podle ledgeru; obchody podle země za posledních 30 pražských dnů.
      const geoKey = (v) => (v === null || v === undefined || v === '' || v === 'none' || v === 'unknown' ? '_none' : String(v));
      const geo = (field) => { const m = new Map(); for (const d of n30) addCount(m, geoKey(d.inst[field])); return breakdown(m); };
      const storeRegion = new Map(), fromIso = dayIso(today - 29), toIso = dayIso(today);
      for (const x of st.docs) {
        if (x.date < fromIso || x.date > toIso) continue;
        const m = x.platform === 'ios' ? x.byTerritory : x.byCountry;
        if (!m || typeof m !== 'object') continue;
        for (const k of Object.keys(m)) if (isNum(m[k])) addCount(storeRegion, k, m[k]);
      }

      // Verdikty a „kdy bude jasno“.
      const elig = comparisons.map((c, i) => [c, sides[i]]).filter(([c]) => c.eligible);
      const z4 = elig.some(([c]) => c.verdict === 'Průkazný rozdíl') ? 'Průkazný rozdíl'
        : elig.some(([c]) => c.verdict === 'Zatím neprůkazné') ? 'Zatím neprůkazné' : 'Málo dat';
      let wz4 = null;
      if (z4 !== 'Průkazný rozdíl') {
        if (elig.length) wz4 = laterClear(elig.flatMap(([c, [sa, sb]]) => [whenClear(c.a.n, addedD1(idx, sa), today), whenClear(c.b.n, addedD1(idx, sb), today)]));
        else if (topChannel) { const l = chanGroups.get(topChannel.key); wz4 = whenClear(getKey(qChannel, topChannel.key).d1.n, addedD1(idx, l), today); }
        else wz4 = { state: 'unknown' };
      }
      return {
