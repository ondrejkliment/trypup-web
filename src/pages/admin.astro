      };
      let qBody = '<table class="qt"><thead><tr><th></th>' + QCOLS.map(([, l]) => `<th class="n">${l}</th>`).join('') + '</tr></thead><tbody>' +
        qRow('Všichni noví za 30 dní', qa);
      if (Q.campaign && typeof Q.campaign === 'object') {
        for (const p of ['android', 'ios']) {
          const c = own(Q.campaign, p);
          if (!c) continue;
          qBody += qRow(`${PLATFORM_LABEL.get(p)}: ve dnech kampaní`, c.in, true) + qRow(`${PLATFORM_LABEL.get(p)}: ve dnech bez kampaně`, c.out, true);
        }
      }
      if (byCh.length) qBody += `<tr><td colspan="5" class="muted">Android po kanálech (jen měřitelní, pod 10 jen počty)</td></tr>` + byCh.map(([k]) => qRow(lv('install_source', 'channel', k), own(Q.channel, k), true)).join('');
      qBody += '</tbody></table>';
      if (!Q.campaign) qBody += '<p class="muted">Dny kampaní × bez kampaně: až po zapsání kampaní.</p>';
      const elig = comps.filter((c) => c && c.eligible);
      qBody += elig.map((c) => `<p>${groupHtml(c.group)} × ostatní noví: D1 ${kzn(c.a)}${c.verdict !== 'Málo dat' && c.aRange ? ` (${rangeTxt(c.aRange)})` : ''} proti ${kzn(c.b)}${c.verdict !== 'Málo dat' && c.bRange ? ` (${rangeTxt(c.bRange)})` : ''} ${verdictPill(c.verdict)}</p>`).join('');
      const sure = elig.find((c) => c.verdict === 'Průkazný rozdíl');
      const sureTxt = (c) => `${cap(groupHtml(c.group, true))} se další den vrací ${num(c.z) > 0 ? 'víc' : 'méně'} než ostatní noví (${pctTxt(c.a.k, c.a.n)} proti ${pctTxt(c.b.k, c.b.n)}).`;
      const tc = Q.topChannel;
      // D1 bez základu (nikomu z nových ještě celý další den neuplynul) = čeká na data, nikdy „0 z 0“ (R7).
      const d1Sent = (f) => (num(f && f.n) > 0 ? `Další den ${pl(f.k, 'se vrátil', 'se vrátili', 'se vrátilo')} ${nf(f.k)} ${zz(f.n)} nových${pctPar(f)}` : 'Další den: čeká na data');
      let s4 = d1Sent(qa.d1);
      if (sure) s4 += '. ' + sureTxt(sure);
      else if (A.verdicts.z4 === 'Zatím neprůkazné') s4 += '; rozdíly mezi skupinami jsou zatím v mezích náhody.';
      else s4 += `; po kanálech je zatím málo dat${tc ? ` (nejvíc ${csv('install_source', 'channel', tc.key)}: ${nf(tc.devices)} zařízení)` : ''}.`;
      const w4 = whenTxt(A.whenClear && A.whenClear.z4, today);
      if (w4 && !sure) s4 += ` Srovnání skupin: ${w4}.`;
      const z4 = card({
        q: 'Jsou lidé z kampaní a kanálů stejně dobří jako ostatní?', verdict: A.verdicts.z4, sentence: s4, body: qBody,
        how: '‚Aktivní aspoň 10 minut‘ a ‚Vrátili se jiný den‘ jsou stejná měřítka jako ve zprávách o kampaních 17. a 19. 11., aby šla čísla srovnat. Počítají se z první a poslední aktivity zařízení, takže ‚jiný den‘ může být i za týden. D1 je přísnější: aplikaci otevřeli přesně další kalendářní den, stejně jako Retence v Souhrnu, a počítá se jen u těch, kterým další den celý uplynul. Telefony se tu nesrovnávají: kampaně běží hlavně na Androidu, takže rozdíl by ukazoval lidi z reklamy, ne telefon.',
        foot: 'Noví za 30 dní · bez testerů a robotů · srovnání skupin až od 30 zařízení v každé',
