        trend, byDay,
        store: { lastDay: { ios: st.last.ios, android: st.last.android } },
        channel: { measured: measured.length, of: and30.length, byChannel, unmeasured: and30.length - measured.length, ios: n30.length - and30.length },
        quality: { all: qAll, channel: qChannel, campaign: qCampaign, comparisons, topChannel },
        campaigns,
        share: {
