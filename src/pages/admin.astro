        return `<tr><td>${esc(VERSION_MARK_LABEL.get(sb) || '')}</td><td class="n" data-label="Od verze">${nf(sb)}</td><td class="n" data-label="Umí poslat">${cell}</td></tr>`;
      }).join('');
      const sbTxt = [['android', 'Android'], ['ios', 'iPhone']].filter(([p]) => num(SB[p]) !== null).map(([p, l]) => `${l} ${nf(SB[p])}`).join(', ');
      const t2 = card({
        q: 'Pokrytí verzí (aktivní za 7 dní)',
        sentence: `${cap(zePrep(act7))} ${nf(act7)} aktivních za 7 dní ${pl(ST.devices, 'je', 'jsou', 'je')} ${nf(ST.devices)} na verzi z obchodu${sbTxt ? ` (${sbTxt})` : ''}, z toho ${nf(ST.oneDay)} ${pl(ST.oneDay, 'bylo aktivní', 'byla aktivní', 'bylo aktivních')} jediný den.`,
        body: `<table class="qt narrow"><thead><tr><th>Měření</th><th class="n">Od verze</th><th class="n">Kolik aktivních ho umí poslat</th></tr></thead><tbody>${t2rows}</tbody></table>`,
        how: 'Nová měření posílají jen telefony s novější verzí aplikace. Aktualizaci telefon stáhne při spuštění a použije až při dalším, takže zařízení na verzi z obchodu s jediným aktivním dnem ji zatím nemá: buď je nové a ještě se nevrátilo, nebo se už nevrátí. Proto u novějších měření počítáme podíl jen z telefonů, které je umí poslat. Verze z obchodu = nejčastější verze, na které začínají nová zařízení za 14 dní (zvlášť Android a iPhone).',
        foot: 'Aktivní za 7 dní · nejvyšší verze v posledních 7 dnech · bez testerů a robotů',
      });

      // T3 Sedí data?
      const C = T.check, chk = [];
      const row = (state, text) => chk.push(`<div class="chk">${okPill(state)}<p>${text}</p></div>`);
      row(C.dups30.state, `Zdvojené záznamy za 30 dní: ${nf(C.dups30.k)} ${zz(C.dups30.n)} (${pct1(C.dups30.k, C.dups30.n)}); počítají se jednou. Pozor nad 5&nbsp;%.`);
      row(C.unknown.state, num(C.unknown.count) > 0
        ? `Akce mimo katalog: ${nf(C.unknown.count)} (${(Array.isArray(C.unknown.names) ? C.unknown.names : []).map((n) => `<span class="raw">${esc(n)}</span>`).join(', ')}${num(C.unknown.count) > 10 ? ', …' : ''}). V tabulkách se ukazují jako „Neznámá akce“.`
        : 'Akce mimo katalog: 0.');
      // Dávky, které nešly přečíst, se přeskočily (bezpecnost-2): počítají se k neplatným záznamům.
      const badB = BAD_BATCHES > 0 ? ` Přeskočeno ${nf(BAD_BATCHES)} ${pl(BAD_BATCHES, 'dávka, která nešla', 'dávky, které nešly', 'dávek, které nešly')} přečíst.` : '';
      row(num(C.invalid.count) > 0 || BAD_BATCHES > 0 ? 'warn' : C.invalid.state, num(C.invalid.count) > 0 || BAD_BATCHES > 0
        ? `Neplatné záznamy: ${nf(C.invalid.count)}.${badB} Zápis do analytiky je anonymní, mohou být podvržené; jednotlivě se nevypisují.`
        : 'Neplatné záznamy: 0.');
      row(C.active30.state, `Aktivní za 30 dní podle událostí ${nf(C.active30.events)} ${num(C.active30.events) === num(C.active30.ledger) ? '=' : '×'} podle evidence zařízení ${nf(C.active30.ledger)}. Pozor při rozdílu nad 2.`);
      row(C.outsideLedger.state, num(C.outsideLedger.records) > 0
        ? `Záznamy zařízení, která ještě nejsou v evidenci: ${nf(C.outsideLedger.records)} ${zz(C.outsideLedger.devices)} ${pl(C.outsideLedger.devices, 'zařízení', 'zařízení', 'zařízení')} (čerstvá dávka); do Získávání a Cesty se nepočítají.`
        : 'Záznamy zařízení mimo evidenci: 0.');
      const NR = C.purchaseNoRc, nrRows = Array.isArray(NR.rows) ? NR.rows : [];
      // Bez rc_events nejde posoudit, co je testovací nákup (provoz2-1); T4 pak důvod „nákup bez záznamu“ nenabízí.
      if (NR.state === 'failed') chk.push(`<div class="chk">${verdictPill('Pozor')}<p>Nákupy z RevenueCatu se nepodařilo načíst, nákupy bez záznamu v RevenueCatu teď nejde posoudit. Zkus Obnovit.</p></div>`);
      else row(NR.state, num(NR.count) > 0
        ? `${nf(NR.count)} ${pl(NR.count, 'nákup', 'nákupy', 'nákupů')} z aplikace bez záznamu v RevenueCatu do 10 min (${nrRows.map((r) => `${esc(dayLabel(r.day))}, ${esc(r.model ?? mapLabel(PLATFORM_NAME, r.platform))}`).join('; ')}), pravděpodobně testovací.`
        : 'Nákupy z aplikace bez záznamu v RevenueCatu: 0.');
      const D1 = C.d1Server;
      if (D1.state === 'incomplete') chk.push(`<div class="chk">${verdictPill('Čeká')}<p>D1 se serverem porovnám po načtení celé historie (Načíst vše nahoře).</p></div>`);
      else if (RETENTION.state === 'error') chk.push(`<div class="chk">${verdictPill('Pozor')}<p>Retenci ze serveru se nepodařilo načíst, D1 nejde porovnat. Zkus Obnovit.</p></div>`);
      else if (D1.state === null || !D1.server) chk.push(`<div class="chk">${verdictPill('Čeká')}<p>Retence ze serveru zatím není spočítaná, D1 nejde porovnat.</p></div>`);
      else row(D1.state, `D1 v adminu ${kzn(D1.admin)} × na serveru ${kzn(D1.server)}. Pozor při rozdílu nad 2.`);
      const anyWarn = [C.dups30, C.unknown, C.invalid, C.active30, C.outsideLedger, C.purchaseNoRc, C.d1Server].some((x) => x && (x.state === 'warn' || x.state === 'failed')) || BAD_BATCHES > 0 || RETENTION.state === 'error';
      const t3 = card({ q: 'Sedí data?', verdict: anyWarn ? 'Pozor' : 'V pořádku', body: chk.join(''),
        foot: 'Zdvojené, mimo katalog a neplatné za 30 dní · aktivní a nákupy bez testerů a robotů · D1 nad všemi skutečnými zařízeními' });

      // T4 K ověření
      const RV = T.review, rvRows = Array.isArray(RV.rows) ? RV.rows : [];
      const byModel = pairsOf(RV.byModel);
      const t4body = rvRows.length
        ? `<p class="ilist">Podle modelu: ${byModel.map(([m, v]) => `${esc(m === '_none' ? 'bez modelu' : m)}&nbsp;<b>${nf(v)}</b>`).join(' · ')}</p>` +
          `<table class="qt"><thead><tr><th>Zařízení</th><th>Model</th><th>První spuštění</th><th class="n">Verze</th><th>Důvod</th><th></th></tr></thead><tbody>` +
          rvRows.map((r) => `<tr><td><span class="raw" title="${esc(r.id)}">${esc(r.iid)}</span></td><td data-label="Model">${esc(r.model ?? '–')}</td><td data-label="První spuštění">${esc(dayLabel(r.firstDay))}</td>` +
            `<td class="n" data-label="Verze">${esc(r.build ?? '–')}</td><td data-label="Důvod">${(Array.isArray(r.reasons) ? r.reasons : []).map((x) => esc(REVIEW_REASON.get(x) || x)).join(', ')}</td>` +
            `<td data-label="Rozhodnutí"><button class="ghost sm" type="button" data-ov="${esc(r.id)}" data-kind="tester">Je to tester</button> <button class="ghost sm" type="button" data-ov="${esc(r.id)}" data-kind="real">Je skutečné</button></td></tr>`).join('') +
          '</tbody></table>'
        : '<p class="muted">Žádné zařízení k ověření.</p>';
      const t4 = card({
        q: 'K ověření: zařízení, která mohou být testovací',
        // Shodný model ještě neznamená tester (texty-6): stejné telefony mají i běžní lidé.
        sentence: rvRows.length ? `${nf(RV.active30)} ${pl(RV.active30, 'aktivní zařízení', 'aktivní zařízení', 'aktivních zařízení')} za 30 dní ${pl(RV.active30, 'má', 'mají', 'má')} stejný model jako označený tester nebo nákup bez záznamu v RevenueCatu, takže ${pl(RV.active30, 'může', 'mohou', 'mohou')} být testovací. Stejné modely mají i běžní lidé: označ jen ta, která poznáš. Jen návrh, rozhoduješ ty.` : 'Žádné aktivní zařízení nemá znaky testovacího.',
        body: t4body,
        // Kontrolní zařízení Applu jsou tester automaticky (cisla-9), proto v seznamu nejsou.
        how: 'TestFlight a nové telefony zakladatele vypadají jako skutečná zařízení, dokud je nikdo neoznačí. Admin je sám neoznačí; výjimkou je pravidlo „kontrolní zařízení Applu (iPhone99)“: telefony, na kterých Apple schvaluje verzi, jsou tester automaticky a v seznamu nejsou. Po označení „Je skutečné“ zařízení ze seznamu zmizí.',
        foot: 'Aktivní za 30 dní, skutečná podle klasifikace, bez ručního označení · se stejným modelem jako označený tester nebo s nákupem bez záznamu v RevenueCatu',
      });

      // T5 Limit Expo
      const EX = T.expo, exLevel = EX.level === 'plan' ? 'Řešit tarif' : EX.level === 'warn' ? 'Pozor' : 'V pořádku';
      const t5 = card({
        q: 'Limit Expo', verdict: exLevel,
        sentence: `Aktivní za 30 dní: ${nf(EX.active30)}&nbsp;${zz(EX.limit)} zařízení, na která bezplatný tarif Expo stačí (včetně testerů a robotů).`,
        how: 'Bezplatný tarif Expo dovolí aktualizace pro 1&nbsp;000 zařízení za měsíc. Přesné číslo ukáže Claude příkazem eas account:usage.',
        foot: 'Aktivní za 30 dní podle evidence zařízení, iPhone i Android, včetně testerů a robotů · V pořádku pod 800, Pozor 800–899, Řešit tarif od 900',
      });

      // T6 Akce podle skupin (respektuje jen zaškrtávátko testerů)
      const AC = FILTERS.testers ? T.actionsAll : T.actions;
      const rowsObj = AC.rows && typeof AC.rows === 'object' ? AC.rows : {};
      const byGroupRows = new Map();
      for (const nm of Object.keys(rowsObj)) { const r = rowsObj[nm]; if (r && typeof r === 'object') { const g = typeof r.g === 'string' ? r.g : 'unknown'; if (!byGroupRows.has(g)) byGroupRows.set(g, []); byGroupRows.get(g).push([nm, r]); } }
      const t6groups = pairsOf(AC.byGroup).map(([g]) => {
        const list = (byGroupRows.get(g) || []).sort((a, b) => (num(b[1].d30) ?? 0) - (num(a[1].d30) ?? 0) || cmpStr(a[0], b[0]));
        const withData = list.filter(([, r]) => (num(r.r30) ?? 0) > 0).length;
        const key = 't6:' + g;
        return `<details class="t6g" data-open="${esc(key)}"${openAttr(key)}><summary>${L.html(L.group(g))} <span>· ${nf(list.length)} ${pl(list.length, 'akce', 'akce', 'akcí')}, s daty za 30 dní ${nf(withData)}</span></summary>` +
          `<table class="qt"><thead><tr><th>Akce</th><th>Technický název</th><th class="n">Zařízení 7 dní</th><th class="n">Zařízení 30 dní</th><th class="n">Záznamů 30 dní</th><th>Od</th><th>Stav</th></tr></thead><tbody>` +
          list.map(([nm, r]) => `<tr><td>${L.html(L.event(nm))}</td><td class="raw" data-label="Technický název">${esc(nm)}</td>` +
            `<td class="n" data-label="Zařízení 7 dní">${nf(r.d7)}</td><td class="n" data-label="Zařízení 30 dní">${nf(r.d30)}</td><td class="n" data-label="Záznamů 30 dní">${nf(r.r30)}</td>` +
            `<td data-label="Od">${r.od ? esc(fullDate(r.od)) + ((num(r.sb) ?? 0) > 0 ? ` <span class="muted">(verze ${nf(r.sb)})</span>` : '') : r.state === 'removed' ? 'nikdy neposláno' : r.state === 'unknown' ? 'není v katalogu' : 'čeká na data'}</td>` +
            `<td data-label="Stav">${esc(ACTION_STATE.get(r.state) || String(r.state ?? ''))}</td></tr>`).join('') +
          '</tbody></table></details>';
      }).join('');
      const t6 = card({
        q: 'Akce podle skupin',
        sentence: `${nf(AC.catalog)} ${pl(AC.catalog, 'akce', 'akce', 'akcí')} v katalogu · za 30 dní se ${pl(AC.seen30, 'objevila', 'objevily', 'objevilo')} ${nf(AC.seen30)} · bez popisku ${nf(AC.unknown30)} · neplatné záznamy ${nf(AC.invalid30)} · vyřazeno ${nf(AC.dups30)} ${pl(AC.dups30, 'zdvojený záznam', 'zdvojené záznamy', 'zdvojených záznamů')}` +
          (FILTERS.testers ? ' · včetně testerů a robotů' : ''),
        body: t6groups,
        how: 'Zařízení = různé telefony, které akci za 7 nebo 30 dní poslaly. „Automaticky“ = akci posílá aplikace sama (spuštění, obrazovka, odznak…), nejde o činnost lidí. „Za 30 dní nic“ = aplikace akci umí poslat déle než 30 dní, ale nikdo ji nepoužil; „zatím bez dat“ = měří se kratší dobu. „Bez popisku“ = akce, kterou katalog ještě nezná; v datech zůstává.',
        foot: `Pevně 7 a 30 dní · ${FILTERS.testers ? 'včetně testerů a robotů (zaškrtávátko nahoře)' : 'bez testerů a robotů (zaškrtávátko nahoře je přidá)'}`,
      });

      root.innerHTML = `<div class="qcards">${t2}${t3}${t4}${t5}${t6}</div>`;
      bindPane(root);
      root.querySelectorAll('button[data-ov]').forEach((b) => { b.onclick = () => setOverride(b.dataset.ov, b.dataset.kind || null).catch(saveFailed); });
    }

    function renderTech(ev) {
      renderTechChecks();
      // Před načtením a po selhání ne „Žádná data.“, „žádné“ ani „zobrazeno 0 z 0“ (provoz3-2).
      const instFail = LOAD_ERR.has('installs');
      const instWait = !instFail && !dataReady && !INSTALLS.length;
      const instMsg = instFail ? 'Evidenci zařízení se nepodařilo načíst. Zkus Obnovit na Souhrnu.' : LOAD_FAILED ? 'Data se nepodařilo načíst. Zkus Obnovit na Souhrnu.' : 'Načítám…';
      if (instFail || instWait) { $('i-sub').textContent = ''; $('inst').innerHTML = `<tr><td style="color:var(--muted)">${instMsg}</td></tr>`; }
      if (!dataReady) {
        const msg = `<div class="wait">${LOAD_FAILED ? 'Data se nepodařilo načíst. Zkus Obnovit na Souhrnu.' : 'Načítám…'}</div>`;
        $('t-devices').innerHTML = msg; $('t-quality').innerHTML = msg; $('feed').innerHTML = msg;
        if (!instFail && !instWait) renderInstallTable();
        return;
      }
      // Zařízení podle filtrů: různá zařízení na hodnotu (E.10), nejaktivnější telefon nepřebije ostatní.
      const purchaseFailed = evByName(ev, 'purchase_failed').filter((e) => !isLegacyRestore(e)); // obnova není nákup
      const ledger = INSTALLS.filter((i) => (i.platform === 'ios' || i.platform === 'android'));
      const users = FILTERS.testers ? ledger : ledger.filter((i) => i.cls && i.cls.kind === 'real');
      const lbl = (pairs, f) => pairs.map(([k, v]) => [H(L.html(f(k))), v]);
      $('t-devices').innerHTML = [
        barPanel('Platforma', lbl(devicesBy(ev, (e) => dataKey(e.dev.platform)), (k) => known(PLATFORM_NAME, k)), 'var(--water)'),
        barPanel('Model zařízení', devicesBy(ev, (e) => dataKey(e.dev.model)), 'var(--apricot)', 12),
        barPanel('Verze systému', devicesBy(ev, (e) => osLabel(e.dev.os, e.dev.osVersion, e.dev.platform) || null), 'var(--water)', 10),
        barPanel('Druh zařízení', lbl(devicesBy(ev, (e) => dataKey(e.dev.type)), (k) => known(DEVICE_TYPE_LABEL, k)), 'var(--water)', 0, 'skládací telefon je u obou'),
        barPanel('Verze aplikace v\u00a0záznamech', devicesBy(ev, (e) => (dataKey(e.dev.appBuild) !== null ? 'verze ' + dataKey(e.dev.appBuild) : '?')), 'var(--apricot)', 10, 'zařízení s víc verzemi je u každé'),
        barPanel('Jazyk aplikace', lbl(devicesBy(ev, (e) => dataKey(e.dev.locale)), (k) => L.lang(k)), 'var(--apricot)'),
        ...(instFail ? ['<div class="panel"><h3>Evidence zařízení</h3><p class="muted">Evidenci zařízení se nepodařilo načíst (verze, druh instalace, klasifikace). Zkus Obnovit na Souhrnu.</p></div>'] : [
        barPanel('Verze aplikace podle evidence zařízení', countBy(users, (i) => (dataKey(i.appBuild) !== null ? 'verze ' + dataKey(i.appBuild) : '?')), 'var(--water)', 10, 'poslední hlášená verze; ' + (FILTERS.testers ? 'včetně testerů' : 'bez testerů a robotů')),
        barPanel('Druh instalace', lbl(countBy(ledger, (i) => dataKey(i.installKind)), (k) => known(INSTALL_KIND_LABEL, k)), 'var(--apricot)', 10, 'celá evidence zařízení; App Store a z obchodu = běžní lidé'),
        barPanel('Klasifikace', lbl(countBy(ledger, (i) => i.cls.kind + '\u0000' + (i.cls.source === 'manual' ? 'manual' : i.cls.rule || '')), (k) => {
          const [kind, rule] = String(k).split('\u0000');
          const kt = clsKindText(kind), rt = rule === 'manual' ? (LANG === 'en' ? 'manually' : 'ručně') : rule ? clsRuleText(rule) : '';
          return lab(LANG === 'raw' ? kind + (rule ? ' · ' + rule : '') : kt + (rt ? ' · ' + rt : ''), kind + (rule ? ' · ' + rule : ''), true);
        }), 'var(--water)', 10, 'celá evidence zařízení; skutečné = počítá se do lidí'),
        ]),
      ].join('');

      // Selhání: selhané nákupy (pokusy, beze změny), odmítnutá poloha (zařízení), pes v útulku podle dne psa.
      // Pes v útulku po týdnech psa (texty-24): dny jednotlivě dávaly přes 40 řádků; pořadí zůstává chronologické.
      const failWeeks = countBy(evByName(ev, 'fail_state'), (e) => { const d = num(e.props.day); return d === null || d < 1 ? '?' : String(Math.floor((d - 1) / 7)); })
        .sort((a, b) => (a[0] === '?' ? 1 : b[0] === '?' ? -1 : Number(a[0]) - Number(b[0])));
      const failPanels = purchaseFailed.length ? [
        barPanel('Selhané nákupy: kód chyby', countBy(purchaseFailed, (e) => valKey(e.props.code || e.props.reason || '?')).map(([k, v]) => [H(L.html(failLab('purchase_failed', k))), v]), '#ff8a8a', 12, 'pokusy; kód RevenueCatu od verze 282, u starších jen důvod; bez obnovy nákupů'),
        barPanel('Selhané nákupy: produkt', lbl(countBy(purchaseFailed, (e) => valKey(e.props.product)), (k) => L.value('purchase_failed', 'product', k)), '#ff8a8a', 10),
        barPanel('Selhané nákupy: platforma', lbl(countBy(purchaseFailed, (e) => dataKey(e.dev.platform) ?? '?'), (k) => known(PLATFORM_NAME, k)), '#ff8a8a'),
        barPanel('Selhané nákupy: hláška', countBy(purchaseFailed, (e) => (dataKey(e.props.message || e.props.underlying) ?? '').slice(0, 80) || '(bez hlášky)'), 'var(--apricot)', 8),
      ] : ['<div class="panel"><h3>Selhané nákupy</h3><p class="muted">Selhané nákupy v tomto období: žádné.</p></div>'];
      $('t-quality').innerHTML = [
        ...failPanels,
        barPanel('Odmítnutá poloha: kde', lbl(devicesBy(evByName(ev, 'gps_denied'), (e) => valKey(e.props.stage)), (k) => L.value('gps_denied', 'stage', k)), 'var(--apricot)', null, 'zařízení'),
        barPanel('Pes skončil v útulku: týden psa', failWeeks.map(([k, v]) => [k === '?' ? 'den neuveden' : `${nf(Number(k) * 7 + 1)}.–${nf(Number(k) * 7 + 7)}. den`, v]), 'var(--apricot)', null, 'případy, chronologicky'),
      ].join('');

      // Evidence zařízení s označením testerů (řazeno podle poslední aktivity).
      if (!instFail && !instWait) renderInstallTable();
      function renderInstallTable() {
      const iidFilter = FILTERS.installId.trim();
      const rows = [...INSTALLS]
        .filter((i) => !iidFilter || i.id.startsWith(iidFilter))
        .sort((a, b) => (b.lastMs || 0) - (a.lastMs || 0))
        .slice(0, 300);
      $('i-sub').textContent = `(zobrazeno ${nf(rows.length)} naposledy aktivních ${zePrep(INSTALLS.length)}\u00a0${nf(INSTALLS.length)})`;
      // Automaticky testovací zařízení s nákupem z RevenueCatu: nákup se počítá a Nákupy ho označí „ověř ho“ (R9).
      const autoBuyIds = new Set(purchaseRows().filter((x) => x.autoTester).map((x) => x.app.installId));
      $('inst').innerHTML = `<tr><th>Zařízení</th><th>platforma</th><th>model</th><th>systém</th><th>jazyk</th><th>země</th><th>verze</th><th>první</th><th>poslední</th><th>druh</th><th></th></tr>` +
        rows.map((i) => {
          const c = i.cls; const o = OVERRIDES.get(i.id);
          // Automatické pravidlo popiskem (cisla-9: kontrolní zařízení Applu), ruční označení poznámkou.
          const title = o ? esc(dataKey(o.note) ?? '') : c.rule ? esc((LANG === 'en' ? 'Rule: ' : 'Pravidlo: ') + clsRuleText(c.rule)) : '';
          const auto = c.source === 'auto' ? ' (automaticky)' : '';
          const tag = c.kind === 'robot' ? `<span class="tag ${c.source === 'manual' ? 'manual' : 'auto'}" title="${title}">robot${auto}</span>`
            : c.kind === 'tester' ? `<span class="tag ${c.source === 'manual' ? 'manual' : 'auto'}" title="${title}">tester${auto}</span>`
            : `<span class="tag store" title="${title}">${o ? 'skutečné (ručně)' : L.html(known(INSTALL_KIND_LABEL, i.installKind))}</span>`;
          const btns = o
            ? `<button class="ghost sm" data-ov="${esc(i.id)}" data-kind="">zrušit označení</button>`
            : c.kind === 'real'
              ? `<button class="ghost sm" data-ov="${esc(i.id)}" data-kind="tester">tester</button> <button class="ghost sm" data-ov="${esc(i.id)}" data-kind="robot">robot</button>`
              // Zařízení s nákupem z RevenueCatu jde potvrdit ručně (R9): jen ruční označení ten nákup skryje.
              : (autoBuyIds.has(i.id) ? `<button class="ghost sm" data-ov="${esc(i.id)}" data-kind="${c.kind === 'robot' ? 'robot' : 'tester'}" title="Má nákup z RevenueCatu, který se počítá. Ruční označení ho skryje jako testovací.">potvrdit</button> ` : '') +
                `<button class="ghost sm" data-ov="${esc(i.id)}" data-kind="real">není ${c.kind === 'robot' ? 'robot' : 'tester'}</button>`;
          // Jazyk a země názvem podle přepínače, kód v title (texty-30, D.3); kód zařízení s rozlišujícím koncem (texty-7).
          const langCell = i.locale && i.locale !== 'none' ? L.html(L.lang(i.locale)) : '';
          const devLang = i.deviceLocale && i.deviceLocale !== 'none' && i.deviceLocale !== i.locale ? ' <span style="color:var(--muted)">(' + L.html(L.lang(i.deviceLocale)) + ')</span>' : '';
          return `<tr class="${c.kind !== 'real' ? 'tester' : ''}"><td><span class="iid" data-iid="${esc(i.id)}" title="${esc(i.id)}" style="cursor:pointer">${esc(shortId(i.id))}</span></td><td>${esc(mapLabel(PLATFORM_NAME, i.platform || '?'))}</td><td>${esc(i.model || '')}</td><td>${esc(osLabel(i.os, i.osVersion, i.platform))}</td><td>${langCell}${devLang}</td><td>${i.region && i.region !== 'none' ? L.html(L.region(i.region)) : ''}</td><td>${esc(i.appBuild ?? '')}</td><td>${i.firstMs ? esc(fmt(i.firstMs)) : ''}</td><td>${i.lastMs ? esc(fmt(i.lastMs)) : ''}</td><td>${tag}</td>
            <td style="white-space:nowrap">${btns}</td></tr>`;
        }).join('');
      $('inst').querySelectorAll('button[data-ov]').forEach((b) => b.onclick = () => setOverride(b.dataset.ov, b.dataset.kind || null).catch(saveFailed));
      $('inst').querySelectorAll('.iid').forEach((el) => el.onclick = () => { FILTERS.installId = el.dataset.iid; $('f-iid').value = el.dataset.iid; render(); });
      }

      // Poslední záznamy (D.4): popisek akce a vlastností, technický zápis šedě pod tím.
      const recent = [...ev].sort((a, b) => b.ts - a.ts).slice(0, 80);
      const short = (v) => { const t = v !== null && typeof v === 'object' ? stableJson(v) : String(v); return t.length > 120 ? t.slice(0, 120) + '…' : t; };
      $('feed').innerHTML = recent.map((e) => {
        const p = e.props && typeof e.props === 'object' ? e.props : {};
        const keys = Object.keys(p);
        const valText = (k) => (e.name === 'screen_view' && k === 'screen' && typeof p[k] === 'string' ? L.screen(p[k]).text
          : L.value(e.name, k, p[k] !== null && typeof p[k] === 'object' ? stableJson(p[k]) : p[k]).text);
        const human = [esc(L.event(e.name).text), ...keys.map((k) => `${esc(L.prop(e.name, k).text)}: ${esc(short(valText(k)))}`)].join(' · ');
        const tech = validActionName(e.name) ? esc(e.name) + (keys.length ? ' ' + esc(keys.map((k) => k + '=' + short(p[k])).join(' ')) : '') : 'neplatný název';
        return `<div class="row"><span><span class="ev">${human}</span><span class="tech">${tech}</span></span>
        <span class="meta"><span class="iid" data-iid="${esc(e.installId || '')}" title="${esc(e.installId || '')}">${esc(shortId(e.installId || '?'))}</span> · ${esc(dataKey(e.dev.model) ?? dataKey(e.dev.platform) ?? '?')} · ${esc(dataKey(e.dev.locale) ?? '')} · ${esc(fmt(e.ts))}</span>
      </div>`;
      }).join('') || '<p style="color:var(--muted)">Žádné záznamy.</p>';
      // Klik na kód zařízení → filtr na to zařízení.
      $('feed').querySelectorAll('.iid').forEach((el) => el.onclick = () => {
        FILTERS.installId = el.dataset.iid; $('f-iid').value = el.dataset.iid; render();
      });
    }

    // --- DASHBOARD (dlaždice) ---
    // Vždy bez testerů a robotů: zařízení podle i.cls.kind === 'real', eventy přes isExcluded,
    // nákupy stejným pravidlem jako Nákupy (rc && !sandbox && cls === 'real', bez vrácených).
    const DAY_MS = 86400000;
    let dataReady = false;        // první načtení doběhlo (dashboard do té doby nic nepočítá)
    let LOADED_AT = null;         // čas posledního načtení (hlavička „Aktualizováno …“)
    const STALE_MS = 3600000;     // po hodině hlavička řekne „Data jsou z …“ (R4)
    let STALE_TIMER = null;       // jednorázové překreslení po hodině kvůli té hlášce i bez kliknutí (provoz2-5)
    // Časovač po spánku počítače nedoběhne včas: Chrome i Safari na macOS odpočítávají jen bdělý čas (provoz3-4).
    // Proto i při návratu na stránku (probuzení, přepnutí okna) a každou minutu: jakmile je hodina od načtení
    // podle nástěnných hodin pryč, jednou překreslit. render() nic nenačítá.
    let STALE_DRAWN = null;       // LOADED_AT, pro který už hláška jednou překreslila
    function staleCheck() {
      if (DEMO || !dataReady || LOADED_AT === null || STALE_DRAWN === LOADED_AT || Date.now() - LOADED_AT <= STALE_MS) return;
      STALE_DRAWN = LOADED_AT; render();
    }
    document.addEventListener('visibilitychange', () => { if (!document.hidden) staleCheck(); });
    window.addEventListener('focus', staleCheck);
    window.addEventListener('pageshow', staleCheck);
    setInterval(staleCheck, 60000);
    let dashCoverage = false;     // dočítání analytiky na 30 dní už spuštěno
    let dashCovering = false;     // … a právě běží
    let dashCoverFailed = false;  // … a skončilo chybou (Souhrn pak radí Obnovit, ne Načíst starší)
    let dashCoverPromise = null;
    let refreshing = false;       // tlačítko Obnovit právě načítá

    // Kurzy: 1× za načtení stránky, Frankfurter (ECB), základ CZK → {rates:{EUR:0.04,…}} = 1 Kč v cizí měně.
    // Pozor: stará adresa api.frankfurter.app jen přesměrovává (301 bez CORS) → v prohlížeči selže.
    const FALLBACK_USD_CZK = 21.0;
    let FX = null, fxPromise = null; // FX = {rates, date} | {failed:true}
    function loadFx() {
      if (fxPromise) return fxPromise;
      const signal = typeof AbortSignal !== 'undefined' && AbortSignal.timeout ? AbortSignal.timeout(8000) : undefined;
      fxPromise = fetch('https://api.frankfurter.dev/v1/latest?base=CZK', { signal })
        .then((r) => r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status)))
        .then((j) => { FX = j && j.rates && typeof j.rates === 'object' ? { rates: j.rates, date: j.date || null } : { failed: true }; })
        .catch((e) => { console.warn('kurzy nenačteny', e); FX = { failed: true }; })
        .then(() => { if (activeTab === 'souhrn') renderDashboard(); });
      return fxPromise;
    }
    const usdCzk = () => { const r = FX && FX.rates ? Number(FX.rates.USD) : NaN; return r > 0 ? { rate: 1 / r, approx: false } : { rate: FALLBACK_USD_CZK, approx: true }; };
    /** Částka v měně nákupu → Kč. Bez kurzu měny (nebo bez kurzů vůbec) přes USD → approx. */
    function toCzk(amount, cur, amountUsd) {
      const a = amount === null || amount === undefined ? NaN : Number(amount);
      const c = String(cur || '').toUpperCase();
      if (c === 'CZK' && Number.isFinite(a)) return { czk: a, approx: false, ecb: false };
      const r = FX && FX.rates && Object.hasOwn(FX.rates, c) ? Number(FX.rates[c]) : NaN; // měna z dat jen přes hasOwn (E.3)
      if (Number.isFinite(a) && r > 0) return { czk: a / r, approx: false, ecb: true };
      const u = amountUsd === null || amountUsd === undefined ? NaN : Number(amountUsd);
      return { czk: Number.isFinite(u) ? u * usdCzk().rate : 0, approx: true, ecb: false };
    }

    // Formáty čísel v mezipaměti podle počtu desetinných míst (provoz-10, uplnost-5).
    const NF_CACHE = new Map();
    const nf = (v, d = 0) => {
      const x = Number(v);
      if (!Number.isFinite(x)) return '–';
      let f = NF_CACHE.get(d);
      if (!f) NF_CACHE.set(d, f = new Intl.NumberFormat('cs-CZ', { minimumFractionDigits: d, maximumFractionDigits: d }));
      return f.format(x);
    };
    const czkFmt = (v) => nf(Math.round(v)) + ' Kč';
    const pctFmt = (a, b, d = 0) => b ? nf((a / b) * 100, d) + ' %' : '–';
    const anyMs = (v) => {
      const t = tsMs(v); if (t !== null) return t;
      if (v instanceof Date) return v.getTime();
      if (v && typeof v === 'object' && Number.isFinite(Number(v.seconds))) return Number(v.seconds) * 1000;
      if (typeof v === 'string') { const p = Date.parse(v); return Number.isFinite(p) ? p : null; }
      return null;
    };
    const rtf = typeof Intl.RelativeTimeFormat === 'function' ? new Intl.RelativeTimeFormat('cs', { numeric: 'auto' }) : null;
    function ago(ms) {
      if (!Number.isFinite(ms)) return '';
      const s = (ms - nowMs()) / 1000, a = Math.abs(s);
      if (!rtf) return fmt(ms);
      if (a < 60) return 'právě teď';
      if (a < 3600) return rtf.format(Math.round(s / 60), 'minute');
      if (a < 86400) return rtf.format(Math.round(s / 3600), 'hour');
      if (a < 86400 * 60) return rtf.format(Math.round(s / 86400), 'day');
      return rtf.format(Math.round(s / (86400 * 30)), 'month');
    }
    const regionLabel = (c) => { try { return new Intl.DisplayNames(['cs'], { type: 'region' }).of(String(c)) || String(c); } catch { return String(c); } };
    const isoDay = (ms) => new Date(ms).toISOString().slice(0, 10);
    const dayLabel = (iso) => /^\d{4}-\d{2}-\d{2}$/.test(String(iso || '')) ? (+iso.slice(8, 10)) + '. ' + (+iso.slice(5, 7)) + '.' : '–';

    // Analytika je stránkovaná po dávkách (lastTs sestupně). 30 dní je pokryto, když kurzor (nejstarší
    // načtená dávka) je starší než 30 dní – všechny nenačtené dávky jsou ještě starší – nebo už není co načíst.
    const rawOldest = () => { let m = Infinity; for (const e of RAW) if (Number.isFinite(e.ts) && e.ts < m) m = e.ts; return m; };
    // Kurzor = lastTs poslední načtené dávky. Nečíselný nebo chybějící kurzor = nepokryto (bezpecnost-4): čas
    // událostí z dat se nepoužívá, podvržené dávky by jinak tvrdily „data úplná“. Konec historie kryje exhausted.
    const cursorTs = () => { const v = lastDoc && typeof lastDoc.get === 'function' ? tsMs(lastDoc.get('lastTs')) : null; return Number.isFinite(v) ? v : Infinity; };
    const coveredDays = (days) => exhausted || cursorTs() <= nowMs() - days * DAY_MS;
    const dashCovered = () => coveredDays(30);
    /** Dočte analytiku na posledních `days` dní (nejvýš maxPages stránek) přes společný zámek; Souhrn,
     *  Získávání, Cesta i Nákupy čtou tytéž stránky. Promise skončí až po doběhnutí, nikdy předčasně. */
    function ensureCoverage(days = 30, maxPages = 40) {
      if (DEMO) return Promise.resolve(true);
      return ensureCoverageWhile(() => !coveredDays(days), maxPages);
    }
    function ensureDashCoverage() {
      if (dashCoverage || DEMO) return dashCoverPromise;
      dashCoverage = true;
      if (dashCovered()) return dashCoverPromise;
      dashCovering = true;
      dashCoverPromise = ensureCoverage(30, 40)
        .catch((e) => { dashCoverFailed = true; console.warn('dočtení analytiky na 30 dní selhalo', e); })
        .finally(() => { dashCovering = false; buildFilterOptions(); render(); });
      return dashCoverPromise;
    }

    /** Dlaždice. Všechny řetězce jsou už HTML – hodnoty z Firestore musí volající prohnat esc(). */
    function tile({ title, big, cells, list, sub, desc, alert }) {
      return `<div class="tile${alert ? ' alert' : ''}"><div class="t-title">${title}</div>` +
        (big !== undefined ? `<div class="t-big">${big}</div>` : '') +
        (cells ? `<div class="t-cells c${cells.length}">${cells.map(([v, l]) => `<div class="t-cell"><b>${v}</b><span>${l}</span></div>`).join('')}</div>` : '') +
        (list ? `<div class="t-list">${list.map(([l, v]) => `<div><span>${l}</span><b>${v}</b></div>`).join('')}</div>` : '') +
        (sub ? `<div class="t-sub">${sub}</div>` : '') +
        (desc ? `<div class="t-desc">${desc}</div>` : '') + '</div>';
    }
    const section = (title, tiles) => `<h2>${title}</h2><div class="tiles">${tiles.join('')}</div>`;

    function renderDashboard() {
      if (!$('dash-tiles')) return;
      if (!dataReady) {
        $('dash-updated').textContent = LOAD_FAILED ? 'Načtení selhalo' : 'Načítám…'; $('dash-cover').textContent = '';
        // Po selhání nenechat dlaždice z minulého načtení bez času (provoz2-4), stejně jako Získávání a Cesta.
        // Během běžného načítání zůstávají (provoz-1).
        if (LOAD_FAILED) $('dash-tiles').innerHTML = '<div class="wait">Data se nepodařilo načíst. Zkus Obnovit.</div>';
        return;
      }
      ensureDashCoverage();
      loadFx();
      // „Teď“ (C.4 bod 8): v produkci čas posledního načtení, v demu čas výpisu.
      const now = nowMs();
      const within = (ms, d) => ms !== null && ms !== undefined && now - ms <= d * DAY_MS;
      // R3: zdvojené záznamy se počítají jednou; nesmí to změnit čísla potichu (C.4 bod 7). Číslo = všechny načtené
      // záznamy včetně testerů (stejně jako T1), proto to věta říká (provoz-5, cisla-8, texty-18).
      $('dash-updated').textContent = (DEMO ? 'Demo · ' : '') + 'Aktualizováno ' + (LOADED_AT ? fmt(LOADED_AT) : '–') + ' · bez testerů a robotů' +
        ` · Zdvojené záznamy z telefonů se počítají jednou (vyřazeno ${nf(DEDUP.dups)} ze všech načtených záznamů včetně testerů).` + staleNote();
      const oldestEv = rawOldest();
      // Chyba dočítání radí Obnovit; zarážka 40 stránek (bez chyby) radí Načíst starší (provoz-2, provoz-4).
      $('dash-cover').textContent = DEMO ? '' : dashCovering ? '· dočítám události za 30 dní…'
        : dashCovered() ? '' : dashCoverFailed ? '· data za 30 dní se nepodařilo načíst celá, zkus Obnovit'
        : '· události načtené jen od ' + (Number.isFinite(oldestEv) ? fmt(oldestEv) : '–') + ' (Načíst starší v Technice)';
      $('dash-refresh').disabled = refreshing || dashCovering;
      // Selhané čtení kolekce se nesmí tvářit jako nula ani jako „zatím nic“ (provoz-4).
      const LEDGER_FAIL = '<span class="warn">Evidenci zařízení se nepodařilo načíst, zkus Obnovit.</span>';

      // ── Uživatelé (ledger instalací) ──
      const real = INSTALLS.filter((i) => (i.platform === 'ios' || i.platform === 'android') && i.cls && i.cls.kind === 'real');
      const PERIODS = [[1, '24 h'], [7, '7 dní'], [14, '14 dní'], [30, '30 dní']];
      const storeSince = (d) => isoDay(now - d * DAY_MS);
      const storeSum = (d, plat) => STORE.filter((x) => (!plat || x.platform === plat) && x.date >= storeSince(d)).reduce((a, x) => a + storeN(x), 0);
      const storeLast = (plat) => STORE.filter((x) => x.platform === plat).map((x) => String(x.date)).sort().slice(-1)[0] || null;
      const instErr = LOAD_ERR.has('installs'), storeErr = LOAD_ERR.has('store'), rcErr = LOAD_ERR.has('rc');
      // rc_events se nenačetly: Peníze by ukázaly nuly jako data (provoz2-1, C.4 bod 9).
      const RC_FAIL = '<span class="warn">Nákupy z RevenueCatu se nepodařilo načíst, zkus Obnovit.</span>';
      const tInstalls = tile({
        title: 'Instalace',
        cells: instErr ? undefined : PERIODS.map(([d, l]) => [nf(real.filter((i) => within(i.firstMs, d)).length), l]),
        // Velká čísla = naše měření (první spuštění). Obchody jen pro srovnání: počítají stažení
        // (i neotevřená) a data vydávají se zpožděním, proto jen 30 dní a s datem, do kdy je mají.
        sub: (instErr ? LEDGER_FAIL + '<br>' : '') + (storeErr ? 'Obchody: nepodařilo se načíst, zkus Obnovit' : STORE.length ? `Pro srovnání oficiálně z obchodů za 30 dní: ${nf(storeSum(30))} stažení <span style="color:var(--muted)">(App Store má data do ${esc(dayLabel(storeLast('ios')))}, Google Play do ${esc(dayLabel(storeLast('android')))}; stažení se počítá i bez otevření aplikace)</span>` : 'Obchody: zatím žádná data'),
        desc: 'velká čísla = naše měření: zařízení, která aplikaci poprvé spustila (bez testerů a robotů)',
      });
      const iosN = real.filter((i) => i.platform === 'ios').length;
      const tActive = tile({
        title: 'Aktivní uživatelé',
        cells: instErr ? undefined : PERIODS.map(([d, l]) => [nf(real.filter((i) => within(i.lastMs, d)).length), l]),
        sub: instErr ? LEDGER_FAIL : `Zařízení celkem: ${nf(real.length)} (iOS ${nf(iosN)} · Android ${nf(real.length - iosN)})`,
        desc: 'zařízení, která aplikaci v tom období otevřela',
      });
      // Klasická retence (den N přesně, kalendářní dny v Praze) po režimech – srovnatelná s trhem.
      // Počítá ji server denně (functions/cohortRetention.js), sem jdou jen počty (Number()).
      const RS = RETENTION.state === 'ok' ? RETENTION.data : null;
      const seg = (k) => own(RS && RS.segments, k);
      // Pod 10 zařízení by procenta klamala (1 z 1 = 100 %) → ukaž jen počet.
      const rPct = (x) => {
        const n = x ? Number(x.n) || 0 : 0, k = x ? Number(x.k) || 0 : 0;
        if (!n) return '–';
        return n < 10 ? `<span>${nf(k)}/${nf(n)}</span>` : pctFmt(k, n);
      };
      const DCOLS = [['d1', 'D1'], ['d7', 'D7'], ['d30', 'D30']];
      const SEG_ROWS = [['challenge', '30denní výzva'], ['trial', 'Pes na zkoušku bez výzvy'], ['owner', 'Pes doma'], ['notActivated', 'Psa nezaložili']];
      const allSeg = seg('all');
      const tRetention = tile({
        title: 'Retence',
        cells: allSeg
          ? DCOLS.map(([k, l]) => [rPct(allSeg[k]), `${l} · ${zz(Number(allSeg[k] && allSeg[k].n) || 0)} zařízení`])
          : [['–', RETENTION.state === 'error' ? 'nepodařilo se načíst' : 'čeká na první výpočet']],
        sub: allSeg
          ? '<table class="t-ret"><tr><th>Podle režimu</th>' + DCOLS.map(([, l]) => `<th>${l}</th>`).join('') + '</tr>'
            + SEG_ROWS.map(([k, l]) => { const s = seg(k); return `<tr><td>${l} <span>(${nf(Number(s && s.installs) || 0)})</span></td>` + DCOLS.map(([d]) => `<td>${s ? rPct(s[d]) : '–'}</td>`).join('') + '</tr>'; }).join('')
            + '<tr class="mkt"><td>Průměr aplikací na trhu</td><td>26 %</td><td>13 %</td><td>7 %</td></tr></table>'
            // Týdenní retence (Pes doma se nevrací denně, ale kvůli plánu péče): vrátil se kdykoli v týdnu.
            + (seg('owner') && seg('owner').w1
              ? `<div style="margin-top:8px"><b>Pes doma po týdnech:</b> 2.&nbsp;týden&nbsp;${rPct(seg('owner').w1)} · 5.&nbsp;týden&nbsp;${rPct(seg('owner').w4)}`
                + ` <span style="color:var(--muted)">(vrátil se kdykoli ve dnech 7–13, resp. 28–34; celkem 2.&nbsp;týden&nbsp;${rPct(allSeg.w1)})</span></div>`
              : '')
          : '',
        desc: 'podíl zařízení, která aplikaci otevřela přesně 1., 7. a 30. den po prvním spuštění&nbsp;– stejně jako srovnávací studie trhu (Adjust, AppsFlyer); v závorce počet zařízení, při méně než 10 zařízeních jen počet (vrátilo se / základ); bez testerů a robotů; přepočet jednou denně'
          + (RS && anyMs(RS.updatedAt) ? ' · ' + esc(fmt(anyMs(RS.updatedAt))) : ''),
      });
      const new7 = real.filter((i) => within(i.firstMs, 7));
      const byRegion = countBy(new7, (i) => i.region && i.region !== 'none' ? String(i.region) : null);
      const noRegion = new7.length - byRegion.reduce((a, [, v]) => a + v, 0);
      const tCountries = tile({
        title: 'Nové instalace podle země (7 dní)',
        list: !instErr && byRegion.length ? byRegion.slice(0, 3).map(([c, v]) => [esc(regionLabel(c)), nf(v)]) : null,
        big: !instErr && byRegion.length ? undefined : '–',
        sub: instErr ? LEDGER_FAIL : noRegion > 0 ? `Bez údaje o zemi: ${nf(noRegion)}` : '',
        desc: 'tři nejčastější země z nastavení telefonu u nových zařízení za 7 dní',
      });

      // ── Peníze (RevenueCat) ──
      const allP = purchaseRows();
      const prow = allP.filter((x) => x.rc && !x.sandbox && x.cls === 'real' && !x.refunded);
      const paid = prow.filter((x) => (Number(x.rc.priceLocal) || 0) > 0);
      const isPlan = (x) => x.key.startsWith('plan_'), isBreed = (x) => x.key.startsWith('breed_');
      const paidAuto = paid.filter((x) => x.autoTester).length;
      const lastTile = (title, x, emptyText, extra) => {
        if (rcErr) return tile({ title, big: '–', sub: RC_FAIL, desc: 'cena v měně nákupu včetně DPH' });
        if (!x) return tile({ title, big: '–', sub: extra || '', desc: emptyText });
        const r = x.rc;
        const where = [fmt(x.ts), r.countryCode ? regionLabel(r.countryCode) : null, r.store ? storeLabel(r.store) : null].filter(Boolean).map(esc).join(' · ');
        return tile({
          title,
          big: money(r.priceLocal, r.currency),
          sub: `${esc(productLabel(x.key))} · ${esc(typeLabel(r.type))}<br>${where}` + (extra ? '<br>' + extra : ''),
          desc: esc(ago(x.ts)) + ' · cena v měně nákupu včetně DPH',
        });
      };
      const lastTrial = prow.find((x) => isPlan(x) && String(x.rc.periodType || '') === 'TRIAL');
      const tLastPremium = lastTile('Poslední nákup Premium', paid.find(isPlan), 'zatím žádný placený nákup Premium',
        lastTrial ? 'Poslední zkušební období: ' + esc(ago(lastTrial.ts)) : '');
      const tLastBreed = lastTile('Poslední nákup plemene', paid.find(isBreed), 'zatím žádný nákup plemene');

      let gross = 0, grossApprox = false, grossEcb = false;
      paid.forEach((x) => { const c = toCzk(x.rc.priceLocal, x.rc.currency, x.rc.priceUsd); gross += c.czk; if (c.approx) grossApprox = true; if (c.ecb) grossEcb = true; });
      const usdRate = usdCzk();
      const proceeds = paid.reduce((a, x) => a + (Number(x.rc.proceedsUsd) || 0), 0) * usdRate.rate;
      const fxNote = !paid.length ? 'zatím žádný placený nákup'
        : grossApprox ? (FX === null ? 'kurz se načítá, zatím přibližně přes USD' : 'přepočet přibližně přes USD' + (usdRate.approx ? ' (kurz nedostupný, 1 USD = ' + nf(FALLBACK_USD_CZK, 0) + ' Kč)' : ''))
        : grossEcb ? 'přepočteno kurzem ECB' + (FX && FX.date ? ' z ' + esc(dayLabel(FX.date)) : '') : 'vše placeno v Kč';
      const tTotal = rcErr ? tile({ title: 'Nákupy celkem', big: '–', sub: RC_FAIL, desc: 'všechny placené nákupy od začátku, hrubě včetně DPH' }) : tile({
        title: 'Nákupy celkem',
        big: (grossApprox ? '≈ ' : '') + czkFmt(gross),
        sub: `Placené nákupy: ${nf(paid.length)} (Premium&nbsp;${nf(paid.filter(isPlan).length)} · plemena&nbsp;${nf(paid.filter(isBreed).length)})<br>` +
          `Výnos po DPH a provizi obchodu: ≈ ${czkFmt(proceeds)}` +
          // R9: nákup z RevenueCatu ze zařízení, které automatika bere jako testovací, se počítá; jen ho přiznáme.
          (paidAuto ? `<br>Z toho ze zařízení, které vypadá jako testovací:&nbsp;${nf(paidAuto)} (${pl(paidAuto, 'počítá', 'počítají', 'počítá')} se, ověř v Nákupech)` : ''),
        desc: 'všechny placené nákupy od začátku, hrubě včetně DPH; ' + fxNote,
      });

      // Aktivní Premium: zákazník má nevrácený nákup „navždy“, nebo jeho nejnovější událost předplatného
      // (měsíčně/ročně) není vypršení ani vrácení peněz a expirationAtMs je v budoucnu. Zkušební období zvlášť.
      const excludedCust = new Set(allP.filter((x) => x.rc && x.rc.customer && (x.sandbox || x.cls !== 'real')).map((x) => x.rc.customer));
      const refundedTx = new Set(RC_EVENTS.filter((r) => r.type === 'CANCELLATION' && r.cancelReason === 'CUSTOMER_SUPPORT').map((r) => r.transactionId).filter(Boolean));
      const evAt = (r) => Number(r.eventAtMs || r.purchasedAtMs) || 0;
      const byCust = new Map();
      RC_EVENTS.forEach((r) => {
        if (!r.customer || r.type === 'TEST' || excludedCust.has(r.customer) || String(r.environment || '').toUpperCase() === 'SANDBOX') return;
        if (!productKey(r.productId).startsWith('plan_')) return;
        const a = byCust.get(r.customer) || []; a.push(r); byCust.set(r.customer, a);
      });
      // Počty podle plánu v Map (E.3: klíč z dat).
      const act = new Map([['plan_monthly', 0], ['plan_yearly', 0], ['plan_lifetime', 0]]); let actTrial = 0;
      byCust.forEach((evs) => {
        if (evs.some((r) => r.isPurchase && productKey(r.productId) === 'plan_lifetime' && !(r.transactionId && refundedTx.has(r.transactionId)))) { addCount(act, 'plan_lifetime'); return; }
        const last = evs.filter((r) => productKey(r.productId) !== 'plan_lifetime').sort((a, b) => evAt(b) - evAt(a))[0];
        if (!last || last.type === 'EXPIRATION' || (last.type === 'CANCELLATION' && last.cancelReason === 'CUSTOMER_SUPPORT')) return;
        if (!(Number(last.expirationAtMs) > now)) return;
        if (String(last.periodType || '') === 'TRIAL') actTrial++;
        else addCount(act, productKey(last.productId));
      });
      const actPaid = [...act.values()].reduce((a, v) => a + v, 0);
      const tActivePremium = rcErr ? tile({ title: 'Aktivní Premium', big: '–', sub: RC_FAIL, desc: 'zákazníci, kterým Premium právě teď platí (předplatné před vypršením nebo navždy), bez zkušebního období' }) : tile({
        title: 'Aktivní Premium',
        big: nf(actPaid),
        sub: `Měsíčně&nbsp;${nf(act.get('plan_monthly'))} · ročně&nbsp;${nf(act.get('plan_yearly'))} · navždy&nbsp;${nf(act.get('plan_lifetime'))}<br>Ve zkušebním období navíc: ${nf(actTrial)}`,
        desc: 'zákazníci, kterým Premium právě teď platí (předplatné před vypršením nebo navždy), bez zkušebního období',
      });

      const custKey = (x) => x.rc.customer || ('tx:' + (x.rc.transactionId || x.ts));
      const payers = new Set(paid.map(custKey));
      const tPayers = tile({
        title: 'Platící zákazníci a konverze',
        cells: rcErr ? undefined : [[nf(payers.size), pl(payers.size, 'platící zákazník', 'platící zákazníci', 'platících zákazníků')], [instErr ? '–' : pctFmt(payers.size, real.length, 1), 'konverze ze zařízení']],
        big: rcErr ? '–' : undefined,
        // Hláška o evidenci na vlastním řádku, ne jako položka výčtu (texty3-7); NBSP mezi popiskem a číslem (texty3-3).
        sub: rcErr ? RC_FAIL : `Premium&nbsp;${nf(new Set(paid.filter(isPlan).map(custKey)).size)} · plemena&nbsp;${nf(new Set(paid.filter(isBreed).map(custKey)).size)}` + (instErr ? '<br>' + LEDGER_FAIL : ` · zařízení celkem&nbsp;${nf(real.length)}`),
        desc: 'různí zákazníci s aspoň jedním placeným nákupem; konverze = podíl ze všech skutečných zařízení od začátku',
      });

      // ── Obchody ──
      const lastIos = storeLast('ios'), lastAnd = storeLast('android');
      const uninst30 = STORE.filter((x) => x.platform === 'android' && x.date >= storeSince(30)).reduce((a, x) => a + (Number(x.uninstalls) || 0), 0);
      const tStore = tile({
        title: 'Stažení z obchodů',
        cells: STORE.length ? [
          [nf(storeSum(7, 'ios')), 'App Store · 7 dní'], [nf(storeSum(30, 'ios')), 'App Store · 30 dní'],
          [nf(storeSum(7, 'android')), 'Google Play · 7 dní'], [nf(storeSum(30, 'android')), 'Google Play · 30 dní'],
        ] : null,
        big: STORE.length ? undefined : '–',
        sub: storeErr ? 'nepodařilo se načíst, zkus Obnovit' : STORE.length ? `Odinstalace Google Play za 30 dní: ${nf(uninst30)}<br>Data do: App Store ${esc(dayLabel(lastIos))} · Google Play ${esc(dayLabel(lastAnd))}` : 'zatím žádná data',
        desc: 'oficiální čísla obchodů (první stažení / nové instalace); chodí se zpožděním 1–5 dní, poslední dny ještě chybí',
      });

      let tRatings;
      const R = RATINGS.state === 'ok' ? RATINGS.data : null;
      if (!R) {
        tRatings = tile({
          title: 'Hodnocení v obchodech', big: '–',
          sub: RATINGS.state === 'error' ? 'nepodařilo se načíst, zkus Obnovit' : 'čeká na první načtení',
          desc: 'průměr hvězdiček a počet hodnocení v App Storu a na Google Play',
        });
      } else {
        const star = (o) => {
          const cnt = Number(o && o.count) || 0, avg = o && o.avg !== null && o.avg !== undefined ? Number(o.avg) : NaN;
          return [!cnt || !Number.isFinite(avg) ? '–' : nf(avg, 1) + ' ★', cnt ? nf(cnt) + ' hodnocení' : 'zatím bez hodnocení'];
        };
        const [iosStar, iosCnt] = star(R.ios), [andStar, andCnt] = star(R.android);
        const rv = R.reviews || {};
        const unIos = Number(rv.ios && rv.ios.unanswered) || 0, unAnd = Number(rv.android && rv.android.unanswered) || 0;
        const un = unIos + unAnd;
        const byCountry = R.ios && R.ios.byCountry && typeof R.ios.byCountry === 'object'
          ? Object.entries(R.ios.byCountry).filter(([, v]) => v && Number(v.count) > 0).sort((a, b) => Number(b[1].count) - Number(a[1].count)).slice(0, 3) : [];
        const upd = anyMs(R.updatedAt);
        tRatings = tile({
          title: 'Hodnocení v obchodech',
          cells: [[iosStar, 'App Store · ' + iosCnt], [andStar, 'Google Play · ' + andCnt]],
          sub: [
            un > 0 ? `<span class="warn">Čeká na odpověď: ${nf(un)}</span> (App Store ${nf(unIos)} · Google Play ${nf(unAnd)})` : 'Všechny recenze mají odpověď',
            byCountry.length ? 'App Store podle země: ' + byCountry.map(([c, v]) => esc(regionLabel(c)) + ' ' + esc(Number.isFinite(Number(v.avg)) ? nf(v.avg, 1) + ' ★' : '–') + ' (' + nf(v.count) + ')').join(' · ') : '',
          ].filter(Boolean).join('<br>'),
          desc: 'průměr hvězdiček a počet hodnocení' + (upd ? ' · aktualizováno ' + esc(fmt(upd)) : ''),
        });
      }

      // ── Zapojení (analytika aplikace, bez testerů a robotů); lidé = různá zařízení (C.4 body 3–6) ──
      const ev = RAW.filter((e) => Number.isFinite(e.ts) && !isExcluded(e.installId, e.dev));
      const evIn = (name, d, pred) => ev.filter((e) => e.name === name && (!d || now - e.ts <= d * DAY_MS) && (!pred || pred(e)));
      const devIn = (name, d, pred) => new Set(evIn(name, d, pred).map((e) => e.installId)).size;
      // Sdílení stejným výpočtem jako Získávání → Z5 (activeWith v jádru): skuteční aktivní za 30 dní, bez klepnutí
      // na odznak (počítá se zvlášť, rozhodnutí 20. 11.); sdílení tlačítkem v detailu odznaku je sdílení.
      // 30 dní = shared.k, odeslali 30 dní = ios.sent, odznak 30 dní = badge.k v Z5.
      const SHARE_DESC = 'kolik zařízení otevřelo sdílení (bez klepnutí na odznak)';
      const shareTile = () => {
        const cx = coreIndex();
        const sharersIn = (w) => activeWith(cx, w, 'share_initiated', isShareEv);
        const s7 = sharersIn(cx.w7), s30 = sharersIn(cx.w30), sentN = (devs, w) => iosWith(cx, devs, w, isShareSent).length;
        // Nezlomitelné mezery mezi popiskem a číslem (G.6, texty3-3): číslo nespadne na další řádek.
        return tile({
          title: 'Sdílení',
          cells: [[nf(s7.length), 'zařízení · 7 dní'], [nf(s30.length), 'zařízení · 30 dní']],
          sub: `Opravdu odeslali (jen iPhone, Android to nehlásí): 7&nbsp;dní&nbsp;${nf(sentN(s7, cx.w7))}&nbsp;· 30&nbsp;dní&nbsp;${nf(sentN(s30, cx.w30))}` +
            `<br>Klepnuli na odznak (zvlášť): 30&nbsp;dní&nbsp;${nf(activeWith(cx, cx.w30, BADGE_TAP_NAMES, isBadgeTap).length)}`,
          desc: SHARE_DESC,
        });
      };
      let tShare = instErr ? null : shareTile();
      // Paywall → nákup za 30 dní (analytika aplikace): obnova se nepočítá, dvojí zobrazení sloučená.
      const mon30 = monetization(ev.filter((e) => now - e.ts <= 30 * DAY_MS));
      const pwInst = new Set(mon30.views.map((v) => v.installId));
      const buys30 = mon30.purchases.filter((p) => p.name === 'purchase_completed');
      const buyInst = new Set(buys30.map((p) => p.installId));
      const rN = (k) => mon30.restores.filter((r) => r.kind === k).length;
      // Nákup z aplikace bez protějšku v RevenueCatu do 10 min = stejné párování jako Technika → Sedí data? (T3),
      // tedy pravděpodobně testovací (cisla2-2). Z čísla ho neodebíráme: o testerech rozhoduje zakladatel v T4.
      const rcUsed = rcErr ? null : pairPurchases(RC_EVENTS, RAW).used;
      const noRcInst = rcUsed ? new Set(ev.filter((e) => e.name === 'purchase_completed' && now - e.ts <= 30 * DAY_MS && !isLegacyRestore(e) && !rcUsed.has(e) && buyInst.has(e.installId)).map((e) => e.installId)) : new Set();
      // „Nejvíc“ jen u jednoznačného vítěze a od 10 nákupů (R7); jinak jen výčet (cisla2-2, texty2-11).
      const srcAll = countBy(buys30, (p) => p.source || null);
      const srcListOnly = buys30.length < SMALL_N || (srcAll.length > 1 && srcAll[1][1] === srcAll[0][1]);
      const srcLine = !srcAll.length ? ''
        : srcListOnly ? `<br>Nákupy podle zdroje: ${srcAll.map(([s, v]) => `${esc(srcLab(s).text)}&nbsp;${nf(v)}`).join(' · ')}`
        : `<br>Nejvíc nákupů ze zdroje: ${esc(srcLab(srcAll[0][0]).text)} (${nf(srcAll[0][1])})`;
      let tPaywall = tile({
        title: 'Paywall → nákup (30 dní)',
        // Pod 10 zařízení s paywallem jen „k z n“ (R7, C.4 bod 4).
        big: pwInst.size < SMALL_N ? `${nf(buyInst.size)} ${zz(pwInst.size)}` : pctFmt(buyInst.size, pwInst.size, 1),
        cells: [[nf(pwInst.size), 'zařízení s paywallem'], [nf(buyInst.size), pl(buyInst.size, 'dokončilo nákup', 'dokončila nákup', 'dokončilo nákup')]],
        // Bez rc_events nejde poznat testovací nákup: místo tichého vynechání řádku „Z toho…“ hláška (texty3-7).
        sub: (rcErr && buyInst.size ? '<span class="warn">Testovací nákupy teď nejde poznat: nákupy z RevenueCatu se nepodařilo načíst, zkus Obnovit.</span><br>'
          : noRcInst.size ? `Z toho bez záznamu v RevenueCatu: ${nf(noRcInst.size)} (pravděpodobně testovací nákup, ověř v Technice)<br>` : '') +
          `Obnova nákupů: ${nf(rN('started'))}× (obnoveno ${nf(rN('completed'))} · nebylo co obnovit ${nf(rN('none'))} · selhalo ${nf(rN('failed'))})` +
          `<br>Spravovat předplatné: ${nf(mon30.manage.length)}×` + srcLine,
        desc: 'zařízení, která za 30 dní viděla paywall, a kolik jich nákup dokončilo (analytika aplikace); obnova nákupů se jako nákup nepočítá; rozpad podle zdroje, režimu a plánu v záložce Nákupy',
      });
      let tCare = tile({
        title: 'Připomínky péče',
        cells: [[nf(devIn('care_reminder_opened', 7)), 'otevřeli · 7 dní'], [nf(devIn('care_reminder_done', 7)), 'splnili po připomínce · 7 dní']],
        desc: 'Otevřeli = klepli na připomínku. Splnili = nakrmili nebo vyvenčili psa do 2 hodin po připomínce, i bez klepnutí, proto se tato dvě čísla nedělí. Měří se od 14. 11. 2026.',
      });
      let tChallenge = tile({
        title: '30denní výzva',
        cells: [[nf(devIn('challenge_completed', 30)), 'dokončili · 30 dní'], [nf(devIn('challenge_started', 30)), 'spustili · 30 dní']],
        desc: 'Kolik zařízení za 30 dní výzvu spustilo a kolik ji dokončilo. Výzva trvá 30 dní, takže dokončit ji mohli jen ti, kdo začali dřív.',
      });

      // Bez evidence zařízení ani ručních přepisů nejde z událostí vyřadit testery a hlavička by lhala
      // „bez testerů a robotů“ (provoz2-2): dlaždice z událostí jen s hláškou, jako Získávání a Cesta.
      if (instErr) {
        const evFail = (title, desc) => tile({ title, big: '–', sub: LEDGER_FAIL, desc });
        tShare = evFail('Sdílení', SHARE_DESC);
        tPaywall = evFail('Paywall → nákup (30 dní)', 'zařízení, která za 30 dní viděla paywall, a kolik jich nákup dokončilo (analytika aplikace)');
        tCare = evFail('Připomínky péče', 'Otevřeli = klepli na připomínku. Splnili = nakrmili nebo vyvenčili psa do 2 hodin po připomínce.');
        tChallenge = evFail('30denní výzva', 'Kolik zařízení za 30 dní výzvu spustilo a kolik ji dokončilo.');
      } else if (!DEMO && !dashCovered()) {
        // Dlaždice z událostí do konce dočítání 30 dní bez čísel z první stránky (rozhodnutí 20. 11., provoz-2), stejně
        // jako Získávání a Cesta. Chyba dočítání radí Obnovit, zarážka stránek (bez chyby) Načíst starší v Technice.
        // Dlaždice z evidence, retence ze serveru a z RevenueCatu se nemění.
        const covMsg = dashCovering ? coverText('running', 30)
          : dashCoverFailed ? 'Data za 30 dní se nepodařilo načíst celá, zkus Obnovit.'
          : `Události jsou načtené jen od ${esc(Number.isFinite(oldestEv) ? fmt(oldestEv) : '–')}, čísla za 30 dní by nebyla úplná (Načíst starší v Technice).`;
        const evWait = (title, desc) => tile({ title, sub: `<div class="t-wait">${covMsg}</div>`, desc });
        tShare = evWait('Sdílení', SHARE_DESC);
        tPaywall = evWait('Paywall → nákup (30 dní)', 'zařízení, která za 30 dní viděla paywall, a kolik jich nákup dokončilo (analytika aplikace)');
        tCare = evWait('Připomínky péče', 'Otevřeli = klepli na připomínku. Splnili = nakrmili nebo vyvenčili psa do 2 hodin po připomínce.');
        tChallenge = evWait('30denní výzva', 'Kolik zařízení za 30 dní výzvu spustilo a kolik ji dokončilo.');
      }
      $('dash-tiles').innerHTML = [
        section('Uživatelé', [tInstalls, tActive, tRetention, tCountries]),
        section('Peníze', [tTotal, tActivePremium, tPayers, tPaywall, tLastPremium, tLastBreed]),
        section('Obchody', [tStore, tRatings]),
        section('Zapojení', [tShare, tCare, tChallenge]),
      ].join('');
    }

    /** Obnovit: Souhrn, Získávání i Cesta (stejná obsluha, SPEC C.0). */
    async function refreshAll() {
      if (refreshing || dashCovering) return;
      if (DEMO) { render(); return; }
      refreshing = true; $('dash-refresh').disabled = true;
      document.querySelectorAll('[data-refresh]').forEach((b) => { b.disabled = true; });
      try {
        if (dashCoverPromise) await dashCoverPromise;
        await firstLoad();
        if (dashCoverPromise) await dashCoverPromise;
      } finally { refreshing = false; $('dash-refresh').disabled = dashCovering; render(); }
    }
    $('dash-refresh').onclick = refreshAll;

    // Dočítání pro Získávání a Cestu (C.5): stejný zámek a tytéž stránky jako Souhrn. Stav podle dní:
    // 'ok' = pokryto, 'running' = dočítám, 'short' = doběhlo, ale dny pokryté nejsou (zarážka stránek nebo chyba).
    const COVER_RUNS = new Map();
    let COVER_GEN = 0;
    function coverState(days) {
      if (DEMO || coveredDays(days)) return 'ok';
      const st = COVER_RUNS.get(days);
      if (st === 'done') return 'short';
      if (!st) {
        const gen = COVER_GEN;
        COVER_RUNS.set(days, 'running');
        ensureCoverage(days, 40)
          .catch((e) => console.warn('dočtení analytiky selhalo', e))
          .finally(() => { if (gen === COVER_GEN) COVER_RUNS.set(days, 'done'); buildFilterOptions(); render(); });
      }
      return 'running';
    }

    // ─── Získávání a Cesta (SPEC C.0–C.2). Všechna čísla jsou z jádra (coreResult); tady jen texty, popisky
    //     a vykreslení (procenta z k a n, rozdíly kroků). Věty karet a „Co z toho plyne“ jsou vždy česky
    //     s českými popisky (D.3); tabulky, pruhy a seznamy se řídí přepínačem popisků.
    const SMALL_N = VERDICT_RULES.SMALL_N;
    const MONTH_GEN = ['ledna', 'února', 'března', 'dubna', 'května', 'června', 'července', 'srpna', 'září', 'října', 'listopadu', 'prosince'];
    // Slovník verdiktů (C.0): barva jen doplňuje slovo, žádná červená.
    const VERDICT_CLASS = new Map([['Vyplatí se', 'v-good'], ['Nad trhem', 'v-good'], ['Nevyplatí se', 'v-warn'], ['Pod trhem', 'v-warn'], ['Roste', 'v-up'],
      ['Zjištění', 'v-info'], ['Průkazný rozdíl', 'v-info'], ['Na úrovni trhu', 'v-info'], ['Drží', 'v-info'], ['Jen počty', 'v-info'],
      ['V pořádku', 'v-good'], ['Pozor', 'v-warn'], ['Řešit tarif', 'v-warn'], ['Zopakovat', 'v-good']]);
    const PLATFORM_LABEL = new Map([['android', 'Android'], ['ios', 'iPhone']]);
    const NETWORK_LABEL = new Map([['tiktok', 'TikTok'], ['google', 'Google Ads'], ['apple', 'Apple Ads'], ['meta', 'Meta']]);
    const OPEN_DETAILS = new Set(); // rozbalené <details> přežijí překreslení (C.5)
    const num = (v) => { if (v === null || v === undefined || v === '' || typeof v === 'boolean') return null; const x = Number(v); return Number.isFinite(x) ? x : null; };
    const isIsoDay = (s) => typeof s === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(s);
