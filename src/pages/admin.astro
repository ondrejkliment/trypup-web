      let wz4 = null;
      if (z4 !== 'Průkazný rozdíl') {
        // Srovnání kampaní (cisla3-1): rostoucí strana se odhaduje, až má 7 dní zralých D1 jen z dnešního stavu
        // (since + 7 + zralost 2); do té doby 'young' s platformou a stavem kampaně pro větu.
        const campWhen = (n, added, rg, grows) => {
          if (!grows) return whenClear(n, added, today);
