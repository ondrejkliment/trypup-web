      INSTALLS = inst.docs.map((d) => { const x = d.data() || {}, v = (k) => toScalar(x[k]); return { id: d.id, platform: v('platform') || null, firstMs: tsMs(x.firstSeenAt), lastMs: tsMs(x.lastSeenAt), locale: v('locale'), deviceLocale: v('deviceLocale'), region: v('region'), installKind: v('installKind') || 'unknown', model: v('model'), os: v('os'), osVersion: v('osVersion'), appBuild: v('appBuild'),
        srcChannel: v('srcChannel'), srcSource: v('srcSource'), srcMedium: v('srcMedium'), srcCampaign: v('srcCampaign'), srcAds: v('srcAds') }; });
      OVERRIDES = new Map(over.docs.map((d) => [d.id, d.data() || {}]));
      DATA_VER++; OVERRIDES_VER++;
      reclassify();
    }
    /** Zápis označení selhal: hláška česky (provoz-11), technický text jen do konzole. */
    const saveFailed = (e) => { console.warn('označení zařízení se nepodařilo uložit', e); alert('Nepodařilo se uložit: ' + errText(e, 'zápis') + '.'); };
    /** kind: 'tester' | 'robot' | 'real' (ruční přepis) | null (zrušit přepis → automatika). */
    async function setOverride(iid, kind) {
      if (kind) {
        const note = prompt(kind === 'real' ? 'Poznámka (proč není robot/tester):' : 'Poznámka (např. „můj iPhone“):', (OVERRIDES.get(iid) || {}).note || '');
        if (note === null) return;
        await setDoc(doc(db, 'tester_installs', iid), { kind, note, at: serverTimestamp() }); OVERRIDES.set(iid, { kind, note });
      } else { await deleteDoc(doc(db, 'tester_installs', iid)); OVERRIDES.delete(iid); }
      OVERRIDES_VER++;
      reclassify(); render();
    }

    // Selhání čtení (provoz-4): která kolekce se nenačetla ('installs' | 'store' | 'rc') a jestli selhala analytika.
    // Karty a dlaždice pak píšou „nepodařilo se načíst“ místo nuly, „zatím nic“ nebo věčného „Počítám…“.
    let LOAD_ERR = new Set(), LOAD_FAILED = false;
    /** Chyba databáze česky, bez anglické hlášky Firebase (provoz-11); původní text jen do konzole. */
    const errText = (e, what = 'čtení') => new Map([['permission-denied', what === 'zápis' ? 'chybí oprávnění k zápisu' : 'chybí oprávnění ke čtení dat'], ['unavailable', 'není spojení se serverem'],
      ['resource-exhausted', 'vyčerpaný denní limit čtení databáze'], ['deadline-exceeded', 'server neodpověděl včas'], ['unauthenticated', 'přihlášení vypršelo']])
      .get(e && typeof e.code === 'string' ? e.code.replace(/^firestore\//, '') : '') || 'neznámá chyba';
    async function firstLoad() {
      // Reset dat pod zámkem: běžící dočítání (Souhrn, Nákupy, Načíst vše) nejdřív doběhne. V tomtéž synchronním
      // bloku i dataReady a pokrytí (provoz-1): pokračování starého běhu jinak vykreslilo prázdná data jako hotová
      // a spustilo čtení dřív než první stránka nového načtení.
      await withLoadLock(() => {
        RAW = []; lastDoc = null; batches = 0; exhausted = false; DEDUP.reset(); DATA_VER++; BAD_BATCHES = 0;
        QUERY_MAX_TS = Date.now() + DAY_MS;
        dataReady = false; dashCoverage = false; dashCoverFailed = false; purchaseCoverage = false; purchaseCoverFailed = false; LOAD_FAILED = false;
        COVER_GEN++; COVER_RUNS.clear();
      });
      LOAD_ERR = new Set();
      $('loadOlder').textContent = 'Načíst starší'; $('loadAll').textContent = 'Načíst vše';
      $('status').classList.remove('hidden');
      $('status').textContent = 'Načítám…';
      try {
        await resetNetIfNeeded();
        // Selhaná evidence nesmí nechat zařízení a označení z minulého načtení (provoz3-3, stejně jako rc_events
        // v provoz2-1): jinak Nákupy skrývají testery podle staré evidence a hláška říká, že to nejde.
        await loadInstalls().catch((e) => { console.warn('ledger instalací nenačten', e); LOAD_ERR.add('installs'); INSTALLS = []; OVERRIDES = new Map(); reclassify(); DATA_VER++; OVERRIDES_VER++; });
        await loadStoreStats().catch((e) => { console.warn('store_stats nenačteny', e); LOAD_ERR.add('store'); RATINGS = { state: 'error', data: null }; RETENTION = { state: 'error', data: null }; AD_CAMPAIGNS = null; });
        await loadCampaignReview();
        // Selhané rc_events nesmí nechat nákupy z minulého načtení bez upozornění (provoz2-1).
        await loadRcEvents().catch((e) => { console.warn('rc_events nenačteny', e); LOAD_ERR.add('rc'); RC_EVENTS = []; DATA_VER++; });
        await withLoadLock(() => fetchPage());
        dataReady = true; LOADED_AT = Date.now();
        // Hláška „Data jsou z …“ (R4) i bez kliknutí: jednou po hodině překreslit (provoz2-5). render() nic
        // nenačítá a jádro jde z mezipaměti, protože „teď“ je pevně LOADED_AT.
        STALE_DRAWN = null;
        clearTimeout(STALE_TIMER); STALE_TIMER = setTimeout(staleCheck, STALE_MS + 1000);
        buildFilterOptions();
        render();
        $('status').classList.add('hidden');
      } catch (e) {
        console.warn('načtení analytiky selhalo', e);
        LOAD_FAILED = true;
        $('dash-updated').textContent = 'Načtení selhalo';
        // Rada podle chyby (provoz3-1): u výpadku spojení věta o pravidlech přístupu posílá ke špatné příčině.
        const net = ['unavailable', 'deadline-exceeded'].includes(errCode(e));
        $('status').innerHTML = '<span class="err">Chyba: ' + esc(errText(e)) +
          '</span><br><span style="color:var(--muted)">' + (net ? 'Data se nepodařilo načíst. Zkontroluj připojení k internetu a zkus Obnovit.'
            : 'Data se nepodařilo načíst. Zkus Obnovit; když chyba trvá, chybí pravidla přístupu k analytice v databázi, nebo v ní zatím nejsou žádná data.') + '</span>';
        render();
      }
    }

    // Načíst starší / vše: přes společný zámek (E.12), „Vše načteno“ až po skutečném konci historie.
    $('loadOlder').onclick = async () => {
      let n = 0, failed = false;
      try { await resetNetIfNeeded(); n = await withLoadLock(() => fetchPage()); } catch (e) { failed = true; console.warn('načtení starších dat selhalo', e); }
      buildFilterOptions(); render();
      if (failed) $('loadOlder').textContent = 'Načtení se nepovedlo, zkus znovu';
      else if (!n || exhausted) $('loadOlder').textContent = 'Historie kompletní';
      else $('loadOlder').textContent = 'Načíst starší';
    };
    $('loadAll').onclick = async () => {
      $('loadAll').textContent = 'Načítám…';
      let failed = false;
      await resetNetIfNeeded();
      await ensureCoverageWhile(() => true, 200).catch((e) => { failed = true; console.warn('načtení celé historie selhalo', e); });
      buildFilterOptions(); render();
      // Selhání nesmí vypadat jako nic (provoz-4): text tlačítka řekne, co se stalo.
      $('loadAll').textContent = exhausted ? 'Vše načteno' : failed ? 'Načtení se nepovedlo, zkus znovu' : 'Načíst vše';
    };

    // --- Filtry (jen Nákupy a Technika). Data a rychlé volby v pražských dnech (E.9): „Od“ = pražská
    //     půlnoc dne, „Do“ = celý pražský den včetně; 24 h / 7 / 30 dní = interval (teď − N × 24 h, teď].
    const FILTERS = { text:'', installId:'', event:'', platform:'', locale:'', build:'', type:'', from:'', to:'', sinceMs:null, testers:false };
    $('f-testers').onchange = (ev) => { FILTERS.testers = ev.target.checked; render(); };
    const PLATFORM_NAME = new Map([['ios', 'iPhone'], ['android', 'Android']]);
    const DEVICE_TYPE_LABEL = new Map([['phone', 'telefon'], ['tablet', 'tablet'], ['desktop', 'počítač'], ['tv', 'televize']]);
    const mapLabel = (m, v) => { const k = valKey(v); return m.has(k) ? m.get(k) : k; };
    /** Systém zařízení: vždy s názvem („Android 16“, „iOS 26.6“), i když zařízení posílá jen číslo (texty-30). */
    const osLabel = (os, ver, platform) => {
      const o = dataKey(os), v = dataKey(ver) ?? '';
      // `os` u starších verzí Androidu nese celý otisk sestavení nebo jen číslo → název podle platformy.
      const name = o !== null && /^(iOS|iPadOS|Android)$/i.test(o) ? o : platform === 'ios' ? 'iOS' : platform === 'android' ? 'Android' : (o ?? '');
      return (name + (v ? ' ' + v : '')).trim();
    };
    /** Pražská půlnoc dne 'YYYY-MM-DD' v ms (Praha má posun v celých hodinách); jinak null. */
    function pragueStartMs(iso) {
      const n = isoDayNum(iso);
      if (n === null) return null;
      let t = n * DAY_MS - 3 * 3600000;
      for (let i = 0; i < 8 && pragueDay(t) < n; i++) t += 3600000;
      return t;
    }
    /** Hranice filtru období v ms: [od, do) nebo (since, …]. */
    function filterRange() {
      if (FILTERS.sinceMs !== null) return { from: null, to: null, since: FILTERS.sinceMs };
      const n = FILTERS.to ? isoDayNum(FILTERS.to) : null;
      return { from: FILTERS.from ? pragueStartMs(FILTERS.from) : null, to: n !== null ? pragueStartMs(dayIso(n + 1)) : null, since: null };
    }
    const inRange = (ts, r) => (r.since === null || ts > r.since) && (r.from === null || ts >= r.from) && (r.to === null || ts < r.to);

    // Hledání podle českého i anglického popisku akce: popisky se počítají jednou za název.
    const SEARCH_LABEL = new Map();
    const searchLabel = (name) => {
      if (!SEARCH_LABEL.has(name)) SEARCH_LABEL.set(name, validActionName(name) ? (L.event(name, 'cs').text + ' ' + L.event(name, 'en').text).toLowerCase() : '');
      return SEARCH_LABEL.get(name);
    };

    // Hodnoty filtrů se z RAW čtou jednou na verzi dat; přepnutí jazyka jen přepíše popisky (provoz-10, rozhodnutí
    // hlavního sezení: zrychlit přepnutí jazyka na Technice).
    let FILTER_VALS = { key: null, names: null, platform: null, locale: null, build: null, type: null };
    function filterValues() {
      const key = DATA_VER + '|' + RAW.length;
      if (FILTER_VALS.key === key) return FILTER_VALS;
      const names = new Set(), sets = { platform: new Set(), locale: new Set(), build: new Set(), type: new Set() };
      const add = (set, v) => { if (v !== null && v !== undefined && v !== '') set.add(String(v)); };
      for (const e of RAW) {
        if (validActionName(e.name)) names.add(e.name);
        const d = e.dev;
        add(sets.platform, d.platform); add(sets.locale, d.locale); add(sets.build, d.appBuild); add(sets.type, d.type);
      }
      const sorted = (set) => [...set].sort();
      FILTER_VALS = { key, names, platform: sorted(sets.platform), locale: sorted(sets.locale), build: sorted(sets.build), type: sorted(sets.type) };
      return FILTER_VALS;
    }
    function buildFilterOptions() {
      const FV = filterValues();
      const fill = (id, opts, label, labelOf) => {
        const sel = $(id); const cur = sel.value;
        sel.innerHTML = '<option value="">' + label + ': vše</option>' +
          opts.map((v) => '<option value="' + esc(v) + '">' + esc(labelOf ? labelOf(v) : v) + '</option>').join('');
        sel.value = cur; // zachovej výběr po překreslení
      };
      // Akce: skupiny katalogu jako <optgroup>, text popiskem, hodnota technická (D.4). Neplatné názvy jen v počtech (D.5).
      const names = FV.names;
      const byGroup = new Map();
      for (const n of names) { const e = EV.get(n); addToSet(byGroup, e && typeof e.g === 'string' && GROUPS.has(e.g) ? e.g : 'unknown', n); }
      const order = [...GROUPS.keys()];
      for (const g of byGroup.keys()) if (!order.includes(g)) order.push(g);
      const sel = $('f-event'), cur = sel.value;
      sel.innerHTML = '<option value="">Akce: vše</option>' + order.filter((g) => byGroup.has(g)).map((g) =>
        `<optgroup label="${esc(L.group(g).text)}">` + [...byGroup.get(g)].map((n) => [n, L.event(n).text]).sort((a, b) => a[1].localeCompare(b[1], 'cs'))
          .map(([n, t]) => `<option value="${esc(n)}">${esc(t)}</option>`).join('') + '</optgroup>').join('');
      sel.value = cur;
      fill('f-platform', FV.platform, 'Platforma', (v) => mapLabel(PLATFORM_NAME, v));
      fill('f-locale', FV.locale, 'Jazyk', (v) => L.lang(v).text);
      fill('f-build', FV.build, 'Verze', (v) => 'verze ' + v);
      fill('f-type', FV.type, 'Druh zařízení', (v) => mapLabel(DEVICE_TYPE_LABEL, v));
    }

    function applyFilters(arr) {
      const text = FILTERS.text.trim().toLowerCase();
      const iid = FILTERS.installId.trim();
      const range = filterRange();
      return arr.filter((e) => {
        if (!Number.isFinite(e.ts)) return false;
        if (!FILTERS.testers && isExcluded(e.installId, e.dev)) return false;
        if (FILTERS.event && e.name !== FILTERS.event) return false;
        if (FILTERS.platform && String(e.dev.platform) !== FILTERS.platform) return false;
        if (FILTERS.locale && String(e.dev.locale) !== FILTERS.locale) return false;
        if (FILTERS.build && String(e.dev.appBuild) !== FILTERS.build) return false;
        if (FILTERS.type && String(e.dev.type) !== FILTERS.type) return false;
        if (iid && !String(e.installId || '').startsWith(iid)) return false;
        if (!inRange(e.ts, range)) return false;
        if (text) {
          const hay = (String(e.name) + ' ' + searchLabel(e.name) + ' ' + JSON.stringify(e.props) + ' ' + (e.dev.model || '') + ' ' + (e.dev.locale || '')).toLowerCase();
          if (!hay.includes(text)) return false;
        }
        return true;
      });
    }

    // Obsluha filtrů
    let textTimer = null;
    $('f-text').oninput = (ev) => { clearTimeout(textTimer); const v = ev.target.value; textTimer = setTimeout(() => { FILTERS.text = v; render(); }, 200); };
    $('f-iid').oninput = (ev) => { clearTimeout(textTimer); const v = ev.target.value; textTimer = setTimeout(() => { FILTERS.installId = v; render(); }, 200); };
    ['event','platform','locale','build','type'].forEach((k) => { $('f-' + k).onchange = (ev) => { FILTERS[k] = ev.target.value; render(); }; });
    $('f-from').onchange = (ev) => { FILTERS.from = ev.target.value; FILTERS.sinceMs = null; setQuickActive(null); render(); };
    $('f-to').onchange = (ev) => { FILTERS.to = ev.target.value; FILTERS.sinceMs = null; setQuickActive(null); render(); };
    $('quick').querySelectorAll('button').forEach((b) => { b.onclick = () => {
      const d = Number(b.dataset.d);
      FILTERS.from = ''; FILTERS.to = '';
      FILTERS.sinceMs = d > 0 ? nowMs() - d * DAY_MS : null;
      $('f-from').value = ''; $('f-to').value = '';
      setQuickActive(b); render();
    }; });
    function setQuickActive(btn) { $('quick').querySelectorAll('button').forEach((x) => x.classList.toggle('on', x === btn)); }
    // Vyčistit vrátí všechny filtry včetně zaškrtávátka testerů (E.9).
    $('f-clear').onclick = () => {
      Object.assign(FILTERS, { text:'', installId:'', event:'', platform:'', locale:'', build:'', type:'', from:'', to:'', sinceMs:null, testers:false });
      ['f-text','f-iid','f-from','f-to'].forEach((id) => { $(id).value = ''; });
      ['f-event','f-platform','f-locale','f-build','f-type'].forEach((id) => { $(id).value = ''; });
      $('f-testers').checked = false;
      setQuickActive($('quick').querySelector('[data-d="0"]'));
      render();
    };

    // --- Záložky (SPEC B.1, E.13): adresa = záložka, staré adresy přesměrují, Zpět v prohlížeči mění záložku ---
    const TABS = ['souhrn', 'ziskavani', 'cesta', 'nakupy', 'technika'];
    const TAB_ALIASES = new Map([['dashboard', 'souhrn'], ['prehled', 'ziskavani'], ['vyzkum', 'cesta']]);
    // Lišta filtrů jen tam, kde filtry platí; Souhrn, Získávání a Cesta jsou vždy bez testerů a s pevnými obdobími.
    const FILTER_TABS = new Set(['nakupy', 'technika']);
    function tabFromHash() {
      const h = (location.hash || '').slice(1);
      if (TAB_ALIASES.has(h)) {
        const t = TAB_ALIASES.get(h);
        try { history.replaceState(null, '', '#' + t); } catch { /* bez history zůstane stará adresa */ }
        return t;
      }
      return TABS.includes(h) ? h : 'souhrn';
    }
    let activeTab = tabFromHash();
    function showTab(t) {
      activeTab = t;
      $('tabs').querySelectorAll('.tab').forEach((b) => { const on = b.dataset.tab === t; b.classList.toggle('active', on); b.setAttribute('aria-selected', String(on)); });
      TABS.forEach((x) => $('tab-' + x).classList.toggle('hidden', x !== t));
      document.querySelector('.filters').classList.toggle('hidden', !FILTER_TABS.has(t));
      render();
    }
    /** Klik na záložku zapíše adresu (nový záznam historie); překreslí posluchač hashchange. */
    function setTab(t) {
      if (!TABS.includes(t)) return;
      if ((location.hash || '').slice(1) !== t) location.hash = t;
      else showTab(t);
    }
    window.addEventListener('hashchange', () => showTab(tabFromHash()));
    $('tabs').querySelectorAll('.tab').forEach((b) => b.onclick = () => setTab(b.dataset.tab));

    // --- Přepínač popisků (SPEC D.3): mění jen popisky z dat, nic se nepřepočítává ---
    function syncLangButtons() { $('langsw').querySelectorAll('button[data-lang]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.lang === LANG))); }
    $('langsw').querySelectorAll('button[data-lang]').forEach((b) => b.onclick = () => {
      const v = b.dataset.lang;
      if (!LANGS.includes(v) || v === LANG) return;
      LANG = v;
      try { localStorage.setItem(LANG_KEY, v); } catch { /* bez úložiště volba platí do obnovení stránky */ }
      syncLangButtons();
      if (dataReady) buildFilterOptions();
      render();
    });
    syncLangButtons();

    // --- agregační helpery ---
    function countBy(arr, keyFn) {
      const m = new Map();
      for (const x of arr) { const k = keyFn(x); if (k == null || k === '') continue; m.set(k, (m.get(k) || 0) + 1); }
      return [...m.entries()].sort((a, b) => b[1] - a[1]);
    }
    /** Různá zařízení na hodnotu (E.10): [[hodnota, zařízení], …] sestupně. */
    function devicesBy(arr, keyFn, idFn = (x) => x.installId) {
      const m = new Map();
      for (const x of arr) { const k = keyFn(x); if (k === null || k === undefined || k === '') continue; addToSet(m, k, idFn(x)); }
      return breakdownSets(m);
    }
    /** Hotové bezpečné HTML (L.html, ml, lv) jako instance soukromé třídy (bezpecnost-1): hodnota z dat, která má
     *  tvar { html }, se nikdy nepovažuje za HTML, protože instancí SafeHtml být nemůže. */
    class SafeHtml { constructor(h) { this.html = String(h); } }
    const H = (html) => new SafeHtml(html);
    /** Popisek pruhu: SafeHtml jako HTML, cokoli jiného escapované (objekt jako JSON se seřazenými klíči). */
    const labelHtml = (k) => (k instanceof SafeHtml ? k.html : esc(k !== null && typeof k === 'object' ? stableJson(k) : k));
    /** Klíč rozpadu z hodnoty dat: prázdná hodnota null (nepočítá se), jinak řetězec přes valKey (nikdy objekt). */
    const dataKey = (v) => (v === null || v === undefined || v === '' ? null : valKey(v));
    /** Panel s pruhy. Číslo jen přes Number() + Number.isFinite (E.2), maximum smyčkou (E.4). */
    function barPanel(title, pairs, color, max, hint) {
      const top = max ? pairs.slice(0, max) : pairs;
      let hi = 0;
      for (const p of top) { const v = Number(p[1]); if (Number.isFinite(v) && v > hi) hi = v; }
      // Volitelný třetí prvek = text místo čísla (např. „–“ u dne bez dat); takový řádek nemá pruh.
      const rows = top.map(([k, v, txt]) => {
        const n = Number(v), ok = Number.isFinite(n);
        const w = ok && hi > 0 ? Math.max(2, (n / hi) * 100) : 0;
        return `<div class="bar"><span class="lbl">${labelHtml(k)}</span><span class="val">${txt != null ? esc(txt) : ok ? nf(n) : '–'}</span>` +
          `<div class="track">${txt != null || !ok ? '' : `<div class="fill" style="width:${w.toFixed(1)}%;${color ? 'background:' + color : ''}"></div>`}</div></div>`;
      }).join('');
      const h = hint ? ` <span class="hint">${esc(hint)}</span>` : '';
      return `<div class="panel"><h3>${esc(title)}${h}</h3>${rows || '<p style="color:var(--muted)">Žádná data.</p>'}</div>`;
    }
    /** Trychtýř z hotových množin zařízení: [[popisek, Set(installId)], …]. */
    function funnelFromSets(title, pairs, hint) {
      const sets = pairs.map(([, set]) => set);
      const base = sets[0].size || 1;
      const rows = pairs.map(([label], i) => {
        const c = sets[i].size; const pct = Math.round((c / base) * 100);
        // Krok na krok: kolik % z PŘEDCHOZÍHO kroku se dostalo sem (+ absolutní úbytek).
        let conv = '';
        if (i > 0) {
          const prev = sets[i - 1].size;
          const stepPct = prev ? Math.round((c / prev) * 100) : 0;
          const drop = prev - c;
          conv = `<div class="conv">↳ ${stepPct}&nbsp;% z předchozího${drop > 0 ? `<span class="drop">−${drop}</span>` : ''}</div>`;
        }
        return `<div class="step"><div class="bar"><span class="lbl">${labelHtml(label)}</span><span class="val">${c} <span class="pct">· ${pct}&nbsp;%</span></span>
          <div class="track"><div class="fill" style="width:${Math.max(2, pct)}%;background:var(--apricot)"></div></div></div>${conv}</div>`;
      }).join('');
      const h = hint ? ` <span class="hint">${esc(hint)}</span>` : '';
      return `<div class="panel funnel"><h3>${esc(title)}${h}</h3>${rows}</div>`;
    }
    const evByName = (ev, name) => ev.filter((e) => e.name === name);

    // --- Monetizace z analytiky aplikace: paywall → nákup, obnova, správa předplatného ---
    // Vlna 1 auditu (pawprint-mobile docs/ANALYTICS.md, 16. 11. 2026):
    //  • Obnova nákupů má vlastní restore_started → restore_completed {kind} / restore_none /
    //    restore_failed {reason, code}. Starší verze ji posílají jako purchase_* s product: 'restore'
    //    → do nákupů, trychtýře ani tržeb se nikdy nepočítá; obnovy jsou zvlášť (oba zdroje sloučené).
    //  • purchase_* nově nesou source, mode, trial (0|1) a u Premium plánu plan. Starším nákupům
    //    zdroj a režim dopočítáme z posledního paywall_viewed téhož zařízení (nejvýš hodinu před).
    //  • Starší verze u zdrojů article a health_tip logují paywall_viewed dvakrát (z článku s article,
    //    z paywallu bez něj) → dvojice téhož zařízení a zdroje do 60 s = jedno zobrazení. Od vlny 1
    //    loguje jen paywall, jednou a s article: dvojice nevznikají, takže netřeba hranice buildu.
    // PURCHASE_EVENTS a isLegacyRestore jsou v jádru (sdílí je kontrola nákupů v Technice).
    const RESTORE_KIND = new Map([['restore_started', 'started'], ['restore_completed', 'completed'], ['restore_none', 'none'], ['restore_failed', 'failed']]);
    const DOUBLE_VIEW_SOURCES = new Set(['article', 'health_tip']);
    const DOUBLE_VIEW_MS = 60 * 1000;
    const ATTRIBUTION_MS = 60 * 60 * 1000;
    const hasArticle = (e) => e.props.article !== undefined && e.props.article !== null && e.props.article !== '';

    /** Dvojí zobrazení ze starších verzí (článek + paywall) → jedno; ponechá záznam paywallu (má mode) s id článku. */
    function dedupePaywallViews(views) {
      const out = [], groups = new Map(); let merged = 0;
      for (const e of views) {
        if (!DOUBLE_VIEW_SOURCES.has(e.props.source)) { out.push(e); continue; }
        const k = e.installId + '|' + e.props.source;
        const a = groups.get(k); if (a) a.push(e); else groups.set(k, [e]);
      }
      // Párování dvěma ukazateli (bezpecnost-6): pro každý záznam nejčasnější nepoužitý záznam opačného druhu
      // (s článkem × bez článku) s vyšším indexem do 60 s. Ukazatele se jen posouvají, výsledek je stejný jako
      // dřívější procházení všech pozdějších záznamů, ale bez kvadratického času u podvržených dávek.
      groups.forEach((arr) => {
        arr.sort((a, b) => a.ts - b.ts);
        const used = new Set(), byKind = [[], []], ptr = [0, 0];
        arr.forEach((e, i) => byKind[hasArticle(e) ? 1 : 0].push(i));
        arr.forEach((a, i) => {
          if (used.has(i)) return;
          const kOpp = hasArticle(a) ? 0 : 1, list = byKind[kOpp];
          while (ptr[kOpp] < list.length && (list[ptr[kOpp]] <= i || used.has(list[ptr[kOpp]]))) ptr[kOpp]++;
          const j = ptr[kOpp] < list.length ? list[ptr[kOpp]] : -1;
          if (j < 0 || arr[j].ts - a.ts > DOUBLE_VIEW_MS) { out.push(a); return; }
          used.add(j); merged++;
          const b = arr[j], art = hasArticle(a) ? a : b, pw = hasArticle(a) ? b : a;
          out.push({ ...pw, props: { ...pw.props, article: art.props.article } });
        });
      });
      return { views: out, merged };
    }

    /**
     * Eventy (už filtrované) → {views, merged, purchases, restores, manage}. purchases = purchase_*
     * BEZ obnovy, s dopočteným zdrojem/režimem; restores = restore_* + starší purchase_* s product
     * 'restore' (kind: started|completed|none|failed, legacy = ze starší verze).
     */
    function monetization(ev) {
      const rawViews = ev.filter((e) => e.name === 'paywall_viewed');
      const { views, merged } = dedupePaywallViews(rawViews);
      const viewsBy = new Map();
      views.forEach((v) => { const a = viewsBy.get(v.installId); if (a) a.push(v); else viewsBy.set(v.installId, [v]); });
      viewsBy.forEach((a) => a.sort((x, y) => x.ts - y.ts));
      // Poslední zobrazení paywallu před událostí (2 s tolerance: pořadí v jedné dávce), binárně (bezpecnost-6).
      const lastView = (e) => {
        const vs = viewsBy.get(e.installId);
        if (!vs || !vs.length) return null;
        let lo = 0, hi = vs.length;
        while (lo < hi) { const m = (lo + hi) >> 1; if (vs[m].ts > e.ts + 2000) hi = m; else lo = m + 1; }
        const v = lo > 0 ? vs[lo - 1] : null;
        return v && e.ts - v.ts <= ATTRIBUTION_MS ? v : null;
      };
      const purchases = [], restores = [];
      for (const e of ev) {
        const p = e.props;
        if (RESTORE_KIND.has(e.name)) {
          restores.push({ installId: e.installId, kind: RESTORE_KIND.get(e.name), legacy: false, reason: e.name === 'restore_failed' ? (p.code || p.reason || '?') : null, source: p.source || null });
          continue;
        }
        if (!PURCHASE_EVENTS.has(e.name)) continue;
        if (isLegacyRestore(e)) {
          const kind = e.name === 'purchase_started' ? 'started' : e.name === 'purchase_completed' ? 'completed'
            : e.name === 'purchase_failed' && p.reason === 'nothing_to_restore' ? 'none' : 'failed';
          restores.push({ installId: e.installId, kind, legacy: true, reason: kind === 'failed' ? (p.code || p.reason || e.name.replace('purchase_', '')) : null, source: null });
          continue;
        }
        let source = p.source || null, mode = p.mode || null, inferred = false;
        if (!source || !mode) {
          const v = lastView(e);
          if (v && !source && v.props.source) { source = v.props.source; inferred = true; }
          if (v && !mode && v.props.mode) { mode = v.props.mode; inferred = true; }
        }
        const product = String(p.product || '');
        const plan = p.plan || (product.startsWith('plan_') ? product.slice(5) : null);
        const trial = p.trial === 1 || p.trial === '1' ? 1 : p.trial === 0 || p.trial === '0' ? 0 : null;
        purchases.push({ name: e.name, installId: e.installId, product, source, mode, plan, trial, inferred });
      }
      return { views, rawViews: rawViews.length, merged, purchases, restores, manage: ev.filter((e) => e.name === 'subscription_manage_opened') };
    }

    // Popisky Nákupů z katalogu (D.2): zdroj paywallu, režim, zkušební doba, plán, správa předplatného.
    // Text = popisek, technický klíč v title (L.html). Prázdná hodnota má vlastní vysvětlení.
    const fixedLab = (cs, en, raw) => lab(LANG === 'raw' ? raw : LANG === 'en' ? en : cs, raw, true);
    const srcLab = (s) => (!s ? fixedLab('Zdroj neznámý', 'Unknown source', '(prázdné)') : L.value('paywall_viewed', 'source', s));
    const modeLab = (m) => (!m ? fixedLab('Neuvedeno (starší verze)', 'Not given (older version)', '(prázdné)') : L.value('paywall_viewed', 'mode', m));
    const trialLab = (t) => (t === 1 || t === 0 ? L.value('purchase_started', 'trial', String(t)) : fixedLab('Neuvedeno (starší verze)', 'Not given (older version)', '(prázdné)'));
    const planLab = (p) => L.value('purchase_started', 'plan', p);
    /** Kód nebo důvod selhání: nejdřív jako kód RevenueCatu, jinak jako důvod. */
    const failLab = (name, x) => { const c = L.value(name, 'code', x); return c.known ? c : L.value(name, 'reason', x); };

    /** Sloupcový „výsledek“ (podíl ze základu); rows = [[popisek, počet, barva], …]. */
    function outcomePanel(title, hint, base, rows) {
      const html = rows.map(([l, v, c]) => {
        const pct = base ? Math.round((v / base) * 100) : 0;
        // Pod 10 pokusů procento vynechat (texty-3), šířka pruhu zůstává.
        const pctHtml = base >= SMALL_N ? ` <span class="pct">· ${pct}&nbsp;%</span>` : '';
        return `<div class="bar"><span class="lbl">${labelHtml(l)}</span><span class="val">${nf(v)}${pctHtml}</span><div class="track"><div class="fill" style="width:${Math.max(2, pct)}%;background:${c}"></div></div></div>`;
      }).join('');
      return `<div class="panel funnel"><h3>${esc(title)} <span class="hint">${esc(hint)}</span></h3>${html}</div>`;
    }

    /**
     * Výsledek pokusu o nákup = hlavní metrika konverze paywallu (ZADANI_ROBOTI_A_NAKUPY B2), bez obnovy.
     * purchase_cancelled / purchase_pending chodí od OTA build282 – starší pokusy bez výsledku
     * se počítají jako „bez záznamu“ (dřív se zrušení nelogovalo vůbec). Od vlny 1 zůstane bez
     * výsledku i klepnutí, které obchod odmítl jako už rozběhnutý nákup.
     */
    function purchaseOutcomePanel(m) {
      const n = (name) => m.purchases.filter((p) => p.name === name).length;
      const started = n('purchase_started');
      const rows = [
        ['dokončeno', n('purchase_completed'), 'var(--water)'],
        ['zrušeno uživatelem', n('purchase_cancelled'), 'var(--muted)'],
        ['čeká na platbu', n('purchase_pending'), '#e8c46a'],
        ['selhalo', n('purchase_failed'), '#ff8a8a'],
      ];
      const known = rows.reduce((a, r) => a + r[1], 0);
      rows.push(['bez záznamu (před verzí 282 nebo nákup už běžel)', Math.max(0, started - known), 'var(--apricot)']);
      return outcomePanel('Výsledek pokusu o nákup', `${started} ${pl(started, 'pokus', 'pokusy', 'pokusů')} o nákup, bez obnovy`, started, rows);
    }

    /** Obnova nákupů: vlastní záznamy obnovy + starší nákupní záznamy s produktem „obnova“. */
    function restoreOutcomePanel(m) {
      const n = (k) => m.restores.filter((r) => r.kind === k).length;
      const started = n('started');
      const rows = [
        ['obnoveno', n('completed'), 'var(--water)'],
        ['nebylo co obnovit', n('none'), 'var(--muted)'],
        ['selhalo', n('failed'), '#ff8a8a'],
      ];
      const known = rows.reduce((a, r) => a + r[1], 0);
      rows.push(['bez výsledku', Math.max(0, started - known), 'var(--apricot)']);
      const legacy = m.restores.filter((r) => r.kind === 'started' && r.legacy).length;
      return outcomePanel('Obnova nákupů', `${started} ${pl(started, 'pokus', 'pokusy', 'pokusů')} · z toho ${legacy} ze starších verzí`, started, rows);
    }

    /** Trychtýř paywall → nákup po zařízeních (bez obnovy, dvojí zobrazení sloučená). */
    function monetFunnel(m) {
      const set = (arr) => new Set(arr.map((x) => x.installId));
      return funnelFromSets('Paywall → nákup (zařízení)', [
        [H(L.html(L.event('paywall_viewed'))), set(m.views)],
        [H(L.html(L.event('purchase_started'))), set(m.purchases.filter((p) => p.name === 'purchase_started'))],
        [H(L.html(L.event('purchase_completed'))), set(m.purchases.filter((p) => p.name === 'purchase_completed'))],
      ], 'bez obnovy nákupů');
    }

    /**
     * Rozpad paywall → nákup podle jedné vlastnosti. Počty = různá zařízení (jako trychtýř).
     * viewKey = null → paywall vlastnost nezná (zkušební doba, plán): tabulka začíná pokusem o nákup.
     * Klíč undefined = událost do rozpadu nepatří (např. plán u nákupu plemene). label(k) vrací popisek (lab).
     */
    function convPanel(title, m, viewKey, buyKey, label, hint) {
      const add = (map, k, iid) => { let s = map.get(k); if (!s) map.set(k, s = new Set()); s.add(iid); };
      const seen = new Map(), viewsN = new Map(), started = new Map(), done = new Map();
      if (viewKey) m.views.forEach((v) => { const k = viewKey(v); if (k === undefined) return; add(seen, k, v.installId); viewsN.set(k, (viewsN.get(k) || 0) + 1); });
      m.purchases.forEach((p) => {
        const k = buyKey(p); if (k === undefined) return;
        if (p.name === 'purchase_started') add(started, k, p.installId);
        else if (p.name === 'purchase_completed') add(done, k, p.installId);
      });
      const sz = (map, k) => (map.get(k) || { size: 0 }).size;
      const keys = [...new Set([...seen.keys(), ...started.keys(), ...done.keys()])]
        .sort((a, b) => (viewKey ? sz(seen, b) - sz(seen, a) : 0) || sz(started, b) - sz(started, a) || sz(done, b) - sz(done, a));
      // Pod 10 zařízení jen „k z n“ bez procenta (texty-3, dohodnuté pravidlo malých čísel).
      const pct = (a, b) => (!b ? '–' : b < SMALL_N ? `${nf(a)}&nbsp;${zz(b)}` : Math.round((a / b) * 100) + '&nbsp;%');
      const head = viewKey
        ? '<tr><th></th><th class="n">zobrazení</th><th class="n">zařízení</th><th class="n">zahájili</th><th class="n">koupili</th><th class="n">konverze</th></tr>'
        : '<tr><th></th><th class="n">zahájili</th><th class="n">koupili</th><th class="n">úspěšnost</th></tr>';
      const rows = keys.map((k) => `<tr><td>${L.html(label(k))}</td>` + (viewKey
        ? `<td class="n">${viewsN.get(k) || 0}</td><td class="n">${sz(seen, k)}</td><td class="n">${sz(started, k)}</td><td class="n">${sz(done, k)}</td><td class="n">${pct(sz(done, k), sz(seen, k))}</td>`
        : `<td class="n">${sz(started, k)}</td><td class="n">${sz(done, k)}</td><td class="n">${pct(sz(done, k), sz(started, k))}</td>`) + '</tr>').join('');
      const h = hint ? ` <span class="hint">${esc(hint)}</span>` : '';
      // Tabulka se zobrazeními má 5 čísel → přes celou šířku mřížky, jinak by se v úzkém sloupci usekla.
      return `<div class="panel${viewKey ? ' wide' : ''}" style="overflow:auto"><h3>${esc(title)}${h}</h3>` +
        (rows ? `<table class="inst conv">${head}${rows}</table>` : '<p style="color:var(--muted)">Žádná data.</p>') + '</div>';
    }

    // --- Render (jen aktivní záložka kvůli výkonu) ---
    // Kořen záložky pro hlášku, když výpočet spadne (bezpecnost-3): jedna záložka neshodí ostatní ani načtení.
    const TAB_ROOT = new Map([['souhrn', 'dash-tiles'], ['ziskavani', 'acq-root'], ['cesta', 'jr-root'], ['nakupy', 'p-kpis'], ['technika', 't-checks']]);
    function render() {
      try { renderTab(); }
      catch (e) {
        console.warn('vykreslení záložky selhalo', e);
        const root = $(TAB_ROOT.get(activeTab) || 'dash-tiles');
        if (root) root.innerHTML = '<div class="wait">Tuto část se nepodařilo spočítat. Zkus Obnovit; když chyba trvá, data obsahují záznam, se kterým admin neumí pracovat.</div>';
      }
    }
    function renderTab() {
      if (activeTab === 'souhrn') { renderDashboard(); return; }
      if (activeTab === 'ziskavani') { renderAcquisition(); return; }
      if (activeTab === 'cesta') { renderJourney(); return; }
      // Filtry platí jen na Nákupech a Technice (lišta je jinde skrytá) → filtrovat jen tady.
      const ev = applyFilters(RAW);
      // Před načtením a po selhání ne „Zobrazeno 0 z 0 … jsou i starší“ (provoz3-2).
      $('count').textContent = !dataReady ? (LOAD_FAILED ? 'Záznamy se nepodařilo načíst' : 'Načítám záznamy…')
        : `Zobrazeno ${nf(ev.length)} ${zePrep(RAW.length)} ${nf(RAW.length)} záznamů · ${nf(batches)} ${pl(batches, 'dávka', 'dávky', 'dávek')}` +
        (exhausted ? ' (celá historie)' : ' (jsou i starší, Načíst starší v Technice)');
      if (activeTab === 'nakupy') renderPurchases(ev);
      else renderTech(ev);
    }

    // --- Nákupy (RevenueCat + párování se zařízením z analytiky) ---
    // MATCH_MS, productKey a pairPurchases jsou v jádru (stejné párování používá kontrola v Technice).
    // Mapy RevenueCatu zůstávají (SPEC D.2); čtou se jen přes Map (E.3).
    const PLAN_LABEL = new Map([['plan_monthly', 'Premium\u00a0– měsíčně'], ['plan_yearly', 'Premium\u00a0– ročně'], ['plan_lifetime', 'Premium\u00a0– navždy'], ['breed_bundle', 'Balíček plemen']]);
    /** Produkt česky (texty-25): plán Premium, jinak popisek z katalogu (nákup, plemeno), teprve pak složený z klíče. */
    const productLabel = (key) => {
      const k = String(key ?? '');
      if (PLAN_LABEL.has(k)) return PLAN_LABEL.get(k);
      const pv = L.value('purchase_completed', 'product', k);
      if (pv.known) return pv.text;
      if (k.startsWith('breed_')) {
        const b = L.value('breed_selected', 'premiumPick', k.slice(6));
        return 'Plemeno: ' + (b.known ? b.text : k.slice(6).split('_').map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(' '));
      }
      return k || '?';
    };
    const STORE_LABEL = new Map([['APP_STORE', 'App Store'], ['PLAY_STORE', 'Google Play'], ['MAC_APP_STORE', 'Mac App Store'], ['AMAZON', 'Amazon'], ['STRIPE', 'Stripe'], ['PROMOTIONAL', 'promo RevenueCat']]);
    const TYPE_LABEL = new Map([['INITIAL_PURCHASE', 'první nákup'], ['RENEWAL', 'obnova'], ['NON_RENEWING_PURCHASE', 'jednorázový'], ['PRODUCT_CHANGE', 'změna tarifu'], ['CANCELLATION', 'zrušení'], ['EXPIRATION', 'vypršení'], ['BILLING_ISSUE', 'problém s platbou'], ['SUBSCRIPTION_EXTENDED', 'prodloužení'], ['UNCANCELLATION', 'obnovené předplatné'], ['TRANSFER', 'převod'], ['SUBSCRIPTION_PAUSED', 'pozastavení'], ['TEST', 'test webhooku']]);
    const storeLabel = (s) => STORE_LABEL.get(s) || String(s || '?');
    const typeLabel = (t) => TYPE_LABEL.get(t) || String(t || '');
    // Důvod zrušení nebo vypršení z RevenueCatu česky (texty-25, uplnost-4); kód zůstává v title.
    const REASON_LABEL = new Map([['UNSUBSCRIBE', 'zákazník zrušil'], ['BILLING_ERROR', 'problém s platbou'], ['CUSTOMER_SUPPORT', 'vráceno přes podporu obchodu'],
      ['PRICE_INCREASE', 'nesouhlas se zdražením'], ['DEVELOPER_INITIATED', 'zrušeno z naší strany'], ['SUBSCRIPTION_PAUSED', 'pozastaveno'], ['UNKNOWN', 'důvod neuveden']]);
    const reasonHtml = (r) => { const rk = r.cancelReason || r.expirationReason; return !rk ? 'bez důvodu' : `<span title="Technický název: ${esc(rk)}">${esc(REASON_LABEL.get(String(rk)) || 'jiný důvod')}</span>`; };
    /** Částka v měně nákupu jako bezpečné HTML (E.2: i náhradní text přes esc). */
    const money = (v, cur) => { if (v === null || v === undefined || !cur) return '–'; try { return esc(new Intl.NumberFormat('cs-CZ', { style: 'currency', currency: cur }).format(v)); } catch { return esc(v + ' ' + cur); } };
    // Částka v USD česky („9,63 US$“), ne v anglickém formátu (texty-25).
    const USD_FMT = new Intl.NumberFormat('cs-CZ', { style: 'currency', currency: 'USD' });
    const usd = (v) => (v === null || v === undefined || !Number.isFinite(Number(v))) ? '' : USD_FMT.format(Number(v));
    /** Jazyk a země jako popisek přes Intl.DisplayNames, kód v title (D.4). */
    const langHtml = (c) => (!c || c === 'none' || c === 'unknown' ? '–' : L.html(L.lang(c)));
    const regionHtml = (c) => (!c || c === 'none' ? '–' : L.html(L.region(c)));
    let purchaseCoverage = false;
    let purchaseCovering = false; // dočítání analytiky kvůli zařízením k nákupům právě běží (provoz-7)
    // … a selhalo nebo narazilo na zarážku 40 stránek (provoz2-3): false, jinak čas, do kterého je potřeba načíst.
    // Párování je neúplné, dokud pozdější čtení (Načíst starší / vše) ten čas nepokryje.
    let purchaseCoverFailed = false;
    const purchaseShort = () => purchaseCoverFailed !== false && !exhausted && cursorTs() > purchaseCoverFailed;

    function purchaseRows() {
      // Obnova (starší verze: purchase_completed s product 'restore') není nákup → nepáruje se (pairPurchases v jádru).
      const { rows, app, used } = pairPurchases(RC_EVENTS, RAW);
      // Obnova předplatného: zařízení z prvního nákupu téhož zákazníka (hash, ne ID).
      const firstByCustomer = new Map();
      [...rows].sort((a, b) => a.ts - b.ts).forEach((x) => { if (x.app && x.rc.customer && !firstByCustomer.has(x.rc.customer)) firstByCustomer.set(x.rc.customer, x.app); });
      rows.forEach((x) => { if (!x.app && x.rc.customer && firstByCustomer.has(x.rc.customer)) { x.app = firstByCustomer.get(x.rc.customer); x.inherited = true; } });
      app.filter((e) => !used.has(e)).forEach((e) => rows.push({ rc: null, app: e, ts: e.ts, key: productKey(e.props.product), inherited: false }));
      const refunded = new Set(RC_EVENTS.filter((r) => r.type === 'CANCELLATION' && r.cancelReason === 'CUSTOMER_SUPPORT').map((r) => r.transactionId).filter(Boolean));
      rows.forEach((x) => {
        x.refunded = !!(x.rc && x.rc.transactionId && refunded.has(x.rc.transactionId));
        x.sandbox = !!(x.rc && String(x.rc.environment || '').toUpperCase() === 'SANDBOX');
        // Automatická klasifikace spárovaného zařízení: pravidla nad evidencí, mimo evidenci kontext zařízení z dávky.
        x.autoCls = x.app ? (CLS_BY_ID.get(x.app.installId) || (isExcluded(x.app.installId, x.app.dev) ? 'tester' : 'real')) : 'real';
        // R9 (rozhodnutí zakladatele 20. 11., bezpecnost2-2): skutečný nákup z RevenueCatu skryje jen sandbox (výše) nebo
        // ruční označení spárovaného zařízení v tester_installs. Zápis do anonymní analytiky ani automatická klasifikace
        // ho neskryjí (podvržené dávky by jinak „ukradly“ párování a schovaly skutečné peníze), jen ho označí štítkem.
        // Řádky jen z aplikace (bez RevenueCatu) se klasifikují jako dřív.
        x.cls = x.rc ? (x.app && OVERRIDES.has(x.app.installId) ? classifyInstall({}, OVERRIDES.get(x.app.installId)).kind : 'real') : x.autoCls;
        // Sandbox a vrácený nákup se nepočítají, takže „počítá se“ by u nich lhalo (texty4-3).
        x.autoTester = !!(x.rc && !x.sandbox && !x.refunded && x.cls === 'real' && x.autoCls !== 'real');
      });
      return rows.sort((a, b) => b.ts - a.ts);
    }

    /** Zařízení ke starším nákupům: dočti analytiku, dokud nepokryje nejstarší nákup (nejvýš 40 stránek,
     *  společný zámek s ostatním dočítáním). */
    async function ensurePurchaseCoverage() {
      // Až po prvním načtení (provoz-1): jinak by se dočítání zařadilo před první stránku a po chybě četlo znovu.
      if (!dataReady || purchaseCoverage) return; purchaseCoverage = true;
      let oldest = Infinity;
      for (const r of RC_EVENTS) if (r.isPurchase) { const t = Number(r.purchasedAtMs); if (Number.isFinite(t) && t < oldest) oldest = t; }
      if (!Number.isFinite(oldest)) return;
      // Podle kurzoru, ne podle času událostí (bezpecnost-4): všechny nenačtené dávky mají lastTs ≤ kurzor, takže
      // jediná událost s ts = 1 (vynulované hodiny telefonu) už dočítání nezastaví.
      if (exhausted || cursorTs() <= oldest - MATCH_MS) return;
      purchaseCovering = true; // renderPurchases, který ensurePurchaseCoverage volá, ho hned ukáže
      try { if (!(await ensureCoverageWhile(() => cursorTs() > oldest - MATCH_MS, 40))) purchaseCoverFailed = oldest - MATCH_MS; }
      catch (e) { purchaseCoverFailed = oldest - MATCH_MS; console.warn('dočtení analytiky k nákupům selhalo', e); }
      finally { purchaseCovering = false; buildFilterOptions(); render(); }
    }

    function renderPurchases(ev) {
      ensurePurchaseCoverage();
      // Paywall → nákup a obnova jsou z analytiky: před načtením a po selhání hláška, ne nuly (provoz3-2).
      if (!dataReady) {
        $('m-sub').textContent = '';
        $('m-panels').innerHTML = `<div class="wait">${LOAD_FAILED ? 'Data se nepodařilo načíst. Zkus Obnovit na Souhrnu.' : 'Načítám…'}</div>`;
        $('m-restore').innerHTML = '';
      } else renderMonetization(ev);
      const range = filterRange();
      const allRows = purchaseRows();
      // Bez záznamu v RevenueCatu = nákup mimo obchod (TestFlight, interní testování Play) → jako tester.
      // Skryté a testovací jen z období filtru (cisla3-3): nákupy mimo období nejsou skryté jako testovací.
      const inP = allRows.filter((x) => inRange(x.ts, range));
      const rows = inP.filter((x) => FILTERS.testers || (x.rc && !x.sandbox && x.cls === 'real'));
      const hidden = inP.length - rows.length;
      const paid = rows.filter((x) => x.rc && !x.refunded && (x.rc.priceLocal || 0) > 0);
      const trials = rows.filter((x) => x.rc && String(x.rc.periodType || '') === 'TRIAL');
      const byCur = new Map(); paid.forEach((x) => byCur.set(x.rc.currency, (byCur.get(x.rc.currency) || 0) + x.rc.priceLocal));
      const sum = (f) => paid.reduce((a, x) => a + (Number(f(x)) || 0), 0);
      // k(): popisek i podtext jsou konstanty nebo už escapované (E.2); hodnota se escapuje tady.
      const k = (label, v, sub) => `<div class="card"><div class="kpi">${esc(typeof v === 'number' ? nf(v) : v)}<small>${esc(label)}${sub ? ' · ' + sub : ''}</small></div></div>`;
      const rcN = RC_EVENTS.filter((r) => r.isPurchase).length;
      // Nákupy z RevenueCatu ze zařízení, které automatika bere jako testovací: počítají se, jen se přiznají (R9).
      const autoRows = rows.filter((x) => x.autoTester), nAuto = autoRows.length, nAutoDev = new Set(autoRows.map((x) => x.app.installId)).size;
      const autoNote = nAuto ? ` · ${nf(nAuto)} ${pl(nAuto, 'nákup', 'nákupy', 'nákupů')} ze ${nAutoDev === 1 ? 'zařízení, které vypadá' : 'zařízení, která vypadají'} jako testovací (${pl(nAuto, 'počítá', 'počítají', 'počítá')} se; ověř zařízení v Technice)` : '';
      // Během dočítání analytiky k nákupům nejsou zařízení spárovaná: testovací a skryté nákupy by byly špatně (provoz-7).
      const pending = purchaseCovering || !dataReady;
      $('p-sub').textContent = !dataReady ? (LOAD_FAILED ? '· načtení selhalo, zkus Obnovit na Souhrnu' : '· Načítám…')
        : LOAD_ERR.has('rc') ? '· nákupy z RevenueCatu se nepodařilo načíst, zkus Obnovit'
        : LOAD_ERR.has('installs') ? `· ${rcN} ${pl(rcN, 'nákup', 'nákupy', 'nákupů')} v RevenueCatu · evidenci zařízení se nepodařilo načíst, testery teď nejde skrýt`
        : `· ${rcN} ${pl(rcN, 'nákup', 'nákupy', 'nákupů')} v RevenueCatu` + (purchaseCovering ? ' · dočítám starší analytiku kvůli zařízení…'
          : purchaseShort() ? ' · starší analytiku k nákupům se nepodařilo dočíst, párování zařízení je neúplné, zkus Obnovit'
          : (hidden ? ` · skryto ${nf(hidden)} (testovací nebo testeři)` : '') + autoNote);
      // Před načtením, po selhání a bez rc_events by karty ukázaly nuly, věčné „Načítám…“ nebo „zařízení
      // nespárováno“ (provoz2-1, provoz2-4): místo čísel jen hláška.
      if (!dataReady || LOAD_ERR.has('rc')) {
        const msg = !dataReady ? (LOAD_FAILED ? 'Data se nepodařilo načíst. Zkus Obnovit na Souhrnu.' : 'Načítám…') : 'Nákupy z RevenueCatu se nepodařilo načíst, čísla by nebyla pravdivá. Zkus Obnovit na Souhrnu.';
        $('p-kpis').innerHTML = `<div class="wait">${msg}</div>`;
        $('p-table').innerHTML = ''; $('p-panels').innerHTML = ''; $('p-other').innerHTML = '';
        return;
      }
      const nTest = inP.filter((x) => !x.rc || x.sandbox).length;
      $('p-kpis').innerHTML = [
        k(pl(paid.length, 'placený nákup', 'placené nákupy', 'placených nákupů'), paid.length, `plemena ${paid.filter((x) => x.key.startsWith('breed_')).length} · Premium ${paid.filter((x) => x.key.startsWith('plan_')).length}`),
        k('tržba hrubě (s DPH)', usd(sum((x) => x.rc.priceUsd)) || usd(0), [...byCur.entries()].map(([c, v]) => money(v, c)).join(' + ') || '–'),
        k('výnos po DPH a provizi', usd(sum((x) => x.rc.proceedsUsd)) || usd(0), 'odhad RevenueCatu'),
        k(pl(trials.length, 'zkušební období', 'zkušební období', 'zkušebních období'), trials.length, 'Premium zdarma, 0 Kč'),
        pending ? k('testovací nákupy', 'Načítám…', 'zařízení se ještě párují')
          : purchaseShort() ? k('testovací nákupy', 'neúplné', 'starší analytiku se nepodařilo dočíst')
          : k(pl(nTest, 'testovací nákup', 'testovací nákupy', 'testovacích nákupů'), nTest, FILTERS.testers ? 'v tabulce' : 'skryté, zaškrtávátko „včetně testerů a robotů“ je ukáže'),
      ].join('');
      const tag = (t, cls) => `<span class="tag ${cls || ''}">${esc(t)}</span>`;
      const head = '<tr><th>Čas</th><th>Co koupil</th><th>Částka</th><th>Výnos</th><th>Obchod</th><th>Země</th><th>Zařízení</th><th>Jazyk aplikace</th><th>Jazyk telefonu</th><th>Verze</th><th>Druh</th><th>Pozn.</th></tr>';
      const body = rows.map((x) => {
        const r = x.rc, d = x.app ? x.app.dev : null;
        const notes = [
          !r ? tag('jen z aplikace', 'auto') : '',
          r && !x.app ? tag('zařízení nespárováno') : '',
          x.inherited ? tag('zařízení z 1. nákupu') : '',
          x.refunded ? tag('vráceno', 'manual') : '',
          x.sandbox ? tag('sandbox', 'auto') : '',
          x.cls !== 'real' ? tag(x.cls, 'manual') : '',
          // R9: automaticky testovací zařízení nákup z RevenueCatu neskryje, jen označí (bezpecnost2-2).
          x.autoTester ? `<span class="tag auto" title="Automatická klasifikace zařízení: ${esc(clsKindText(x.autoCls))}. Nákup se počítá; skryje ho jen ruční označení zařízení v Technice (evidence zařízení) nebo sandbox.">zařízení vypadá jako testovací, ověř ho</span>` : '',
        ].join(' ');
        const what = esc(productLabel(x.key)) + (r && r.periodType === 'TRIAL' ? ' · zkušební období' : '');
        const amount = r ? money(r.priceLocal, r.currency) + (r.priceUsd !== null && r.priceUsd !== undefined ? ` <span style="color:var(--muted)">(${esc(usd(r.priceUsd))})</span>` : '') : '–';
        // `os` u starších verzí Androidu nese celý otisk sestavení → platforma + verze.
        const device = d ? esc((d.model || '?') + ' · ' + (d.platform === 'ios' ? 'iOS' : d.platform === 'android' ? 'Android' : (d.platform || '')) + ' ' + (d.osVersion || '')) : '–';
        const country = (r && r.countryCode) || (d && d.region !== 'none' && d.region) || '';
        return `<tr class="${x.cls !== 'real' || x.sandbox ? 'tester' : ''}"><td>${esc(fmt(x.ts))}</td><td><span title="Technický název: ${esc(x.key)}">${what}</span></td><td>${amount}</td><td>${r ? esc(usd(r.proceedsUsd) || '–') : '–'}</td>` +
          `<td>${esc(r ? storeLabel(r.store) : (d && d.platform === 'ios' ? 'App Store?' : d ? 'Google Play?' : '?'))}</td><td>${regionHtml(country)}</td>` +
          `<td>${device}</td><td>${d ? langHtml(d.locale) : '–'}</td><td>${d ? langHtml(d.deviceLocale) : '–'}</td><td>${esc(d && d.appBuild != null ? d.appBuild : '–')}</td>` +
          `<td>${r ? esc(typeLabel(r.type)) : L.html(L.event('purchase_completed'))}</td><td>${notes}</td></tr>`;
      }).join('');
      $('p-table').innerHTML = head + (body || '<tr><td colspan="12" style="color:var(--muted)">Žádné nákupy (nebo jsou skryté filtrem).</td></tr>');
      const matched = paid.filter((x) => x.app);
      const labelled = (pairs, labOf) => pairs.map(([kk, v]) => [H(L.html(labOf(kk))), v]);
      $('p-panels').innerHTML = [
        barPanel('Placené nákupy podle produktu', countBy(paid, (x) => productLabel(x.key)), 'var(--apricot)', 12),
        barPanel('Podle obchodu', countBy(paid, (x) => storeLabel(x.rc.store)), 'var(--water)', 4),
        barPanel('Podle země', labelled(countBy(paid, (x) => x.rc.countryCode || '_none'), (c) => L.region(c)), 'var(--water)', 12, 'země účtu v obchodě'),
        barPanel('Podle jazyka aplikace', labelled(countBy(matched, (x) => x.app.dev.locale || '_none'), (c) => L.lang(c)), 'var(--water)', 12, 'spárováno se zařízením: ' + matched.length),
        barPanel('Podle zařízení', countBy(matched, (x) => dataKey(x.app.dev.model) ?? '?'), 'var(--apricot)', 12),
      ].join('');
      const other = RC_EVENTS.filter((r) => !r.isPurchase && r.type !== 'TEST' && (FILTERS.testers || String(r.environment || '').toUpperCase() !== 'SANDBOX')).sort((a, b) => (b.eventAtMs || 0) - (a.eventAtMs || 0));
      $('p-other').innerHTML = '<tr><th>Čas</th><th>Událost</th><th>Produkt</th><th>Důvod</th><th>Obchod</th><th>Země</th></tr>' + (other.map((r) => `<tr><td>${esc(fmt(r.eventAtMs || r.purchasedAtMs))}</td><td>${esc(typeLabel(r.type))}</td><td>${esc(productLabel(productKey(r.productId)))}</td><td>${reasonHtml(r)}</td><td>${esc(storeLabel(r.store))}</td><td>${regionHtml(r.countryCode)}</td></tr>`).join('') || '<tr><td colspan="6" style="color:var(--muted)">Žádné.</td></tr>');
    }

    /** Nákupy → „Paywall → nákup“: analytika aplikace (respektuje všechny filtry nahoře). */
    function renderMonetization(ev) {
      if (!$('m-panels')) return;
      const m = monetization(ev);
      const inferred = m.purchases.filter((p) => p.inferred).length;
      // Dokončený nákup bez protějšku v RevenueCatu do 10 min = stejné párování jako Souhrn a T3, pravděpodobně
      // testovací (cisla3-2). Z čísel níž ho neodebíráme (o testerech rozhoduje zakladatel), jen ho přiznáme.
      const rcUsed = !dataReady || LOAD_ERR.has('rc') ? null : pairPurchases(RC_EVENTS, RAW).used;
      const noRc = rcUsed ? new Set(ev.filter((e) => e.name === 'purchase_completed' && !isLegacyRestore(e) && !rcUsed.has(e)).map((e) => e.installId)) : new Set();
      $('m-sub').textContent = `· ${m.views.length} ${pl(m.views.length, 'zobrazení', 'zobrazení', 'zobrazení')} paywallu` + (m.merged ? ` (${m.merged} ${pl(m.merged, 'dvojice sloučena', 'dvojice sloučeny', 'dvojic sloučeno')})` : '') +
        ` · ${m.purchases.length} ${pl(m.purchases.length, 'záznam', 'záznamy', 'záznamů')} o nákupu` + (inferred ? ` (${inferred} se zdrojem z paywallu)` : '') +
        (noRc.size ? ` · dokončený nákup bez záznamu v RevenueCatu: ${nf(noRc.size)} ${pl(noRc.size, 'zařízení', 'zařízení', 'zařízení')} (pravděpodobně ${pl(noRc.size, 'testovací nákup', 'testovací nákupy', 'testovací nákupy')}, čísla níž ${pl(noRc.size, 'ho', 'je', 'je')} zahrnují; ověř v Technice)` : '') +
        (LOAD_ERR.has('installs') && !FILTERS.testers ? ' · evidenci zařízení se nepodařilo načíst, testery teď nejde skrýt' : '');
      const planOf = (p) => p.plan || undefined; // jen Premium plán, plemena do rozpadu nepatří
      $('m-panels').innerHTML = [
        monetFunnel(m),
        purchaseOutcomePanel(m),
        convPanel('Podle zdroje paywallu', m, (v) => v.props.source || null, (p) => p.source, srcLab, 'odkud člověk na paywall přišel'),
        convPanel('Podle režimu', m, (v) => v.props.mode || null, (p) => p.mode, modeLab, 'v jakém režimu byl paywall'),
        convPanel('Podle zkušební doby', m, null, (p) => p.trial, trialLab, 'zkušební doba u vybraného plánu, od 16. 11. 2026'),
        convPanel('Podle plánu Premium', m, null, planOf, planLab, 'jen Premium, bez plemen'),
      ].join('');
      const failed = m.restores.filter((r) => r.kind === 'failed');
      const manage = new Map();
      for (const e of m.manage) addCount(manage, valKey(e.props.source) + '\u0000' + valKey(e.props.via));
      $('m-restore').innerHTML = [
        restoreOutcomePanel(m),
        barPanel('Obnova nákupů: odkud', countBy(m.restores.filter((r) => r.kind === 'started'), (r) => r.legacy ? '\u0000legacy' : (r.source || '_none'))
          .map(([kk, v]) => [kk === '\u0000legacy' ? 'Starší verze (zdroj neposílá)' : H(L.html(srcLab(kk === '_none' ? null : kk))), v]), 'var(--water)', 10),
        failed.length ? barPanel('Obnova nákupů: proč selhala', countBy(failed, (r) => r.reason || '?').map(([kk, v]) => [H(L.html(failLab('restore_failed', kk))), v]), '#ff8a8a', 8, 'kód nebo důvod z RevenueCatu') : '',
        barPanel('Spravovat předplatné', breakdown(manage).map(([kk, v]) => {
          const [src, via] = kk.split('\u0000');
          return [H(L.html(L.value('subscription_manage_opened', 'source', src)) + ' · ' + L.html(L.value('subscription_manage_opened', 'via', via))), v];
        }), 'var(--apricot)', 8, `${m.manage.length}× otevřeno (od 16. 11. 2026)`),
      ].join('');
    }

    // --- Technika (SPEC C.3): nahoře kontrola dat z jádra (pevně 7 a 30 dní), pod ní panely podle filtrů ---
    const INSTALL_KIND_LABEL = new Map([['app_store', 'App Store'], ['device', 'z obchodu (Android)'], ['unknown', 'neznámý (verze před 281)'],
      ['emulator', 'emulátor'], ['test_lab', 'Test Lab Google'], ['simulator', 'simulátor'], ['development', 'vývojová verze'], ['expo_go', 'Expo Go'],
      ['ad_hoc', 'ad hoc'], ['enterprise', 'firemní distribuce']]);
    // Klasifikace a pravidla [cs, en] podle přepínače popisků; v režimu Technické názvy id pravidla (cisla-9).
    const CLS_KIND_LABEL = new Map([['real', ['skutečné', 'real']], ['tester', ['tester', 'tester']], ['robot', ['robot', 'robot']]]);
    const CLS_RULE_LABEL = new Map([['kind', ['podle druhu instalace', 'by install kind']], ['sdk_gphone', ['emulátor Google', 'Google emulator']],
      ['oneplus8pro_android11_short', ['OnePlus 8 Pro, Android 11, krátká aktivita', 'OnePlus 8 Pro, Android 11, short activity']],
      ['ios_simulator_model', ['simulátor iPhonu', 'iPhone simulator']], ['apple_review_model', ['kontrolní zařízení Applu (iPhone99)', 'Apple review device (iPhone99)']]]);
    /** Popisek pravidla klasifikace podle přepínače (D.3); neznámé pravidlo = jeho id. */
    const clsRuleText = (rule) => { const r = String(rule ?? ''); const m = CLS_RULE_LABEL.get(r); return LANG === 'raw' || !m ? r : pickLang(m, r, LANG); };
    const clsKindText = (kind) => { const k = String(kind ?? ''); const m = CLS_KIND_LABEL.get(k); return LANG === 'raw' || !m ? k : pickLang(m, k, LANG); };
    const known = (m, v, raw) => { const k = valKey(v), r = raw === undefined || raw === null ? k : valKey(raw); return m.has(k) ? lab(LANG === 'raw' ? r : m.get(k), r, true) : lab(`${k} (bez překladu)`, r, false); };
    const REVIEW_REASON = new Map([['testerModel', 'stejný model jako označený tester'], ['purchaseNoRc', 'nákup bez záznamu v RevenueCatu']]);
    const ACTION_STATE = new Map([['live', 'živá'], ['auto', 'automaticky'], ['noData', 'zatím bez dat'], ['none30', 'za 30 dní nic'], ['removed', 'už se neposílá'], ['testers', 'jen testeři'], ['unknown', 'bez popisku']]);
    const VERSION_MARK_LABEL = new Map([[335, 'Připomínky péče'], [337, 'Akce v plánu, deník a váha (Pes doma)'], [338, 'Procházky Psa doma'],
      [342, 'Vstupy do aplikace'], [344, 'Test první péče'], [352, 'Zdroj instalace (jen Android)']]);
    const fullDate = (iso) => (isIsoDay(iso) ? `${Number(iso.slice(8, 10))}. ${Number(iso.slice(5, 7))}. ${iso.slice(0, 4)}` : '–');
    const pct1 = (k, n) => (n > 0 ? nf((100 * k) / n, 1) + '&nbsp;%' : '–');
    const okPill = (state) => verdictPill(state === 'warn' ? 'Pozor' : 'V pořádku');

    function renderTechChecks() {
      const root = $('t-checks');
      const st = tabCover();
      const T = dataReady ? coreResult('tech') : null;
      // T1 Načtená data (vždy, i během dočítání). Zdvojené = všechny načtené záznamy (i testerů), z toho skutečná
      // zařízení zvlášť, ať jdou čísla spárovat s T3 a T6 (cisla-8).
      if (T) {
        const LD = T.loaded, recs = num(LD.records) ?? 0, dups = num(LD.dups) ?? 0, b = num(LD.batches);
