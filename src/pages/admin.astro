    }

    // ── Deduplikace (R3): installId + název + ts + vlastnosti se seřazenými klíči. Stejný čas s jinými
    //    vlastnostmi zůstává (dohánění dnů, víc odznaků naráz). Používá fetchPage i setData.
    function stableJson(v, seen = new WeakSet(), depth = 0) {
      if (typeof v === 'bigint') return JSON.stringify(String(v));
      if (v === null || typeof v !== 'object') { const s = JSON.stringify(v); return s === undefined ? 'null' : s; }
      // Pojistka (bezpecnost-2): cyklus nebo hluboké zanoření (cizí třídy z databáze) nesmí shodit načtení.
      if (seen.has(v) || depth > 40) return '"(cyklus)"';
