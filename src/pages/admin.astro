        : 'Majitelé zatím nic neotevřeli.';
      const b3 = card({
        q: 'Co dělají majitelé v Psovi doma?', verdict: V.b3, sentence: sB3,
        body: `<table class="qt"><thead><tr><th>Místo</th><th class="n">Otevřeli (${zz(OW.base)})</th><th class="n">Aspoň 2 různé dny</th><th>Udělali</th></tr></thead><tbody>${rows3}</tbody></table>` +
          '<p class="muted">Detail psa a úpravu údajů nepočítáme: projde jimi každý při založení psa.</p>',
        how: 'Otevřeli = obrazovka se aspoň jednou ukázala, ještě to neznamená, že tam něco udělali. Udělali = akce, kterou aplikace posílá jen od určité verze, proto má vlastní základ ‚měřitelné u X z Y‘. Detail psa a úpravu údajů nepočítáme: projde jimi každý při založení psa. Jeden telefon = jeden majitel i s víc psy.',
        foot: 'Majitelé aktivní za 30 dní · obrazovky od 23. 10. 2026, akce od 15. 11. 2026 · bez testerů a robotů',
