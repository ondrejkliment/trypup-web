      if (fc.length) rows2 += `<tr><td colspan="3"><span class="sublbl">↳ potom: ${fc.map(([k, v]) => `${lvLc('fail_state_choice', 'choice', k)}&nbsp;<b>${nf(v)}</b>`).join(' · ')}</span></td></tr>`;
      const t1 = MAIN2[0], t2 = MAIN2[1];
