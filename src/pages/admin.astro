          `zdvojené záznamy vyřazeny: ${nf(dups)}&nbsp;${zz(recs)} (${pct1(dups, recs)}), z toho skutečná zařízení ${nf(T.dupsAllReal)} · ${LD.complete ? 'celá historie' : 'jsou i starší'}`;
      } else $('t-loaded').textContent = LOAD_FAILED ? 'Načtení selhalo, zkus Obnovit na Souhrnu.' : 'Načítám…';
