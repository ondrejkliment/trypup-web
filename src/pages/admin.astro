      }
      const va = abGroups.has('a') ? getKey(variants, 'a') : null, vb = abGroups.has('b') ? getKey(variants, 'b') : null;
      const a5 = va && vb && va.d1.n >= R.SURE_N && vb.d1.n >= R.SURE_N ? compareGroups(va.d1, vb.d1).verdict : 'Málo dat';

      // B1 režimy aktivních za 30 dní.
      const active = real.filter((d) => inWin(d.lastMs, w30, now));
      const mTrial = active.filter((d) => d.mode.trial), mOwner = active.filter((d) => d.mode.owner);
      const tdTrial = twoDaysOf(mTrial, (d) => d.mode.trial, matureAt), tdOwner = twoDaysOf(mOwner, (d) => d.mode.owner, matureAt);
      const b1c = compareGroups(tdTrial, tdOwner);

      // B2 Pes na zkoušku: řádky v období, „aspoň 2 různé dny“ podle R6.
      const in30 = (d, pred) => scanDev(d, w30, now, pred);
      const notOwner = (p) => p.mode !== 'owner';
      const TRIAL_ROWS = [
        ['care', (e) => e.name === 'task_done', true],
        ['training', (e) => e.name === 'training_done', true],
