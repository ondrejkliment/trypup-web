          if (c.note === 'nothingExtra') return `${nm}: nad běžný stav nepřibylo nic (${nf(c.new)} nových za ${dayN(c.days)}, útrata ${eur(c.spendEur)}).`;
          return `${nm}: ${nf(c.above, 1)} zařízení nad běžný stav za ${eur(c.spendEur)} = ${eur(c.cost)} za zařízení${c.tight ? ' (těsně)' : ''}. Hranice je 5&nbsp;€ (aspoň 12 zařízení za 60&nbsp;€).`;
        };
