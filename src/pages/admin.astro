    /** „Kdy bude jasno“ (C.0): základ ≥ cíl (30, u „Málo dat“ 10) → null; měření mladší než 7 dní + zralost
     *  (o.since = pražský den začátku měření, o.lag = dny do zralosti, např. 2 u D1) → 'young': tempo za necelý
     *  týden by datum posunulo o měsíce (cisla-2); nic nepřibylo → neznámé; jinak den, kdy základ dosáhne cíle. */
    function whenClear(base, added, today, o = CORE_EMPTY) {
