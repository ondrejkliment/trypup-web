        const vd1 = d1Of(idx, list);
        setKey(variants, v, { assigned: list.length, d1: vd1,
          tapped: list.filter((d) => scanDev(d, -Infinity, Infinity, (e, p) => e.name === 'home_banner' && p.kind === 'first_care' && p.action === 'tap').n > 0).length,
