        for (const c of list) if (!newest || String(c.from) >= String(newest.from)) newest = c;
        s3 = newest ? campSent(newest) + (list.length > 1 ? ' Ostatní kampaně jsou v tabulce.' : '') : 'Zápis kampaní je prázdný.';
        for (const c of list) z0Camp.push([c.verdict, campSent(c)]);
        if (!list.length) z0Camp.push(['Chybí útrata', 'Zápis kampaní je prázdný, cenu za zařízení spočítat nejde.']);
        const toTxt = (c) => (isIsoDay(c.to) ? esc(dayLabel(c.to)) : 'běží');
        z3Body = list.length ? '<table class="qt"><thead><tr><th>Kampaň</th><th>Dny</th><th class="n">Nová</th><th class="n">Běžný stav za den</th><th class="n">Nad běžný stav</th><th class="n">Útrata</th><th class="n">Cena za zařízení</th><th>Verdikt</th></tr></thead><tbody>' +
          list.map((c) => `<tr><td>${cName(c)} <span class="muted">${esc(NETWORK_LABEL.get(c.network) || String(c.network ?? ''))} · ${esc(PLATFORM_LABEL.get(c.platform) || '')}</span></td>` +
            `<td data-label="Dny">${isIsoDay(c.from) ? esc(dayLabel(c.from)) : ''}–${toTxt(c)} <span class="muted">(${dayN(c.days)})</span></td>` +
            `<td data-label="Nová" class="n">${nf(c.new)}</td>` +
            `<td data-label="Běžný stav za den" class="n">${c.baseline && !c.baseline.state ? nf(c.baseline.perDay, 1) : 'nelze určit'}</td>` +
            `<td data-label="Nad běžný stav" class="n">${num(c.above) === null ? 'nelze určit' : nf(c.above, 1)}</td>` +
            `<td data-label="Útrata" class="n">${eur(c.spendEur)}</td>` +
            `<td data-label="Cena za zařízení" class="n">${num(c.cost) === null ? 'nelze spočítat' : eur(c.cost)}</td>` +
            `<td data-label="Verdikt">${verdictPill(c.verdict)}${c.tight ? ' <span class="muted">těsně</span>' : ''}${c.note === 'nothingExtra' ? ' <span class="muted">nic navíc</span>' : ''}</td></tr>`).join('') +
          '</tbody></table>' +
          joint.map((j) => `<p>Společně (${(Array.isArray(j.ids) ? j.ids : []).map((x) => esc(x)).join(', ')}): ${eur(j.spendEur)} / ${num(j.above) === null ? 'nelze určit' : nf(j.above, 1)} zařízení = ${num(j.cost) === null ? 'nelze spočítat' : eur(j.cost)}</p>`).join('')
          : '<p>Zápis kampaní je prázdný.</p>';
        const upd = newest && isIsoDay(newest.spendAt) ? newest.spendAt : typeof CP.updatedAt === 'string' ? CP.updatedAt.slice(0, 10) : '';
        if (isIsoDay(upd)) z3Upd = ` (aktualizováno ${esc(dayLabel(upd))})`;
      }
      const z3 = card({
        q: 'Vyplatí se placené kampaně?', verdict: A.verdicts.z3, sentence: s3, body: z3Body,
        how: 'Nepočítáme kliknutí ani ‚konverze‘ reklamních systémů, ty hlásí víc, protože počítají i stažení bez otevření. Od nových zařízení ve dnech kampaně odečteme, kolik jich přichází v běžný den bez kampaně. Když běží dvě kampaně na stejném telefonu ve stejné dny, umíme jen společnou cenu.',
        foot: `Útrata ze zápisu kampaní${z3Upd} · nová zařízení z našeho měření · Vyplatí se do 5&nbsp;€ za zařízení nad běžný stav (dohodnuto)`,
      });

      // Z4 Jsou lidé z kampaní a kanálů stejně dobří jako ostatní?
      const Q = A.quality, qa = Q.all, comps = Array.isArray(Q.comparisons) ? Q.comparisons : [];
      const QCOLS = [['active10', 'Aktivní aspoň 10 min'], ['otherDay', 'Vrátili se jiný den'], ['d1', 'D1'], ['dog', 'Psa založili']];
      const qRow = (labelHtml, r, sub) => (r ? `<tr><td>${sub ? `<span class="sublbl">${labelHtml}</span>` : labelHtml} <span class="muted">(${nf(r.n)})</span></td>` +
        QCOLS.map(([k, l]) => `<td data-label="${l}" class="n">${k === 'd1' ? kzn(r.d1) : kpct(r[k])}</td>`).join('') + '</tr>' : '');
      const groupHtml = (g, cs) => {
