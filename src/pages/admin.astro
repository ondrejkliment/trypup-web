    <!-- TAB: NÁKUPY -->
    <div id="tab-nakupy" class="tabpane hidden">
      <h2>Nákupy <span id="p-sub" class="h2-hint"></span></h2>
      <div class="cards" id="p-kpis"></div>
      <div class="panel" style="overflow:auto;margin-top:12px"><table class="inst" id="p-table"></table></div>
      <div class="grid2" id="p-panels" style="margin-top:12px"></div>
      <h2>Ostatní události předplatného</h2>
      <div class="panel" style="overflow:auto"><table class="inst" id="p-other"></table></div>
      <h2>Paywall → nákup (analytika aplikace) <span id="m-sub" class="h2-hint"></span></h2>
      <div class="grid2" id="m-panels"></div>
      <h2>Obnova nákupů a správa předplatného</h2>
      <div class="grid2" id="m-restore"></div>
      <details class="qdet how-calc">
        <summary>Jak se to počítá</summary>
        <p class="note"><b>Nákupy</b> jsou z RevenueCatu: od 1. 11. 2026 chodí samy, starší jsou doplněné jednorázově. Částka je v měně nákupu včetně DPH, v závorce v USD; výnos = po DPH a provizi obchodu (odhad RevenueCatu). <b>Zařízení a jazyk</b> RevenueCat nezná: přiřazují se z anonymní analytiky aplikace (dokončený nákup se stejným produktem do 10 minut), obnova předplatného přebírá zařízení z prvního nákupu. Řádek „jen z aplikace“ = nákup bez záznamu v RevenueCatu (testovací nákup z TestFlightu nebo interního testování Google Play). Testovací nákupy (sandbox) a testeři se skrývají jako jinde (zaškrtávátko „včetně testerů a robotů“ nahoře). Výjimka: nákup z RevenueCatu ze zařízení, které za testovací považuje jen automatika (simulátor, vývojová verze, kontrolní zařízení Applu…), se počítá a dostane štítek „zařízení vypadá jako testovací, ověř ho“; skryje ho až ruční označení zařízení v evidenci v Technice.</p>
        <p class="note"><b>Paywall → nákup</b> je z anonymní analytiky aplikace a platí pro něj všechny filtry nahoře (období, platforma, verze…). Počty v tabulkách = různá zařízení, <b>konverze</b> = kolik zařízení, která paywall z daného zdroje viděla, nákup dokončilo. <b>Obnova nákupů</b> se do nákupů ani tržeb nepočítá: od 16. 11. 2026 má vlastní záznamy, starší verze ji posílaly jako nákup s produktem „obnova“&nbsp;– obojí je sloučené v „Obnova nákupů“. Starší verze u zamčeného článku a zdravotního tipu zapisují zobrazení paywallu dvakrát; dvojice téhož zařízení do 60 s se počítá jako jedno zobrazení. Nákupy ze starších verzí zdroj ani režim nenesou: doplní se z posledního zobrazení paywallu na tomtéž zařízení (nejvýš hodinu před); zkušební doba u nich zůstane „neuvedeno“. „Bez určeného zdroje“ = paywall otevřený z místa, které zdroj nepředává (aplikace pak pošle výchozí hodnotu). „Zdroj neznámý“ = zobrazení paywallu ze starších verzí (do 217), které zdroj neposílaly vůbec, a nákupy, před kterými v datech není zobrazení paywallu se zdrojem.</p>
      </details>
    </div>
  </div>

  <script type="application/json" id="admin-labels" is:inline set:html={labelsJson}></script>
  <script type="module" is:inline>
    import { initializeApp } from 'https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js';
    import { getAuth, GoogleAuthProvider, signInWithPopup, signOut, onAuthStateChanged }
      from 'https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js';
    // Čtení jen ze serveru (bezpecnost2-1): getDocs bez spojení nevyhodí chybu, vrátí prázdnou odpověď z mezipaměti
    // a admin by ji ukázal jako úplná prázdná data („Historie kompletní“, nuly). getDocsFromServer vyhodí 'unavailable'.
    // disableNetwork + enableNetwork (provoz3-1): po visícím spojení SDK zůstane až 45 s „offline“ a getDocsFromServer
    // hned selže, i když spojení už funguje. Restart sítě před dalším čtením ho vrátí hned.
    import { getFirestore, collection, query, where, orderBy, limit, startAfter, getDocsFromServer, getDocFromServer, doc, setDoc, deleteDoc, serverTimestamp, disableNetwork, enableNetwork }
      from 'https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js';

    const ADMIN_EMAIL = 'o.kliment@gmail.com';
    const FIREBASE_CONFIG = {
      apiKey: 'AIzaSyCrFi62rqFPVJuyFcS8HHuEGhZ1PfElgAs',
      authDomain: 'trypupapp.firebaseapp.com',
      projectId: 'trypupapp',
      storageBucket: 'trypupapp.firebasestorage.app',
      messagingSenderId: '354782336728',
      appId: '1:354782336728:web:b14e119b183bf4d824e9ad',
    };

    const app = initializeApp(FIREBASE_CONFIG);
    const auth = getAuth(app);
    const db = getFirestore(app);

    const $ = (id) => document.getElementById(id);
    // Escapuje i uvozovky – data jdou i do HTML ATRIBUTŮ (data-iid, <option value>), a zápis
    // do analytics_events je anonymní (Firestore rules nevalidují tvar) → bez toho stored XSS.
    const esc = (s) => String(s ?? '').replace(/[<>&"']/g, (c) => ({ '<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;',"'":'&#39;' }[c]));
    // Datum a čas česky s mezerami a bez nul na začátku, v pražském čase (texty-17, R4): „19. 11. 2026 20:27“.
    // Formát se staví jednou: toLocaleString ho stavěl při každém volání (stovky volání na Technice, provoz-10).
    const FMT_DT = new Intl.DateTimeFormat('cs-CZ', { day: 'numeric', month: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: 'Europe/Prague' });
    const fmt = (t) => { const d = new Date(t); return Number.isFinite(d.getTime()) ? FMT_DT.format(d) : '–'; };

    $('signin').onclick = async () => {
      try { await signInWithPopup(auth, new GoogleAuthProvider()); }
      catch (e) { $('login-err').textContent = e.message || String(e); }
    };
    $('signout').onclick = () => signOut(auth);

    // Lokální ověření dashboardu bez přihlášení: jen na localhostu s ?demo (bez Firestore).
    // V produkci je DEMO vždy false → přihlášení beze změny.
    const DEMO = location.hostname === 'localhost' && new URLSearchParams(location.search).has('demo');

    if (!DEMO) onAuthStateChanged(auth, (user) => {
      if (user && user.email === ADMIN_EMAIL) {
        $('login').classList.add('hidden');
        $('dash').classList.remove('hidden');
        $('who').textContent = '· ' + user.email;
        firstLoad();
      } else if (user) {
        $('login-err').textContent = 'Účet ' + user.email + ' nemá přístup.';
        signOut(auth);
      } else {
        $('dash').classList.add('hidden');
        $('login').classList.remove('hidden');
      }
    });

    // == ADMIN CORE START ==
    // Výpočetní jádro analytiky (SPEC C.5). Čisté funkce: žádné DOM, Firebase ani window, takže ho
    // scripts/check-admin-core.mjs vyřízne, spustí v node:vm nad výpisem dat a porovná s nezávislým
    // výpočtem (scripts/admin-reference.py, SPEC G.2). Výstup = objekty čísel se stabilními klíči
    // (scripts/admin-keys.md); popisky a vykreslení jsou mimo jádro.
    // Vstup D = { raw (události po deduplikaci), installs (ledger, každé zařízení s cls z classifyInstall),
    //   overrides (Map přepisů testerů), rcEvents, store (dokumenty store_stats s date), retention
    //   (store_stats/retention_summary nebo null), adCampaigns (store_stats/ad_campaigns nebo null),
    //   catalog (admin-labels.json), now (ms, „teď“), loaded { dups, dupLog, batches, complete } }.

    /** Pravidla verdiktů (SPEC C.0). Každé má důvod; patičky karet je citují. */
    const VERDICT_RULES = Object.freeze({
      // Pod 10 zařízení by procenta klamala (1 z 1 = 100 %), proto jen „k z n“ (dohodnuto se zakladatelem).
      SMALL_N: 10,
      // Od 30 zařízení v každé skupině má test dvou podílů smysl; „kdy bude jasno“ míří na tento základ.
      SURE_N: 30,
      // 95 % jistota: hranice testu dvou podílů i rozpětí Wilson.
      Z: 1.96,
      // Roste / Klesá jen při změně aspoň o pětinu a zároveň aspoň o 5 zařízení; menší výkyv je šum.
      TREND_PCT: 20,
      TREND_MIN: 5,
      // Dohodnuto: kampaň se vyplatí do 5 € za zařízení nad běžný stav (aspoň 12 zařízení za 60 €).
      CAMPAIGN_MAX_EUR: 5,
      // Pásmo „těsně“ kolem hranice 5 €: rozdíl pár centů je v šumu jednoho dne.
      CAMPAIGN_TIGHT: Object.freeze([4.5, 5.5]),
      // Kampaň kratší než 3 dny je „Běží krátce“: z pár dní nejde odlišit náhodný výkyv.
      CAMPAIGN_MIN_DAYS: 3,
      // Běžný stav = průměr nejvýš 14 posledních dnů bez kampaně; z méně než 4 dnů ho určit nejde.
      BASELINE_DAYS: 14,
      BASELINE_MIN_DAYS: 4,
      // Zralost pro první týden a „aspoň 2 různé dny“: kdo začal před méně než 7 × 24 h, nestihl se vrátit.
      MATURE_DAYS: 7,
      // Když akci umí poslat méně než 90 % základu, základ se zúží na telefony, které ji umí poslat (R8).
      MEASURABLE_PCT: 90,
      // Průměr aplikací na trhu (dohodnuto 14. 11. 2026, Adjust / AppsFlyer).
      MARKET: Object.freeze({ d1: 0.26, d7: 0.13, d30: 0.07 }),
    });
    /** Pevné hodnoty mimo verdikty (SPEC C.1–C.3). */
    const CORE_LIMITS = Object.freeze({
      VERSION_MARKS: Object.freeze([335, 337, 338, 342, 344, 352]), // měření v T2 „od verze“
      EXPO_LIMIT: 1000, EXPO_WARN: 800, EXPO_PLAN: 900,          // bezplatný tarif Expo (T5)
      DUPS_WARN_PCT: 5,                                          // T3: zdvojených nad 5 % = Pozor
      ACTIVE_DIFF_WARN: 2, D1_DIFF_WARN: 2,                      // T3: rozdíl nad 2 = Pozor
      ACTIVE10_MS: 10 * 60 * 1000,                               // Z4: aktivní aspoň 10 min
      AB_START: '2026-11-16', AB_NAME: 'first_care',             // A5: test první péče (verze 344)
      MODE_SINCE: '2026-10-23',                                  // B1: režim podle obrazovek (verze 291)
      UNKNOWN_NAMES_MAX: 10,                                     // T3: nanejvýš 10 neznámých názvů
    });
    const CORE_DAY = 86400000;
    const CORE_EMPTY = Object.freeze({});
    const CORE_EMPTY_SET = new Set();
    const ISO_DAY_RE = /^\d{4}-\d{2}-\d{2}$/;
    const ACTION_NAME_RE = /^[a-z][a-z0-9_]{0,59}$/;
    const isNum = (v) => typeof v === 'number' && Number.isFinite(v);
    const validActionName = (n) => typeof n === 'string' && ACTION_NAME_RE.test(n);
    const propsOf = (e) => (e && e.props && typeof e.props === 'object' ? e.props : CORE_EMPTY);
    /** Klíč hodnoty z dat: null, chybějící a '' → '_none'; objekt nebo pole (jen podvržené zápisy) → JSON
     *  se seřazenými klíči; jinak String(). Klíče jsou technické, popisky řeší vykreslení. */
    const valKey = (v) => (v === null || v === undefined || v === '' ? '_none' : typeof v === 'object' ? stableJson(v) : String(v));
    const cmpStr = (a, b) => (a < b ? -1 : a > b ? 1 : 0);
    const roundTo = (x, d) => { const f = 10 ** d; return Math.round(x * f) / f; };
    /** Vlastnost s klíčem z dat (i „__proto__“) bez zásahu do prototypu. */
    function setKey(o, k, v) { Object.defineProperty(o, k, { value: v, enumerable: true, writable: true, configurable: true }); return o; }
    function addCount(m, k, c = 1) { m.set(k, (m.get(k) || 0) + c); }
    function addToSet(m, k, v) { let s = m.get(k); if (!s) m.set(k, s = new Set()); s.add(v); }
    /** Rozpad [[klíč, počet], …]: sestupně podle počtu, při shodě podle klíče; nulové řádky ne. */
    function breakdown(m) { return [...m.entries()].filter(([, c]) => c > 0).sort((a, b) => b[1] - a[1] || cmpStr(a[0], b[0])); }
    /** Rozpad zařízení: Map klíč → Set(installId) → [[klíč, zařízení], …]. */
    function breakdownSets(m) { return breakdown(new Map([...m.entries()].map(([k, s]) => [k, s.size]))); }

    // ── Pražské dny (R4): stejný vzorec jako server (functions/cohortRetention.js), nikdy toISOString.
    const PRAGUE_DATE = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Prague', year: 'numeric', month: '2-digit', day: '2-digit' });
    const PRAGUE_DAY_CACHE = new Map();
    /** Pořadové číslo kalendářního dne v Praze (dny od 1970). Mezipaměť podle hodiny UTC: Praha má posun
     *  v celých hodinách, takže celá hodina leží v jednom pražském dni. */
    function pragueDay(ms) {
      if (!isNum(ms) || Math.abs(ms) > 8.64e15) return NaN;
      const h = Math.floor(ms / 3600000);
      let d = PRAGUE_DAY_CACHE.get(h);
      if (d === undefined) {
        if (PRAGUE_DAY_CACHE.size > 200000) PRAGUE_DAY_CACHE.clear();
        d = Math.round(Date.parse(`${PRAGUE_DATE.format(new Date(ms))}T00:00:00Z`) / CORE_DAY);
        PRAGUE_DAY_CACHE.set(h, d);
      }
      return d;
    }
    /** Pořadové číslo dne → 'YYYY-MM-DD' (den je půlnoc UTC daného čísla, žádné časové pásmo). */
    function dayIso(n) {
