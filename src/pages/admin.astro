        body: kvRow('Volba na rozcestí v úvodu', `na Psa doma <b>${nf(SW.onboarding.owner)}</b> · zpět na Psa na zkoušku <b>${nf(SW.onboarding.trial)}</b>`) +
          kvRow(`Přepnuli později na Psa doma (${nf(SW.later.owner)})`, `<span class="ilist">${srcList(SW.later.ownerBySource)}</span>`) +
          kvRow(`Přepnuli později zpět na Psa na zkoušku (${nf(SW.later.trial)})`, `<span class="ilist">${srcList(SW.later.trialBySource)}</span>`),
        how: 'Počty zařízení, ne přepnutí. Volba na rozcestí patří k úvodu; pozdější přepnutí ukazují, jestli fungují nabídky v aplikaci (řádek dole na Domů, Nastavení, konec výzvy). Jedno zařízení mohlo přepnout víc cestami, proto součet míst může být větší než celkem.',
        foot: 'Aktivní za 30 dní · měří se od 23. 10. 2026 (verze 292) · bez testerů a robotů',
      });

      // B5 Co lidi vrací do aplikace?
      const EN = J.entry, NT = J.notif, CR = J.care;
      let sB5, entryHtml;
      if (EN.state === 'unmeasured') {
        sB5 = `Vstupy do aplikace ${unmeasuredTxt(EN)} aktivních za 7 dní.`;
        entryHtml = `<p>Vstupy za 7 dní: ${unmeasuredTxt(EN)} aktivních.</p>`;
      } else {
        const bySrc = pairsOf(EN.bySource), cnt = new Map(pairsOf(EN.countBySource));
        sB5 = `Vstupy měříme u ${nf(EN.n)} ${zz(EN.y)} aktivních za 7 dní` +
          (bySrc.length ? ': ' + bySrc.slice(0, 3).map(([k, v]) => `${esc(lc1(L.value('app_entry', 'source', k, 'cs').text))} ${nf(v)}`).join(', ') + '.' : '.');
        entryHtml = `<p class="ilist">Vstupy za 7 dní (zařízení, v závorce vstupů): ${bySrc.map(([k, v]) => `${lv('app_entry', 'source', k)} <b>${nf(v)}</b> (${nf(cnt.get(k) ?? 0)})`).join(' · ') || 'zatím žádné'}` +
          (num(EN.n) < num(EN.y) ? ` <span class="muted">(měřitelné u ${nf(EN.x)} ${zz(EN.y)})</span>` : '') + '</p>';
      }
      // Popisek končící číslem („Varianta textu 3“) dostane dvojtečku, ať se nespojí s počtem.
      const devList = (arr, name, key) => pairsOf(arr).map(([k, v]) => `${lv(name, key, k)}${/\d$/.test(L.value(name, key, k).text) ? ':' : ''} <b>${nf(v)}</b>`).join(' · ') || 'zatím nikdo';
      let careHtml;
      if (!CR || CR.state === 'unmeasured') careHtml = `<p>Připomínky péče: ${CR ? unmeasuredTxt(CR) : 'čeká na data'}.</p>`;
      else {
        const wb5 = whenTxt(WC.b5, today);
        careHtml = `<p>Připomínky péče (30 dní${num(CR.n) < num(CR.y) ? `, měřitelné u ${nf(CR.x)} ${zz(CR.y)}` : ''}): ${pl(CR.opened, 'otevřelo', 'otevřela', 'otevřelo')} <b>${nf(CR.opened)}</b> · ${pl(CR.done, 'splnilo', 'splnila', 'splnilo')} po připomínce <b>${nf(CR.done)}</b></p>` +
