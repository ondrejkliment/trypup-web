    /** Měřitelnost (R8): Y = základ, X = zařízení základu s verzí ≥ sb. Vrací { base, x, y } nebo { unmeasured }. */
    function measurable(base, versionOf, sb) {
      const R = VERDICT_RULES, y = base.length, xs = base.filter((d) => versionOf(d) >= sb), x = xs.length;
      if (x * 100 >= R.MEASURABLE_PCT * y) return { base, x, y };
