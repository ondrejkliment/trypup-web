      if (base >= target) return null;
      if (isNum(o.since) && today - o.since < VERDICT_RULES.MATURE_DAYS + (isNum(o.lag) ? o.lag : 0)) return { state: 'young', since: dayIso(o.since) };
      if (!(added > 0)) return { state: 'unknown' };
