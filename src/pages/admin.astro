        const did = DIDS.filter(([k]) => own(OW.did, k) && OW.did[k].place === p).map(([k, lf]) => `<div>${lf()} ${mfrac(OW.did[k])}</div>`).join('') || '<span class="muted">jen obrazovky</span>';
