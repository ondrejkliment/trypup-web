      const tdT = TDN.trial, tdO = TDN.owner, tdTa = TDA.trial, tdOa = TDA.owner, wb1 = whenTxt(WC.b1, today);
      const fewO = num(tdO && tdO.n) < VERDICT_RULES.SURE_N, fewT = num(tdT && tdT.n) < VERDICT_RULES.SURE_N;
