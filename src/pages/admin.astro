    function lowerIdx(evs, t) { let lo = 0, hi = evs.length; while (lo < hi) { const m = (lo + hi) >> 1; if (evs[m].ts > t) hi = m; else lo = m + 1; } return lo; }
    const inWin = (ms, from, to) => ms !== null && ms !== undefined && ms > from && ms <= to;
    function buildIndex(D) {
