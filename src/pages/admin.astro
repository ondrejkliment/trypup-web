      }
      const O = (d) => onb.get(d.id);
      const saved = (d) => d.names.has('owner_activated') || d.dogScreen;
      const onbL = K.filter((d) => O(d).has);
      const forkL = onbL.filter((d) => O(d).reached.has('fork') || O(d).lastChoice !== null);
      const forkChoice = new Map();
      for (const d of forkL) addCount(forkChoice, valKey(O(d).lastChoice));
      const trialB = onbL.filter((d) => O(d).lastChoice !== 'owner');
      const ownerB = onbL.filter((d) => O(d).lastChoice === 'owner');
      const reached = (list, step) => list.filter((d) => O(d).reached.has(step)).length;
      const ownerSaved = ownerB.filter(saved), ownerNot = ownerB.filter((d) => !saved(d));
      const hasDog = (d) => d.names.has('activated') || saved(d);
      const noDog = new Map();
      for (const d of K) if (!hasDog(d)) addCount(noDog, O(d).has ? O(d).lastStep : '_none');
      const dwellM = new Map(), backT = new Map();
      let backDevices = 0;
      for (const d of K) {
