        });
      };
      const lastTrial = prow.find((x) => isPlan(x) && String(x.rc.periodType || '') === 'TRIAL');
      const tLastPremium = lastTile('Poslední nákup Premium', paid.find(isPlan), 'zatím žádný placený nákup Premium',
        lastTrial ? 'Poslední zkušební období: ' + esc(ago(lastTrial.ts)) : '');
      const tLastBreed = lastTile('Poslední nákup plemene (in-app)', paid.find(isBreed), 'zatím žádný nákup plemene');

      let gross = 0, grossApprox = false, grossEcb = false;
      paid.forEach((x) => { const c = toCzk(x.rc.priceLocal, x.rc.currency, x.rc.priceUsd); gross += c.czk; if (c.approx) grossApprox = true; if (c.ecb) grossEcb = true; });
      const usdRate = usdCzk();
      const proceeds = paid.reduce((a, x) => a + (Number(x.rc.proceedsUsd) || 0), 0) * usdRate.rate;
      const fxNote = !paid.length ? 'zatím žádný placený nákup'
        : grossApprox ? (FX === null ? 'kurz se načítá, zatím přibližně přes USD' : 'přepočet přibližně přes USD' + (usdRate.approx ? ' (kurz nedostupný, 1 USD = ' + nf(FALLBACK_USD_CZK, 0) + ' Kč)' : ''))
        : grossEcb ? 'přepočteno kurzem ECB' + (FX && FX.date ? ' z ' + esc(dayLabel(FX.date)) : '') : 'vše placeno v Kč';
      const tTotal = tile({
        title: 'Nákupy celkem',
        big: (grossApprox ? '≈ ' : '') + czkFmt(gross),
        sub: `Placené nákupy: ${nf(paid.length)} (Premium ${nf(paid.filter(isPlan).length)} · plemena ${nf(paid.filter(isBreed).length)})<br>` +
          `Výnos po DPH a provizi obchodu: ≈ ${czkFmt(proceeds)}`,
        desc: 'všechny placené nákupy od začátku, hrubě včetně DPH; ' + fxNote,
      });

      // Aktivní Premium: zákazník má nevrácený nákup „navždy“, nebo jeho nejnovější událost předplatného
      // (měsíčně/ročně) není vypršení ani vrácení peněz a expirationAtMs je v budoucnu. Zkušební období zvlášť.
      const excludedCust = new Set(allP.filter((x) => x.rc && x.rc.customer && (x.sandbox || x.cls !== 'real')).map((x) => x.rc.customer));
      const refundedTx = new Set(RC_EVENTS.filter((r) => r.type === 'CANCELLATION' && r.cancelReason === 'CUSTOMER_SUPPORT').map((r) => r.transactionId).filter(Boolean));
      const evAt = (r) => Number(r.eventAtMs || r.purchasedAtMs) || 0;
      const byCust = new Map();
      RC_EVENTS.forEach((r) => {
        if (!r.customer || r.type === 'TEST' || excludedCust.has(r.customer) || String(r.environment || '').toUpperCase() === 'SANDBOX') return;
        if (!productKey(r.productId).startsWith('plan_')) return;
        const a = byCust.get(r.customer) || []; a.push(r); byCust.set(r.customer, a);
      });
      const act = { plan_monthly: 0, plan_yearly: 0, plan_lifetime: 0 }; let actTrial = 0;
      byCust.forEach((evs) => {
        if (evs.some((r) => r.isPurchase && productKey(r.productId) === 'plan_lifetime' && !(r.transactionId && refundedTx.has(r.transactionId)))) { act.plan_lifetime++; return; }
        const last = evs.filter((r) => productKey(r.productId) !== 'plan_lifetime').sort((a, b) => evAt(b) - evAt(a))[0];
        if (!last || last.type === 'EXPIRATION' || (last.type === 'CANCELLATION' && last.cancelReason === 'CUSTOMER_SUPPORT')) return;
        if (!(Number(last.expirationAtMs) > now)) return;
        if (String(last.periodType || '') === 'TRIAL') actTrial++;
        else { const k = productKey(last.productId); act[k] = (act[k] || 0) + 1; }
      });
      const actPaid = Object.values(act).reduce((a, v) => a + v, 0);
      const tActivePremium = tile({
        title: 'Aktivní Premium',
        big: nf(actPaid),
        sub: `Měsíčně ${nf(act.plan_monthly)} · ročně ${nf(act.plan_yearly)} · navždy ${nf(act.plan_lifetime)}<br>Ve zkušebním období navíc: ${nf(actTrial)}`,
        desc: 'zákazníci, kterým Premium právě teď platí (předplatné před vypršením nebo navždy), bez zkušebního období',
      });

      const custKey = (x) => x.rc.customer || ('tx:' + (x.rc.transactionId || x.ts));
      const payers = new Set(paid.map(custKey));
      const tPayers = tile({
        title: 'Platící zákazníci a konverze',
        cells: [[nf(payers.size), 'platící zákazníci'], [pctFmt(payers.size, real.length, 1), 'konverze ze zařízení']],
        sub: `Premium ${nf(new Set(paid.filter(isPlan).map(custKey)).size)} · plemena ${nf(new Set(paid.filter(isBreed).map(custKey)).size)} · zařízení celkem ${nf(real.length)}`,
        desc: 'různí zákazníci s aspoň jedním placeným nákupem; konverze = podíl ze všech skutečných zařízení od začátku',
      });

      // ── Obchody ──
      const lastIos = storeLast('ios'), lastAnd = storeLast('android');
      const uninst30 = STORE.filter((x) => x.platform === 'android' && x.date >= storeSince(30)).reduce((a, x) => a + (Number(x.uninstalls) || 0), 0);
      const tStore = tile({
        title: 'Stažení z obchodů',
        cells: STORE.length ? [
          [nf(storeSum(7, 'ios')), 'App Store · 7 dní'], [nf(storeSum(30, 'ios')), 'App Store · 30 dní'],
          [nf(storeSum(7, 'android')), 'Google Play · 7 dní'], [nf(storeSum(30, 'android')), 'Google Play · 30 dní'],
        ] : null,
        big: STORE.length ? undefined : '–',
        sub: STORE.length ? `Odinstalace Google Play za 30 dní: ${nf(uninst30)}<br>Data do: App Store ${esc(dayLabel(lastIos))} · Google Play ${esc(dayLabel(lastAnd))}` : 'zatím žádná data',
        desc: 'oficiální čísla obchodů (první stažení / nové instalace); chodí se zpožděním 1–5 dní, poslední dny ještě chybí',
      });

      let tRatings;
      const R = RATINGS.state === 'ok' ? RATINGS.data : null;
      if (!R) {
        tRatings = tile({
          title: 'Hodnocení v obchodech', big: '–',
          sub: 'čeká na první načtení',
          desc: 'průměr hvězdiček a počet hodnocení v App Storu a na Google Play',
        });
      } else {
        const star = (o) => {
          const cnt = Number(o && o.count) || 0, avg = o && o.avg !== null && o.avg !== undefined ? Number(o.avg) : NaN;
          return [!cnt || !Number.isFinite(avg) ? '–' : nf(avg, 1) + ' ★', cnt ? nf(cnt) + ' hodnocení' : 'zatím bez hodnocení'];
        };
        const [iosStar, iosCnt] = star(R.ios), [andStar, andCnt] = star(R.android);
        const rv = R.reviews || {};
        const unIos = Number(rv.ios && rv.ios.unanswered) || 0, unAnd = Number(rv.android && rv.android.unanswered) || 0;
        const un = unIos + unAnd;
        const byCountry = R.ios && R.ios.byCountry && typeof R.ios.byCountry === 'object'
          ? Object.entries(R.ios.byCountry).filter(([, v]) => v && Number(v.count) > 0).sort((a, b) => Number(b[1].count) - Number(a[1].count)).slice(0, 3) : [];
        const upd = anyMs(R.updatedAt);
        tRatings = tile({
          title: 'Hodnocení v obchodech',
          cells: [[iosStar, 'App Store · ' + iosCnt], [andStar, 'Google Play · ' + andCnt]],
          sub: [
            un > 0 ? `<span class="warn">Čeká na odpověď: ${nf(un)}</span> (App Store ${nf(unIos)} · Google Play ${nf(unAnd)})` : 'Všechny recenze mají odpověď',
            byCountry.length ? 'App Store podle země: ' + byCountry.map(([c, v]) => esc(regionLabel(c)) + ' ' + esc(Number.isFinite(Number(v.avg)) ? nf(v.avg, 1) + ' ★' : '–') + ' (' + nf(v.count) + ')').join(' · ') : '',
          ].filter(Boolean).join('<br>'),
          desc: 'průměr hvězdiček a počet hodnocení' + (upd ? ' · aktualizováno ' + esc(fmt(upd)) : ''),
        });
      }

      // ── Zapojení + zdraví (analytické eventy, bez testerů a robotů) ──
      const ev = RAW.filter((e) => Number.isFinite(e.ts) && !isExcluded(e.installId, e.dev));
      const evIn = (name, d, pred) => ev.filter((e) => e.name === name && (!d || now - e.ts <= d * DAY_MS) && (!pred || pred(e)));
      const shared = (e) => e.props && e.props.action === 'shared';
      const tShare = tile({
        title: 'Sdílení',
        cells: [[nf(evIn('share_initiated', 7).length), '7 dní'], [nf(evIn('share_initiated', 30).length), '30 dní']],
        sub: `Opravdu odesláno (share_completed): 7 dní ${nf(evIn('share_completed', 7, shared).length)} · 30 dní ${nf(evIn('share_completed', 30, shared).length)}`,
        desc: 'kolikrát lidé otevřeli sdílení (share_initiated)',
      });
      // Paywall → nákup za 30 dní (analytika aplikace): obnova se nepočítá, dvojí zobrazení sloučená.
      const mon30 = monetization(ev.filter((e) => now - e.ts <= 30 * DAY_MS));
      const pwInst = new Set(mon30.views.map((v) => v.installId));
      const buys30 = mon30.purchases.filter((p) => p.name === 'purchase_completed');
      const buyInst = new Set(buys30.map((p) => p.installId));
      const rN = (k) => mon30.restores.filter((r) => r.kind === k).length;
      const topSrc = countBy(buys30, (p) => p.source || null)[0];
      const tPaywall = tile({
        title: 'Paywall → nákup (30 dní)',
        big: pctFmt(buyInst.size, pwInst.size, 1),
        cells: [[nf(pwInst.size), 'zařízení s paywallem'], [nf(buyInst.size), 'dokončilo nákup']],
        sub: `Obnova nákupů: ${nf(rN('started'))}× (obnoveno ${nf(rN('completed'))} · nebylo co obnovit ${nf(rN('none'))} · selhalo ${nf(rN('failed'))})` +
          `<br>Spravovat předplatné: ${nf(mon30.manage.length)}×` +
          (topSrc ? `<br>Nejvíc nákupů ze zdroje: ${esc(srcLabel(topSrc[0]))} (${nf(topSrc[1])})` : ''),
        desc: 'zařízení, která za 30 dní viděla paywall, a kolik jich nákup dokončilo (analytika aplikace); obnova nákupů se jako nákup nepočítá; rozpad podle zdroje, režimu a plánu v záložce Nákupy',
      });
      const opened7 = evIn('care_reminder_opened', 7).length, done7 = evIn('care_reminder_done', 7).length;
      const tCare = tile({
        title: 'Připomínky péče',
        cells: [[nf(opened7), 'otevřeno · 7 dní'], [nf(done7), 'splněno · 7 dní'], [pctFmt(done7, opened7), 'splněno z otevřených']],
        desc: 'notifikace virtuálního psa podle zvyku (od 13. 11. 2026)',
      });
      const tChallenge = tile({
        title: '30denní výzva',
        cells: [[nf(evIn('challenge_completed', 30).length), '30 dní'], [nf(evIn('challenge_completed').length), 'načtená historie' + (Number.isFinite(oldestEv) ? ' od ' + esc(dayLabel(isoDay(oldestEv))) : '')]],
        desc: 'dokončené 30denní výzvy (challenge_completed)',
      });
      const errs = evIn('app_error', 7);
      const topErr = countBy(errs, (e) => e.props && e.props.context ? String(e.props.context) : '?')[0];
      const tErrors = tile({
        title: 'Chyby v aplikaci',
        alert: errs.length > 0,
        cells: [[nf(errs.length), 'chyby · 7 dní'], [nf(uniqInstalls(errs)), 'zasažená zařízení']],
        sub: topErr ? `Nejčastěji: ${esc(topErr[0].slice(0, 80))} (${nf(topErr[1])}×)` : 'Za 7 dní žádná chyba',
        desc: 'zachycené chyby (app_error) za 7 dní; podrobnosti v záložce Technika',
      });

      $('dash-tiles').innerHTML = [
        section('Uživatelé', [tInstalls, tActive, tRetention, tCountries]),
        section('Peníze', [tTotal, tActivePremium, tPayers, tPaywall, tLastPremium, tLastBreed]),
        section('Obchody', [tStore, tRatings]),
        section('Zapojení', [tShare, tCare, tChallenge]),
        section('Zdraví aplikace', [tErrors]),
      ].join('');
    }

    /** Obnovit: Souhrn, Získávání i Cesta (stejná obsluha, SPEC C.0). */
    async function refreshAll() {
      if (refreshing || dashCovering) return;
      if (DEMO) { render(); return; }
      refreshing = true; $('dash-refresh').disabled = true;
      document.querySelectorAll('[data-refresh]').forEach((b) => { b.disabled = true; });
      try {
        if (dashCoverPromise) await dashCoverPromise;
        await firstLoad();
        if (dashCoverPromise) await dashCoverPromise;
      } finally { refreshing = false; $('dash-refresh').disabled = dashCovering; render(); }
    }
    $('dash-refresh').onclick = refreshAll;

    // Dočítání pro Získávání a Cestu (C.5): stejný zámek a tytéž stránky jako Souhrn. Stav podle dní:
    // 'ok' = pokryto, 'running' = dočítám, 'short' = doběhlo, ale dny pokryté nejsou (zarážka stránek nebo chyba).
    const COVER_RUNS = new Map();
    let COVER_GEN = 0;
    function coverState(days) {
      if (DEMO || coveredDays(days)) return 'ok';
      const st = COVER_RUNS.get(days);
      if (st === 'done') return 'short';
      if (!st) {
        const gen = COVER_GEN;
        COVER_RUNS.set(days, 'running');
        ensureCoverage(days, 40)
          .catch((e) => console.warn('dočtení analytiky selhalo', e))
          .finally(() => { if (gen === COVER_GEN) COVER_RUNS.set(days, 'done'); buildFilterOptions(); render(); });
      }
      return 'running';
    }

    // ─── Získávání a Cesta (SPEC C.0–C.2). Všechna čísla jsou z jádra (coreResult); tady jen texty, popisky
    //     a vykreslení (procenta z k a n, rozdíly kroků). Věty karet a „Co z toho plyne“ jsou vždy česky
    //     s českými popisky (D.3); tabulky, pruhy a seznamy se řídí přepínačem popisků.
    const SMALL_N = VERDICT_RULES.SMALL_N;
    const MONTH_GEN = ['ledna', 'února', 'března', 'dubna', 'května', 'června', 'července', 'srpna', 'září', 'října', 'listopadu', 'prosince'];
    // Slovník verdiktů (C.0): barva jen doplňuje slovo, žádná červená.
    const VERDICT_CLASS = new Map([['Vyplatí se', 'v-good'], ['Nad trhem', 'v-good'], ['Nevyplatí se', 'v-warn'], ['Pod trhem', 'v-warn'], ['Roste', 'v-up'],
      ['Zjištění', 'v-info'], ['Průkazný rozdíl', 'v-info'], ['Na úrovni trhu', 'v-info'], ['Drží', 'v-info'], ['Jen počty', 'v-info']]);
    const PLATFORM_LABEL = new Map([['android', 'Android'], ['ios', 'iPhone']]);
    const NETWORK_LABEL = new Map([['tiktok', 'TikTok'], ['google', 'Google Ads'], ['apple', 'Apple Ads'], ['meta', 'Meta']]);
    const OPEN_DETAILS = new Set(); // rozbalené <details> přežijí překreslení (C.5)
    const num = (v) => { if (v === null || v === undefined || v === '' || typeof v === 'boolean') return null; const x = Number(v); return Number.isFinite(x) ? x : null; };
    const isIsoDay = (s) => typeof s === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(s);
    /** Tvar podle počtu: 1 / 2–4 / ostatní (0 a 5+). */
    const pl = (n, one, few, many) => (n === 1 ? one : n >= 2 && n <= 4 ? few : many);
    /** Předložka „z“ / „ze“ před číslem podle výslovnosti: ze 7, ze 16, ze 104, z 62, z 1 000. */
    function zePrep(v) {
      let n = Math.abs(Math.trunc(num(v) ?? 0));
      while (n >= 1000) { const t = Math.floor(n / 1000); if (t === 1) return 'z'; n = t; }
      if (n >= 100) return n < 200 || (n >= 600 && n < 800) ? 'ze' : 'z';
      return n === 6 || n === 7 || n === 16 || n === 17 || (n >= 60 && n < 80) ? 'ze' : 'z';
    }
    const zz = (n) => `${zePrep(n)}&nbsp;${nf(n)}`;
    const pctTxt = (k, n) => `${nf(Math.round((100 * k) / n))}&nbsp;%`;
    const cap = (s) => String(s).charAt(0).toUpperCase() + String(s).slice(1);
    const lc1 = (s) => (/^\p{Lu}\p{Ll}/u.test(String(s)) ? String(s).charAt(0).toLowerCase() + String(s).slice(1) : String(s));
    /** R7: „k z n“, od 10 navíc „· p %“; bez základu „čeká na data“ (nikdy 0 ani pomlčka). */
    function kzn(f, empty = 'čeká na data') {
      const k = num(f && f.k), n = num(f && f.n);
      if (k === null || n === null || n <= 0) return empty;
      return `${nf(k)} ${zz(n)}` + (n < SMALL_N ? '' : ` · ${pctTxt(k, n)}`);
    }
    /** Základ je v záhlaví sloupce: pod 10 „k z n“, jinak „k · p %“. */
    function kpct(f) {
      const k = num(f && f.k), n = num(f && f.n);
      if (k === null || n === null || n <= 0) return 'čeká na data';
      return n < SMALL_N ? `${nf(k)} ${zz(n)}` : `${nf(k)} · ${pctTxt(k, n)}`;
    }
    /** Procento do závorky ve větě „(27 %)“; pod 10 bez procenta (R7). */
    const pctPar = (f) => { const k = num(f && f.k), n = num(f && f.n); return k !== null && n !== null && n >= SMALL_N ? ` (${pctTxt(k, n)})` : ''; };
    const unmeasuredTxt = (f) => `zatím neměříme: verzi, která to posílá, ${num(f.x) > 0 ? 'má ' + nf(f.x) + ' ' + zz(f.y) : 'nemá nikdo ' + zz(f.y)}`;
    /** R8: zlomek s „měřitelné u X z Y“, „Zatím neměříme…“ nebo „zatím jen testeři“. */
    function mfrac(f) {
      if (!f || typeof f !== 'object') return 'čeká na data';
      if (f.state === 'unmeasured') return cap(unmeasuredTxt(f));
      if (f.state === 'testers') return 'zatím jen testeři';
      const n = num(f.n), y = num(f.y);
      return kzn(f) + (n !== null && y !== null && n < y ? ` <span class="muted">(měřitelné u ${nf(f.x)} ${zz(y)})</span>` : '');
    }
    /** „Kdy bude jasno“ (C.0): začátkem / v polovině / koncem měsíce (2. pád), jiný rok s rokem. */
    function whenTxt(w, todayIso) {
      if (!w || typeof w !== 'object') return '';
      if (w.state === 'unknown') return 'kdy bude jasno, zatím nejde odhadnout';
      const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(w.date || ''));
      const mi = m ? Number(m[2]) - 1 : -1;
      if (!(mi >= 0 && mi < 12)) return '';
      const part = w.part === 'start' ? 'začátkem' : w.part === 'mid' ? 'v polovině' : 'koncem';
      return `jasno nejspíš ${part} ${MONTH_GEN[mi]}${m[1] !== String(todayIso || '').slice(0, 4) ? ' ' + m[1] : ''}`;
    }
    const rangeTxt = (r) => (Array.isArray(r) && num(r[0]) !== null && num(r[1]) !== null ? `nejspíš ${nf(r[0])}–${nf(r[1])}&nbsp;%` : '');
    const eur = (v) => { const x = num(v); return x === null ? 'chybí' : `${nf(x, Number.isInteger(x) ? 0 : 2)}&nbsp;€`; };
    const PRAGUE_HM = new Intl.DateTimeFormat('cs-CZ', { timeZone: 'Europe/Prague', day: 'numeric', month: 'numeric', hour: '2-digit', minute: '2-digit' });
    /** Čas dat v hlavičce: v demu čas výpisu, jinak čas načtení. */
    const dataTime = () => { const t = NOW_FIXED !== null ? NOW_FIXED : LOADED_AT; return Number.isFinite(t) ? PRAGUE_HM.format(t) : 'načítám'; };
    function verdictPill(v) { const s = String(v ?? ''); return `<span class="verdict ${VERDICT_CLASS.get(s) || 'v-muted'}">${esc(s)}</span>`; }
    /** Karta (C.0). Jako tile() nic neescapuje: hodnoty z dat musí volající prohnat esc() nebo L.html(). */
    function card({ q, verdict, sentence, body, how, foot }) {
      return `<section class="qcard"><div class="q-head"><h3>${q}</h3>${verdict ? verdictPill(verdict) : ''}</div>` +
        (sentence ? `<p class="q-sent">${sentence}</p>` : '') + (body ? `<div class="q-body">${body}</div>` : '') +
        (how ? `<p class="q-how"><b>Jak číst:</b> ${how}</p>` : '') + (foot ? `<p class="q-foot">${foot}</p>` : '') + '</section>';
    }
    const takeaways = (rows) => `<div class="takeaways"><h3>Co z toho plyne</h3>${rows.map(([v, s]) => `<div class="tk-row">${verdictPill(v)}<p>${s}</p></div>`).join('')}</div>`;
    function tabHead(title, meta) {
      return `<div class="tab-head"><div><h2>${title}</h2><div class="tab-meta">${meta}</div></div>` +
        `<button class="ghost" type="button" data-refresh${refreshing ? ' disabled' : ''}>Obnovit</button></div>`;
    }
    const coverWord = (st) => (st === 'ok' ? 'data úplná' : st === 'short' ? 'data neúplná' : 'dočítám…');
    /** Během dočítání žádná čísla (neúplná se nesmí tvářit jako hotová). */
    const waitBox = (st, days) => `<div class="wait">${st === 'short'
      ? `Data za posledních ${nf(days)} dní se nepodařilo načíst celá, čísla by nebyla úplná. Zkus Obnovit.`
      : `Počítám z dat za ${nf(days)} dní…`}</div>`;
    /** Po vykreslení: Obnovit a pamatování rozbalených sekcí. */
    function bindPane(root) {
      root.querySelectorAll('[data-refresh]').forEach((b) => { b.onclick = refreshAll; });
      root.querySelectorAll('details[data-open]').forEach((d) => d.addEventListener('toggle', () => {
        if (d.open) OPEN_DETAILS.add(d.dataset.open); else OPEN_DETAILS.delete(d.dataset.open);
      }));
    }
    const openAttr = (key) => (OPEN_DETAILS.has(key) ? ' open' : '');
    /** Pruhy: [[popisek HTML, číslo, text místo čísla, bez pruhu]]. Šířka jen z Number() (R12), maximum smyčkou. */
    function barRows(rows, color = 'var(--apricot)') {
      let hi = 0;
      for (const r of rows) { const v = num(r[1]); if (!r[3] && v !== null && v > hi) hi = v; }
      return rows.map(([label, v, txt, noBar]) => {
        const n = num(v);
        const val = txt !== undefined && txt !== null ? txt : n !== null ? nf(n) : 'čeká na data';
        const track = noBar ? '' : `<div class="track">${n !== null && hi > 0 && n > 0 ? `<div class="fill" style="width:${Math.max(2, (n / hi) * 100).toFixed(1)}%;background:${color}"></div>` : ''}</div>`;
        return `<div class="bar"><span class="lbl">${label}</span><span class="val">${val}</span>${track}</div>`;
      }).join('');
    }
    const kvRow = (label, val) => `<div class="kv"><span>${label}</span><span>${val}</span></div>`;
    const pairsOf = (arr) => (Array.isArray(arr) ? arr.filter((x) => Array.isArray(x) && x.length >= 2) : []);
    const own = (o, k) => (o && typeof o === 'object' && Object.hasOwn(o, k) ? o[k] : null);

    // ── Záložka Získávání (C.1)
    function renderAcquisition() {
      const root = $('acq-root');
      if (!root) return;
      const title = 'Získávání&nbsp;– kolik nových lidí přichází, odkud a za kolik';
      const st = dataReady ? coverState(30) : 'running';
      const meta = `Skutečná zařízení bez testerů a robotů · data do ${esc(dataTime())} · dnešek je neúplný · ${coverWord(st)}`;
      if (st !== 'ok') { root.innerHTML = tabHead(title, meta) + waitBox(st, 30); bindPane(root); return; }
      const A = coreResult('acq'), J = coreResult('jr'), M = coreResult('meta');
      const today = M.today, NW = A.new, n7 = NW.d7.all, a7 = NW.d7.android;

      // Z1 Kolik nových lidí přichází?
      const s1 = `Za posledních 7 dní ${pl(n7, 'přišlo', 'přišla', 'přišlo')} ${nf(n7)} ${pl(n7, 'nové zařízení', 'nová zařízení', 'nových zařízení')}, předchozích 7 dní ${nf(NW.prev7.all)}. ` +
        `Z těch ${nf(n7)} ${a7 >= 2 && a7 <= 4 ? 'jsou' : 'je'} ${nf(a7)} z Androidu.`;
      const days = Array.isArray(A.byDay) ? A.byDay : [];
      let dayHi = 0;
      for (const d of days) { const v = num(d.all); if (v !== null && v > dayHi) dayHi = v; }
      const storeCell = (d) => {
        const i = num(d.store && d.store.ios), a = num(d.store && d.store.android);
        if (i === null && a === null) return 'čeká na data';
        return `App Store ${i === null ? 'čeká na data' : nf(i)} · Google Play ${a === null ? 'čeká na data' : nf(a)}`;
      };
      let anyCamp = false;
      const dayRows = days.map((d) => {
        const v = num(d.all) ?? 0, camp = Array.isArray(d.campaign) ? d.campaign.filter((p) => PLATFORM_LABEL.has(p)) : [];
        if (camp.length) anyCamp = true;
        return `<div class="drow${camp.length ? ' camp' : ''}"><span>${esc(dayLabel(d.day))}${d.partial ? ' <span class="muted">(neúplný)</span>' : ''}</span>` +
          `<span class="d-track">${dayHi > 0 && v > 0 ? `<span class="d-fill" style="width:${Math.max(2, (v / dayHi) * 100).toFixed(1)}%"></span>` : ''}</span>` +
          `<b class="d-val">${nf(v)}</b><span class="d-store">${storeCell(d)}${camp.length ? ' · kampaň ' + camp.map((p) => PLATFORM_LABEL.get(p)).join(', ') : ''}</span></div>`;
      }).join('');
      const z1 = card({
        q: 'Kolik nových lidí přichází?', verdict: A.verdicts.z1, sentence: s1,
        body: `<div class="qnums">${[[NW.h24.all, 'za 24 h'], [n7, 'za 7 dní'], [NW.prev7.all, 'předchozích 7 dní'], [NW.d30.all, 'za 30 dní']]
          .map(([v, l]) => `<div class="qnum"><b>${nf(v)}</b><span>${l}</span></div>`).join('')}</div>` +
          `<p>7 dní: Android <b>${nf(a7)}</b> · iPhone <b>${nf(NW.d7.ios)}</b><br>30 dní: Android <b>${nf(NW.d30.android)}</b> · iPhone <b>${nf(NW.d30.ios)}</b></p>` +
          `<div class="sub">Po dnech</div><div class="days"><div class="drow dhead"><span>Den</span><span>naše měření</span><span></span><span class="d-store">obchody pro srovnání</span></div>${dayRows}</div>` +
          (anyCamp ? '<p class="muted"><span class="legend-camp"></span>den, kdy podle zápisu kampaní běžela placená kampaň</p>' : ''),
        how: 'Nové zařízení = telefon, na kterém někdo aplikaci poprvé spustil a odpověděl na věk jako dospělý. Lidé pod 16 let a lidé s vypnutou analytikou v datech nejsou a přeinstalace je nové zařízení. Obchody jsou jen pro srovnání: počítají i stažení bez otevření, data vydávají se zpožděním a den bez dat je ‚čeká na data‘, ne nula.',
        foot: 'Měří se od 10. 6. 2026 · bez testerů a robotů · Roste / Klesá při změně aspoň o 20&nbsp;% a aspoň o 5 zařízení',
      });

      // Z2 Odkud noví lidé přišli?
      const CH = A.channel, byCh = pairsOf(CH.byChannel), topCh = byCh[0] || null;
      const androidNoun = (n) => (n === 1 ? 'nového Android zařízení' : 'nových Android zařízení');
      const s2 = `Zdroj známe u ${nf(CH.measured)} ${zz(CH.of)} ${androidNoun(CH.of)}` + (topCh ? `; nejčastěji ${csv('install_source', 'channel', topCh[0])} (${nf(topCh[1])}).` : '.');
      const z2 = card({
        q: 'Odkud noví lidé přišli?', verdict: A.verdicts.z2, sentence: s2,
        body: '<div class="sub">Android, noví za 30 dní</div>' +
          barRows(byCh.map(([k, v]) => [lv('install_source', 'channel', k), v]), 'var(--water)') +
          barRows([['Verze bez měření zdroje', CH.unmeasured, null, true], ['iPhone: zdroj od Applu v adminu zatím není', CH.ios, null, true]]),
        how: 'Kanál čteme z odkazu, přes který Google Play aplikaci stáhl. TikTok v kampani ‚Propagace aplikace‘ odkaz nepředává, jeho lidé spadnou do ‚Google Play organicky‘. Kdo klikl na reklamu a aplikaci našel později, je také organicky. U iPhonu dává Apple jen souhrn po dnech a ten v adminu zatím není.',
        foot: 'Měří se od 18. 11. 2026 (verze 352), jen Android · noví za 30 dní · bez testerů a robotů',
      });

      // Z3 Vyplatí se placené kampaně?
      const CP = A.campaigns;
      let s3, z3Body, z3Upd = '';
      const z0Camp = [];
      if (!CP || CP.state !== 'ok') {
        s3 = 'Útrata a dny kampaní zatím nejsou v adminu zapsané, takže cenu za zařízení spočítat nejde.';
