          ios: { shared: sharers.filter((d) => d.platform === 'ios').length, sent: iosSent },
          coop: { invited: active30.filter((d) => set30('coop_invite_created').has(d.id)).length, joined: active30.filter((d) => set30('coop_joined').has(d.id)).length },
          link: active30.filter((d) => d.inst.srcChannel === 'trypup_link').length,
