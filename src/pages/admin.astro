    }

    // ── Signály režimů (B1, jediná definice režimu pro celý admin). Bit 1 = Pes na zkoušku, 2 = Pes doma.
    const MODE_OWNER_EVENTS = new Set(['owner_activated', 'owner_setup_exit', 'plan_item', 'diary_entry', 'weight_entry', 'setup_checklist',
      'real_reminder_opened', 'training_logged', 'training_stage_confirmed', 'training_help_opened', 'map_opened',
      'calendar_event_opened', 'dog_photo', 'dog_document', 'family']);
    const MODE_TRIAL_EVENTS = new Set(['activated', 'task_done', 'day_advanced', 'training_done', 'event_choice', 'trip_sitter',
      'vet_visit_done', 'challenge_started', 'fail_state']);
    const MODE_TRIAL_SCREENS = new Set(['feed', 'play', 'brush', 'training', 'walk', 'walk-summary', 'health', '(main)/health',
      'achievements', 'breeddex', 'breed-select', 'timeline', 'challenge-result', 'graduation', 'fail-state']);
    function modeBits(e, p) {
      const n = e.name;
      if (n === 'screen_view') {
        const s = typeof p.screen === 'string' ? p.screen : '';
        let b = 0;
        if (p.mode === 'owner' || s.startsWith('pesdoma/')) b |= 2;
        if (MODE_TRIAL_SCREENS.has(s) || (s === '(main)/home' && p.mode !== 'owner')) b |= 1;
        return b;
      }
      if (MODE_OWNER_EVENTS.has(n)) return 2;
      if ((n === 'walk_started' || n === 'walk_completed') && p.mode === 'owner') return 2;
      if (MODE_TRIAL_EVENTS.has(n)) return 1;
      return 0;
    }
    // Místa Psa doma (B3): obrazovky přesně podle SPEC, výcvik podle začátku trasy; vets a family i akcí.
    const OWNER_PLACES = [
      ['plan', (s) => s === 'pesdoma/dog/[id]/plan', null],
      ['diary', (s) => s === 'pesdoma/dog/[id]/diary' || s === 'pesdoma/dog/[id]/entry' || s === 'pesdoma/dog/[id]/weight', null],
      ['docs', (s) => s === 'pesdoma/dog/[id]/passport' || s === 'pesdoma/dog/[id]/documents' || s === 'pesdoma/dog/[id]/scan' || s === 'pesdoma/dog/[id]/summary', null],
      ['firstaid', (s) => s === 'pesdoma/first-aid' || s === 'pesdoma/first-aid/[topic]', null],
      ['training', (s) => s.startsWith('pesdoma/dog/[id]/training') || s.startsWith('pesdoma/training/'), null],
      ['vets', (s) => s === 'pesdoma/vets' || s === 'pesdoma/vet/[id]', 'map_opened'],
      ['walk', (s) => s === 'pesdoma/walk' || s === 'pesdoma/walk-summary', null],
      ['family', (s) => s === 'pesdoma/dog/[id]/family' || s === 'pesdoma/family-join', 'family'],
    ];
    const LEARNING_EVENTS = new Set(['article_opened', 'article_read', 'lesson_answered', 'myth_answered', 'review_answered']);
    // Procházka psa na zkoušku se započítá od 5 minut a 150 metrů (pawprint-mobile src/modules/walk/walkMeasure.ts).
    const WALK_MIN_SEC = 5 * 60, WALK_MIN_M = 150;
    const screenOf = (e, p) => (e.name === 'screen_view' && typeof p.screen === 'string' ? p.screen : null);
    /** Názvy útulků (B6, cisla-12): pomlčka mezi slovy v jakémkoli zápisu (spojovník, krátká i dlouhá pomlčka U+2014, i s nezlomitelnou
     *  mezerou) = „ – “, aby jeden útulek nebyl ve dvou řádcích a dlouhá pomlčka se nedostala do českého textu. */
