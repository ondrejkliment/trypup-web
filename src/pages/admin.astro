<body>
  <!-- LOGIN -->
  <div id="login" class="center">
    <img src="/icon.png" class="logo" alt="Trypup" />
    <div>
      <h1>Trypup · Analytika</h1>
      <p style="color:var(--muted);max-width:340px">Skrytá analytika. Přihlas se účtem správce Google.</p>
    </div>
    <button id="signin">Přihlásit přes Google</button>
    <p id="login-err" class="err"></p>
  </div>

  <!-- DASHBOARD -->
  <div id="dash" class="wrap hidden">
    <header>
      <h1>Trypup · Analytika <small id="who"></small></h1>
      <div class="toolbar">
        <a href="/admin/content" class="pill" style="text-decoration:none">Obsah webu</a>
        <a href="/admin/shelters" class="pill" style="text-decoration:none">Útulky</a>
        <a href="/admin/notices" class="pill" style="text-decoration:none">Novinky a akce</a>
        <a href="/admin/articles" class="pill" style="text-decoration:none">Články a zdroje</a>
        <span class="langsw" id="langsw" role="group" aria-label="Popisky akcí">Popisky:
          <button type="button" data-lang="cs" aria-pressed="true">Čeština</button><span aria-hidden="true">·</span>
          <button type="button" data-lang="en" aria-pressed="false">English</button><span aria-hidden="true">·</span>
          <button type="button" data-lang="raw" aria-pressed="false">Technické názvy</button>
        </span>
        <button id="signout" class="ghost">Odhlásit</button>
      </div>
    </header>

    <!-- ZÁLOŽKY -->
    <div class="tabs" id="tabs" role="tablist">
      <button class="tab active" data-tab="souhrn" role="tab">Souhrn</button>
      <button class="tab" data-tab="ziskavani" role="tab">Získávání</button>
      <button class="tab" data-tab="cesta" role="tab">Cesta</button>
      <button class="tab" data-tab="nakupy" role="tab">Nákupy</button>
      <button class="tab" data-tab="technika" role="tab">Technika</button>
    </div>

    <!-- FILTRY + VYHLEDÁVÁNÍ -->
    <div class="filters">
      <div class="row1">
        <input id="f-text" type="search" placeholder="Hledat akci, hodnotu, model, jazyk…" style="min-width:min(240px,100%);flex:1" />
        <input id="f-iid" type="text" placeholder="Kód zařízení (začátek)" style="width:180px" />
        <button id="f-clear" class="ghost">Vyčistit</button>
      </div>
      <div class="row2">
        <select id="f-event"><option value="">Akce: vše</option></select>
        <select id="f-platform"><option value="">Platforma: vše</option></select>
        <select id="f-locale"><option value="">Jazyk: vše</option></select>
        <select id="f-build"><option value="">Verze: vše</option></select>
        <select id="f-type"><option value="">Druh zařízení: vše</option></select>
        <span class="quick" id="quick">
          <button data-d="1">24 h</button><button data-d="7">7 dní</button>
          <button data-d="30">30 dní</button><button data-d="0" class="on">Vše</button>
        </span>
        <input id="f-from" type="date" title="Od (pražský den)" />
        <input id="f-to" type="date" title="Do (pražský den včetně)" />
        <label class="tgl" title="Testeři (simulátory, vývojové verze, Expo Go, kontrolní zařízení Applu iPhone99, ručně označená zařízení) a roboti (předběžná kontrola Google Play: emulátory, OnePlus 8 Pro s Androidem 11 a krátkou aktivitou)"><input type="checkbox" id="f-testers" /> včetně testerů a robotů</label>
        <span class="count" id="count"></span>
      </div>
    </div>

    <p id="status" style="color:var(--muted)">Načítám…</p>

    <!-- TAB: SOUHRN (dlaždice, vždy bez testerů a robotů; filtry se tu skrývají) -->
    <div id="tab-souhrn" class="tabpane">
      <div class="dash-head">
        <span><span id="dash-updated">Načítám…</span> <span id="dash-cover"></span></span>
        <button id="dash-refresh" class="ghost">Obnovit</button>
      </div>
      <div id="dash-tiles"></div>
    </div>

    <!-- TAB: ZÍSKÁVÁNÍ (SPEC C.1, vždy bez testerů a robotů, pevná období) -->
    <div id="tab-ziskavani" class="tabpane hidden"><div id="acq-root"></div></div>

    <!-- TAB: CESTA (SPEC C.2, vždy bez testerů a robotů, pevná období) -->
    <div id="tab-cesta" class="tabpane hidden"><div id="jr-root"></div></div>

    <!-- TAB: TECHNIKA (SPEC C.3): nahoře kontrola dat s pevnými obdobími, pod ní panely podle filtrů -->
    <div id="tab-technika" class="tabpane hidden">
      <h2>Načtená data</h2>
      <div class="panel t-loaded">
        <p id="t-loaded" class="t-loaded-text">Načítám…</p>
        <div class="toolbar"><button id="loadOlder" class="ghost">Načíst starší</button><button id="loadAll" class="ghost">Načíst vše</button></div>
      </div>
      <div id="t-checks"></div>
      <h2>Zařízení podle filtrů <span class="h2-hint">počty různých zařízení</span></h2>
      <div class="grid2" id="t-devices"></div>
      <h2>Selhání <span class="h2-hint">podle filtrů</span></h2>
      <p class="note">Pády a chyby aplikace sleduje Sentry, do analytiky se neposílají.</p>
      <div class="grid2" id="t-quality"></div>
      <h2>Evidence zařízení&nbsp;– označení testerů a robotů <span id="i-sub" class="h2-hint"></span></h2>
      <p class="note"><span class="tag auto">robot (automaticky)</span> = předběžná kontrola Google Play (emulátory Google a OnePlus 8 Pro s Androidem 11 a aktivitou pod hodinu). <span class="tag auto">tester (automaticky)</span> = simulátor, vývojová verze, Expo Go nebo kontrolní zařízení Applu při schvalování verze (iPhone99, iPad99). „Potvrdit“ u automatického testera s nákupem z RevenueCatu ho označí ručně, teprve pak se ten nákup skryje. TestFlight a interní testování Google Play vypadají jako obchod, proto je označ ručně (<span class="tag manual">tester</span>): tvůj iPhone, Xiaomi testera. „Není robot“ vypne automatiku pro jedno zařízení (skutečný majitel OnePlus 8 Pro). Označení platí hned pro všechny záložky i veřejné statistiky webu.</p>
      <div class="panel" style="overflow:auto"><table class="inst" id="inst"></table></div>
