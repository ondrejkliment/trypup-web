    const toScalar = (v) => { const x = toPlain(v); return x !== null && typeof x === 'object' ? stableJson(x) : x; };
    /** Mapa z dat (props, device) → prostý objekt s primitivními hodnotami; cokoli jiného → {}. */
    function plainMap(m) {
      const out = {}, p = toPlain(m);
      if (p && typeof p === 'object' && !Array.isArray(p)) for (const k of Object.keys(p)) setKey(out, k, p[k] !== null && typeof p[k] === 'object' ? stableJson(p[k]) : p[k]);
      return out;
    }
    /** Událost z dávky: name, session a installId jako primitiva, ts jen konečné číslo (jinak null), vlastnosti
     *  jako primitiva; dev = už normalizovaný kontext zařízení dávky. Společná pro fetchPage, setData a kontrolu jádra. */
    function plainEvent(e, installId, dev, ts) {
      return { name: toScalar(e.name), props: plainMap(e.props), ts: isNum(ts) ? ts : null, session: toScalar(e.session),
        installId: toScalar(installId), dev };
    }
    /** Záznam evidence zařízení: každé pole jako primitivum; časy firstMs / lastMs předá volající. */
    function plainInstall(x, firstMs, lastMs) {
      const o = {};
      for (const k of Object.keys(x)) setKey(o, k, toScalar(x[k]));
      if (!Object.hasOwn(o, 'installKind')) o.installKind = 'unknown';
      o.firstMs = isNum(firstMs) ? firstMs : null; o.lastMs = isNum(lastMs) ? lastMs : null;
      return o;
    }
    /** Zkrácený kód zařízení (texty-7): prvních 10 znaků je časová předpona a opakuje se, proto i konec kódu. */
    const shortId = (id) => { const s = String(id ?? '?'); return s.length > 12 ? s.slice(5, 10) + '…' + s.slice(-4) : s; };

    // ── Retence = DOSLOVNÉ ZRCADLO computeRetention z pawprint-mobile/functions/cohortRetention.js.
    //    Při změně upravit obě místa (stejně jako classifyInstall ↔ installClass.js). Jen přejmenováno
    //    computeRetention → cohortRetention; pragueDay je výše (stejný vzorec, navíc mezipaměť).
    const DAYS = [1, 7, 30];
    const WEEKS = [['w1', 7, 13], ['w4', 28, 34]]; // 2. týden, 5. týden
    const SEGMENTS = ['all', 'challenge', 'trial', 'owner', 'notActivated'];
    function segmentOf(a) {
      if (!a) return 'notActivated';
      if (a.owner) return 'owner';
      if (a.challenge) return 'challenge';
      if (a.trial) return 'trial';
      return 'notActivated';
    }
    /**
     * @param installs [{ id, firstMs }] jen skutečná zařízení (bez testerů a robotů)
     * @param activity Map(id → { days:Set<pragueDay>, owner, challenge, trial })
     * @returns { segments: { [seg]: { installs, d1:{k,n}, d7:{k,n}, d30:{k,n} } } }  Čistá funkce.
     */
    function cohortRetention(installs, activity, nowMs) {
      const today = pragueDay(nowMs);
      const empty = () => ({ installs: 0, ...Object.fromEntries([...DAYS.map((d) => `d${d}`), ...WEEKS.map(([w]) => w)].map((key) => [key, { k: 0, n: 0 }])) });
      const segments = Object.fromEntries(SEGMENTS.map((s) => [s, empty()]));
      for (const i of installs) {
        if (!Number.isFinite(i.firstMs)) continue;
        const a = activity.get(i.id);
        const first = pragueDay(i.firstMs);
        for (const seg of ['all', segmentOf(a)]) {
          const s = segments[seg];
          s.installs += 1;
          for (const d of DAYS) {
            if (today - first <= d) continue; // den N ještě celý neproběhl
            s[`d${d}`].n += 1;
            if (a && a.days.has(first + d)) s[`d${d}`].k += 1;
          }
          for (const [w, from, to] of WEEKS) {
            if (today - first <= to) continue; // týden ještě celý neproběhl
            s[w].n += 1;
            if (a) { for (let x = from; x <= to; x++) if (a.days.has(first + x)) { s[w].k += 1; break; } }
          }
