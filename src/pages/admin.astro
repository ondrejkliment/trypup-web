      const ownerSaved = ownerB.filter(saved), ownerNot = ownerB.filter((d) => !saved(d));
      const hasDog = (d) => d.names.has('activated') || saved(d);
      const noDog = new Map();
      for (const d of K) if (!hasDog(d)) addCount(noDog, O(d).has ? O(d).lastStep : '_none');
      const dwellM = new Map(), backT = new Map();
      let backDevices = 0;
      for (const d of K) {
        let back = false;
        for (const e of d.evs) {
          if (e.name !== 'onboarding_step') continue;
          const p = propsOf(e);
          if (p.dir === 'back') { back = true; addCount(backT, side(p.fromStep) + '>' + side(p.step)); continue; }
          if (isNum(p.dwellMs) && valKey(p.fromStep) !== '_none') { const k = String(p.fromStep); const a = dwellM.get(k); if (a) a.push(p.dwellMs); else dwellM.set(k, [p.dwellMs]); }
        }
        if (back) backDevices++;
      }
      const dwell = {};
      for (const [k, arr] of [...dwellM].sort((a, b) => cmpStr(a[0], b[0]))) {
        if (arr.length < R.SMALL_N) continue;
        arr.sort((a, b) => a - b);
        const m = arr.length >> 1, ms = arr.length % 2 ? arr[m] : (arr[m - 1] + arr[m]) / 2;
        setKey(dwell, k, { n: arr.length, ms, s: Math.round(ms / 1000) });
      }

      // A3 první týden: jen zralí, vše do 7 × 24 h od prvního spuštění.
      const mature = K.filter((d) => d.firstMs !== null && d.firstMs <= matureAt);
      const wTrial = mature.filter((d) => O(d).has && O(d).lastChoice !== 'owner' && d.names.has('activated'));
      const wOwner = mature.filter((d) => O(d).has && O(d).lastChoice === 'owner' && saved(d));
      const wkEnd = (d) => d.firstMs + 7 * CORE_DAY;
      const wk = (d, pred) => scanDev(d, -Infinity, wkEnd(d), pred);
      const wkBuild = (d) => buildIn(d, -Infinity, wkEnd(d));
      const frac = (list, kOf) => ({ k: list.filter(kOf).length, n: list.length });
      const careDays = (d) => wk(d, isName('task_done')).days.size;
      const isOwnerScreen = (e, p) => { const s = screenOf(e, p); return s !== null && s.startsWith('pesdoma/'); };
      const week = {
