          if (c.verdict === 'Nelze oddělit') {
            const j = jointOf.get(c.group);
            return `${nm}: běží ve stejné dny jako jiná kampaň na stejném telefonu, umíme jen společnou cenu` +
              (j && num(j.cost) !== null ? ` (${eur(j.spendEur)} / ${nf(j.above, 1)} zařízení = ${eur(j.cost)}).` : '.');
          }
