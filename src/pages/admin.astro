    const pctRange = (f) => { const w = f ? wilson(f.k, f.n) : null; return w ? [Math.round(100 * w[0]), Math.round(100 * w[1])] : null; };
    /** Test dvou podílů se sdruženým podílem: z = (pa − pb) / se; prázdná skupina nebo se = 0 → 0. */
    function twoProp(a, b) {
