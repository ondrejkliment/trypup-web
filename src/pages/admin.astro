    function catalogOd(ci, name, fallback) {
      const e = ci.ev.get(name), d = e ? isoDayNum(e.od) : null;
      return d !== null ? d : isoDayNum(fallback);
    }

    // ── Nákupy: párování RevenueCatu s analytikou (záložka Nákupy i kontrola T3 / T4).
    const MATCH_MS = 10 * 60 * 1000;
    const PURCHASE_EVENTS = new Set(['purchase_started', 'purchase_completed', 'purchase_cancelled', 'purchase_pending', 'purchase_failed']);
    const isLegacyRestore = (e) => PURCHASE_EVENTS.has(e.name) && !!e.props && e.props.product === 'restore';
    const productKey = (id) => {
