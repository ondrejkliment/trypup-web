          diary: frac(wOwner, (d) => wk(d, (e, p) => { const s = screenOf(e, p); return s === 'pesdoma/dog/[id]/diary' || s === 'pesdoma/dog/[id]/entry' || s === 'pesdoma/dog/[id]/weight'; }).n > 0),
          returned: frac(wOwner, (d) => wk(d, isOwnerScreen).days.size >= 2),
