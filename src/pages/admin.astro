        z0Camp.push(['Chybí útrata', 'Kolik z nich přivedly placené kampaně, zatím nevíme: útrata a dny kampaní nejsou v adminu zapsané.']);
      } else {
        const list = Array.isArray(CP.list) ? CP.list : [], joint = Array.isArray(CP.joint) ? CP.joint : [];
        const jointOf = new Map(joint.map((j) => [j.group, j]));
        const cName = (c) => esc(c.name || c.id || 'kampaň');
        const dayN = (n) => `${nf(n)} ${pl(n, 'den', 'dny', 'dní')}`;
        const campSent = (c) => {
          const nm = cName(c);
