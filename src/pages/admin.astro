---
// Trypup – skrytý analytický dashboard (cross-device).
// Čte kolekci `analytics_events` z Firestore (projekt trypupapp). Přístup jen pro
// admin účet (Firestore rules: read jen pro o.kliment@gmail.com). Skryté pro roboty
// (noindex + robots.txt Disallow /admin). Firebase přes CDN (žádná npm změna webu).
//
// Záložky: PŘEHLED (KPI+funnely) · VÝZKUM (onboarding odpovědi/chování – oddělené od
// technických dat) · TECHNIKA (zařízení/chyby/build). Filtr + fulltext nad daty.
// Retence: stránkování (Načíst starší / Načíst vše) – data se drží od začátku měření.
const ADMIN_EMAIL = 'o.kliment@gmail.com';
---

<!doctype html>
<html lang="cs">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Trypup · Analytika</title>
  <style is:global>
    :root {
      --apricot:#F2784B; --plum:#4A2B45; --water:#3E7C8C; --cream:#FDF4EF;
      --bg:#1d1620; --card:#2e2636; --line:#493e54; --muted:#a99bb0; --text:#f3ecf2;
    }
    * { box-sizing:border-box; }
    body { margin:0; background:var(--bg); color:var(--text);
      font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; font-size:14px; }
    a { color:var(--apricot); }
    .wrap { max-width:1180px; margin:0 auto; padding:24px 18px 80px; }
    header { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:14px; flex-wrap:wrap; }
    h1 { font-size:20px; margin:0; font-weight:800; letter-spacing:-.3px; }
    h1 small { color:var(--muted); font-weight:500; font-size:13px; }
    h2 { font-size:13px; text-transform:uppercase; letter-spacing:.8px; color:var(--muted); margin:28px 0 12px; }
    button { background:var(--apricot); color:#fff; border:0; border-radius:10px;
      padding:9px 14px; font-weight:700; cursor:pointer; font-size:13px; }
    button.ghost { background:transparent; color:var(--muted); border:1px solid var(--line); }
    .center { min-height:70vh; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:16px; text-align:center; }
    .logo { width:64px; height:64px; border-radius:18px; }
    .cards { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:12px; }
    .card { background:var(--card); border:1px solid var(--line); border-radius:14px; padding:16px; box-shadow:0 1px 2px #00000030; }
    .kpi { font-size:26px; font-weight:800; font-variant-numeric:tabular-nums; letter-spacing:-.5px; }
    .kpi small { display:block; font-size:12px; color:var(--muted); font-weight:500; margin-top:4px; }
    .grid2 { display:grid; grid-template-columns:repeat(auto-fit,minmax(330px,1fr)); gap:16px; }
    .panel { background:var(--card); border:1px solid var(--line); border-radius:14px; padding:16px 18px; box-shadow:0 1px 2px #00000030; }
    .panel h3 { margin:0 0 14px; font-size:14px; display:flex; justify-content:space-between; align-items:baseline; gap:8px; }
    .panel h3 .hint { font-weight:500; color:var(--muted); font-size:12px; }
    .bar { display:grid; grid-template-columns:1fr auto; column-gap:10px; align-items:baseline; margin:9px 0 12px; }
    .bar .lbl { font-size:13px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .bar .track { grid-column:1 / -1; height:9px; background:#ffffff1f; border-radius:6px; position:relative; margin-top:5px; overflow:hidden; }
    .bar .fill { position:absolute; left:0; top:0; bottom:0; border-radius:6px; background:var(--water); min-width:3px; }
    .bar .val { font-variant-numeric:tabular-nums; color:var(--text); font-weight:600; font-size:12.5px; }
    .bar .val .pct { color:var(--muted); font-weight:500; }
    .funnel .step { margin:0 0 12px; }
    .funnel .bar { margin:0; }
    .funnel .fill { background:var(--apricot); }
    .funnel .conv { font-size:11px; color:var(--muted); margin:4px 0 0; letter-spacing:.2px; }
    .funnel .conv .drop { color:#d98a6b; font-variant-numeric:tabular-nums; margin-left:3px; }
    .feed { max-height:520px; overflow:auto; font-size:12.5px; }
    .feed .row { display:flex; justify-content:space-between; gap:10px; padding:6px 0; border-bottom:1px solid var(--line); }
    .feed .ev { font-weight:600; }
    .feed .meta { color:var(--muted); white-space:nowrap; }
    .feed .iid { cursor:pointer; text-decoration:underline dotted; }
    .pill { display:inline-block; background:#0003; border:1px solid var(--line); border-radius:20px; padding:2px 9px; font-size:11px; color:var(--muted); }
    .err { color:#ff8a8a; }
    .toolbar { display:flex; gap:8px; align-items:center; flex-wrap:wrap; }
    select, input { background:var(--card); color:var(--text); border:1px solid var(--line); border-radius:8px; padding:7px 10px; font-size:13px; }
    input::placeholder { color:var(--muted); }
    .hidden { display:none !important; }
    /* Tab bar */
    .tabs { display:flex; gap:6px; border-bottom:1px solid var(--line); margin:6px 0 4px; }
    .tab { background:transparent; color:var(--muted); border:0; border-bottom:2px solid transparent; border-radius:0; padding:10px 14px; font-weight:700; }
    .tab.active { color:var(--text); border-bottom-color:var(--apricot); }
    /* Filter bar */
    .filters { position:sticky; top:0; z-index:5; background:var(--bg); padding:12px 0; border-bottom:1px solid var(--line); margin-bottom:8px; }
    .filters .row1, .filters .row2 { display:flex; gap:8px; align-items:center; flex-wrap:wrap; }
    .filters .row2 { margin-top:8px; }
    .filters .count { color:var(--muted); font-size:12px; margin-left:auto; }
    .quick { display:inline-flex; gap:4px; }
    .quick button { padding:6px 10px; font-size:12px; }
    .quick button.on { background:var(--water); }
    .tgl { display:inline-flex; align-items:center; gap:6px; font-size:12.5px; color:var(--muted); cursor:pointer; user-select:none; }
    .tgl input { accent-color:var(--apricot); }
    table.inst { width:100%; border-collapse:collapse; font-size:12px; }
    table.inst th, table.inst td { text-align:left; padding:5px 6px; border-bottom:1px solid var(--line); white-space:nowrap; }
    table.inst th { color:var(--muted); font-weight:600; font-size:11px; text-transform:uppercase; letter-spacing:.4px; }
    table.inst tr.tester td { opacity:.55; }
    .tag { display:inline-block; border-radius:10px; padding:1px 7px; font-size:10.5px; font-weight:700; background:var(--bg); border:1px solid var(--line); }
    .tag.auto { color:#e8c46a; } .tag.manual { color:#ff8a8a; } .tag.store { color:#7dd39a; }
    .note { color:var(--muted); font-size:12px; margin:4px 0 12px; line-height:1.5; }
    table { width:100%; border-collapse:collapse; }
    td,th { text-align:left; padding:5px 6px; border-bottom:1px solid var(--line); font-size:12.5px; }
    th { color:var(--muted); font-weight:600; }
    /* Záložky na telefonu: pět záložek se nevejde → lišta se posouvá sama, stránka ne */
    .tabs { overflow-x:auto; scrollbar-width:none; }
    .tab { flex-shrink:0; white-space:nowrap; }
    @media (max-width:560px) { .tab { padding:10px 9px; } }
    /* Dashboard – dlaždice */
    .dash-head { display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap; margin:14px 0 0; color:var(--muted); font-size:12.5px; }
    .dash-head button { padding:6px 12px; font-size:12px; }
    .dash-head button:disabled { opacity:.5; cursor:default; }
    .tiles { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(240px,100%),1fr)); gap:12px; }
    .tile { background:var(--card); border:1px solid var(--line); border-radius:14px; padding:14px 16px; box-shadow:0 1px 2px #00000030;
      display:flex; flex-direction:column; gap:8px; min-width:0; container-type:inline-size; }
    .tile.alert { border-color:#ff8a8a; box-shadow:inset 3px 0 0 #ff8a8a; }
    .tile .t-title { font-size:13px; text-transform:uppercase; letter-spacing:.6px; color:var(--muted); font-weight:700; }
    .tile .t-big { font-size:32px; font-weight:800; font-variant-numeric:tabular-nums; letter-spacing:-.5px; line-height:1.1; overflow-wrap:anywhere; }
    .tile.alert .t-big, .tile.alert .t-cell b { color:#ff8a8a; }
    .tile .t-cells { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:6px; }
    .tile .t-cells.c3 { grid-template-columns:repeat(3,minmax(0,1fr)); }
    @container (min-width:420px) { .tile .t-cells.c4 { grid-template-columns:repeat(4,minmax(0,1fr)); } }
    .tile .t-cell { background:#00000026; border:1px solid var(--line); border-radius:10px; padding:7px 9px; min-width:0; }
    .tile .t-cell b { display:block; font-size:22px; font-weight:800; font-variant-numeric:tabular-nums; letter-spacing:-.3px; line-height:1.15; overflow-wrap:anywhere; }
    .tile .t-cell span { display:block; font-size:11px; color:var(--muted); margin-top:2px; line-height:1.35; }
    .tile .t-list { display:flex; flex-direction:column; gap:4px; }
    .tile .t-list div { display:flex; justify-content:space-between; gap:10px; font-size:13.5px; }
    .tile .t-list b { font-variant-numeric:tabular-nums; }
    .tile .t-sub { font-size:12.5px; line-height:1.45; }
    .tile .t-sub .warn { color:var(--apricot); font-weight:700; }
    .tile table.t-ret { width:100%; border-collapse:collapse; margin-top:2px; }
    .tile table.t-ret th, .tile table.t-ret td { padding:4px 4px; border-bottom:1px solid var(--line); font-size:12.5px; text-align:right; font-variant-numeric:tabular-nums; white-space:nowrap; }
    .tile table.t-ret th:first-child, .tile table.t-ret td:first-child { text-align:left; white-space:normal; }
    .tile table.t-ret td span { color:var(--muted); }
    .tile table.t-ret tr.mkt td { color:var(--muted); border-bottom:0; }
    .tile .t-desc { font-size:12px; color:var(--muted); line-height:1.45; margin-top:auto; }
  </style>
</head>
<body>
  <!-- LOGIN -->
  <div id="login" class="center">
    <img src="/icon.png" class="logo" alt="Trypup" />
    <div>
      <h1>Trypup · Analytika</h1>
      <p style="color:var(--muted);max-width:340px">Skrytý dashboard. Přihlas se admin účtem Google.</p>
    </div>
    <button id="signin">Přihlásit přes Google</button>
    <p id="login-err" class="err"></p>
  </div>

  <!-- DASHBOARD -->
  <div id="dash" class="wrap hidden">
    <header>
      <h1>Trypup · Analytika <small id="who"></small></h1>
      <div class="toolbar">
        <a href="/admin/content" class="pill" style="text-decoration:none">✏️ Obsah webu</a>
        <a href="/admin/shelters" class="pill" style="text-decoration:none">🐾 Útulky</a>
        <a href="/admin/notices" class="pill" style="text-decoration:none">📣 Novinky a akce</a>
        <a href="/admin/articles" class="pill" style="text-decoration:none">📚 Články a zdroje</a>
        <button id="loadOlder" class="ghost">Načíst starší</button>
        <button id="loadAll" class="ghost">Načíst vše</button>
        <button id="signout" class="ghost">Odhlásit</button>
      </div>
    </header>

    <!-- ZÁLOŽKY -->
    <div class="tabs" id="tabs">
      <button class="tab active" data-tab="dashboard">Dashboard</button>
      <button class="tab" data-tab="prehled">Přehled</button>
      <button class="tab" data-tab="vyzkum">Výzkum</button>
      <button class="tab" data-tab="technika">Technika</button>
      <button class="tab" data-tab="nakupy">Nákupy</button>
    </div>

    <!-- FILTRY + VYHLEDÁVÁNÍ -->
    <div class="filters">
      <div class="row1">
        <input id="f-text" type="search" placeholder="🔎 Hledat (event, props, model, jazyk…)" style="min-width:240px;flex:1" />
        <input id="f-iid" type="text" placeholder="installId (prefix)" style="width:150px" />
        <button id="f-clear" class="ghost">Vyčistit</button>
      </div>
      <div class="row2">
        <select id="f-event"><option value="">Event: vše</option></select>
        <select id="f-platform"><option value="">Platforma: vše</option></select>
        <select id="f-locale"><option value="">Jazyk: vše</option></select>
        <select id="f-build"><option value="">Build: vše</option></select>
        <select id="f-type"><option value="">Typ: vše</option></select>
        <span class="quick" id="quick">
          <button data-d="1">24 h</button><button data-d="7">7 d</button>
          <button data-d="30">30 d</button><button data-d="0" class="on">Vše</button>
        </span>
        <input id="f-from" type="date" title="Od" />
        <input id="f-to" type="date" title="Do" />
        <label class="tgl" title="Testeři (simulátory, vývojové buildy, Expo Go, ručně označená zařízení) a roboti (Google Play pre-launch report: sdk_gphone*, OnePlus8Pro/Android 11 s krátkou aktivitou)"><input type="checkbox" id="f-testers" /> včetně testerů a robotů</label>
        <span class="count" id="count"></span>
      </div>
    </div>

    <p id="status" style="color:var(--muted)">Načítám…</p>

    <!-- TAB: DASHBOARD (dlaždice, vždy bez testerů a robotů; filtry se tu skrývají) -->
    <div id="tab-dashboard" class="tabpane">
      <div class="dash-head">
        <span><span id="dash-updated">Načítám…</span> <span id="dash-cover"></span></span>
        <button id="dash-refresh" class="ghost">Obnovit</button>
      </div>
      <div id="dash-tiles"></div>
    </div>

    <!-- TAB: PŘEHLED -->
    <div id="tab-prehled" class="tabpane hidden">
      <h2>Uživatelé <span id="u-sub" style="color:var(--muted);font-weight:500;font-size:12px"></span></h2>
      <div class="cards" id="u-kpis"></div>
      <div class="grid2" id="u-panels" style="margin-top:12px"></div>
      <h2>Stažení z obchodů <span id="st-sub" style="color:var(--muted);font-weight:500;font-size:12px"></span></h2>
      <div class="cards" id="st-kpis"></div>
      <div class="grid2" id="st-panels" style="margin-top:12px"></div>
      <p class="note">Zdroj: App Store Analytics Reports (první stažení, od 5. 10. 2026) a Google Play hromadné přehledy (nové instalace uživatelů, měsíční CSV – Google je vydává se zpožděním několika dní). Dny, které obchod ještě nevydal, graf označí „čeká na data“ nebo „jen App Store“ / „jen Google Play“, ne nulou. Kolekce <code>store_stats</code>, plní funkce <code>syncStoreStats</code> denně v 6:40. Jen součty po dnech a zemích, žádná data o lidech.</p>
      <p class="note">Zdroj: ledger instalací (<code>install_platforms</code>, každé zařízení jednou, bez testerů – přepínač „včetně testerů“ nahoře).
        Skutečná <strong>stažení z obchodů</strong> jsou v bloku níž.</p>
      <h2>Eventy (načtené dávky)</h2>
      <div class="cards" id="kpis"></div>
      <h2>Funnely (kolik instalací dojde k…)</h2>
      <div class="grid2" id="funnels"></div>
      <h2>Aktivita v čase</h2>
      <div class="grid2" id="overview-events"></div>
    </div>

    <!-- TAB: VÝZKUM -->
    <div id="tab-vyzkum" class="tabpane hidden">
      <h2>Onboarding funnel & váhání</h2>
      <div class="grid2" id="r-funnel"></div>
      <h2>Připravenost (formulář „Než si pořídíš psa")</h2>
      <div class="grid2" id="r-readiness"></div>
      <h2>Kvíz – profil uživatele</h2>
      <div class="grid2" id="r-quiz"></div>
      <h2>Doporučení vs. výběr plemene</h2>
      <div class="grid2" id="r-breed"></div>
      <h2>Engagement & chování</h2>
      <div class="grid2" id="r-engage"></div>
      <h2>Mise, retence & virální smyčka</h2>
      <div class="grid2" id="r-mission"></div>
    </div>

    <!-- TAB: TECHNIKA -->
    <div id="tab-technika" class="tabpane hidden">
      <h2>Zařízení – na čem se to děje</h2>
      <div class="grid2" id="t-devices"></div>
      <h2>Kvalita & chyby</h2>
      <div class="grid2" id="t-quality"></div>
      <h2>Instalace (ledger) – označení testerů <span id="i-sub" style="color:var(--muted);font-weight:500;font-size:12px"></span></h2>
      <p class="note"><span class="tag auto">robot (auto)</span> = Google Play pre-launch report (emulátory <code>sdk_gphone*</code>, OnePlus8Pro na Androidu 11 s aktivitou pod hodinu) – pravidla v <code>functions/installClass.js</code>. <span class="tag auto">tester (auto)</span> = simulátor / vývojový build / Expo Go. TestFlight a interní testování Play vypadají jako obchod → označ ručně (<span class="tag manual">tester</span>): tvůj iPhone, Xiaomi tester. „není robot“ vypne automatiku pro konkrétní zařízení (skutečný majitel OnePlus 8 Pro). Platí hned pro všechny záložky i <code>/api/stats.json</code>.</p>
      <div class="panel" style="overflow:auto"><table class="inst" id="inst"></table></div>
      <h2>Poslední aktivita (drill log)</h2>
      <div class="panel"><div class="feed" id="feed"></div></div>
    </div>

    <!-- TAB: NÁKUPY -->
    <div id="tab-nakupy" class="tabpane hidden">
      <h2>Nákupy <span id="p-sub" style="color:var(--muted);font-weight:500;font-size:12px"></span></h2>
      <div class="cards" id="p-kpis"></div>
      <div class="panel" style="overflow:auto;margin-top:12px"><table class="inst" id="p-table"></table></div>
      <div class="grid2" id="p-panels" style="margin-top:12px"></div>
      <h2>Ostatní události předplatného</h2>
      <div class="panel" style="overflow:auto"><table class="inst" id="p-other"></table></div>
      <p class="note">Zdroj: RevenueCat – kolekce <code>rc_events</code>, plní ji webhook <code>revenuecatWebhook</code> (od 1. 11. 2026) a doplněná historie (<code>functions/backfill-rc-events.cjs</code>). Částka je v měně nákupu včetně DPH, v závorce v USD; výnos = po DPH a provizi obchodu (odhad RevenueCatu). <strong>Zařízení a jazyk</strong> RevenueCat nezná: páruje se s anonymní analytikou (<code>purchase_completed</code> se stejným produktem do 10 minut), obnova předplatného přebírá zařízení z prvního nákupu. Řádek „jen z aplikace“ = nákup bez záznamu v RevenueCatu (testovací nákup z TestFlightu / interního testování). Sandbox a testeři se skrývají jako jinde (přepínač „včetně testerů“ nahoře).</p>
    </div>
  </div>

  <script type="module" is:inline>
    import { initializeApp } from 'https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js';
    import { getAuth, GoogleAuthProvider, signInWithPopup, signOut, onAuthStateChanged }
      from 'https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js';
    import { getFirestore, collection, query, orderBy, limit, startAfter, getDocs, doc, setDoc, deleteDoc, serverTimestamp }
      from 'https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js';

    const ADMIN_EMAIL = 'o.kliment@gmail.com';
    const FIREBASE_CONFIG = {
      apiKey: 'AIzaSyCrFi62rqFPVJuyFcS8HHuEGhZ1PfElgAs',
      authDomain: 'trypupapp.firebaseapp.com',
      projectId: 'trypupapp',
      storageBucket: 'trypupapp.firebasestorage.app',
      messagingSenderId: '354782336728',
      appId: '1:354782336728:web:b14e119b183bf4d824e9ad',
    };

    const app = initializeApp(FIREBASE_CONFIG);
    const auth = getAuth(app);
    const db = getFirestore(app);

    const $ = (id) => document.getElementById(id);
    // Escapuje i uvozovky – data jdou i do HTML ATRIBUTŮ (data-iid, <option value>), a zápis
    // do analytics_events je anonymní (Firestore rules nevalidují tvar) → bez toho stored XSS.
    const esc = (s) => String(s ?? '').replace(/[<>&"']/g, (c) => ({ '<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;',"'":'&#39;' }[c]));
    const fmt = (t) => new Date(t).toLocaleString('cs-CZ', { dateStyle: 'short', timeStyle: 'short' });

    $('signin').onclick = async () => {
      try { await signInWithPopup(auth, new GoogleAuthProvider()); }
      catch (e) { $('login-err').textContent = e.message || String(e); }
    };
    $('signout').onclick = () => signOut(auth);

    // Lokální ověření dashboardu bez přihlášení: jen na localhostu s ?demo (bez Firestore).
    // V produkci je DEMO vždy false → přihlášení beze změny.
    const DEMO = location.hostname === 'localhost' && new URLSearchParams(location.search).has('demo');

    if (!DEMO) onAuthStateChanged(auth, (user) => {
      if (user && user.email === ADMIN_EMAIL) {
        $('login').classList.add('hidden');
        $('dash').classList.remove('hidden');
        $('who').textContent = '· ' + user.email;
        firstLoad();
      } else if (user) {
        $('login-err').textContent = 'Účet ' + user.email + ' nemá přístup.';
        signOut(auth);
      } else {
        $('dash').classList.add('hidden');
        $('login').classList.remove('hidden');
      }
    });

    // --- Data load (stránkování – drží data od začátku měření) ---
    const PAGE = 500;
    let RAW = [];          // ploché eventy ze všech načtených dávek
    let lastDoc = null;    // cursor pro startAfter
    let batches = 0;       // počet načtených dávek
    let exhausted = false; // už není co načítat
    let loading = false;

    async function fetchPage() {
      if (loading || exhausted) return 0;
      loading = true;
      try {
        const base = [collection(db, 'analytics_events'), orderBy('lastTs', 'desc')];
        const q = lastDoc ? query(...base, startAfter(lastDoc), limit(PAGE)) : query(...base, limit(PAGE));
        const snap = await getDocs(q);
        snap.forEach((d) => {
          const b = d.data();
          const dev = b.device || {};
          (b.events || []).forEach((e) => RAW.push({
            name: e.name, props: e.props || {}, ts: e.ts, session: e.session,
            installId: b.installId, dev,
          }));
        });
        lastDoc = snap.docs.length ? snap.docs[snap.docs.length - 1] : lastDoc;
        batches += snap.size;
        if (snap.size < PAGE) exhausted = true;
        return snap.size;
      } finally { loading = false; }
    }

    // --- Ledger instalací + testeři (docs/ANALYTICS_DASHBOARD_PLAN.md) ---
    let INSTALLS = [];                 // [{id, platform, firstMs, lastMs, locale, deviceLocale, region, installKind, model, os, osVersion, appBuild, cls}]
    let OVERRIDES = new Map();         // installId → {kind: 'tester'|'robot'|'real', note}
    const CLS_BY_ID = new Map();       // installId → 'real' | 'tester' | 'robot'
    const tsMs = (v) => (v && typeof v.toMillis === 'function') ? v.toMillis() : (typeof v === 'number' ? v : null);
    // ── Klasifikace = ZRCADLO functions/installClass.js (pawprint-mobile). Při změně upravit obě místa.
    //    Robot = Google Play pre-launch report (Firebase Test Lab): emulátory sdk_gphone* a OnePlus8Pro
    //    na Androidu 11 s krátkou aktivitou (< 60 min). Tester = simulátor / vývoj / Expo Go / ručně.
    const TESTER_KINDS = new Set(['simulator', 'development', 'ad_hoc', 'enterprise', 'expo_go']);
    const ROBOT_KINDS = new Set(['emulator', 'test_lab']);
    const ROBOT_RULES = [
      { id: 'kind', test: (d) => ROBOT_KINDS.has(String(d.installKind || '')) },
      { id: 'sdk_gphone', test: (d) => /^sdk_gphone/i.test(String(d.model || '')) },
      { id: 'oneplus8pro_android11_short', test: (d, span) => String(d.model || '') === 'OnePlus8Pro' && (/^11(\.|$)/.test(String(d.osVersion || '')) || /android\s*11\b/i.test(String(d.osVersion || ''))) && span !== null && span < 60 },
    ];
    const TESTER_RULES = [
      { id: 'kind', test: (d) => TESTER_KINDS.has(String(d.installKind || '')) },
      { id: 'ios_simulator_model', test: (d) => /simulator/i.test(String(d.model || '')) },
    ];
    function classifyInstall(d, o) {
      if (o) return { kind: o.kind === 'robot' ? 'robot' : o.kind === 'real' ? 'real' : 'tester', source: 'manual', rule: null };
      const span = (d.firstMs !== null && d.lastMs !== null) ? Math.max(0, Math.round((d.lastMs - d.firstMs) / 60000)) : null;
      for (const r of ROBOT_RULES) if (r.test(d, span)) return { kind: 'robot', source: 'auto', rule: r.id };
      for (const r of TESTER_RULES) if (r.test(d, span)) return { kind: 'tester', source: 'auto', rule: r.id };
      return { kind: 'real', source: 'none', rule: null };
    }
    const clsOf = (iid) => CLS_BY_ID.get(iid) || 'real';
    // Eventy bez záznamu v ledgeru (čerstvá dávka) posuzujeme podle device kontextu dávky.
    const isExcluded = (iid, dev) => {
      const k = CLS_BY_ID.get(iid);
      if (k) return k !== 'real';
      return dev ? classifyInstall({ installKind: dev.installKind, model: dev.model, osVersion: dev.osVersion, firstMs: null, lastMs: null }, null).kind !== 'real' : false;
    };
    const isTester = (iid, kind) => isExcluded(iid, kind ? { installKind: kind } : null);
    function reclassify() {
      CLS_BY_ID.clear();
      INSTALLS.forEach((i) => { i.cls = classifyInstall(i, OVERRIDES.get(i.id) || null); CLS_BY_ID.set(i.id, i.cls.kind); });
    }
    // --- Nákupy z RevenueCatu (rc_events, functions/rcEvents.js) ---
    let RC_EVENTS = [];
    async function loadRcEvents() {
      const snap = await getDocs(collection(db, 'rc_events'));
      RC_EVENTS = snap.docs.map((d) => d.data()).filter((x) => x && x.type);
    }
    let STORE = [];
    // Hodnocení v obchodech: dokument store_stats/ratings_summary (stejná kolekce, nemá date/platform,
    // takže do STORE nespadne). {updatedAt, ios:{avg,count,byCountry}, android:{avg,count}, reviews:{ios,android}}
    let RATINGS = { state: 'missing', data: null };
    // Retence po režimech: store_stats/retention_summary (functions/cohortRetention.js, denně se syncStoreStats).
    // {updatedAt, method, segments:{all|challenge|trial|owner|notActivated:{installs, d1:{k,n}, d7, d30}}}
    let RETENTION = { state: 'missing', data: null };
    async function loadStoreStats() {
      const snap = await getDocs(collection(db, 'store_stats'));
      STORE = snap.docs.map((d) => d.data()).filter((x) => x && x.date && (x.platform === 'ios' || x.platform === 'android'));
      const rs = snap.docs.find((d) => d.id === 'ratings_summary');
      RATINGS = rs ? { state: 'ok', data: rs.data() || {} } : { state: 'missing', data: null };
      const rt = snap.docs.find((d) => d.id === 'retention_summary');
      RETENTION = rt ? { state: 'ok', data: rt.data() || {} } : { state: 'missing', data: null };
    }
    // Stažení podle obchodu: iOS = první stažení (firstTime), Android = nové instalace (installs).
    const storeN = (x) => x.platform === 'ios' ? (Number(x.firstTime) || 0) : (Number(x.installs) || 0);
    function renderStoreStats() {
      if (!$('st-kpis')) return;
      if (!STORE.length) { $('st-sub').textContent = '· zatím žádná data'; $('st-kpis').innerHTML = ''; $('st-panels').innerHTML = ''; return; }
      const n = storeN;
      const today = new Date(); const DAY = 86400000;
      const iso = (ms) => new Date(ms).toISOString().slice(0, 10);
      const since = (d) => iso(today.getTime() - d * DAY);
      const sum = (rows) => rows.reduce((a, x) => a + n(x), 0);
      const ios = STORE.filter((x) => x.platform === 'ios'), and = STORE.filter((x) => x.platform === 'android');
      const last = (rows) => rows.map((x) => x.date).sort().slice(-1)[0] || '–';
      // Obchody vydávají data se zpožděním (Apple 1–2 dny, Google i 5 dní). Den po posledním dni
      // s daty není nula, jen ho obchod ještě nevydal. Apple dny bez stažení nezapisuje, takže
      // „má data“ = den nejpozději poslední den, který obchod vydal.
      const lastIos = last(ios), lastAnd = last(and);
      const hasIos = (d) => lastIos !== '–' && d <= lastIos, hasAnd = (d) => lastAnd !== '–' && d <= lastAnd;
      const k = (label, v, sub) => `<div class="card"><div class="kpi">${v}<small>${label}${sub ? ' · ' + sub : ''}</small></div></div>`;
      $('st-sub').textContent = `· App Store data do ${last(ios)} · Google Play do ${last(and)}`;
      $('st-kpis').innerHTML = [
        k('stažení celkem', sum(STORE), `App Store ${sum(ios)} · Google Play ${sum(and)}`),
        k('za 30 dní', sum(STORE.filter((x) => x.date >= since(30))), `7 dní ${sum(STORE.filter((x) => x.date >= since(7)))} · jen dny, které obchody už vydaly`),
        k('odinstalace Google Play', and.reduce((a, x) => a + (x.uninstalls || 0), 0), 'celkem'),
      ].join('');
      const byDay = new Map();
      for (let d = 29; d >= 0; d--) byDay.set(iso(today.getTime() - d * DAY), 0);
      STORE.forEach((x) => { if (byDay.has(x.date)) byDay.set(x.date, byDay.get(x.date) + n(x)); });
      const regionName = (c) => { try { return new Intl.DisplayNames(['cs'], { type: 'region' }).of(c) + ' (' + c + ')'; } catch { return c; } };
      const country = new Map();
      STORE.forEach((x) => { for (const [c, v] of Object.entries(x.platform === 'ios' ? (x.byTerritory || {}) : (x.byCountry || {}))) country.set(regionName(c), (country.get(regionName(c)) || 0) + v); });
      const plat = [['App Store', sum(ios)], ['Google Play', sum(and)]];
      $('st-panels').innerHTML = [
        barPanel('Stažení za den (30 dní, oba obchody)', [...byDay.entries()].map(([d, v]) => {
          const lbl = d.slice(5).split('-').reverse().join('. ') + '.';
          if (!hasIos(d) && !hasAnd(d)) return [lbl + ' · čeká na data', 0, '–'];
          if (!hasAnd(d)) return [lbl + ' · jen App Store', v];
          if (!hasIos(d)) return [lbl + ' · jen Google Play', v];
          return [lbl, v];
        }), 'var(--apricot)', 0, 'čeká na data = obchod den ještě nevydal, není to nula'),
        barPanel('Země (oba obchody, celkem)', [...country.entries()].sort((a, b) => b[1] - a[1]), 'var(--plum)', 12),
        barPanel('Obchod', plat, 'var(--water)'),
      ].join('');
    }
    async function loadInstalls() {
      const [inst, over] = await Promise.all([getDocs(collection(db, 'install_platforms')), getDocs(collection(db, 'tester_installs'))]);
      INSTALLS = inst.docs.map((d) => { const x = d.data(); return { id: d.id, platform: x.platform || null, firstMs: tsMs(x.firstSeenAt), lastMs: tsMs(x.lastSeenAt), locale: x.locale, deviceLocale: x.deviceLocale, region: x.region, installKind: x.installKind || 'unknown', model: x.model, os: x.os, osVersion: x.osVersion, appBuild: x.appBuild }; });
      OVERRIDES = new Map(over.docs.map((d) => [d.id, d.data() || {}]));
      reclassify();
    }
    /** kind: 'tester' | 'robot' | 'real' (ruční přepis) | null (zrušit přepis → automatika). */
    async function setOverride(iid, kind) {
      if (kind) {
        const note = prompt(kind === 'real' ? 'Poznámka (proč není robot/tester):' : 'Poznámka (např. „můj iPhone“):', (OVERRIDES.get(iid) || {}).note || '');
        if (note === null) return;
        await setDoc(doc(db, 'tester_installs', iid), { kind, note, at: serverTimestamp() }); OVERRIDES.set(iid, { kind, note });
      } else { await deleteDoc(doc(db, 'tester_installs', iid)); OVERRIDES.delete(iid); }
      reclassify(); render();
    }

    async function firstLoad() {
      RAW = []; lastDoc = null; batches = 0; exhausted = false;
      // Obnovit (dashboard) volá firstLoad znovu → dočítání starší analytiky musí proběhnout znovu.
      dataReady = false; dashCoverage = false; purchaseCoverage = false;
      $('status').classList.remove('hidden');
      $('status').textContent = 'Načítám…';
      try {
        await loadInstalls().catch((e) => console.warn('ledger instalací nenačten', e));
        await loadStoreStats().catch((e) => { console.warn('store_stats nenačteny', e); RATINGS = { state: 'error', data: null }; RETENTION = { state: 'error', data: null }; });
        await loadRcEvents().catch((e) => console.warn('rc_events nenačteny', e));
        await fetchPage();
        dataReady = true; LOADED_AT = Date.now();
        buildFilterOptions();
        render();
        $('status').classList.add('hidden');
      } catch (e) {
        $('dash-updated').textContent = 'Načtení selhalo';
        $('status').innerHTML = '<span class="err">Chyba: ' + esc(e.message || e) +
          '</span><br><span style="color:var(--muted)">Pravděpodobně nejsou nasazené Firestore rules pro <code>analytics_events</code>, nebo je kolekce prázdná.</span>';
      }
    }

    $('loadOlder').onclick = async () => {
      const n = await fetchPage();
      buildFilterOptions(); render();
      if (!n || exhausted) $('loadOlder').textContent = 'Historie kompletní';
    };
    $('loadAll').onclick = async () => {
      $('loadAll').textContent = 'Načítám…';
      let guard = 0;
      while (!exhausted && guard++ < 200) { await fetchPage(); }
      buildFilterOptions(); render();
      $('loadAll').textContent = 'Vše načteno';
    };

    // --- Filtry ---
    const FILTERS = { text:'', installId:'', event:'', platform:'', locale:'', build:'', type:'', from:'', to:'', testers:false };
    $('f-testers').onchange = (ev) => { FILTERS.testers = ev.target.checked; render(); };

    function buildFilterOptions() {
      const fill = (id, vals, label) => {
        const sel = $(id); const cur = sel.value;
        const opts = [...new Set(vals.filter(Boolean))].sort();
        sel.innerHTML = '<option value="">' + label + ': vše</option>' +
          opts.map((v) => '<option value="' + esc(v) + '">' + esc(v) + '</option>').join('');
        sel.value = cur; // zachovej výběr po reloadu
      };
      fill('f-event', RAW.map((e) => e.name), 'Event');
      fill('f-platform', RAW.map((e) => e.dev.platform), 'Platforma');
      fill('f-locale', RAW.map((e) => e.dev.locale), 'Jazyk');
      fill('f-build', RAW.map((e) => e.dev.appBuild != null ? String(e.dev.appBuild) : ''), 'Build');
      fill('f-type', RAW.map((e) => e.dev.type), 'Typ');
    }

    function applyFilters(arr) {
      const text = FILTERS.text.trim().toLowerCase();
      const iid = FILTERS.installId.trim();
      const fromTs = FILTERS.from ? new Date(FILTERS.from).getTime() : null;
      const toTs = FILTERS.to ? new Date(FILTERS.to).getTime() + 86400000 : null; // celý „do" den včetně
      return arr.filter((e) => {
        if (!Number.isFinite(e.ts)) return false;
        if (!FILTERS.testers && isExcluded(e.installId, e.dev)) return false;
        if (FILTERS.event && e.name !== FILTERS.event) return false;
        if (FILTERS.platform && e.dev.platform !== FILTERS.platform) return false;
        if (FILTERS.locale && e.dev.locale !== FILTERS.locale) return false;
        if (FILTERS.build && String(e.dev.appBuild) !== FILTERS.build) return false;
        if (FILTERS.type && e.dev.type !== FILTERS.type) return false;
        if (iid && !String(e.installId || '').startsWith(iid)) return false;
        if (fromTs && e.ts < fromTs) return false;
        if (toTs && e.ts >= toTs) return false;
        if (text) {
          const hay = (e.name + ' ' + JSON.stringify(e.props) + ' ' + (e.dev.model || '') + ' ' + (e.dev.locale || '')).toLowerCase();
          if (!hay.includes(text)) return false;
        }
        return true;
      });
    }

    // filter event wiring
    let textTimer = null;
    $('f-text').oninput = (ev) => { clearTimeout(textTimer); const v = ev.target.value; textTimer = setTimeout(() => { FILTERS.text = v; render(); }, 200); };
    $('f-iid').oninput = (ev) => { clearTimeout(textTimer); const v = ev.target.value; textTimer = setTimeout(() => { FILTERS.installId = v; render(); }, 200); };
    ['event','platform','locale','build','type'].forEach((k) => { $('f-' + k).onchange = (ev) => { FILTERS[k] = ev.target.value; render(); }; });
    $('f-from').onchange = (ev) => { FILTERS.from = ev.target.value; setQuickActive(null); render(); };
    $('f-to').onchange = (ev) => { FILTERS.to = ev.target.value; setQuickActive(null); render(); };
    $('quick').querySelectorAll('button').forEach((b) => { b.onclick = () => {
      const d = +b.dataset.d;
      FILTERS.to = '';
      FILTERS.from = d ? new Date(Date.now() - d * 86400000).toISOString().slice(0, 10) : '';
      $('f-from').value = FILTERS.from; $('f-to').value = '';
      setQuickActive(b); render();
    }; });
    function setQuickActive(btn) { $('quick').querySelectorAll('button').forEach((x) => x.classList.toggle('on', x === btn)); }
    $('f-clear').onclick = () => {
      Object.keys(FILTERS).forEach((k) => FILTERS[k] = '');
      ['f-text','f-iid','f-from','f-to'].forEach((id) => $(id).value = '');
      ['f-event','f-platform','f-locale','f-build','f-type'].forEach((id) => $(id).value = '');
      setQuickActive($('quick').querySelector('[data-d="0"]'));
      render();
    };

    // --- Záložky ---
    const TABS = ['dashboard','prehled','vyzkum','technika','nakupy'];
    let activeTab = (location.hash || '#dashboard').slice(1);
    if (!TABS.includes(activeTab)) activeTab = 'dashboard';
    function setTab(t) {
      activeTab = t; location.hash = t;
      $('tabs').querySelectorAll('.tab').forEach((b) => b.classList.toggle('active', b.dataset.tab === t));
      TABS.forEach((x) => $('tab-' + x).classList.toggle('hidden', x !== t));
      // Dashboard filtry nepoužívá (vždy bez testerů a robotů) → lišta filtrů jen na ostatních záložkách.
      document.querySelector('.filters').classList.toggle('hidden', t === 'dashboard');
      render();
    }
    $('tabs').querySelectorAll('.tab').forEach((b) => b.onclick = () => setTab(b.dataset.tab));

    // --- agregační helpery ---
    function countBy(arr, keyFn) {
      const m = new Map();
      for (const x of arr) { const k = keyFn(x); if (k == null || k === '') continue; m.set(k, (m.get(k) || 0) + 1); }
      return [...m.entries()].sort((a, b) => b[1] - a[1]);
    }
    const uniqInstalls = (arr) => new Set(arr.map((e) => e.installId)).size;
    function barPanel(title, pairs, color, max, hint) {
      const top = max ? pairs.slice(0, max) : pairs;
      const hi = (top.length ? Math.max(...top.map((p) => p[1])) : 0) || 1;
      // Volitelný třetí prvek = text místo čísla (např. „–“ u dne bez dat); takový řádek nemá pruh.
      const rows = top.map(([k, v, txt]) => `
        <div class="bar"><span class="lbl">${esc(k)}</span><span class="val">${txt != null ? esc(txt) : v}</span>
        <div class="track">${txt != null ? '' : `<div class="fill" style="width:${Math.max(2, (v / hi) * 100)}%;${color ? 'background:' + color : ''}"></div>`}</div></div>`).join('');
      const h = hint ? ` <span class="hint">${esc(hint)}</span>` : '';
      return `<div class="panel"><h3>${esc(title)}${h}</h3>${rows || '<p style="color:var(--muted)">Žádná data.</p>'}</div>`;
    }
    function funnelPanel(title, steps, ev) {
      const installsWith = (name) => new Set(ev.filter((e) => e.name === name).map((e) => e.installId));
      return funnelFromSets(title, steps.map((s) => [s, installsWith(s)]));
    }
    /** Trychtýř z hotových množin instalací: [[popisek, Set(installId)], …]. */
    function funnelFromSets(title, pairs, hint) {
      const steps = pairs.map(([label]) => label);
      const sets = pairs.map(([, set]) => set);
      const base = sets[0].size || 1;
      const rows = steps.map((s, i) => {
        const c = sets[i].size; const pct = Math.round((c / base) * 100);
        // Krok-na-krok konverze: kolik % z PŘEDCHOZÍHO kroku se dostalo sem (+ absolutní úbytek).
        let conv = '';
        if (i > 0) {
          const prev = sets[i - 1].size;
          const stepPct = prev ? Math.round((c / prev) * 100) : 0;
          const drop = prev - c;
          conv = `<div class="conv">↳ ${stepPct}&nbsp;% z předchozího${drop > 0 ? `<span class="drop">−${drop}</span>` : ''}</div>`;
        }
        return `<div class="step"><div class="bar"><span class="lbl">${esc(s)}</span><span class="val">${c} <span class="pct">· ${pct}%</span></span>
          <div class="track"><div class="fill" style="width:${Math.max(2, pct)}%;background:var(--apricot)"></div></div></div>${conv}</div>`;
      }).join('');
      const h = hint ? ` <span class="hint">${esc(hint)}</span>` : '';
      return `<div class="panel funnel"><h3>${esc(title)}${h}</h3>${rows}</div>`;
    }
    const evByName = (ev, name) => ev.filter((e) => e.name === name);

    /**
     * Výsledek pokusu o nákup = hlavní metrika konverze paywallu (ZADANI_ROBOTI_A_NAKUPY B2).
     * purchase_cancelled / purchase_pending chodí od OTA build282 – starší pokusy bez výsledku
     * se počítají jako „bez záznamu“ (dřív se zrušení nelogovalo vůbec).
     */
    function purchaseOutcomePanel(ev) {
      const n = (name) => evByName(ev, name).length;
      const started = n('purchase_started');
      const rows = [
        ['dokončeno', n('purchase_completed'), 'var(--water)'],
        ['zrušeno uživatelem', n('purchase_cancelled'), 'var(--muted)'],
        ['čeká na platbu', n('purchase_pending'), '#e8c46a'],
        ['selhalo', n('purchase_failed'), '#ff8a8a'],
      ];
      const known = rows.reduce((a, r) => a + r[1], 0);
      rows.push(['bez záznamu (před build282)', Math.max(0, started - known), 'var(--line)']);
      const html = rows.map(([l, v, c]) => {
        const pct = started ? Math.round((v / started) * 100) : 0;
        return `<div class="bar"><span class="lbl">${esc(l)}</span><span class="val">${v} <span class="pct">· ${pct}%</span></span><div class="track"><div class="fill" style="width:${Math.max(2, pct)}%;background:${c}"></div></div></div>`;
      }).join('');
      return `<div class="panel funnel"><h3>Výsledek pokusu o nákup <span class="hint">${started} pokusů (purchase_started)</span></h3>${html}</div>`;
    }

    // --- Render (jen aktivní záložka kvůli výkonu) ---
    function render() {
      const ev = applyFilters(RAW);
      $('count').textContent = 'Zobrazeno ' + ev.length + ' / ' + RAW.length + ' eventů · ' + batches + ' dávek' + (exhausted ? ' (kompletní)' : ' (jsou starší – Načíst starší)');
      if (activeTab === 'dashboard') renderDashboard();
      else if (activeTab === 'prehled') renderOverview(ev);
      else if (activeTab === 'vyzkum') renderResearch(ev);
      else if (activeTab === 'nakupy') renderPurchases();
      else renderTech(ev);
    }

    function renderUsers() {
      const now = Date.now(); const DAY = 86400000;
      const all = INSTALLS.filter((i) => i.platform === 'ios' || i.platform === 'android');
      const testers = all.filter((i) => i.cls.kind === 'tester');
      const robots = all.filter((i) => i.cls.kind === 'robot');
      const users = FILTERS.testers ? all : all.filter((i) => i.cls.kind === 'real');
      const within = (ms, d) => ms !== null && now - ms <= d * DAY;
      const k = (label, v, sub) => `<div class="card"><div class="kpi">${v}<small>${label}${sub ? ' · ' + sub : ''}</small></div></div>`;
      const ios = users.filter((i) => i.platform === 'ios').length, and = users.length - ios;
      $('u-sub').textContent = (FILTERS.testers ? 'včetně ' : 'bez ') + testers.length + ' testerů a ' + robots.length + ' robotů · ' + all.length + ' zařízení v ledgeru';
      $('u-kpis').innerHTML = [
        k('zařízení celkem', users.length, `iOS ${ios} · Android ${and}`),
        k('aktivní 7 dní', users.filter((i) => within(i.lastMs, 7)).length, `30 dní ${users.filter((i) => within(i.lastMs, 30)).length}`),
        k('nové 7 dní', users.filter((i) => within(i.firstMs, 7)).length, `30 dní ${users.filter((i) => within(i.firstMs, 30)).length}`),
        k('nové 24 h', users.filter((i) => within(i.firstMs, 1)).length),
      ].join('');
      const byDay = new Map();
      for (let d = 29; d >= 0; d--) byDay.set(new Date(now - d * DAY).toLocaleDateString('cs-CZ'), 0);
      users.forEach((i) => { if (within(i.firstMs, 30)) { const key = new Date(i.firstMs).toLocaleDateString('cs-CZ'); byDay.set(key, (byDay.get(key) || 0) + 1); } });
      const regionName = (c) => { try { return c && c !== 'none' ? new Intl.DisplayNames(['cs'], { type: 'region' }).of(c) + ' (' + c + ')' : '– nehlásí (starší build)'; } catch { return c; } };
      const langName = (c) => { try { return c ? new Intl.DisplayNames(['cs'], { type: 'language' }).of(c) + ' (' + c + ')' : '–'; } catch { return c; } };
      $('u-panels').innerHTML = [
        barPanel('Nová zařízení za den (30 dní)', [...byDay.entries()], 'var(--apricot)'),
        barPanel('Jazyk aplikace', countBy(users, (i) => langName(i.locale)), 'var(--water)', 12, 'z nastavení aplikace'),
        barPanel('Země zařízení', countBy(users, (i) => regionName(i.region)), 'var(--plum)', 12, 'z nastavení telefonu; sbírá se od OTA build281'),
        barPanel('Jazyk telefonu', countBy(users, (i) => langName(i.deviceLocale === 'none' ? null : i.deviceLocale)), null, 12, 'co má člověk v systému'),
        barPanel('Build aplikace', countBy(users, (i) => i.appBuild != null ? 'build' + i.appBuild : '?'), null, 10, 'podle poslední dávky'),
        barPanel('Druh instalace', countBy(all, (i) => i.installKind), null, 8, 'app_store/device = běžní uživatelé; unknown = před build281'),
        barPanel('Klasifikace', countBy(all, (i) => i.cls.kind + (i.cls.rule ? ' · ' + i.cls.rule : i.cls.source === 'manual' ? ' · ručně' : '')), 'var(--water)', 10, 'real = počítá se do uživatelů'),
      ].join('');
    }

    function renderOverview(ev) {
      renderUsers();
      renderStoreStats();
      const tsList = ev.map((e) => e.ts).filter(Boolean);
      const sessions = new Set(ev.map((e) => e.installId + ':' + e.session)).size;
      const span = tsList.length ? Math.round((Math.max(...tsList) - Math.min(...tsList)) / 86400000) : 0;
      $('kpis').innerHTML = [
        ['Eventy', ev.length], ['Instalace', uniqInstalls(ev)], ['Relace', sessions],
        ['Rozsah (dny)', span], ['Poslední', tsList.length ? fmt(Math.max(...tsList)) : '–'],
      ].map(([l, v]) => `<div class="card"><div class="kpi">${v}<small>${l}</small></div></div>`).join('');

      $('funnels').innerHTML = [
        funnelPanel('Aktivace', ['app_open','onboarding_step','quiz_completed','breed_selected','activated'], ev),
        funnelPanel('Monetizace', ['paywall_viewed','purchase_started','purchase_completed'], ev),
        funnelPanel('Mise (→ útulek)', ['activated','article_read','graduation_reached','shelter_opened'], ev),
        purchaseOutcomePanel(ev),
      ].join('');

      $('overview-events').innerHTML = [
        barPanel('Eventy dle typu', countBy(ev, (e) => e.name), 'var(--water)', 30),
        barPanel('Otevření aplikace dle dne', countBy(evByName(ev, 'app_open'), (e) => new Date(e.ts).toLocaleDateString('cs-CZ')), 'var(--apricot)', 21),
      ].join('');
    }

    function renderResearch(ev) {
      // Onboarding funnel + dwell (průměrný čas na kroku z onboarding_step.dwellMs)
      const dwell = (() => {
        const m = new Map();
        for (const e of evByName(ev, 'onboarding_step')) {
          const k = e.props.fromStep; const d = +e.props.dwellMs;
          if (!k || !Number.isFinite(d)) continue;
          const a = m.get(k) || [0, 0]; a[0] += d; a[1]++; m.set(k, a);
        }
        return [...m.entries()].map(([k, [s, n]]) => [k + ' (' + n + '×)', Math.round(s / n / 1000)]).sort((a, b) => b[1] - a[1]);
      })();
      const flows = onboardingFlows(ev);
      $('r-funnel').innerHTML = [
        funnelFromSets('Nový onboarding (od 2.2.1) – kroky', flows.newPairs, flows.newHint),
        funnelFromSets('Původní onboarding (do 2.2.0) – kroky', flows.oldPairs, flows.oldHint),
        funnelFromSets('Pes doma z onboardingu', flows.ownerPairs, flows.ownerHint),
        barPanel('Kde odešli – nový onboarding', flows.newExits, '#ff8a8a', 8, 'poslední krok instalací, které psa nezaložily'),
        barPanel('Krok zpět (odkud → kam)', flows.backs, null, 8, 'onboarding_step s dir: back, od 2.2.1'),
        barPanel('Založení psa – zvolený režim', flows.doneModes, 'var(--water)', 4, 'step done → mode, od 2.2.1'),
        funnelPanel('Onboarding funnel (dle eventů)', ['app_open','onboarding_step','quiz_completed','breed_selected','activated'], ev),
        barPanel('Průměrný čas na kroku (s)', dwell, 'var(--plum)', 8, 'z onboarding_step.dwellMs'),
      ].join('');

      // Readiness
      const rc = evByName(ev, 'readiness_completed');
      const perQ = ['q1','q2','q3','q4','q5','q6'].map((q) => {
        const yes = rc.filter((e) => e.props[q] === 'yes').length;
        const no = rc.filter((e) => e.props[q] === 'no').length;
        const na = rc.filter((e) => e.props[q] === 'na').length;
        return [q + ': ' + yes + '× ano / ' + no + '× ne / ' + na + '× ø', yes];
      });
      $('r-readiness').innerHTML = [
        barPanel('Tier připravenosti', countBy(rc, (e) => e.props.tier), 'var(--water)', null, rc.length + '× vyplněno'),
        barPanel('Odkud vyplněno', countBy(rc, (e) => ({ first: 'karta na Domů (od 2.2.1)', again: 'zopakování na výsledku výzvy' }[e.props.phase] || 'krok onboardingu (do 2.2.0)')), 'var(--plum)', 3),
        barPanel('Odpovědi „ano" dle otázky', perQ, 'var(--apricot)', null, 'kolik z nich na danou otázku odpovědělo ano'),
      ].join('');

      // Quiz profil
      const qc = evByName(ev, 'quiz_completed');
      $('r-quiz').innerHTML = [
        barPanel('Čas na péči (q1)', countBy(qc, (e) => 'volba ' + e.props.hours), 'var(--water)'),
        barPanel('Bydlení (q2)', countBy(qc, (e) => 'volba ' + e.props.housing), 'var(--plum)'),
        barPanel('Aktivita (q3)', countBy(qc, (e) => 'volba ' + e.props.activity), 'var(--apricot)'),
      ].join('');

      // Doporučení vs výběr
      const bs = evByName(ev, 'breed_selected');
      const matched = bs.filter((e) => e.props.matchedRecommendation === true).length;
      const diff = bs.filter((e) => e.props.matchedRecommendation === false).length;
      const premiumDiff = bs.filter((e) => e.props.matchedRecommendation === false && e.props.ownsPremium === true).length;
      const premiumPicked = bs.filter((e) => e.props.isPremium === true).length;
      $('r-breed').innerHTML = [
        barPanel('Vybral doporučené plemeno?', [['ano (shoda)', matched], ['ne (jiné)', diff]], 'var(--water)'),
        barPanel('Vybraná plemena', countBy(bs, (e) => e.props.breed), null, 13),
        barPanel('Premium nabídka v onboardingu', countBy(evByName(ev, 'onboarding_premium_offer'), (e) => e.props.action), 'var(--apricot)', null, 'shown vs tapped'),
        barPanel('„Koupil premium A vybral jiné"', [['premium + jiné než doporučené', premiumDiff], ['premium plemeno vybráno', premiumPicked]], '#caa6ff', null, 'TF otázka'),
      ].join('');

      // Engagement
      const tch = countBy(evByName(ev, 'event_choice'), (e) => e.props.best ? 'nejlepší volba' : 'horší volba');
      $('r-engage').innerHTML = [
        barPanel('Splněné úkoly (task_done)', countBy(evByName(ev, 'task_done'), (e) => e.props.task), 'var(--water)'),
        barPanel('Trénink povelů (training_done)', countBy(evByName(ev, 'training_done'), (e) => e.props.command), 'var(--apricot)', 12),
        barPanel('Kvalita rozhodnutí v událostech', tch, 'var(--plum)'),
        barPanel('Sdílení (share_initiated)', countBy(evByName(ev, 'share_initiated'), (e) => e.props.kind), 'var(--water)'),
      ].join('');

      // Mise + retence + délka session
      const dayReach = (() => {
        const maxDay = new Map();
        for (const e of evByName(ev, 'day_advanced')) { const d = +e.props.day || 0; const cur = maxDay.get(e.installId) || 0; if (d > cur) maxDay.set(e.installId, d); }
        return [1, 3, 7, 14, 30].map((b) => ['den ≥ ' + b, [...maxDay.values()].filter((d) => d >= b).length]);
      })();
      const returns = (() => {
        const days = new Map();
        for (const e of evByName(ev, 'app_open')) { const k = e.installId; const set = days.get(k) || new Set(); set.add(new Date(e.ts).toDateString()); days.set(k, set); }
        const counts = [...days.values()].map((s) => s.size);
        return [['1 den', counts.filter((c) => c === 1).length], ['2–3 dny', counts.filter((c) => c >= 2 && c <= 3).length], ['4–6 dní', counts.filter((c) => c >= 4 && c <= 6).length], ['7+ dní', counts.filter((c) => c >= 7).length]];
      })();
      const sess = evByName(ev, 'session_end').map((e) => +e.props.durationSec).filter((n) => Number.isFinite(n) && n >= 0);
      const sessBuckets = [['< 30 s', sess.filter((s) => s < 30).length], ['30 s–2 min', sess.filter((s) => s >= 30 && s < 120).length], ['2–10 min', sess.filter((s) => s >= 120 && s < 600).length], ['10+ min', sess.filter((s) => s >= 600).length]];
      $('r-mission').innerHTML = [
        barPanel('Retence – instalace co dosáhly herního dne', dayReach, 'var(--apricot)'),
        barPanel('Návraty – počet odlišných dní s otevřením', returns, 'var(--water)'),
        barPanel('Délka relace (session_end)', sessBuckets, 'var(--plum)', null, sess.length + '× ukončeno'),
        barPanel('Proklik na útulek dle útulku', countBy(evByName(ev, 'shelter_opened'), (e) => e.props.shelter || '(neznámý)'), 'var(--water)', 12),
      ].join('');
    }

    /**
     * Onboarding po krocích, zvlášť nový (2.2.1: úvod → věk → 3 otázky → doporučení → plemeno →
     * jméno s režimem → hotovo) a původní (s dotazníkem připravenosti a krokem režimu).
     * „Dosáhl kroku“ = onboarding_step se step == krok (bez dir: back). Instalace se do průběhu
     * zařadí podle stop v datech (done/dir/věk → otázky = nový, readiness/mode = původní); kdo
     * odešel dřív, podle buildu: od nejnižšího buildu, kde se nový průběh objevil, je nový.
     */
    function onboardingFlows(ev) {
      const NEW = ['age', 'quiz', 'quiz_result', 'breed', 'name', 'done'];
      const OLD = ['age', 'readiness', 'quiz', 'quiz_result', 'breed', 'name', 'mode'];
      const LABEL = { intro: 'úvod (otevřeli aplikaci)', age: 'věk', readiness: 'dotazník připravenosti', quiz: '3 otázky', quiz_result: 'doporučení', breed: 'výběr plemene', name: 'jméno (+ režim od 2.2.1)', mode: 'režim', done: 'pes založen (done)', activated: 'pes založen (activated)' };
      const per = new Map(); // installId → {steps:Set, isNew, isOld, build, last:{ts,step}, minTs, activated, owner…}
      const get = (iid) => { let x = per.get(iid); if (!x) { x = { steps: new Set(), isNew: false, isOld: false, build: null, last: null, minTs: Infinity, hadStep: false, activated: false, ownerSetup: false, ownerAct: false, ownerBack: false }; per.set(iid, x); } return x; };
      const backs = new Map(); const doneModes = new Map();
      for (const e of ev) {
        const x = get(e.installId);
        const b = Number(e.dev.appBuild); if (Number.isFinite(b) && (x.build === null || b < x.build)) x.build = b;
        if (e.ts < x.minTs) x.minTs = e.ts;
        if (e.name === 'activated') x.activated = true;
        else if (e.name === 'owner_activated' && e.props.from === 'onboarding') x.ownerAct = true;
        else if (e.name === 'mode_switched' && e.props.source === 'onboarding' && e.props.from === 'owner' && e.props.to === 'trial') x.ownerBack = true;
        else if (e.name === 'onboarding_step') {
          const st = e.props.step; const from = e.props.fromStep;
          x.hadStep = true;
          if (e.props.dir === 'back') { x.isNew = true; const k = (from || '?') + ' → ' + (st || '?'); backs.set(k, (backs.get(k) || 0) + 1); continue; }
          if (st === 'owner_setup') x.ownerSetup = true;
          if (st === 'done') { x.isNew = true; const m = e.props.mode || '?'; doneModes.set(m, (doneModes.get(m) || 0) + 1); }
          if (st === 'readiness' || st === 'mode') x.isOld = true;
          if (from === 'age' && st === 'quiz') x.isNew = true;
          if (st) x.steps.add(st);
          if (!x.last || e.ts > x.last.ts) x.last = { ts: e.ts, step: st };
        }
      }
      // Jen instalace, jejichž PRVNÍ relaci máme v datech (ledger firstSeenAt ≈ první načtený event);
      // jinak by se do „úvodu“ počítali dávní uživatelé, kteří onboarding prošli dřív.
      const FIRST = new Map(INSTALLS.map((i) => [i.id, i.firstMs]));
      const all = [...per.entries()].filter(([id, x]) => { const f = FIRST.get(id); return f === null || f === undefined ? x.hadStep : x.minTs <= f + 2 * 3600000; });
      const newBuilds = all.filter(([, x]) => x.isNew && !x.isOld && x.build !== null).map(([, x]) => x.build);
      const from = newBuilds.length ? Math.min(...newBuilds) : null;
      const isNewFlow = (x) => x.isNew && !x.isOld ? true : x.isOld ? false : (from !== null && x.build !== null && x.build >= from);
      const cohort = (wantNew) => all.filter(([, x]) => isNewFlow(x) === wantNew);
      const pairs = (rows, steps) => [['úvod (otevřeli aplikaci)', new Set(rows.map(([id]) => id))], ...steps.map((st) => [LABEL[st] || st, new Set(rows.filter(([, x]) => x.steps.has(st)).map(([id]) => id))])];
      const nw = cohort(true), od = cohort(false);
      const oldPairs = pairs(od, OLD);
      oldPairs.push([LABEL.activated, new Set(od.filter(([, x]) => x.activated).map(([id]) => id))]);
      const exits = new Map();
      nw.filter(([, x]) => !x.steps.has('done') && !x.ownerAct).forEach(([, x]) => { const k = LABEL[x.last ? x.last.step : 'intro'] || (x.last && x.last.step) || '?'; exits.set(k, (exits.get(k) || 0) + 1); });
      const ownerRows = all.filter(([, x]) => x.ownerSetup);
      return {
        newPairs: pairs(nw, NEW),
        newHint: from !== null ? `instalace od buildu ${from} · ${nw.length}` : 'zatím žádná data (přijde s nativní 2.2.1)',
        oldPairs,
        oldHint: `${od.length} instalací`,
        ownerPairs: [
          ['zvolili „mám psa“', new Set(ownerRows.map(([id]) => id))],
          ['skutečný pes založen (měří se od 2.2.1)', new Set(ownerRows.filter(([, x]) => x.ownerAct).map(([id]) => id))],
        ],
        ownerHint: `${ownerRows.filter(([, x]) => x.ownerBack).length}× se vrátili na Pes na zkoušku`,
        newExits: [...exits.entries()].sort((a, b) => b[1] - a[1]),
        backs: [...backs.entries()].sort((a, b) => b[1] - a[1]),
        doneModes: [...doneModes.entries()].sort((a, b) => b[1] - a[1]),
      };
    }

    // --- Nákupy (rc_events + párování se zařízením z analytiky) ---
    const MATCH_MS = 10 * 60 * 1000;
    const productKey = (id) => {
      const s = String(id || '').toLowerCase();
      if (/lifetime/.test(s)) return 'plan_lifetime';
      if (/year|annual/.test(s)) return 'plan_yearly';
      if (/month/.test(s)) return 'plan_monthly';
      if (/bundle/.test(s)) return 'breed_bundle';
      return s.replace(/^trypup_/, '');
    };
    const PLAN_LABEL = { plan_monthly: 'Premium – měsíčně', plan_yearly: 'Premium – ročně', plan_lifetime: 'Premium – navždy', breed_bundle: 'Balíček plemen' };
    const productLabel = (key) => PLAN_LABEL[key] || (key.startsWith('breed_') ? 'Plemeno: ' + key.slice(6).split('_').map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ') : key || '?');
    const STORE_LABEL = { APP_STORE: 'App Store', PLAY_STORE: 'Google Play', MAC_APP_STORE: 'Mac App Store', AMAZON: 'Amazon', STRIPE: 'Stripe', PROMOTIONAL: 'promo RevenueCat' };
    const TYPE_LABEL = { INITIAL_PURCHASE: 'první nákup', RENEWAL: 'obnova', NON_RENEWING_PURCHASE: 'jednorázový', PRODUCT_CHANGE: 'změna tarifu', CANCELLATION: 'zrušení', EXPIRATION: 'vypršení', BILLING_ISSUE: 'problém s platbou', SUBSCRIPTION_EXTENDED: 'prodloužení', UNCANCELLATION: 'obnovené předplatné', TRANSFER: 'převod', SUBSCRIPTION_PAUSED: 'pozastavení', TEST: 'test webhooku' };
    const money = (v, cur) => { if (v === null || v === undefined || !cur) return '–'; try { return new Intl.NumberFormat('cs-CZ', { style: 'currency', currency: cur }).format(v); } catch { return v + ' ' + cur; } };
    const usd = (v) => (v === null || v === undefined) ? '' : '$' + Number(v).toFixed(2);
    const langLabel = (c) => { if (!c || c === 'none' || c === 'unknown') return '–'; try { return new Intl.DisplayNames(['cs'], { type: 'language' }).of(c) + ' (' + c + ')'; } catch { return c; } };
    let purchaseCoverage = false;

    function purchaseRows() {
      const app = RAW.filter((e) => e.name === 'purchase_completed' && e.props.product !== 'restore');
      const used = new Set();
      const rows = RC_EVENTS.filter((r) => r.isPurchase).map((r) => {
        const key = productKey(r.productId); const t = r.purchasedAtMs || r.eventAtMs || 0;
        let best = null, bestD = Infinity;
        if (r.type !== 'RENEWAL') for (const e of app) {
          if (used.has(e) || productKey(e.props.product) !== key) continue;
          const d = Math.abs(e.ts - t); if (d <= MATCH_MS && d < bestD) { best = e; bestD = d; }
        }
        if (best) used.add(best);
        return { rc: r, app: best, ts: t, key, inherited: false };
      });
      // Obnova předplatného: zařízení z prvního nákupu téhož zákazníka (hash, ne ID).
      const firstByCustomer = new Map();
      [...rows].sort((a, b) => a.ts - b.ts).forEach((x) => { if (x.app && x.rc.customer && !firstByCustomer.has(x.rc.customer)) firstByCustomer.set(x.rc.customer, x.app); });
      rows.forEach((x) => { if (!x.app && x.rc.customer && firstByCustomer.has(x.rc.customer)) { x.app = firstByCustomer.get(x.rc.customer); x.inherited = true; } });
      app.filter((e) => !used.has(e)).forEach((e) => rows.push({ rc: null, app: e, ts: e.ts, key: productKey(e.props.product), inherited: false }));
      const refunded = new Set(RC_EVENTS.filter((r) => r.type === 'CANCELLATION' && r.cancelReason === 'CUSTOMER_SUPPORT').map((r) => r.transactionId).filter(Boolean));
      rows.forEach((x) => { x.refunded = !!(x.rc && x.rc.transactionId && refunded.has(x.rc.transactionId)); x.sandbox = !!(x.rc && String(x.rc.environment || '').toUpperCase() === 'SANDBOX'); x.cls = x.app ? (CLS_BY_ID.get(x.app.installId) || (isExcluded(x.app.installId, x.app.dev) ? 'tester' : 'real')) : 'real'; });
      return rows.sort((a, b) => b.ts - a.ts);
    }

    /** Zařízení ke starším nákupům: dočti analytiku, dokud nepokryje nejstarší nákup (nejvýš 40 stránek). */
    async function ensurePurchaseCoverage() {
      if (purchaseCoverage) return; purchaseCoverage = true;
      const oldest = Math.min(...RC_EVENTS.filter((r) => r.isPurchase).map((r) => r.purchasedAtMs || Infinity));
      if (!Number.isFinite(oldest)) return;
      let guard = 0;
      const rawOldest = () => RAW.reduce((m, e) => Math.min(m, e.ts || Infinity), Infinity);
      if (rawOldest() <= oldest - MATCH_MS || exhausted) return;
      $('p-sub').textContent = '· dočítám starší analytiku kvůli zařízení…';
      while (!exhausted && guard++ < 40 && rawOldest() > oldest - MATCH_MS) await fetchPage();
      buildFilterOptions(); render();
    }

    function renderPurchases() {
      ensurePurchaseCoverage();
      const fromTs = FILTERS.from ? new Date(FILTERS.from).getTime() : null;
      const toTs = FILTERS.to ? new Date(FILTERS.to).getTime() + 86400000 : null;
      const allRows = purchaseRows();
      // Bez záznamu v RevenueCatu = nákup mimo obchod (TestFlight, interní testování Play) → jako tester.
      const rows = allRows.filter((x) => (FILTERS.testers || (x.rc && !x.sandbox && x.cls === 'real')) && (!fromTs || x.ts >= fromTs) && (!toTs || x.ts < toTs));
      const hidden = allRows.length - rows.length;
      const paid = rows.filter((x) => x.rc && !x.refunded && (x.rc.priceLocal || 0) > 0);
      const trials = rows.filter((x) => x.rc && String(x.rc.periodType || '') === 'TRIAL');
      const byCur = new Map(); paid.forEach((x) => byCur.set(x.rc.currency, (byCur.get(x.rc.currency) || 0) + x.rc.priceLocal));
      const sum = (f) => paid.reduce((a, x) => a + (Number(f(x)) || 0), 0);
      const k = (label, v, sub) => `<div class="card"><div class="kpi">${v}<small>${label}${sub ? ' · ' + sub : ''}</small></div></div>`;
      $('p-sub').textContent = `· ${RC_EVENTS.filter((r) => r.isPurchase).length} nákupů v RevenueCatu` + (hidden ? ` · skryto ${hidden} (testovací / testeři)` : '');
      $('p-kpis').innerHTML = [
        k('placených nákupů', paid.length, `plemena ${paid.filter((x) => x.key.startsWith('breed_')).length} · Premium ${paid.filter((x) => x.key.startsWith('plan_')).length}`),
        k('tržba hrubě (s DPH)', usd(sum((x) => x.rc.priceUsd)) || '$0.00', [...byCur.entries()].map(([c, v]) => money(v, c)).join(' + ') || '–'),
        k('výnos po DPH a provizi', usd(sum((x) => x.rc.proceedsUsd)) || '$0.00', 'odhad RevenueCatu'),
        k('zkušební období', trials.length, 'Premium zdarma, 0 Kč'),
        k('testovací nákupy', allRows.filter((x) => !x.rc || x.sandbox).length, FILTERS.testers ? 'v tabulce' : 'skryté, „včetně testerů“ je ukáže'),
      ].join('');
      const tag = (t, cls) => `<span class="tag ${cls || ''}">${esc(t)}</span>`;
      const head = '<tr><th>Čas</th><th>Co koupil</th><th>Částka</th><th>Výnos</th><th>Obchod</th><th>Země</th><th>Zařízení</th><th>Jazyk aplikace</th><th>Jazyk telefonu</th><th>Build</th><th>Druh</th><th>Pozn.</th></tr>';
      const body = rows.map((x) => {
        const r = x.rc, d = x.app ? x.app.dev : null;
        const notes = [
          !r ? tag('jen z aplikace', 'auto') : '',
          r && !x.app ? tag('zařízení nespárováno') : '',
          x.inherited ? tag('zařízení z 1. nákupu') : '',
          x.refunded ? tag('vráceno', 'manual') : '',
          x.sandbox ? tag('sandbox', 'auto') : '',
          x.cls !== 'real' ? tag(x.cls, 'manual') : '',
        ].join(' ');
        const what = productLabel(x.key) + (r && r.periodType === 'TRIAL' ? ' · zkušební období' : '');
        const amount = r ? money(r.priceLocal, r.currency) + (r.priceUsd !== null && r.priceUsd !== undefined ? ` <span style="color:var(--muted)">(${usd(r.priceUsd)})</span>` : '') : '–';
        // `os` u starších buildů Androidu nese celý otisk sestavení → platforma + verze.
        const device = d ? esc((d.model || '?') + ' · ' + (d.platform === 'ios' ? 'iOS' : d.platform === 'android' ? 'Android' : (d.platform || '')) + ' ' + (d.osVersion || '')) : '–';
        return `<tr class="${x.cls !== 'real' || x.sandbox ? 'tester' : ''}"><td>${esc(fmt(x.ts))}</td><td>${esc(what)}</td><td>${amount}</td><td>${r ? esc(usd(r.proceedsUsd) || '–') : '–'}</td>` +
          `<td>${esc(r ? (STORE_LABEL[r.store] || r.store || '?') : (d && d.platform === 'ios' ? 'App Store?' : d ? 'Google Play?' : '?'))}</td><td>${esc((r && r.countryCode) || (d && d.region !== 'none' && d.region) || '–')}</td>` +
          `<td>${device}</td><td>${esc(d ? langLabel(d.locale) : '–')}</td><td>${esc(d ? langLabel(d.deviceLocale) : '–')}</td><td>${esc(d && d.appBuild != null ? d.appBuild : '–')}</td>` +
          `<td>${esc(r ? (TYPE_LABEL[r.type] || r.type) : 'purchase_completed')}</td><td>${notes}</td></tr>`;
      }).join('');
      $('p-table').innerHTML = head + (body || '<tr><td colspan="12" style="color:var(--muted)">Žádné nákupy (nebo jsou skryté filtrem).</td></tr>');
      const matched = paid.filter((x) => x.app);
      $('p-panels').innerHTML = [
        barPanel('Placené nákupy podle produktu', countBy(paid, (x) => productLabel(x.key)), 'var(--apricot)', 12),
        barPanel('Podle obchodu', countBy(paid, (x) => STORE_LABEL[x.rc.store] || x.rc.store || '?'), 'var(--water)', 4),
        barPanel('Podle země', countBy(paid, (x) => x.rc.countryCode || '?'), 'var(--plum)', 12, 'země účtu v obchodě'),
        barPanel('Podle jazyka aplikace', countBy(matched, (x) => langLabel(x.app.dev.locale)), 'var(--water)', 12, matched.length + ' spárováno se zařízením'),
        barPanel('Podle zařízení', countBy(matched, (x) => x.app.dev.model || '?'), null, 12),
      ].join('');
      const other = RC_EVENTS.filter((r) => !r.isPurchase && r.type !== 'TEST' && (FILTERS.testers || String(r.environment || '').toUpperCase() !== 'SANDBOX')).sort((a, b) => (b.eventAtMs || 0) - (a.eventAtMs || 0));
      $('p-other').innerHTML = '<tr><th>Čas</th><th>Událost</th><th>Produkt</th><th>Důvod</th><th>Obchod</th><th>Země</th></tr>' + (other.map((r) => `<tr><td>${esc(fmt(r.eventAtMs || r.purchasedAtMs))}</td><td>${esc(TYPE_LABEL[r.type] || r.type)}</td><td>${esc(productLabel(productKey(r.productId)))}</td><td>${esc(r.cancelReason || r.expirationReason || '–')}</td><td>${esc(STORE_LABEL[r.store] || r.store || '?')}</td><td>${esc(r.countryCode || '–')}</td></tr>`).join('') || '<tr><td colspan="6" style="color:var(--muted)">Žádné.</td></tr>');
    }

    function renderTech(ev) {
      $('t-devices').innerHTML = [
        barPanel('Platforma', countBy(ev, (e) => e.dev.platform), 'var(--water)'),
        barPanel('Model zařízení', countBy(ev, (e) => e.dev.model), null, 12),
        barPanel('OS verze', countBy(ev, (e) => (e.dev.os || '') + ' ' + (e.dev.osVersion || '')), null, 10),
        barPanel('Typ', countBy(ev, (e) => e.dev.type), 'var(--plum)'),
        barPanel('Build aplikace', countBy(ev, (e) => e.dev.appBuild != null ? 'build' + e.dev.appBuild : '?')),
        barPanel('Jazyk', countBy(ev, (e) => e.dev.locale), 'var(--apricot)'),
      ].join('');

      $('t-quality').innerHTML = [
        barPanel('Chyby (app_error) dle kontextu', countBy(evByName(ev, 'app_error'), (e) => e.props.context || '?'), '#ff8a8a', 12),
        barPanel('Selhané nákupy – kód chyby', countBy(evByName(ev, 'purchase_failed'), (e) => (e.props.code || e.props.reason || '?') + (e.props.code && e.props.reason && e.props.code !== e.props.reason ? ' (' + e.props.reason + ')' : '')), '#ff8a8a', 12, 'code = název chyby RevenueCatu (od build282), dřív jen reason'),
        barPanel('Selhané nákupy – produkt', countBy(evByName(ev, 'purchase_failed'), (e) => e.props.product || '?'), '#ff8a8a', 10),
        barPanel('Selhané nákupy – platforma', countBy(evByName(ev, 'purchase_failed'), (e) => e.dev.platform || '?'), '#ff8a8a'),
        barPanel('Selhané nákupy – hláška', countBy(evByName(ev, 'purchase_failed'), (e) => (e.props.message || e.props.underlying || '').slice(0, 80) || '(bez hlášky)'), null, 8),
        barPanel('GPS odmítnuto', countBy(evByName(ev, 'gps_denied'), () => 'gps_denied'), '#ff8a8a'),
        barPanel('Fail-state (pes do útulku) dle dne', countBy(evByName(ev, 'fail_state'), (e) => 'den ' + (e.props.day ?? '?')), '#ff8a8a'),
      ].join('');

      // Ledger instalací s označením testerů (řazeno podle poslední aktivity).
      const iidFilter = FILTERS.installId.trim();
      const rows = [...INSTALLS]
        .filter((i) => !iidFilter || i.id.startsWith(iidFilter))
        .sort((a, b) => (b.lastMs || 0) - (a.lastMs || 0))
        .slice(0, 300);
      $('i-sub').textContent = rows.length + ' z ' + INSTALLS.length;
      $('inst').innerHTML = `<tr><th>installId</th><th>platforma</th><th>model</th><th>OS</th><th>jazyk</th><th>země</th><th>build</th><th>první</th><th>poslední</th><th>druh</th><th></th></tr>` +
        rows.map((i) => {
          const c = i.cls; const o = OVERRIDES.get(i.id);
          const title = o ? esc(o.note || '') : (c.rule || '');
          const tag = c.kind === 'robot' ? `<span class="tag ${c.source === 'manual' ? 'manual' : 'auto'}" title="${title}">robot${c.source === 'auto' ? ' (auto)' : ''}</span>`
            : c.kind === 'tester' ? `<span class="tag ${c.source === 'manual' ? 'manual' : 'auto'}" title="${title}">tester${c.source === 'auto' ? ' (auto)' : ''}</span>`
            : `<span class="tag store" title="${title}">${o ? 'real (ručně)' : esc(i.installKind)}</span>`;
          const btns = o
            ? `<button class="ghost" style="padding:3px 8px;font-size:11px" data-ov="${esc(i.id)}" data-kind="">zrušit přepis</button>`
            : c.kind === 'real'
              ? `<button class="ghost" style="padding:3px 8px;font-size:11px" data-ov="${esc(i.id)}" data-kind="tester">tester</button> <button class="ghost" style="padding:3px 8px;font-size:11px" data-ov="${esc(i.id)}" data-kind="robot">robot</button>`
              : `<button class="ghost" style="padding:3px 8px;font-size:11px" data-ov="${esc(i.id)}" data-kind="real">není ${c.kind}</button>`;
          return `<tr class="${c.kind !== 'real' ? 'tester' : ''}"><td><span class="iid" data-iid="${esc(i.id)}" style="cursor:pointer">${esc(i.id.slice(0, 10))}</span></td><td>${esc(i.platform || '?')}</td><td>${esc(i.model || '')}</td><td>${esc((i.os || '') + ' ' + (i.osVersion || ''))}</td><td>${esc(i.locale || '')}${i.deviceLocale && i.deviceLocale !== 'none' && i.deviceLocale !== i.locale ? ' <span style="color:var(--muted)">(' + esc(i.deviceLocale) + ')</span>' : ''}</td><td>${esc(i.region && i.region !== 'none' ? i.region : '')}</td><td>${i.appBuild ?? ''}</td><td>${i.firstMs ? fmt(i.firstMs) : ''}</td><td>${i.lastMs ? fmt(i.lastMs) : ''}</td><td>${tag}</td>
            <td style="white-space:nowrap">${btns}</td></tr>`;
        }).join('');
      $('inst').querySelectorAll('button[data-ov]').forEach((b) => b.onclick = () => setOverride(b.dataset.ov, b.dataset.kind || null).catch((e) => alert('Nepodařilo se uložit: ' + e.message)));
      $('inst').querySelectorAll('.iid').forEach((el) => el.onclick = () => { FILTERS.installId = el.dataset.iid; $('f-iid').value = el.dataset.iid; render(); });

      const recent = [...ev].sort((a, b) => b.ts - a.ts).slice(0, 80);
      $('feed').innerHTML = recent.map((e) => `<div class="row">
        <span><span class="ev">${esc(e.name)}</span> ${e.props && Object.keys(e.props).length ? '<span class="pill">' + esc(Object.entries(e.props).map(([k, v]) => k + '=' + v).join(' ')) + '</span>' : ''}</span>
        <span class="meta"><span class="iid" data-iid="${esc(e.installId || '')}">${esc((e.installId || '?').slice(0, 6))}</span> · ${esc(e.dev.model || e.dev.platform || '?')} · ${esc(e.dev.locale || '')} · ${fmt(e.ts)}</span>
      </div>`).join('') || '<p style="color:var(--muted)">Žádné eventy.</p>';
      // drill-down: klik na installId ve feedu → nastav filtr + zůstaň
      $('feed').querySelectorAll('.iid').forEach((el) => el.onclick = () => {
        FILTERS.installId = el.dataset.iid; $('f-iid').value = el.dataset.iid; render();
      });
    }

    // --- DASHBOARD (dlaždice) ---
    // Vždy bez testerů a robotů: zařízení podle i.cls.kind === 'real', eventy přes isExcluded,
    // nákupy stejným pravidlem jako Nákupy (rc && !sandbox && cls === 'real', bez vrácených).
    const DAY_MS = 86400000;
    let dataReady = false;        // první načtení doběhlo (dashboard do té doby nic nepočítá)
    let LOADED_AT = null;         // čas posledního načtení (hlavička „Aktualizováno …“)
    let dashCoverage = false;     // dočítání analytiky na 30 dní už spuštěno
    let dashCovering = false;     // … a právě běží
    let dashCoverPromise = null;
    let refreshing = false;       // tlačítko Obnovit právě načítá

    // Kurzy: 1× za načtení stránky, Frankfurter (ECB), základ CZK → {rates:{EUR:0.04,…}} = 1 Kč v cizí měně.
    // Pozor: stará adresa api.frankfurter.app jen přesměrovává (301 bez CORS) → v prohlížeči selže.
    const FALLBACK_USD_CZK = 21.0;
    let FX = null, fxPromise = null; // FX = {rates, date} | {failed:true}
    function loadFx() {
      if (fxPromise) return fxPromise;
      const signal = typeof AbortSignal !== 'undefined' && AbortSignal.timeout ? AbortSignal.timeout(8000) : undefined;
      fxPromise = fetch('https://api.frankfurter.dev/v1/latest?base=CZK', { signal })
        .then((r) => r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status)))
        .then((j) => { FX = j && j.rates && typeof j.rates === 'object' ? { rates: j.rates, date: j.date || null } : { failed: true }; })
        .catch((e) => { console.warn('kurzy nenačteny', e); FX = { failed: true }; })
        .then(() => { if (activeTab === 'dashboard') renderDashboard(); });
      return fxPromise;
    }
    const usdCzk = () => { const r = FX && FX.rates ? Number(FX.rates.USD) : NaN; return r > 0 ? { rate: 1 / r, approx: false } : { rate: FALLBACK_USD_CZK, approx: true }; };
    /** Částka v měně nákupu → Kč. Bez kurzu měny (nebo bez kurzů vůbec) přes USD → approx. */
    function toCzk(amount, cur, amountUsd) {
      const a = amount === null || amount === undefined ? NaN : Number(amount);
      const c = String(cur || '').toUpperCase();
      if (c === 'CZK' && Number.isFinite(a)) return { czk: a, approx: false, ecb: false };
      const r = FX && FX.rates ? Number(FX.rates[c]) : NaN;
      if (Number.isFinite(a) && r > 0) return { czk: a / r, approx: false, ecb: true };
      const u = amountUsd === null || amountUsd === undefined ? NaN : Number(amountUsd);
      return { czk: Number.isFinite(u) ? u * usdCzk().rate : 0, approx: true, ecb: false };
    }

    const nf = (v, d = 0) => { const x = Number(v); return Number.isFinite(x) ? x.toLocaleString('cs-CZ', { minimumFractionDigits: d, maximumFractionDigits: d }) : '–'; };
    const czkFmt = (v) => nf(Math.round(v)) + ' Kč';
    const pctFmt = (a, b, d = 0) => b ? nf((a / b) * 100, d) + ' %' : '–';
    const anyMs = (v) => {
      const t = tsMs(v); if (t !== null) return t;
      if (v instanceof Date) return v.getTime();
      if (v && typeof v === 'object' && Number.isFinite(Number(v.seconds))) return Number(v.seconds) * 1000;
      if (typeof v === 'string') { const p = Date.parse(v); return Number.isFinite(p) ? p : null; }
      return null;
    };
    const rtf = typeof Intl.RelativeTimeFormat === 'function' ? new Intl.RelativeTimeFormat('cs', { numeric: 'auto' }) : null;
    function ago(ms) {
      if (!Number.isFinite(ms)) return '';
      const s = (ms - Date.now()) / 1000, a = Math.abs(s);
      if (!rtf) return fmt(ms);
      if (a < 60) return 'právě teď';
      if (a < 3600) return rtf.format(Math.round(s / 60), 'minute');
      if (a < 86400) return rtf.format(Math.round(s / 3600), 'hour');
      if (a < 86400 * 60) return rtf.format(Math.round(s / 86400), 'day');
      return rtf.format(Math.round(s / (86400 * 30)), 'month');
    }
    const regionLabel = (c) => { try { return new Intl.DisplayNames(['cs'], { type: 'region' }).of(String(c)) || String(c); } catch { return String(c); } };
    const isoDay = (ms) => new Date(ms).toISOString().slice(0, 10);
    const dayLabel = (iso) => /^\d{4}-\d{2}-\d{2}$/.test(String(iso || '')) ? (+iso.slice(8, 10)) + '. ' + (+iso.slice(5, 7)) + '.' : '–';

    // Analytika je stránkovaná po dávkách (lastTs sestupně). 30 dní je pokryto, když kurzor (nejstarší
    // načtená dávka) je starší než 30 dní – všechny nenačtené dávky jsou ještě starší – nebo už není co načíst.
    const rawOldest = () => RAW.reduce((m, e) => Math.min(m, Number.isFinite(e.ts) ? e.ts : Infinity), Infinity);
    const cursorTs = () => { const v = lastDoc && typeof lastDoc.get === 'function' ? tsMs(lastDoc.get('lastTs')) : null; return v !== null ? v : rawOldest(); };
    const dashCovered = () => exhausted || cursorTs() <= Date.now() - 30 * DAY_MS;
    function ensureDashCoverage() {
      if (dashCoverage || DEMO) return dashCoverPromise;
      dashCoverage = true;
      if (dashCovered()) return dashCoverPromise;
      dashCovering = true;
      dashCoverPromise = (async () => {
        let pages = 0, waits = 0;
        while (!dashCovered() && pages < 40 && waits < 300) {
          // Souběh s jiným dočítáním (Nákupy): fetchPage by vrátil 0 → počkej, nepočítej jako stránku.
          if (loading) { waits++; await new Promise((r) => setTimeout(r, 100)); continue; }
          const n = await fetchPage(); pages++;
          if (!n) break;
        }
      })().catch((e) => console.warn('dočtení analytiky na 30 dní selhalo', e))
        .finally(() => { dashCovering = false; buildFilterOptions(); render(); });
      return dashCoverPromise;
    }

    /** Dlaždice. Všechny řetězce jsou už HTML – hodnoty z Firestore musí volající prohnat esc(). */
    function tile({ title, big, cells, list, sub, desc, alert }) {
      return `<div class="tile${alert ? ' alert' : ''}"><div class="t-title">${title}</div>` +
        (big !== undefined ? `<div class="t-big">${big}</div>` : '') +
        (cells ? `<div class="t-cells c${cells.length}">${cells.map(([v, l]) => `<div class="t-cell"><b>${v}</b><span>${l}</span></div>`).join('')}</div>` : '') +
        (list ? `<div class="t-list">${list.map(([l, v]) => `<div><span>${l}</span><b>${v}</b></div>`).join('')}</div>` : '') +
        (sub ? `<div class="t-sub">${sub}</div>` : '') +
        (desc ? `<div class="t-desc">${desc}</div>` : '') + '</div>';
    }
    const section = (title, tiles) => `<h2>${title}</h2><div class="tiles">${tiles.join('')}</div>`;

    function renderDashboard() {
      if (!$('dash-tiles')) return;
      if (!dataReady) { $('dash-updated').textContent = 'Načítám…'; $('dash-cover').textContent = ''; return; }
      ensureDashCoverage();
      loadFx();
      const now = Date.now();
      const within = (ms, d) => ms !== null && ms !== undefined && now - ms <= d * DAY_MS;
      $('dash-updated').textContent = (DEMO ? 'Demo · ' : '') + 'Aktualizováno ' + (LOADED_AT ? fmt(LOADED_AT) : '–') + ' · bez testerů a robotů';
      const oldestEv = rawOldest();
      $('dash-cover').textContent = DEMO ? '' : dashCovering ? '· dočítám události za 30 dní…'
        : dashCovered() ? '' : '· události načtené jen od ' + (Number.isFinite(oldestEv) ? fmt(oldestEv) : '–') + ' (Načíst starší)';
      $('dash-refresh').disabled = refreshing || dashCovering;

      // ── Uživatelé (ledger instalací) ──
      const real = INSTALLS.filter((i) => (i.platform === 'ios' || i.platform === 'android') && i.cls && i.cls.kind === 'real');
      const PERIODS = [[1, '24 h'], [7, '7 dní'], [14, '14 dní'], [30, '30 dní']];
      const storeSince = (d) => isoDay(now - d * DAY_MS);
      const storeSum = (d, plat) => STORE.filter((x) => (!plat || x.platform === plat) && x.date >= storeSince(d)).reduce((a, x) => a + storeN(x), 0);
      const storeLast = (plat) => STORE.filter((x) => x.platform === plat).map((x) => String(x.date)).sort().slice(-1)[0] || null;
      const tInstalls = tile({
        title: 'Instalace',
        cells: PERIODS.map(([d, l]) => [nf(real.filter((i) => within(i.firstMs, d)).length), l]),
        // Velká čísla = naše měření (první spuštění). Obchody jen pro srovnání: počítají stažení
        // (i neotevřená) a data vydávají se zpožděním, proto jen 30 dní a s datem, do kdy je mají.
        sub: STORE.length ? `Pro srovnání oficiálně z obchodů za 30 dní: ${nf(storeSum(30))} stažení <span style="color:var(--muted)">(App Store má data do ${esc(dayLabel(storeLast('ios')))}, Google Play do ${esc(dayLabel(storeLast('android')))}; stažení se počítá i bez otevření aplikace)</span>` : 'Obchody: zatím žádná data',
        desc: 'velká čísla = naše měření: zařízení, která aplikaci poprvé spustila (bez testerů a robotů)',
      });
      const iosN = real.filter((i) => i.platform === 'ios').length;
      const tActive = tile({
        title: 'Aktivní uživatelé',
        cells: PERIODS.map(([d, l]) => [nf(real.filter((i) => within(i.lastMs, d)).length), l]),
        sub: `Zařízení celkem: ${nf(real.length)} (iOS ${nf(iosN)} · Android ${nf(real.length - iosN)})`,
        desc: 'zařízení, která aplikaci v tom období otevřela',
      });
      // Klasická retence (den N přesně, kalendářní dny v Praze) po režimech – srovnatelná s trhem.
      // Počítá ji server denně (functions/cohortRetention.js), sem jdou jen počty (Number()).
      const RS = RETENTION.state === 'ok' ? RETENTION.data : null;
      const seg = (k) => (RS && RS.segments && RS.segments[k]) || null;
      // Pod 10 zařízení by procenta klamala (1 z 1 = 100 %) → ukaž jen počet.
      const rPct = (x) => {
        const n = x ? Number(x.n) || 0 : 0, k = x ? Number(x.k) || 0 : 0;
        if (!n) return '–';
        return n < 10 ? `<span>${nf(k)}/${nf(n)}</span>` : pctFmt(k, n);
      };
      const DCOLS = [['d1', 'D1'], ['d7', 'D7'], ['d30', 'D30']];
      const SEG_ROWS = [['challenge', '30denní výzva'], ['trial', 'Pes na zkoušku bez výzvy'], ['owner', 'Pes doma'], ['notActivated', 'Psa nezaložili']];
      const allSeg = seg('all');
      const tRetention = tile({
        title: 'Retence',
        cells: allSeg
          ? DCOLS.map(([k, l]) => [rPct(allSeg[k]), `${l} · z ${nf(Number(allSeg[k] && allSeg[k].n) || 0)} zařízení`])
          : [['–', RETENTION.state === 'error' ? 'nepodařilo se načíst' : 'čeká na první výpočet']],
        sub: allSeg
          ? '<table class="t-ret"><tr><th>Podle režimu</th>' + DCOLS.map(([, l]) => `<th>${l}</th>`).join('') + '</tr>'
            + SEG_ROWS.map(([k, l]) => { const s = seg(k); return `<tr><td>${l} <span>(${nf(Number(s && s.installs) || 0)})</span></td>` + DCOLS.map(([d]) => `<td>${s ? rPct(s[d]) : '–'}</td>`).join('') + '</tr>'; }).join('')
            + '<tr class="mkt"><td>Průměr aplikací na trhu</td><td>26 %</td><td>13 %</td><td>7 %</td></tr></table>'
          : '',
        desc: 'podíl zařízení, která aplikaci otevřela přesně 1., 7. a 30. den po prvním spuštění – stejně jako srovnávací studie trhu (Adjust, AppsFlyer); v závorce počet zařízení, při méně než 10 zařízeních jen počet (vrátilo se / základ); bez testerů a robotů; přepočet jednou denně'
          + (RS && anyMs(RS.updatedAt) ? ' · ' + esc(fmt(anyMs(RS.updatedAt))) : ''),
      });
      const new7 = real.filter((i) => within(i.firstMs, 7));
      const byRegion = countBy(new7, (i) => i.region && i.region !== 'none' ? String(i.region) : null);
      const noRegion = new7.length - byRegion.reduce((a, [, v]) => a + v, 0);
      const tCountries = tile({
        title: 'Nové instalace podle země (7 dní)',
        list: byRegion.length ? byRegion.slice(0, 3).map(([c, v]) => [esc(regionLabel(c)), nf(v)]) : null,
        big: byRegion.length ? undefined : '–',
        sub: noRegion > 0 ? `Bez údaje o zemi: ${nf(noRegion)}` : '',
        desc: 'tři nejčastější země z nastavení telefonu u nových zařízení za 7 dní',
      });

      // ── Peníze (RevenueCat) ──
      const allP = purchaseRows();
      const prow = allP.filter((x) => x.rc && !x.sandbox && x.cls === 'real' && !x.refunded);
      const paid = prow.filter((x) => (Number(x.rc.priceLocal) || 0) > 0);
      const isPlan = (x) => x.key.startsWith('plan_'), isBreed = (x) => x.key.startsWith('breed_');
      const lastTile = (title, x, emptyText, extra) => {
        if (!x) return tile({ title, big: '–', sub: extra || '', desc: emptyText });
        const r = x.rc;
        const where = [fmt(x.ts), r.countryCode ? regionLabel(r.countryCode) : null, STORE_LABEL[r.store] || r.store || null].filter(Boolean).map(esc).join(' · ');
        return tile({
          title,
          big: esc(money(r.priceLocal, r.currency)),
          sub: `${esc(productLabel(x.key))} · ${esc(TYPE_LABEL[r.type] || r.type || '')}<br>${where}` + (extra ? '<br>' + extra : ''),
          desc: esc(ago(x.ts)) + ' · cena v měně nákupu včetně DPH',
        });
      };
      const lastTrial = prow.find((x) => isPlan(x) && String(x.rc.periodType || '') === 'TRIAL');
      const tLastPremium = lastTile('Poslední nákup Premium', paid.find(isPlan), 'zatím žádný placený nákup Premium',
        lastTrial ? 'Poslední zkušební období: ' + esc(ago(lastTrial.ts)) : '');
      const tLastBreed = lastTile('Poslední nákup plemene (in-app)', paid.find(isBreed), 'zatím žádný nákup plemene');

      let gross = 0, grossApprox = false, grossEcb = false;
      paid.forEach((x) => { const c = toCzk(x.rc.priceLocal, x.rc.currency, x.rc.priceUsd); gross += c.czk; if (c.approx) grossApprox = true; if (c.ecb) grossEcb = true; });
      const usdRate = usdCzk();
      const proceeds = paid.reduce((a, x) => a + (Number(x.rc.proceedsUsd) || 0), 0) * usdRate.rate;
      const fxNote = !paid.length ? 'zatím žádný placený nákup'
        : grossApprox ? (FX === null ? 'kurz se načítá, zatím přibližně přes USD' : 'přepočet přibližně přes USD' + (usdRate.approx ? ' (kurz nedostupný, 1 USD = ' + nf(FALLBACK_USD_CZK, 0) + ' Kč)' : ''))
        : grossEcb ? 'přepočteno kurzem ECB' + (FX && FX.date ? ' z ' + esc(dayLabel(FX.date)) : '') : 'vše placeno v Kč';
      const tTotal = tile({
        title: 'Nákupy celkem',
        big: (grossApprox ? '≈ ' : '') + czkFmt(gross),
        sub: `Placené nákupy: ${nf(paid.length)} (Premium ${nf(paid.filter(isPlan).length)} · plemena ${nf(paid.filter(isBreed).length)})<br>` +
          `Výnos po DPH a provizi obchodu: ≈ ${czkFmt(proceeds)}`,
        desc: 'všechny placené nákupy od začátku, hrubě včetně DPH; ' + fxNote,
      });

      // Aktivní Premium: zákazník má nevrácený nákup „navždy“, nebo jeho nejnovější událost předplatného
      // (měsíčně/ročně) není vypršení ani vrácení peněz a expirationAtMs je v budoucnu. Zkušební období zvlášť.
      const excludedCust = new Set(allP.filter((x) => x.rc && x.rc.customer && (x.sandbox || x.cls !== 'real')).map((x) => x.rc.customer));
      const refundedTx = new Set(RC_EVENTS.filter((r) => r.type === 'CANCELLATION' && r.cancelReason === 'CUSTOMER_SUPPORT').map((r) => r.transactionId).filter(Boolean));
      const evAt = (r) => Number(r.eventAtMs || r.purchasedAtMs) || 0;
      const byCust = new Map();
      RC_EVENTS.forEach((r) => {
        if (!r.customer || r.type === 'TEST' || excludedCust.has(r.customer) || String(r.environment || '').toUpperCase() === 'SANDBOX') return;
        if (!productKey(r.productId).startsWith('plan_')) return;
        const a = byCust.get(r.customer) || []; a.push(r); byCust.set(r.customer, a);
      });
      const act = { plan_monthly: 0, plan_yearly: 0, plan_lifetime: 0 }; let actTrial = 0;
      byCust.forEach((evs) => {
        if (evs.some((r) => r.isPurchase && productKey(r.productId) === 'plan_lifetime' && !(r.transactionId && refundedTx.has(r.transactionId)))) { act.plan_lifetime++; return; }
        const last = evs.filter((r) => productKey(r.productId) !== 'plan_lifetime').sort((a, b) => evAt(b) - evAt(a))[0];
        if (!last || last.type === 'EXPIRATION' || (last.type === 'CANCELLATION' && last.cancelReason === 'CUSTOMER_SUPPORT')) return;
        if (!(Number(last.expirationAtMs) > now)) return;
        if (String(last.periodType || '') === 'TRIAL') actTrial++;
        else { const k = productKey(last.productId); act[k] = (act[k] || 0) + 1; }
      });
      const actPaid = Object.values(act).reduce((a, v) => a + v, 0);
      const tActivePremium = tile({
        title: 'Aktivní Premium',
        big: nf(actPaid),
        sub: `Měsíčně ${nf(act.plan_monthly)} · ročně ${nf(act.plan_yearly)} · navždy ${nf(act.plan_lifetime)}<br>Ve zkušebním období navíc: ${nf(actTrial)}`,
        desc: 'zákazníci, kterým Premium právě teď platí (předplatné před vypršením nebo navždy), bez zkušebního období',
      });

      const custKey = (x) => x.rc.customer || ('tx:' + (x.rc.transactionId || x.ts));
      const payers = new Set(paid.map(custKey));
      const tPayers = tile({
        title: 'Platící zákazníci a konverze',
        cells: [[nf(payers.size), 'platící zákazníci'], [pctFmt(payers.size, real.length, 1), 'konverze ze zařízení']],
        sub: `Premium ${nf(new Set(paid.filter(isPlan).map(custKey)).size)} · plemena ${nf(new Set(paid.filter(isBreed).map(custKey)).size)} · zařízení celkem ${nf(real.length)}`,
        desc: 'různí zákazníci s aspoň jedním placeným nákupem; konverze = podíl ze všech skutečných zařízení od začátku',
      });

      // ── Obchody ──
      const lastIos = storeLast('ios'), lastAnd = storeLast('android');
      const uninst30 = STORE.filter((x) => x.platform === 'android' && x.date >= storeSince(30)).reduce((a, x) => a + (Number(x.uninstalls) || 0), 0);
      const tStore = tile({
        title: 'Stažení z obchodů',
        cells: STORE.length ? [
          [nf(storeSum(7, 'ios')), 'App Store · 7 dní'], [nf(storeSum(30, 'ios')), 'App Store · 30 dní'],
          [nf(storeSum(7, 'android')), 'Google Play · 7 dní'], [nf(storeSum(30, 'android')), 'Google Play · 30 dní'],
        ] : null,
        big: STORE.length ? undefined : '–',
        sub: STORE.length ? `Odinstalace Google Play za 30 dní: ${nf(uninst30)}<br>Data do: App Store ${esc(dayLabel(lastIos))} · Google Play ${esc(dayLabel(lastAnd))}` : 'zatím žádná data',
        desc: 'oficiální čísla obchodů (první stažení / nové instalace); chodí se zpožděním 1–5 dní, poslední dny ještě chybí',
      });

      let tRatings;
      const R = RATINGS.state === 'ok' ? RATINGS.data : null;
      if (!R) {
        tRatings = tile({
          title: 'Hodnocení v obchodech', big: '–',
          sub: 'čeká na první načtení',
          desc: 'průměr hvězdiček a počet hodnocení v App Storu a na Google Play',
        });
      } else {
        const star = (o) => {
          const cnt = Number(o && o.count) || 0, avg = o && o.avg !== null && o.avg !== undefined ? Number(o.avg) : NaN;
          return [!cnt || !Number.isFinite(avg) ? '–' : nf(avg, 1) + ' ★', cnt ? nf(cnt) + ' hodnocení' : 'zatím bez hodnocení'];
        };
        const [iosStar, iosCnt] = star(R.ios), [andStar, andCnt] = star(R.android);
        const rv = R.reviews || {};
        const unIos = Number(rv.ios && rv.ios.unanswered) || 0, unAnd = Number(rv.android && rv.android.unanswered) || 0;
        const un = unIos + unAnd;
        const byCountry = R.ios && R.ios.byCountry && typeof R.ios.byCountry === 'object'
          ? Object.entries(R.ios.byCountry).filter(([, v]) => v && Number(v.count) > 0).sort((a, b) => Number(b[1].count) - Number(a[1].count)).slice(0, 3) : [];
        const upd = anyMs(R.updatedAt);
        tRatings = tile({
          title: 'Hodnocení v obchodech',
          cells: [[iosStar, 'App Store · ' + iosCnt], [andStar, 'Google Play · ' + andCnt]],
          sub: [
            un > 0 ? `<span class="warn">Čeká na odpověď: ${nf(un)}</span> (App Store ${nf(unIos)} · Google Play ${nf(unAnd)})` : 'Všechny recenze mají odpověď',
            byCountry.length ? 'App Store podle země: ' + byCountry.map(([c, v]) => esc(regionLabel(c)) + ' ' + esc(Number.isFinite(Number(v.avg)) ? nf(v.avg, 1) + ' ★' : '–') + ' (' + nf(v.count) + ')').join(' · ') : '',
          ].filter(Boolean).join('<br>'),
          desc: 'průměr hvězdiček a počet hodnocení' + (upd ? ' · aktualizováno ' + esc(fmt(upd)) : ''),
        });
      }

      // ── Zapojení + zdraví (analytické eventy, bez testerů a robotů) ──
      const ev = RAW.filter((e) => Number.isFinite(e.ts) && !isExcluded(e.installId, e.dev));
      const evIn = (name, d, pred) => ev.filter((e) => e.name === name && (!d || now - e.ts <= d * DAY_MS) && (!pred || pred(e)));
      const shared = (e) => e.props && e.props.action === 'shared';
      const tShare = tile({
        title: 'Sdílení',
        cells: [[nf(evIn('share_initiated', 7).length), '7 dní'], [nf(evIn('share_initiated', 30).length), '30 dní']],
        sub: `Opravdu odesláno (share_completed): 7 dní ${nf(evIn('share_completed', 7, shared).length)} · 30 dní ${nf(evIn('share_completed', 30, shared).length)}`,
        desc: 'kolikrát lidé otevřeli sdílení (share_initiated)',
      });
      const opened7 = evIn('care_reminder_opened', 7).length, done7 = evIn('care_reminder_done', 7).length;
      const tCare = tile({
        title: 'Připomínky péče',
        cells: [[nf(opened7), 'otevřeno · 7 dní'], [nf(done7), 'splněno · 7 dní'], [pctFmt(done7, opened7), 'splněno z otevřených']],
        desc: 'notifikace virtuálního psa podle zvyku (od 13. 11. 2026)',
      });
      const tChallenge = tile({
        title: '30denní výzva',
        cells: [[nf(evIn('challenge_completed', 30).length), '30 dní'], [nf(evIn('challenge_completed').length), 'načtená historie' + (Number.isFinite(oldestEv) ? ' od ' + esc(dayLabel(isoDay(oldestEv))) : '')]],
        desc: 'dokončené 30denní výzvy (challenge_completed)',
      });
      const errs = evIn('app_error', 7);
      const topErr = countBy(errs, (e) => e.props && e.props.context ? String(e.props.context) : '?')[0];
      const tErrors = tile({
        title: 'Chyby v aplikaci',
        alert: errs.length > 0,
        cells: [[nf(errs.length), 'chyby · 7 dní'], [nf(uniqInstalls(errs)), 'zasažená zařízení']],
        sub: topErr ? `Nejčastěji: ${esc(topErr[0].slice(0, 80))} (${nf(topErr[1])}×)` : 'Za 7 dní žádná chyba',
        desc: 'zachycené chyby (app_error) za 7 dní; podrobnosti v záložce Technika',
      });

      $('dash-tiles').innerHTML = [
        section('Uživatelé', [tInstalls, tActive, tRetention, tCountries]),
        section('Peníze', [tTotal, tActivePremium, tPayers, tLastPremium, tLastBreed]),
        section('Obchody', [tStore, tRatings]),
        section('Zapojení', [tShare, tCare, tChallenge]),
        section('Zdraví aplikace', [tErrors]),
      ].join('');
    }

    $('dash-refresh').onclick = async () => {
      const b = $('dash-refresh');
      if (refreshing || dashCovering) return;
      if (DEMO) { renderDashboard(); return; }
      refreshing = true; b.disabled = true;
      try {
        if (dashCoverPromise) await dashCoverPromise;
        await firstLoad();
        if (dashCoverPromise) await dashCoverPromise;
      } finally { refreshing = false; b.disabled = dashCovering; }
    };

    // Lokální ověření (jen localhost): ?demo ukáže dashboard bez přihlášení a bez Firestore,
    // window.__dash.setData({INSTALLS, RC_EVENTS, STORE, RAW, RATINGS}) podstrčí vlastní data.
    if (location.hostname === 'localhost') {
      window.__dash = {
        setData(d = {}) {
          if (d.INSTALLS) INSTALLS = d.INSTALLS.map((i) => ({ installKind: 'unknown', ...i, firstMs: anyMs(i.firstMs), lastMs: anyMs(i.lastMs) }));
          if (d.RC_EVENTS) RC_EVENTS = d.RC_EVENTS.filter((x) => x && x.type);
          if (d.STORE) STORE = d.STORE.filter((x) => x && x.date && (x.platform === 'ios' || x.platform === 'android'));
          if (d.RAW) { RAW = d.RAW.map((e) => ({ ...e, ts: anyMs(e.ts), props: e.props || {}, dev: e.dev || {} })); batches = 0; exhausted = true; }
          if ('RATINGS' in d) RATINGS = d.RATINGS ? { state: 'ok', data: d.RATINGS } : { state: 'missing', data: null };
          if ('RETENTION' in d) RETENTION = d.RETENTION ? { state: 'ok', data: d.RETENTION } : { state: 'missing', data: null };
          reclassify();
          dataReady = true; dashCoverage = true; LOADED_AT = Date.now();
          render();
        },
        render: renderDashboard,
      };
    }
    if (DEMO) {
      $('login').classList.add('hidden');
      $('dash').classList.remove('hidden');
      $('who').textContent = '· demo (localhost, bez Firestore)';
      $('status').classList.add('hidden');
      exhausted = true; dataReady = true; LOADED_AT = Date.now();
    }

    // init tab z hashe
    setTab(activeTab);
  </script>
</body>
</html>
