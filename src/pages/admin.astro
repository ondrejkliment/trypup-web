        ['walkGps', (e, p) => e.name === 'walk_completed' && notOwner(p), true],
        ['learning', (e, p) => LEARNING_EVENTS.has(e.name) && notOwner(p), true],
        ['event', (e) => e.name === 'event_choice', true],
        ['challenge', (e) => e.name === 'challenge_started', false],
