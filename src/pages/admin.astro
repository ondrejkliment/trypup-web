      // Bez evidence zařízení by kontroly ukázaly nuly a „V pořádku“ (provoz-4).
      if (LOAD_ERR.has('installs')) { root.innerHTML = ledgerFailBox(); return; }

      // T2 Pokrytí verzí: verze z obchodu podle platformy (cisla-5), zdroj instalace jen z Android zařízení (texty-8).
      const V7 = T.versions7, act7 = num(V7.active) ?? 0, ST = V7.store, SB = ST.builds || {}, AN7 = V7.android || {};
      const t2rows = CORE_LIMITS.VERSION_MARKS.map((sb) => {
