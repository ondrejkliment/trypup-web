      const OW = J.owner, PLACES_B3 = ['plan', 'diary', 'docs', 'firstaid', 'training', 'vets', 'walk', 'family'];
      // Sloupec Udělali celý malým písmenem; dokument = nahraný (přidaný nebo připojený), ne otevřený (texty-28).
      const evLc = (name) => { const x = L.event(name); return L.html(LANG === 'raw' ? x : { ...x, text: lc1(x.text) }); };
      const DIDS = [['planItem', () => evLc('plan_item')], ['calendar', () => evLc('calendar_event_opened')],
        ['entry', () => ml('zápis do deníku nebo váhy', 'diary or weight entry', 'diary_entry | weight_entry')], ['document', () => ml('nahraný dokument', 'document uploaded', 'dog_document · action = added | attached')],
        ['trainingSession', () => ml('uložené sezení výcviku', 'training session saved', 'training_logged | training_stage_confirmed')],
        ['walkStarted', () => ml('zahájená procházka', 'walk started', 'walk_started · mode = owner')], ['walkCompleted', () => ml('dokončená procházka', 'walk completed', 'walk_completed · mode = owner')],
        ['family', () => evLc('family')]];
      const rows3 = PLACES_B3.map((p) => {
