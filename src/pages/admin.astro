      // B4 Přecházejí lidé mezi režimy?
      const SW = J.switch;
      const srcList = (arr) => pairsOf(arr).map(([k, v]) => `${lv('mode_switched', 'source', k)} <b>${nf(v)}</b>`).join(' · ') || 'nikdo';
      const sB4 = `Za 30 dní ${pl(SW.total, 'přepnulo', 'přepnula', 'přepnulo')} ${nf(SW.total)} zařízení; mimo úvod na Psa doma ${nf(SW.later.owner)}, zpět ${nf(SW.later.trial)}.`;
      const b4 = card({
