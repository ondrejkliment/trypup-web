      // B3 Co dělají majitelé v Psovi doma?
      const OW = J.owner, PLACES_B3 = ['plan', 'diary', 'docs', 'firstaid', 'training', 'vets', 'walk', 'family'];
      const DIDS = [['planItem', () => L.html(L.event('plan_item'))], ['calendar', () => L.html(L.event('calendar_event_opened'))],
