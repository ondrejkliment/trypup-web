      const s6 = topRegion ? `Nejčastější země nových za 30 dní je ${esc(L.region(topRegion[0], 'cs').text)} (${nf(topRegion[1])} ${zz(NW.d30.all)}).` : 'Zemi nových zařízení zatím neznáme.';
      const storeReg = pairsOf(A.storeRegion30);
      const z6 = card({
        q: 'Odkud lidé jsou?', verdict: A.verdicts.z6, sentence: s6,
        body: '<div class="subgrid">' +
          `<div><div class="sub">Země (noví za 30 dní)</div>${barRows(geoRows(A.region, 'region'))}</div>` +
          `<div><div class="sub">Jazyk aplikace</div>${barRows(geoRows(A.locale, 'language'))}</div>` +
          `<div><div class="sub">Jazyk telefonu</div>${barRows(geoRows(A.deviceLocale, 'language'))}</div>` +
          `<div><div class="sub">Stažení z obchodů podle země (30 dní)</div>${storeReg.length ? barRows(storeReg.slice(0, 15).map(([k, v]) => [L.html(L.region(k)), v]), 'var(--water)') : '<p class="muted">Obchody zatím nic nevydaly.</p>'}</div>` +
          '</div>',
        how: 'Země je oblast nastavená v telefonu, ne poloha. Bez údaje = verze před 5. 10. Obchody počítají stažení, ne spuštění, proto se čísla liší.',
        foot: 'Noví za 30 dní · bez testerů a robotů',
      });

      // Z0 Co z toho plyne (stejná čísla a verdikty jako karty pod ním)
      const rd1 = J.ret.all.d1;
      let s04 = `${d1Sent(rd1)}, průměr trhu je ${nf(Math.round(VERDICT_RULES.MARKET.d1 * 100))}&nbsp;%.`;
      if (sure) s04 += ' ' + sureTxt(sure);
      const z0 = [[A.verdicts.z1, s1], ...z0Camp,
        [A.verdicts.z2, `Zdroj známe u ${nf(CH.measured)} ${zz(CH.of)} ${androidNoun(CH.of)} (měří se od 18. 11.).`],
        [J.verdicts.a4, s04]];
      root.innerHTML = tabHead(title, meta) + takeaways(z0) + `<div class="qcards">${z1}${z2}${z3}${z4}${z5}${z6}</div>`;
      bindPane(root);
    }

    // ── Záložka Cesta (C.2)
    function renderJourney() {
      const root = $('jr-root');
      if (!root) return;
      const title = 'Cesta&nbsp;– kudy noví lidé procházejí a co aktivní lidé dělají';
      const st = dataReady ? coverState(30) : 'running';
      const M = st === 'ok' ? coreResult('meta') : null;
      const meta = (M ? `Noví = první spuštění ${esc(dayLabel(M.cohortFrom))}–${esc(dayLabel(M.cohortTo))} · ` : '') +
        `Aktivní = použili aplikaci za posledních 30 dní · bez testerů a robotů · data do ${esc(dataTime())} · ${coverWord(st)}`;
      if (st !== 'ok') { root.innerHTML = tabHead(title, meta) + waitBox(st, 30); bindPane(root); return; }
      const J = coreResult('jr'), today = M.today, V = J.verdicts, WC = J.whenClear || {};
      // A5 čte přiřazení od 16. 11. 2026 bez ohledu na 30 dní: dočíst max(30, dní od začátku testu).
      const abStartMs = Date.parse(CORE_LIMITS.AB_START + 'T00:00:00+01:00');
      const abDays = Math.max(30, Math.ceil((nowMs() - abStartMs) / DAY_MS) + 1);
      const abSt = abDays > 30 ? coverState(abDays) : 'ok';

      // A1 Kolik nových lidí projde úvodem a založí si psa?
      const BT = J.branch.trial, BO = J.branch.owner, dog = J.dogAny;
      const s1 = `Psa si ${pl(dog.k, 'založil', 'založili', 'založilo')} ${nf(dog.k)} ${zz(dog.n)} nových${pctPar(dog)}: Pes na zkoušku ${nf(BT.activated)} ${zz(BT.entered)}, Pes doma ${nf(BO.saved)} ${zz(BO.entered)}.`;
      const stepsHtml = (steps) => {
        const first = num(steps[0][1]) ?? 0;
        let hi = 0;
        for (const s of steps) { const v = num(s[1]); if (v !== null && v > hi) hi = v; }
        return steps.map(([label, v, extra], i) => {
          const c = num(v) ?? 0, prev = i > 0 ? num(steps[i - 1][1]) ?? 0 : null;
          const pFirst = i > 0 && first >= SMALL_N ? ` <span class="pct">· ${pctTxt(c, first)}</span>` : '';
          const conv = !(prev > 0) ? '' : `<div class="conv">↳ ${prev >= SMALL_N ? `${pctTxt(c, prev)} z předchozího` : `${nf(c)} ${zz(prev)} z předchozího`}${prev - c > 0 ? `, −${nf(prev - c)}` : ''}</div>`;
          return `<div class="step"><div class="bar"><span class="lbl">${label}</span><span class="val">${nf(c)}${pFirst}</span>` +
            `<div class="track">${hi > 0 && c > 0 ? `<div class="fill" style="width:${Math.max(2, (c / hi) * 100).toFixed(1)}%"></div>` : ''}</div></div>${conv}${extra || ''}</div>`;
        }).join('');
      };
      const trialSteps = [['Vstoupili', BT.entered], [lv('onboarding_step', 'step', 'quiz'), BT.quiz], [lv('onboarding_step', 'step', 'quiz_result'), BT.quiz_result],
        [lv('onboarding_step', 'step', 'name'), BT.name], [L.html(L.event('activated')), BT.activated]];
      const ownerSteps = [['Vstoupili', BO.entered], [lv('onboarding_step', 'step', 'owner_setup'), BO.owner_setup],
        [ml('Pes uložen', 'Dog saved', 'owner_activated | screen_view pesdoma/dog/*'), BO.saved,
          `<div class="conv">↳ neuložili ${nf(BO.notSaved)}, z toho ${ml('zavřeli založení', 'closed the setup', 'owner_setup_exit')} ${nf(BO.closed)}</div>` +
          `<div class="conv">uložení hlásí aplikace sama u ${nf(BO.savedEvent)}, ostatní podle otevřené karty psa (verze před 6. 11.)</div>`]];
      const forkCh = pairsOf(J.fork.choice);
      const a1 = card({
        q: 'Kolik nových lidí projde úvodem a založí si psa?', verdict: V.a1, sentence: s1,
        body: kvRow('Nová zařízení (odpověděli na věk)', `<b>${nf(J.cohort)}</b> · bez úvodu ${nf(J.noOnb)} <span class="muted">(obnova ze zálohy, pozvánka)</span>`) +
          kvRow(`${lv('onboarding_step', 'step', 'fork')} vidělo`, `<b>${nf(J.fork.n)}</b>${forkCh.length ? ' · ' + forkCh.map(([k, v]) => `${lv('onboarding_step', 'choice', k)} <b>${nf(v)}</b>`).join(' · ') : ''}`) +
          `<div class="branches"><div class="branch"><h4>Pes na zkoušku</h4>${stepsHtml(trialSteps)}</div><div class="branch"><h4>Pes doma</h4>${stepsHtml(ownerSteps)}</div></div>` +
          `<p>Psa si založilo celkem: <b>${kzn(dog)}</b></p>`,
        how: 'Začínáme lidmi, kteří odpověděli na věk jako dospělí: aplikace před tím nic neposílá, takže kdo odešel na úvodní obrazovce nebo u věku, tu chybí a skutečný odpad na začátku je větší. Uložení psa doma počítáme i podle otevřené karty psa, protože verze před 6. 11. ho samy nehlásily. Bez rozcestí = starší verze úvodu, ti jdou do větve Pes na zkoušku.',
        foot: 'Noví za 30 dní · rozcestí od 26. 10. 2026 (verze 293) · bez testerů a robotů',
      });

      // A2 Kde v úvodu odcházejí a kde váhají?
      const noDog = pairsOf(J.noDog), noDogN = (num(dog.n) ?? 0) - (num(dog.k) ?? 0), topND = noDog[0] || null;
      const stepLbl = (k, key) => (k === '_none' ? ml('bez kroku úvodu', 'no onboarding step', '_none') : k === '?' ? ml('neznámý krok', 'unknown step', '?') : lv('onboarding_step', key, k));
      const s2 = `Bez psa ${pl(noDogN, 'zůstal', 'zůstali', 'zůstalo')} ${nf(noDogN)} ${pl(noDogN, 'nový', 'noví', 'nových')}` +
        (topND ? `; nejčastěji naposledy byli na kroku „${topND[0] === '_none' ? 'bez kroku úvodu' : csv('onboarding_step', 'step', topND[0])}“ (${nf(topND[1])}).` : '.');
      const dw = J.dwell && typeof J.dwell === 'object' ? Object.keys(J.dwell).map((k) => [k, own(J.dwell, k)]).filter(([, v]) => v && num(v.s) !== null) : [];
      dw.sort((a, b) => b[1].s - a[1].s || cmpStr(a[0], b[0]));
      const backT = pairsOf(J.back.transitions).slice(0, 3).map(([k, v]) => {
        const s = String(k), i = s.indexOf('>');
        return kvRow(`${stepLbl(s.slice(0, i), 'fromStep')} → ${stepLbl(s.slice(i + 1), 'step')}`, `<b>${nf(v)}×</b>`);
      }).join('');
      const a2 = card({
        q: 'Kde v úvodu odcházejí a kde váhají?', verdict: V.a2, sentence: s2,
        body: '<div class="subgrid">' +
          `<div><div class="sub">Kde naposledy byli (${nf(noDogN)})</div>${noDog.length ? barRows(noDog.map(([k, v]) => [stepLbl(k, 'step'), v])) : '<p class="muted">Psa si založili všichni.</p>'}</div>` +
          `<div><div class="sub">Kde váhají (medián)</div>${dw.length ? barRows(dw.map(([k, v]) => [stepLbl(k, 'fromStep'), v.s, `${nf(v.s)}&nbsp;s <span class="pct">(${nf(v.n)}×)</span>`]), 'var(--water)') : '<p class="muted">Zatím žádný krok nemá 10 záznamů.</p>'}</div>` +
          `<div><div class="sub">Krok zpět: ${nf(J.back.devices)} zařízení</div>${backT || '<p class="muted">Zatím nikdo.</p>'}<p class="muted">Nejčastější přechody, počet přechodů.</p></div>` +
          '</div>',
        how: 'Čas je medián: polovina lidí byla na kroku kratší dobu. Průměr by zkreslila aplikace nechaná otevřená hodiny. ‚Odchod do založení skutečného psa‘ jako poslední krok znamená, že psa doma neuložili.',
        foot: 'Noví za 30 dní · krok zpět od 1. 11. 2026 (verze 314) · bez testerů a robotů',
      });

      // A3 Co noví lidé udělají v prvním týdnu?
      const WK = J.week, TU = WK.trialUse, OU = WK.ownerUse;
      const wDog = (num(WK.trial) ?? 0) + (num(WK.owner) ?? 0);
      const s3 = `Týden uplynul ${nf(WK.mature)} novým, psa má ${nf(wDog)}: se psem na zkoušku péči ${pl(TU.care.k, 'začal', 'začali', 'začalo')} ${nf(TU.care.k)} ${zz(TU.care.n)}, ` +
        `se psem doma plán péče ${pl(OU.plan.k, 'otevřel', 'otevřeli', 'otevřelo')} ${nf(OU.plan.k)} ${zz(OU.plan.n)}.`;
      const a3 = card({
        q: 'Co noví lidé udělají v prvním týdnu?', verdict: V.a3, sentence: s3,
        body: '<div class="branches">' +
          `<div class="branch"><h4>Pes na zkoušku (${nf(WK.trial)})</h4>` +
            kvRow(ml('První péče', 'First care', 'task_done'), kzn(TU.care)) +
            kvRow(ml('Péče aspoň 2 různé dny', 'Care on 2+ different days', 'task_done ≥ 2 dny'), kzn(TU.care2)) +
            kvRow(ml('Péče aspoň 3 různé dny', 'Care on 3+ different days', 'task_done ≥ 3 dny'), kzn(TU.care3)) +
            kvRow(ml('Spustili 30denní výzvu', 'Started the 30-day challenge', 'challenge_started'), kzn(TU.challenge)) +
            kvRow(ml('Povolili upozornění', 'Allowed notifications', 'notification_permission · status = granted'), mfrac(TU.notif)) + '</div>' +
          `<div class="branch"><h4>Pes doma (${nf(WK.owner)})</h4>` +
            kvRow(ml('Otevřeli plán péče', 'Opened the care plan', 'screen_view pesdoma/dog/[id]/plan'), kzn(OU.plan)) +
            kvRow(ml('Otevřeli deník nebo váhu', 'Opened diary or weight', 'screen_view …/diary | …/entry | …/weight'), kzn(OU.diary)) +
            kvRow(ml('Vrátili se k Psovi doma jiný den', 'Came back to Dog at home another day', 'screen_view pesdoma/* ≥ 2 dny'), kzn(OU.returned)) +
            kvRow(ml('Akce v plánu', 'Care plan actions', 'plan_item'), mfrac(OU.planItem)) + '</div>' +
          '</div>',
        how: 'Jen lidé, kterým první týden už celý uplynul. Pes doma se měří hlavně podle otevřených obrazovek: akce v plánu a deníku posílají jen verze od 15. 11.',
        foot: 'Noví za 30 dní, kterým uplynul týden · bez testerů a robotů',
      });

      // A4 Vracejí se noví lidé?
      const RT = J.ret, all = RT.all, MK = VERDICT_RULES.MARKET;
      const mpct = (x) => `${nf(Math.round(x * 100))}&nbsp;%`;
      const inPar = (f, mk) => { const n = num(f.n); return ` (${n !== null && n >= SMALL_N ? pctTxt(f.k, n) + ', ' : ''}trh ${mpct(mk)})`; };
      const s4 = num(all.d1.n) > 0
        ? `Další den ${pl(all.d1.k, 'se vrátil', 'se vrátili', 'se vrátilo')} ${nf(all.d1.k)} ${zz(all.d1.n)} nových${inPar(all.d1, MK.d1)}, po týdnu ${nf(all.d7.k)} ${zz(all.d7.n)}${inPar(all.d7, MK.d7)}.`
        : 'Další den zatím nikomu z nových celý neuplynul, retence čeká na data.';
      const SEG_ROWS = [['all', 'Celkem', 'Total'], ['challenge', '30denní výzva', '30-day challenge'], ['trial', 'Pes na zkoušku bez výzvy', 'Trial dog, no challenge'],
        ['owner', 'Pes doma', 'Dog at home'], ['notActivated', 'Psa nezaložili', 'No dog created']];
      const a4 = card({
        q: 'Vracejí se noví lidé?', verdict: V.a4, sentence: s4,
        body: '<table class="qt narrow"><thead><tr><th></th><th class="n">D1</th><th class="n">D7</th></tr></thead><tbody>' +
          SEG_ROWS.map(([k, cs, en]) => { const s = own(RT, k); return s ? `<tr><td>${ml(cs, en, 'segment ' + k)}</td><td data-label="D1" class="n">${kzn(s.d1)}</td><td data-label="D7" class="n">${kzn(s.d7)}</td></tr>` : ''; }).join('') +
          `<tr class="mkt"><td>Průměr aplikací na trhu</td><td data-label="D1" class="n">${mpct(MK.d1)}</td><td data-label="D7" class="n">${mpct(MK.d7)}</td></tr></tbody></table>` +
          `<p>2. týden (dny 7–13): celkem ${kzn(all.w1)} · Pes doma ${kzn(own(RT, 'owner') && RT.owner.w1)}</p>` +
          (J.retMarket && J.retMarket.d1Range ? `<p class="muted">D1 celkem ${rangeTxt(J.retMarket.d1Range)} (rozpětí s 95% jistotou).</p>` : '') +
          (whenTxt(WC.a4, today) ? `<p class="muted">${cap(whenTxt(WC.a4, today))}.</p>` : ''),
        how: 'Stejná metoda jako dlaždice Retence v Souhrnu: zařízení aplikaci otevřelo přesně 1., resp. 7. kalendářní den po prvním spuštění. Souhrn počítá všechny lidi od června, tady jen nové z posledních 30 dní, aby bylo vidět, jestli zabraly poslední změny. Do základu patří jen ti, kterým ten den už celý uplynul; pod 10 zařízení jen počet. Pes doma = kdo si uložil psa doma nebo na Psa doma přepnul.',
        foot: 'Noví za 30 dní · bez testerů a robotů · Nad / Pod trhem jen tehdy, když je průměr trhu mimo pravděpodobné rozpětí (95&nbsp;%)',
      });

      // A5 Zabírá varianta B testu první péče?
      const AB = J.ab, VARS = AB.variants && typeof AB.variants === 'object' ? AB.variants : {};
      const vKeys = Object.keys(VARS).sort(cmpStr), vA = own(VARS, 'a'), vB = own(VARS, 'b');
      let abTotal = 0;
      for (const k of vKeys) abTotal += num(own(VARS, k).assigned) ?? 0;
      let s5, a5Body;
      if (abSt !== 'ok') {
        s5 = 'Test běží od 16. 11. 2026, dočítám data od jeho začátku.';
        a5Body = waitBox(abSt, abDays);
      } else {
        s5 = V.a5 === 'Málo dat'
          ? `Zatím zařazeno A ${nf(vA ? vA.assigned : 0)}, B ${nf(vB ? vB.assigned : 0)}; každá varianta potřebuje aspoň 30 lidí. Vyhodnocení je naplánované na 14. 12.`
          : `Další den se vrátilo A ${kzn(vA && vA.d1)}, B ${kzn(vB && vB.d1)}: ${esc(V.a5)}.`;
        const d1Txt = (v) => (num(v.d1 && v.d1.n) > 0
          ? `další den ${pl(v.d1.k, 'se vrátil', 'se vrátili', 'se vrátilo')} ${kzn(v.d1)}${V.a5 !== 'Málo dat' && v.d1Range ? ` (${rangeTxt(v.d1Range)})` : ''}`
          : 'další den zatím 0 z 0');
        a5Body = vKeys.map((k) => {
          const v = own(VARS, k);
          return kvRow(lv('experiment_assigned', 'variant', k), `<b>${nf(v.assigned)}</b> · ${k === 'b' ? `klepli na kartu ${lv('home_banner', 'kind', 'first_care')} ${nf(v.tapped)} ${zz(v.assigned)} · ` : ''}${d1Txt(v)}`);
        }).join('') +
          kvRow('K ověření (stejný model jako testovací telefon nebo nákup bez záznamu v RevenueCatu, seznam v Technice)', `<b>${nf(AB.review)}</b> ${zz(abTotal)}`) +
          (whenTxt(WC.a5, today) ? `<p class="muted">${cap(whenTxt(WC.a5, today))}.</p>` : '');
      }
      const a5 = card({
        q: 'Zabírá varianta B testu první péče?', verdict: V.a5, sentence: s5, body: a5Body,
        how: 'A = průvodce aplikací, B = rovnou Domů s kartou ‚Začni snídaní‘. Do testu jdou jen nové instalace při založení prvního psa, napůl. K novým lidem se dostane s verzí 2.2.3 (Android od 19. 11., iPhone po schválení Applem). Rozdíl pár procent u desítek lidí bývá náhoda, proto ukazujeme rozpětí.',
        foot: 'Měří se od 16. 11. 2026 (verze 344) · bez testerů a robotů · rozhodnutí až od 30 lidí v každé variantě',
      });

      // B1 Kolik aktivních lidí je v kterém režimu?
      const MD = J.modes, TD = MD.twoDays, RG = TD.ranges || {};
      const modeT = ml('Pes na zkoušku', 'Trial dog', 'trial'), modeO = ml('Pes doma', 'Dog at home', 'owner');
      const tdT = TD.trial, tdO = TD.owner, wb1 = whenTxt(WC.b1, today);
      let b1Why;
      if (V.b1 === 'Průkazný rozdíl') b1Why = `Pes doma drží lidi průkazně ${num(TD.z) > 0 ? 'hůř' : 'líp'}.`;
      else if (V.b1 === 'Zatím neprůkazné' && num(tdO.n) >= VERDICT_RULES.SURE_N && num(tdT.n) >= VERDICT_RULES.SURE_N) b1Why = 'Rozdíl je zatím v mezích náhody.';
      else b1Why = `${num(tdO.n) < VERDICT_RULES.SURE_N ? 'Majitelů' : 'Lidí se psem na zkoušku'} je zatím málo na jistý závěr${wb1 ? ', ' + wb1 : ''}.`;
      const sB1 = `${cap(zePrep(MD.active))} ${nf(MD.active)} aktivních zařízení ${pl(MD.trial, 'byl', 'byli', 'bylo')} ${nf(MD.trial)} se psem na zkoušku a ${nf(MD.owner)} se psem doma, ${nf(MD.both)} v obou a ${nf(MD.neither)} v žádném.`;
      const twoTxt = (f, r) => `${kzn(f)}${V.b1 !== 'Málo dat' && r ? ` <span class="muted">(${rangeTxt(r)})</span>` : ''}`;
      const b1 = card({
        q: 'Kolik aktivních lidí je v kterém režimu?', verdict: V.b1, sentence: sB1,
        body: `<div class="qnums">${[[MD.trial, modeT], [MD.owner, modeO], [MD.both, 'v obou'], [MD.neither, 'ani v jednom (jen úvod nebo bez psa)']]
          .map(([v, l]) => `<div class="qnum"><b>${nf(v)}</b><span>${l}</span></div>`).join('')}</div>` +
          '<div class="sub">Používali režim aspoň 2 různé dny</div>' + kvRow(modeT, twoTxt(tdT, RG.trial)) + kvRow(modeO, twoTxt(tdO, RG.owner)) + `<p>${b1Why}</p>`,
        how: 'Podle toho, co lidé za posledních 30 dní opravdu dělali, ne podle volby v úvodu. Kdo přepnul, je v obou. ‚Aspoň 2 různé dny‘ není retence: říká, jestli se k režimu vracejí, nebo ho zkusili jednou. Počítáme jen ty, kdo ho poprvé otevřeli aspoň před týdnem, ostatní se ještě vrátit nestihli.',
        foot: 'Aktivní za 30 dní · režim podle obrazovek od 23. 10. 2026 (verze 291) · bez testerů a robotů',
      });

      // B2 Co dělají lidé se psem na zkoušku?
      const TR = J.trialUse, base2 = TR.base;
      const usedK = (key) => num(own(TR, key) && TR[key].used.k) ?? 0;
      const MAIN2 = [
        ['care', ml('Denní péče', 'Daily care', 'task_done'), 'denní péče'],
        ['training', ml('Výcvik povelů', 'Command training', 'training_done'), 'výcvik povelů'],
        ['walk', ml('Otevřeli procházku', 'Opened a walk', 'walk_started (bez mode owner) | screen_view walk'), 'procházka'],
        ['learning', ml('Vzdělávání', 'Learning', 'article_opened | article_read | lesson_answered | myth_answered | review_answered'), 'vzdělávání'],
        ['event', ml('Denní událost', 'Daily event', 'event_choice'), 'denní událost'],
        ['challenge', ml('Spustili 30denní výzvu', 'Started the 30-day challenge', 'challenge_started'), '30denní výzva'],
      ].sort((a, b) => usedK(b[0]) - usedK(a[0]));
      const r2 = (key, label, twoCell, sub) => {
        const r = own(TR, key);
        if (!r) return '';
        return `<tr><td>${sub ? `<span class="sublbl">↳ ${label}</span>` : label}</td><td data-label="Použili (${zz(base2)})" class="n">${kpct(r.used)}</td>` +
          `<td data-label="Aspoň 2 různé dny">${twoCell === null ? kzn(r.twoDays) : twoCell}</td></tr>`;
      };
      const fc = pairsOf(TR.failChoice);
      let rows2 = '';
      for (const [key, label] of MAIN2) {
        rows2 += r2(key, label, key === 'challenge' ? 'jednou za výzvu' : null);
        if (key === 'walk') rows2 += r2('walkGps', ml('dokončili procházku s GPS', 'finished a GPS walk', 'walk_completed (bez mode owner)'), null, true);
      }
      rows2 += r2('day7', ml('Pes došel aspoň do 7. dne', 'Dog reached day 7', 'day_advanced · day ≥ 7'), 'výsledek');
      rows2 += r2('shelter', ml('Pes skončil v útulku', 'Dog ended up in a shelter', 'fail_state'),
        `výsledek${fc.length ? ' · pak ' + fc.map(([k, v]) => `${lv('fail_state_choice', 'choice', k)} <b>${nf(v)}</b>`).join(', ') : ''}`);
      const t1 = MAIN2[0], t2 = MAIN2[1];
      const sB2 = `Nejčastěji: ${t1[2]} (${nf(usedK(t1[0]))} ${zz(base2)}) a ${t2[2]} (${nf(usedK(t2[0]))}); procházku s GPS ${pl(usedK('walkGps'), 'dokončil', 'dokončili', 'dokončilo')} ${nf(usedK('walkGps'))}.`;
      const b2 = card({
        q: 'Co dělají lidé se psem na zkoušku?', verdict: V.b2, sentence: sB2,
        body: `<table class="qt"><thead><tr><th></th><th class="n">Použili (${zz(base2)})</th><th>Aspoň 2 různé dny</th></tr></thead><tbody>${rows2}</tbody></table>`,
        how: 'Kolik lidí se psem na zkoušku každou funkci za posledních 30 dní aspoň jednou použilo. ‚Aspoň 2 různé dny‘ odliší zvyk od zvědavosti; počítáme jen ty, kdo funkci poprvé použili aspoň před týdnem. ‚Otevřeli procházku‘ je obrazovka nebo zahájená procházka, dokončenou procházku s GPS ukazuje řádek pod ní. Odznaky a posun dne posílá aplikace sama, nejsou to činnosti lidí.',
        foot: 'Aktivní se psem na zkoušku za 30 dní · bez testerů a robotů',
