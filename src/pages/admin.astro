    /** Český popisek do vět „Co z toho plyne“ (D.3: věty jsou vždy česky), escapovaný. */
    const csv = (name, key, val) => esc(L.value(name, key, val, 'cs').text);

    // --- Data load (stránkování – drží data od začátku měření) ---
    const PAGE = 500;
    let RAW = [];          // ploché eventy ze všech načtených dávek (po deduplikaci R3)
    let lastDoc = null;    // cursor pro startAfter
