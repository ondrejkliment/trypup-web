          .map(([v, l]) => `<div class="qnum"><b>${nf(v)}</b><span>${l}</span></div>`).join('')}</div>` +
          '<div class="sub">Používali režim aspoň 2 různé dny: noví za 30 dní (srovnání)</div>' + kvRow(modeT, twoTxt(tdT, RG.trial)) + kvRow(modeO, twoTxt(tdO, RG.owner)) + `<p>${b1Why}</p>` +
