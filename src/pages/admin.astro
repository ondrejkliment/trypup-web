      return st;
    }

    // ── Normalizace dat na vstupu (bezpecnost-2, 3, 8). Zápis do analytiky je anonymní a pravidla tvar
    //    nekontrolují, server ukládá i evidenci zařízení bez kontroly typu. Proto se každá událost a každý
    //    záznam evidence převede na čistá data dřív, než na ně sáhne deduplikace, jádro nebo vykreslení.
    const BAD_VALUE = '(neplatná hodnota)';
