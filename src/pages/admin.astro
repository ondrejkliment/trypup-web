      const b4 = card({
        q: 'Přecházejí lidé mezi režimy?', verdict: V.b4, sentence: sB4,
        body: kvRow('V úvodu přepnuli', `na Psa doma&nbsp;<b>${nf(SW.onboarding.owner)}</b> · zpět na Psa na zkoušku&nbsp;<b>${nf(SW.onboarding.trial)}</b>`) +
          kvRow(`Přepnuli později na Psa doma (${nf(SW.later.owner)})`, `<span class="ilist">${srcList(SW.later.ownerBySource)}</span>`) +
          kvRow(`Přepnuli později zpět na Psa na zkoušku (${nf(SW.later.trial)})`, `<span class="ilist">${srcList(SW.later.trialBySource)}</span>`),
        how: `Počty zařízení, ne přepnutí. Volba na rozcestí patří k úvodu; pozdější přepnutí ukazují, jestli fungují nabídky v aplikaci (řádek dole na Domů, Nastavení, konec výzvy). Jedno zařízení mohlo přepnout víc cestami, proto součet míst může být větší než celkem. Konečnou volbu na rozcestí ukazuje karta úvodu nahoře (Psa už mám ${nf(num(new Map(pairsOf(J.fork.choice)).get('owner')) ?? 0)}). Tady jsou zařízení, která v úvodu aspoň jednou přepnula, i ta, která si to pak rozmyslela, proto může být číslo vyšší. Pes na zkoušku je v úvodu nastavený předem: kdo zvolí „Chci si psa vyzkoušet“, nic nepřepíná. „Zpět na Psa na zkoušku“ jsou ti, kdo v úvodu zvolili Psa doma a pak se vrátili.`,
        foot: 'Aktivní za 30 dní · měří se od 23. 10. 2026 (verze 292) · bez testerů a robotů',
      });

      // B5 Co lidi vrací do aplikace?
      const EN = J.entry, NT = J.notif, CR = J.care;
      let sB5, entryHtml;
      if (EN.state === 'unmeasured') {
        sB5 = `Vstupy do aplikace ${unmeasuredTxt(EN)} aktivních za 7 dní.`;
        entryHtml = `<p>Vstupy za 7 dní: ${unmeasuredTxt(EN)} aktivních.</p>`;
      } else {
        const bySrc = pairsOf(EN.bySource), cnt = new Map(pairsOf(EN.countBySource));
        sB5 = `Vstupy měříme u ${nf(EN.n)}&nbsp;${zz(EN.y)} aktivních za 7 dní` +
          (bySrc.length ? ': ' + bySrc.slice(0, 3).map(([k, v]) => `${esc(ENTRY_FROM.get(k) || lc1(L.value('app_entry', 'source', k, 'cs').text))} ${nf(v)}`).join(', ') + '.' : '.');
        entryHtml = `<p class="ilist">Vstupy za 7 dní (zařízení, v závorce vstupů): ${bySrc.map(([k, v]) => `${lv('app_entry', 'source', k)}&nbsp;<b>${nf(v)}</b> (${nf(cnt.get(k) ?? 0)})`).join(' · ') || 'zatím žádné'}` +
          (num(EN.n) < num(EN.y) ? ` <span class="muted">(měřitelné u ${nf(EN.x)} ${zz(EN.y)})</span>` : '') + '</p>';
      }
      // Popisek končící číslem („Varianta textu 3“) dostane dvojtečku, ať se nespojí s počtem.
      const devList = (arr, name, key) => pairsOf(arr).map(([k, v]) => `${lv(name, key, k)}${/\d$/.test(L.value(name, key, k).text) ? ':' : ''}&nbsp;<b>${nf(v)}</b>`).join(' · ') || 'zatím nikdo';
      let careHtml;
      if (!CR || CR.state === 'unmeasured') careHtml = `<p>Připomínky péče: ${CR ? unmeasuredTxt(CR) : 'čeká na data'}.</p>`;
      else {
        // Varianty (cisla-1, texty-21): zařízení a v závorce splnění; vítěze ani „kdy bude jasno“ nevyhlašujeme.
        const recByVar = new Map(pairsOf(CR.doneByVariantRecords));
        const varName = (k) => (k === '_none' ? (LANG === 'en' ? 'no variant' : 'bez varianty') : LANG === 'raw' ? k : LANG === 'en' ? `variant ${k}` : `${k}.\u00a0varianta`); // esc() níže, proto znak, ne &nbsp;
        const varList = pairsOf(CR.doneByVariant).map(([k, v]) => `<span title="Technický název: care_reminder_done · variant = ${esc(k)}">${esc(varName(k))}</span>&nbsp;<b>${nf(v)}</b> (${nf(recByVar.get(k) ?? 0)})`).join(' · ') || 'zatím nikdo';
        careHtml = `<p>Připomínky péče (30 dní${num(CR.n) < num(CR.y) ? `, měřitelné u ${nf(CR.x)}&nbsp;${zz(CR.y)}` : ''}): ${pl(CR.opened, 'otevřelo', 'otevřela', 'otevřelo')}&nbsp;<b>${nf(CR.opened)}</b> · ${pl(CR.done, 'splnilo', 'splnila', 'splnilo')} po připomínce&nbsp;<b>${nf(CR.done)}</b></p>` +
          `<p class="ilist">Splnili podle času: ${devList(CR.doneBySlot, 'care_reminder_done', 'slot')}</p>` +
          `<p class="ilist">Splnili podle varianty textu (zařízení, v závorce splnění): ${varList}</p>` +
          '<p class="muted">Varianty textu zatím porovnat nejde: každý telefon je dostává střídavě (variantu 5 jen při sérii aspoň 2 dny) a kolik připomínek přišlo, aplikace neposílá. Jeden telefon proto bývá u víc variant.</p>' +
          `<p class="ilist">Splnili podle načasování: ${devList(CR.doneByTiming, 'care_reminder_done', 'timing')}</p>`;
      }
      const b5 = card({
        q: 'Co lidi vrací do aplikace?', verdict: V.b5, sentence: sB5,
        body: entryHtml +
          `<p>Upozornění (30 dní): ${pl(NT.answered, 'odpovědělo', 'odpověděla', 'odpovědělo')}&nbsp;<b>${nf(NT.answered)}</b> · ${pl(NT.granted, 'povolilo', 'povolila', 'povolilo')}&nbsp;<b>${nf(NT.granted)}</b> · ${pl(NT.denied, 'zamítlo', 'zamítla', 'zamítlo')}&nbsp;<b>${nf(NT.denied)}</b></p>` +
          careHtml,
        how: 'Vstup = každé otevření aplikace i návrat z pozadí (krátké odskočení pod 10 s ne); měří se jen u verzí od 16. 11. Upozornění: poslední odpověď na dotaz systému. Připomínky: otevřeli = klepli na připomínku, splnili = nakrmili nebo vyvenčili psa do 2 hodin po připomínce i bez klepnutí, proto je nedělíme. Kolik připomínek opravdu přišlo, aplikace neposílá, proto varianty textu nesrovnáváme.',
        foot: 'Vstupy od 16. 11. 2026 (verze 342) · připomínky od 14. 11. 2026 (verze 335) · upozornění od 13. 10. 2026 (verze 288) · bez testerů a robotů',
      });

      // B6 Plní aplikace misi?
      const MS = J.mission, decs = new Map(pairsOf(MS.decision)), dv = (k) => num(decs.get(k)) ?? 0;
      const decCs = (k) => esc(lc1(L.value('challenge_decision', 'choice', k, 'cs').text));
      const shelterLbl = (k) => lv('shelter_opened', 'shelter', k);
      const sB6 = `Za posledních 30 dní ${pl(MS.started, 'spustilo', 'spustila', 'spustilo')} 30denní výzvu ${nf(MS.started)} zařízení a ${pl(MS.completed, 'dokončilo', 'dokončila', 'dokončilo')} ji ${nf(MS.completed)}; ` +
        `po výzvě: ${decCs('yes')} ${nf(dv('yes'))}, ${decCs('not_yet')} ${nf(dv('not_yet'))}, ${decCs('no')} ${nf(dv('no'))}${dv('skipped') ? `, ${decCs('skipped')} ${nf(dv('skipped'))}` : ''}. ` +
        `Na útulek ${pl(MS.shelter.devices, 'kliklo', 'klikla', 'kliklo')} ${nf(MS.shelter.devices)} zařízení.`;
      const b6 = card({
        q: 'Plní aplikace misi?', verdict: V.b6, sentence: sB6,
        body: `<p class="ilist">${ml('Spustili výzvu', 'Started the challenge', 'challenge_started')}&nbsp;<b>${nf(MS.started)}</b> · ${ml('došli k promoci', 'reached graduation', 'graduation_reached')}&nbsp;<b>${nf(MS.graduation)}</b> · ` +
          `${ml('dokončili výzvu', 'completed the challenge', 'challenge_completed')}&nbsp;<b>${nf(MS.completed)}</b> · ${ml('rozhodli se počkat', 'decided to wait', 'graduation_wait_cta')}&nbsp;<b>${nf(MS.wait)}</b></p>` +
          `<p class="ilist">Rozhodnutí po výzvě (${nf(MS.decided)}): ${devList(MS.decision, 'challenge_decision', 'choice')}</p>` +
          `<p class="ilist">Proklik na útulek: <b>${nf(MS.shelter.devices)}</b>&nbsp;zařízení, <b>${nf(MS.shelter.clicks)}</b>&nbsp;${pl(MS.shelter.clicks, 'proklik', 'prokliky', 'prokliků')}: ${pairsOf(MS.shelter.byShelter).map(([k, v]) => `${shelterLbl(k)}&nbsp;<b>${nf(v)}</b>`).join(' · ') || 'zatím žádné'}</p>` +
          // Promoce jen otevře seznam útulků v aplikaci; útulek z něj je až další proklik výše (cisla2-7).
          `<p class="ilist">${ml('Z promoce otevřeli seznam útulků', 'Opened the shelter list from graduation', 'graduation_shelter_cta')}:&nbsp;<b>${nf(MS.gradShelter)}</b>&nbsp;zařízení</p>`,
        how: 'Výzva trvá 30 dní, každé číslo proto říká, kolik zařízení to za posledních 30 dní udělalo, není to cesta jedné skupiny. Rozhodnutí po výzvě je hlavní měřítko dopadu mise: „Zatím počkám“ i „Pes teď není pro mě“ jsou dobrý výsledek: člověk se rozhodl dřív, než si pořídil psa, který by mohl skončit v útulku.',
        foot: 'Aktivní za 30 dní · rozhodnutí po výzvě od 11. 10. 2026 (verze 287) · bez testerů a robotů',
      });

      // B7 Odpovědi v úvodu (sbalené, převzato z Výzkumu: zařízení, 30 dní, popisky z katalogu)
      const AN = J.answers, RD = AN.readiness, QZ = AN.quiz, BR = AN.breed, PO = AN.premiumOffer;
      const qRows = ['q1', 'q2', 'q3', 'q4', 'q5', 'q6'].map((q) => { const x = own(RD.q, q) || {}; return [L.html(L.prop('readiness_completed', q)), x.yes, kzn({ k: x.yes, n: RD.n })]; });
      const phaseLbl = (k) => (k === '_none' ? ml('krok úvodu (do verze 2.2.0)', 'onboarding step (up to version 2.2.0)', 'phase = _none') : lvLc('readiness_completed', 'phase', k));
      const quizBlock = (field, color) => `<div class="sub">${L.html(L.prop('quiz_completed', field))}</div>${barRows(pairsOf(own(QZ, field)).map(([k, v]) => [lv('quiz_completed', field, k), v]), color)}`;
      const b7 = `<details class="qdet" data-open="b7"${openAttr('b7')}><summary>Odpovědi v úvodu <span>připravenost, kvíz, doporučené plemeno, nabídka Premium plemene</span></summary>` +
        '<div class="subgrid" style="margin-top:12px">' +
        `<div><h4>Připravenost (${nf(RD.n)} zařízení)</h4><div class="sub">Výsledek</div>${barRows(pairsOf(RD.tier).map(([k, v]) => [lv('readiness_completed', 'tier', k), v]))}` +
          `<div class="sub">Odpověděli ano</div>${barRows(qRows, 'var(--water)')}<div class="sub">Odkud vyplněno</div>${barRows(pairsOf(RD.phase).map(([k, v]) => [phaseLbl(k), v]), 'var(--water)')}</div>` +
        `<div><h4>Kvíz o životním stylu (${nf(QZ.n)} zařízení)</h4>${quizBlock('hours', 'var(--apricot)')}${quizBlock('housing', 'var(--water)')}${quizBlock('activity', 'var(--apricot)')}</div>` +
        `<div><h4>Doporučení vs. výběr plemene (${nf(BR.n)} zařízení)</h4>${kvRow('Vybrali doporučené plemeno', `<b>${nf(BR.matched)}</b>`)}${kvRow('Vybrali jiné', `<b>${nf(BR.other)}</b>`)}` +
          `<div class="sub">${L.html(L.prop('breed_selected', 'breed'))}</div>${barRows(pairsOf(BR.breed).slice(0, 15).map(([k, v]) => [lv('breed_selected', 'breed', k), v]), 'var(--water)')}</div>` +
        `<div><h4>${L.html(L.event('onboarding_premium_offer'))}</h4>${kvRow(lv('onboarding_premium_offer', 'action', 'shown'), `<b>${nf(PO.shown)}</b> zařízení`)}${kvRow(lv('onboarding_premium_offer', 'action', 'tapped'), `<b>${nf(PO.tapped)}</b> zařízení`)}</div>` +
        '</div><p class="q-how"><b>Jak číst:</b> Co o sobě lidé řekli za posledních 30 dní. Dotazník připravenosti je od 31. 10. karta na Domů, ne krok úvodu. Kolik peněz nabídka Premium plemene vydělala, ukazují Nákupy podle zdroje.</p>' +
        '<p class="q-foot">Aktivní za 30 dní, u každého zařízení poslední odpověď · bez testerů a robotů</p></details>';

      // C0 Co z toho plyne
      const piC0 = !pi ? '' : pi.state === 'unmeasured' ? ` Akce v plánu ${unmeasuredTxt(pi)} majitelů.` : ` Akce v plánu umí poslat ${num(pi.x) < num(pi.y) ? 'jen ' : ''}${nf(pi.x)} ${zz(pi.y)} majitelů.`;
      // C0 bod 3 (cisla-10): srovnání jen nových, všichni v závorce; proč jen noví.
      const c03 = `Z nových za 30 dní se k Psovi doma jiný den ${pl(tdO.k, 'vrátil', 'vrátili', 'vrátilo')} ${nf(tdO.k)}&nbsp;${zz(tdO.n)} majitelů, kteří ho otevřeli aspoň před týdnem${pctPar(tdO)}; u Psa na zkoušku ${nf(tdT.k)}&nbsp;${zz(tdT.n)}${pctPar(tdT)}. ${b1Why}` +
        ` Srovnáváme jen nové, protože u Psa na zkoušku jsou mezi všemi aktivními i lidé z doby před Psem doma, kteří aplikaci používají déle (všichni: Pes doma ${nf(tdOa.k)}&nbsp;${zz(tdOa.n)}, Pes na zkoušku ${nf(tdTa.k)}&nbsp;${zz(tdTa.n)}).`;
      const c04 = topPl
        ? `Majitelé nejčastěji otevírají ${esc(L.place(topPl, 'cs').text)} (${nf(OW.opened[topPl].k)} ${zz(OW.opened[topPl].n)}), ` +
          (tdTop && num(tdTop.n) > 0 ? `znovu jiný den ale jen ${nf(tdTop.k)} ${zz(tdTop.n)}.` : 'jestli se vracejí jiný den, zatím nejde říct.') + piC0
        : 'Majitelé zatím nic neotevřeli.';
      const c0 = [[V.a1, s1], [V.a4, s4], [V.b1, c03], [V.b3, c04], [V.b6, sB6]];

      root.innerHTML = tabHead(title, meta) + takeaways(c0) +
        `<h2 class="qsec">A&nbsp; Noví lidé <span class="muted">(první spuštění za posledních 30 dní)</span></h2><div class="qcards">${a1}${a2}${a3}${a4}${a5}</div>` +
        `<h2 class="qsec">B&nbsp; Aktivní lidé <span class="muted">(posledních 30 dní, ${nf(MD.active)} zařízení)</span></h2><div class="qcards">${b1}${b2}${b3}${b4}${b5}${b6}${b7}</div>`;
      bindPane(root);
    }

    // --- Jádro v paměti (C.5): index a výsledky compute* pod klíčem verze dat (počet událostí, konec
    //     historie, verze přepisů testerů, „teď“ na minuty). Přepnutí záložky, jazyka ani rozbalení
    //     sekce nic nepřepočítává. Katalog akcí (LABELS) je načtený výše (#admin-labels, SPEC D.1).
    let CORE_CACHE = { key: null, idx: null, out: new Map() };
    const coreKey = () => [DATA_VER, RAW.length, exhausted ? 1 : 0, OVERRIDES_VER, LOAD_ERR.has('rc') ? 1 : 0, Math.floor(nowMs() / 60000)].join('|');
    function coreIndex() {
      const key = coreKey();
      if (CORE_CACHE.key !== key) {
        CORE_CACHE = { key, out: new Map(), idx: buildIndex({
          raw: RAW, installs: INSTALLS, overrides: OVERRIDES, rcEvents: RC_EVENTS, rcFailed: LOAD_ERR.has('rc'), store: STORE,
          retention: RETENTION.state === 'ok' ? RETENTION.data : null, adCampaigns: AD_CAMPAIGNS, catalog: LABELS, now: nowMs(),
          loaded: { dups: DEDUP.dups, dupLog: DEDUP.log, batches, complete: exhausted },
        }) };
      }
      return CORE_CACHE.idx;
    }
    const CORE_FNS = new Map([['acq', computeAcquisition], ['jr', computeJourney], ['tech', computeTech], ['meta', computeMeta]]);
    /** Výsledek jedné části jádra ('acq' | 'jr' | 'tech' | 'meta') pro aktuální data, z mezipaměti. */
    function coreResult(part) {
      const idx = coreIndex(), fn = CORE_FNS.get(part);
      if (!fn) return null;
      if (!CORE_CACHE.out.has(part)) CORE_CACHE.out.set(part, fn(idx));
      return CORE_CACHE.out.get(part);
    }

    // Lokální ověření (jen localhost): ?demo ukáže dashboard bez přihlášení a bez Firestore.
    // window.__dash.setData(výpis) podstrčí data jedním voláním: {INSTALLS, OVERRIDES (objekt nebo dvojice),
    // RC_EVENTS, STORE, RAW (projde stejnou deduplikací jako fetchPage), RATINGS, RETENTION, AD_CAMPAIGNS,
    // NOW nebo meta.dumpedAt (= „teď“ výpočtů), meta.batches}. __dash.core() vrátí výstupy jádra.
    if (location.hostname === 'localhost') {
      window.__dash = {
        setData(d = {}) {
          if (!d || typeof d !== 'object') return;
          // Stejná normalizace jako v produkci (plainInstall, plainEvent): harness testuje tutéž cestu.
          if (Array.isArray(d.INSTALLS)) INSTALLS = d.INSTALLS.filter((i) => i && typeof i === 'object').map((i) => plainInstall(i, anyMs(i.firstMs), anyMs(i.lastMs)));
          if (d.OVERRIDES && typeof d.OVERRIDES === 'object') OVERRIDES = new Map(Array.isArray(d.OVERRIDES) ? d.OVERRIDES.filter((x) => Array.isArray(x)) : Object.entries(d.OVERRIDES));
          if (Array.isArray(d.RC_EVENTS)) RC_EVENTS = d.RC_EVENTS.filter((x) => x && x.type);
          if (Array.isArray(d.STORE)) STORE = d.STORE.filter((x) => x && x.date && (x.platform === 'ios' || x.platform === 'android'));
          if (Array.isArray(d.RAW)) {
            DEDUP.reset(); RAW = [];
            for (const e of d.RAW) {
              if (!e || typeof e !== 'object') continue;
              // Čas jako fetchPage (bezpecnost2-4): číslo, nebo Timestamp přes tsMs; řetězec se nepřevádí.
              const x = plainEvent(e, e.installId, plainMap(e.dev), isNum(e.ts) ? e.ts : tsMs(e.ts));
              if (DEDUP.add(x)) RAW.push(x);
            }
            const mb = d.meta && typeof d.meta === 'object' ? Number(d.meta.batches) : NaN;
            batches = Number.isFinite(mb) ? mb : 0;
          }
          if ('RATINGS' in d) RATINGS = d.RATINGS ? { state: 'ok', data: d.RATINGS } : { state: 'missing', data: null };
          if ('RETENTION' in d) RETENTION = d.RETENTION ? { state: 'ok', data: d.RETENTION } : { state: 'missing', data: null };
          if ('AD_CAMPAIGNS' in d) AD_CAMPAIGNS = d.AD_CAMPAIGNS && typeof d.AD_CAMPAIGNS === 'object' ? { ...d.AD_CAMPAIGNS, updatedAt: campaignUpdatedAt(d.AD_CAMPAIGNS.updatedAt) } : null;
          // Odkřížkované kampaně: {acks:{…}} nebo null (= bez stavu, tlačítka se neukážou); v demu se zápis drží jen v paměti.
          if ('CAMPAIGN_REVIEW' in d) CAMP_REVIEW = d.CAMPAIGN_REVIEW && typeof d.CAMPAIGN_REVIEW === 'object' ? { state: 'ok', acks: cleanAcks(d.CAMPAIGN_REVIEW.acks) } : { state: 'missing', acks: {} };
          const nowIn = 'NOW' in d ? d.NOW : d.meta && typeof d.meta === 'object' ? d.meta.dumpedAt : undefined;
          if (nowIn !== undefined) { const t = anyMs(nowIn); NOW_FIXED = Number.isFinite(t) ? t : null; }
          exhausted = true; dataReady = true; dashCoverage = true; purchaseCoverage = true; LOADED_AT = nowMs();
          DATA_VER++; OVERRIDES_VER++; CORE_CACHE.key = null;
          reclassify();
          buildFilterOptions();
          render();
        },
        core() { return { meta: coreResult('meta'), acq: coreResult('acq'), jr: coreResult('jr'), tech: coreResult('tech') }; },
        render: renderDashboard,
      };
    }
    if (DEMO) {
      $('login').classList.add('hidden');
      $('dash').classList.remove('hidden');
      $('who').textContent = '· demo (localhost, bez Firestore)';
      $('status').classList.add('hidden');
      CAMP_REVIEW = { state: 'ok', acks: {} }; // odkřížkování v demu jen v paměti
      exhausted = true; dataReady = true; LOADED_AT = Date.now();
    }

    // init záložky z adresy (staré adresy už přesměroval tabFromHash)
    showTab(activeTab);
  </script>
</body>
</html>
