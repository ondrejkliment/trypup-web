---
import Base from '../../layouts/Base.astro';
import { featureIcons } from '../../lib/featureIcons';

// Ikony per oblast → `featureIcons` (sdílené, 1:1 z appky). Pořadí musí sedět.
const features = [
  { title: 'GPS-Spaziergänge', text: 'Echte Strecken mit Zeit, Distanz und einer Anti-Cheat-Prüfung, dass Sie tatsächlich draußen waren.' },
  { title: 'Tägliche Pflege', text: 'Füttern, Spielen, Pflege, Ruhe. Die Werte reagieren darauf, wie gut Sie sich kümmern.' },
  { title: 'Training', text: '9 Kommandos mit fortschreitenden Freischaltungen. Jede Rasse lernt in ihrem eigenen Tempo.' },
  { title: 'Gesundheit & Kosten', text: 'Impfplan und realistische monatliche und jährliche Hundekosten.' },
  { title: 'Wissen', text: 'Artikel über Adoption, die Wahl eines Tierheims und die Fragen, die Sie sich zuerst stellen sollten.' },
  { title: 'Gemeinsame Verantwortung', text: 'Teilen Sie die Pflege mit der Familie — jeder sieht, was der andere getan hat.' },
];
---
<Base
  title="Trypup — ein Hund auf Probe"
  description="Trypup ist ein Hund auf Probe — ein realistischer Hunde-Pflege-Simulator. Spaziergänge, Füttern, Training und Kosten, bevor Sie einen echten Hund anschaffen."
  lang="de"
  alt="/en/"
  pageKey="home">
  <section class="hero wrap">
    <span class="badge">🐾 Pädagogischer Pflege-Simulator</span>
    <h1>Ein Hund auf Probe</h1>
    <p class="lead">Erleben Sie selbst, was die Pflege eines Hundes wirklich bedeutet — <strong>bevor Sie sich einen echten anschaffen</strong>.</p>
    <div class="cta-row">
      <a class="btn btn-primary" href="#get">App herunterladen</a>
      <a class="btn btn-ghost" href="#how-it-works">Wie es funktioniert</a>
    </div>
  </section>

  <section class="stat section">
    <div class="wrap">
      <p class="big"><span>Die meisten Tierheimhunde</span> landen dort nicht wegen des Hundes selbst, sondern weil ihre Besitzer nicht vorbereitet waren.</p>
      <p style="opacity:.8;margin-top:10px">Mit Trypup finden Sie es vor der Entscheidung heraus — nicht danach.</p>
    </div>
  </section>

  <section id="how-it-works" class="section wrap">
    <h2 class="section-title">Wie es funktioniert</h2>
    <p class="section-sub">Drei Schritte, genau wie bei der Pflege eines echten Hundes.</p>
    <div class="steps" style="max-width:680px;margin:0 auto">
      <div class="step"><div class="num"></div><div><strong>Wählen Sie eine Rasse und geben Sie Ihrem Hund einen Namen.</strong> <span>Ein Fragebogen empfiehlt, was zu Ihnen passt.</span></div></div>
      <div class="step"><div class="num"></div><div><strong>Kümmern Sie sich jeden Tag um ihn.</strong> <span>Spaziergänge, Füttern, Training, Tierarzt. Nichts kann übersprungen werden.</span></div></div>
      <div class="step"><div class="num"></div><div><strong>Erfahren Sie die Wahrheit über sich selbst.</strong> <span>Schaffen Sie es, die Routine auch an Tagen einzuhalten, an denen Sie keine Lust haben? Vernachlässigen Sie den Hund, kommt er ins Tierheim — ohne Konsequenzen für ein lebendes Tier.</span></div></div>
    </div>
  </section>

  <section class="section wrap">
    <h2 class="section-title">Was die App bietet</h2>
    <p class="section-sub">Eine realistische Pflegesimulation — von Spaziergängen bis zu den Kosten.</p>
    <div class="grid">
      {features.map((f, i) => (
        <div class="card">
          <div class="feat-icon" set:html={featureIcons[i]} />
          <h3>{f.title}</h3>
          <p>{f.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="get" class="section wrap center">
    <h2 class="section-title">Trypup herunterladen</h2>
    <p class="section-sub">Trypup ist jetzt für Android und iPhone erhältlich. Laden Sie die App herunter und probieren Sie einen Hund zur Probe.</p>
    <div class="store-btns">
      <a class="store-badge gp" href="https://play.google.com/store/apps/details?id=app.trypup.mobile&amp;pcampaignid=web_trypup" target="_blank" rel="noopener">
        <img src="/badges/google-play-en.png" alt="Get it on Google Play" width="478" height="142" />
      </a>
      <a class="store-badge as" href="https://apps.apple.com/app/trypup-try-a-dog-first/id6775990135" target="_blank" rel="noopener">
        <img src="/badges/app-store-en.svg" alt="Download on the App Store" width="120" height="40" />
      </a>
    </div>
  </section>
</Base>
