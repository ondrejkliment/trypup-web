---
import Base from '../layouts/Base.astro';
// Cíl magic linku z pozvánky ke spoluvlastnictví: https://trypup.life/join?c=KÓD
// Statická stránka — kód čte klientský skript z query parametru. Tlačítko
// „Otevřít v aplikaci" vede na deep link trypup://join/KÓD (zpracuje appka).
---
<Base
  title="Připojit se k péči — Trypup"
  description="Připoj se ke společné péči o psa v aplikaci Trypup."
>
  <section class="section wrap" style="text-align:center; max-width: 560px; margin-inline: auto;">
    <h1 style="margin-bottom: 0.4rem;">🐾 Pozvánka ke společné péči</h1>
    <p class="meta" style="margin-bottom: 2rem;">Někdo tě zve, abyste se spolu starali o psa v Trypup.</p>

    <div id="code-card" style="background: #FDF4EF; border: 2px solid #F2784B; border-radius: 16px; padding: 1.5rem; margin-bottom: 1.5rem;">
      <div style="font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; color: #4A2B45; opacity: .7; margin-bottom: .4rem;">Tvůj kód</div>
      <div id="code" style="font-size: 2.6rem; font-weight: 800; letter-spacing: .35em; color: #4A2B45;">······</div>
      <button id="copy" style="margin-top: 1rem; background: none; border: 1px solid #F2784B; color: #F2784B; border-radius: 999px; padding: .5rem 1.2rem; font-size: .95rem; cursor: pointer;">📋 Zkopírovat kód</button>
    </div>

    <a id="open-app" href="#" style="display: inline-block; background: #F2784B; color: #fff; border-radius: 999px; padding: .9rem 2rem; font-weight: 700; text-decoration: none; margin-bottom: 1rem;">Otevřít v aplikaci Trypup</a>

    <p style="font-size: .9rem; opacity: .75; line-height: 1.5;">
      Nemáš appku? Trypup je zatím v testování — požádej toho, kdo tě pozval,
      o pozvánku do TestFlightu (iOS) nebo testovací verze na Google Play.
      Pak se vrať sem, nebo kód <span id="code-inline" style="font-weight:700;"></span> zadej v appce na záložce <strong>Spolu → Připojit se</strong>.
    </p>
    <p id="no-code" hidden style="color: #B91C1C; font-weight: 600;">Odkaz nemá platný kód — požádej o nové pozvání.</p>
  </section>

  <script>
    const params = new URLSearchParams(location.search);
    const raw = (params.get('c') ?? params.get('code') ?? '').trim().toUpperCase();
    const valid = /^[A-Z2-9]{6}$/.test(raw);
    const codeEl = document.getElementById('code');
    const inlineEl = document.getElementById('code-inline');
    const openEl = document.getElementById('open-app') as HTMLAnchorElement | null;
    const copyEl = document.getElementById('copy');
    if (valid && codeEl && openEl) {
      codeEl.textContent = raw;
      if (inlineEl) inlineEl.textContent = raw;
      openEl.href = `trypup://join/${raw}`;
      copyEl?.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(raw); if (copyEl) copyEl.textContent = '✓ Zkopírováno'; } catch {}
      });
    } else {
      document.getElementById('code-card')?.setAttribute('hidden', '');
      openEl?.setAttribute('hidden', '');
      document.getElementById('no-code')?.removeAttribute('hidden');
    }
  </script>
</Base>
