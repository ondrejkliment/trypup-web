---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { featureIcons } from '../lib/featureIcons';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
).slice(0, 3);

// Ikony per oblast → `featureIcons` (sdílené, 1:1 z appky). Pořadí musí sedět.
const features = [
  { title: 'GPS procházky', text: 'Reálné trasy s časem, vzdáleností a anti-cheat kontrolou, že fakt jdete ven.' },
  { title: 'Denní péče', text: 'Krmení, hra, čištění, odpočinek. Statistiky reagují na to, jak se staráte.' },
  { title: 'Výcvik', text: '9 povelů s postupným odemykáním. Každé plemeno se učí jinak rychle.' },
  { title: 'Zdraví & náklady', text: 'Očkovací kalendář a reálné měsíční i roční náklady na psa.' },
  { title: 'Vzdělávání', text: 'Články o adopci, výběru útulku a otázkách, které si položíte předem.' },
  { title: 'Spoluvlastnictví', text: 'Sdílejte péči s rodinou — každý vidí, co udělal ten druhý.' },
];
---
<Base alt="/en/">
  <section class="hero wrap">
    <span class="badge" data-cms="home.cs.hero.badge">🐾 Edukativní simulátor péče</span>
    <h1 data-cms="home.cs.hero.title">Pes na zkoušku</h1>
    <p class="lead" data-cms="home.cs.hero.lead">Vyzkoušejte si na vlastní kůži, co péče o psa obnáší — <strong>dřív, než si pořídíte toho skutečného</strong>.</p>
    <div class="cta-row">
      <a class="btn btn-primary" href="#stahnout" data-cms="home.cs.hero.ctaPrimary">Stáhnout appku</a>
      <a class="btn btn-ghost" href="#jak-to-funguje" data-cms="home.cs.hero.ctaGhost">Jak to funguje</a>
    </div>
  </section>

  <section class="stat section">
    <div class="wrap">
      <p class="big" data-cms="home.cs.stat.big">Většina psů v útulcích tam není kvůli povaze, ale kvůli <span>nepřipravenosti majitelů</span>.</p>
      <p style="opacity:.8;margin-top:10px" data-cms="home.cs.stat.sub">Trypup vám dá šanci to zjistit před rozhodnutím — ne po něm.</p>
    </div>
  </section>

  <section id="jak-to-funguje" class="section wrap">
    <h2 class="section-title" data-cms="home.cs.how.title">Jak to funguje</h2>
    <p class="section-sub" data-cms="home.cs.how.sub">Tři kroky, jako byste se starali doopravdy.</p>
    <div class="steps" style="max-width:680px;margin:0 auto">
      <div class="step"><div class="num"></div><div><strong data-cms="home.cs.how.step1title">Vyberte plemeno a pojmenujte psa.</strong> <span data-cms="home.cs.how.step1text">Dotazník vám doporučí, co k vám sedí.</span></div></div>
      <div class="step"><div class="num"></div><div><strong data-cms="home.cs.how.step2title">Starejte se každý den.</strong> <span data-cms="home.cs.how.step2text">Procházky, krmení, výcvik, veterina. Nic se nedá odbýt.</span></div></div>
      <div class="step"><div class="num"></div><div><strong data-cms="home.cs.how.step3title">Zjistěte pravdu o sobě.</strong> <span data-cms="home.cs.how.step3text">Zvládnete rutinu i ve dnech, kdy se vám nechce? Pokud psa zanedbáte, odejde do útulku — bez následků pro živé zvíře.</span></div></div>
    </div>
  </section>

  <section class="section wrap">
    <h2 class="section-title" data-cms="home.cs.feat.title">Co appka umí</h2>
    <p class="section-sub" data-cms="home.cs.feat.sub">Realistická simulace péče — od procházek po náklady.</p>
    <div class="grid">
      {features.map((f, i) => (
        <div class="card">
          <div class="feat-icon" set:html={featureIcons[i]} />
          <h3 data-cms={`home.cs.feat${i + 1}.title`}>{f.title}</h3>
          <p data-cms={`home.cs.feat${i + 1}.text`}>{f.text}</p>
        </div>
      ))}
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section wrap">
      <h2 class="section-title">Z blogu</h2>
      <p class="section-sub">Fakta a tipy o zodpovědné péči a adopci.</p>
      <div class="posts">
        {posts.map((p) => (
          <a class="post-row" href={`/blog/${p.id}/`}>
            <h3>{p.data.title}</h3>
            <div class="meta">{p.data.tag ? p.data.tag + ' · ' : ''}{p.data.date.toLocaleDateString('cs-CZ')}</div>
            <p>{p.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <section id="stahnout" class="section wrap center">
    <h2 class="section-title" data-cms="home.cs.dl.title">Pes na zkoušku</h2>
    <p class="section-sub" data-cms="home.cs.dl.sub">Appka brzy v App Store a Google Play. Zatím se mrkněte, o co jde.</p>
    <div class="cta-row">
      <a class="btn btn-primary" href="/o-aplikaci/" data-cms="home.cs.dl.ctaPrimary">O aplikaci</a>
      <a class="btn btn-ghost" href="/blog/" data-cms="home.cs.dl.ctaGhost">Číst blog</a>
    </div>
  </section>
</Base>
