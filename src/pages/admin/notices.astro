---
// Trypup – skrytý editor oznámení v aplikaci („Novinky a akce"). Píše do Firestore
// `app_notice/current`, pole `items: Notice[]`; app to čte při startu
// (@stores/appNoticeStore) – doručení je „při dalším otevření aplikace".
//
// PUSH (od 10/2026, pawprint-mobile/docs/PUSH_PLAN.md): ke zveřejněné zprávě jde poslat
// segmentované push oznámení. Admin tu jen založí dokument `push_campaigns/{id}`
// (status queued) – segment vyhodnotí a rozešle Cloud Function `onPushCampaignCreated`
// (FCM + APNs), výsledek zapíše zpět a tahle stránka ho sleduje přes onSnapshot.
// Tokeny zařízení (`push_devices`) prohlížeč NIKDY nečte (rules) – počty dává dry-run.
//
// Tvar zápisu MUSÍ sedět na `isValidNotice` ve storu, jinak aplikace zprávu TIŠE zahodí.
// Proto je validace níž zkopírovaná 1:1 ze storu a běží před každým uložením.
// Zároveň se nikam neposílá `undefined` (Firestore ho odmítá) – volitelná pole se
// do objektu vůbec nepřidávají.
//
// Přístup jen admin (Firestore rules), skryté pro roboty (noindex + robots.txt).
// POZOR: styly jsou `is:global` – seznam se vykresluje z JS, scoped styly by na něj
// nesedly (bez data-astro-cid atributu by byl plochý).
---
<!doctype html>
<html lang="cs">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Trypup · Oznámení</title>
  <style is:global>
    :root { --apricot:#F2784B; --water:#3E7C8C; --bg:#1d1620; --card:#2a2230; --line:#3c3242; --muted:#a99bb0; --text:#f3ecf2; }
    * { box-sizing:border-box; }
    body { margin:0; background:var(--bg); color:var(--text); font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; font-size:14px; }
    a { color:var(--apricot); }
    .wrap { max-width:940px; margin:0 auto; padding:24px 18px 80px; }
    header { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:18px; flex-wrap:wrap; }
    h1 { font-size:20px; margin:0; font-weight:800; }
    h1 small { color:var(--muted); font-weight:500; font-size:13px; }
    h2 { font-size:13px; text-transform:uppercase; letter-spacing:.6px; color:var(--apricot); margin:0 0 10px; }
    button { background:var(--apricot); color:#fff; border:0; border-radius:10px; padding:9px 15px; font-weight:700; cursor:pointer; font-family:inherit; }
    button.ghost { background:transparent; color:var(--muted); border:1px solid var(--line); }
    button.danger { background:transparent; color:#ff8a8a; border:1px solid #6a2f2f; }
    button.sm { padding:5px 10px; font-size:12px; font-weight:600; }
    button:disabled { opacity:.5; cursor:not-allowed; }
    .center { min-height:70vh; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:16px; text-align:center; }
    .logo { width:64px; height:64px; border-radius:18px; }
    input, textarea, select { background:var(--bg); color:var(--text); border:1px solid var(--line); border-radius:8px; padding:8px 10px; font-size:13px; width:100%; font-family:inherit; resize:vertical; }
    input:focus, textarea:focus, select:focus { outline:none; border-color:var(--apricot); }
    .toolbar { display:flex; gap:8px; align-items:center; flex-wrap:wrap; }
    .panel { background:var(--card); border:1px solid var(--line); border-radius:14px; padding:16px 18px; margin-top:14px; }
    label { display:block; font-size:12px; color:var(--muted); margin:0 0 4px; }
    .field { margin:0 0 12px; }
    .cols { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
    .cols3 { display:grid; grid-template-columns:1fr 1fr 1fr; gap:14px; }
    .flag { font-size:12px; font-weight:700; color:var(--text); }
    .count { float:right; font-size:11px; color:var(--muted); font-weight:500; }
    .count.over { color:#e8c46a; }
    .more-langs { margin:2px 0 12px; }
    .more-langs > summary { cursor:pointer; font-size:12.5px; font-weight:700; margin:4px 0 10px; }
    .hidden { display:none !important; }
    .err { color:#ff8a8a; } .ok { color:#7dd39a; } .warn { color:#e8c46a; }
    .muted { color:var(--muted); font-size:12.5px; }
    .hint { color:var(--muted); font-size:12px; margin:6px 0 0; line-height:1.5; }

    /* --- cílení podle země --- */
    .chips { display:flex; flex-wrap:wrap; gap:6px; }
    .chip { display:inline-flex; align-items:center; gap:6px; border:1px solid var(--line); border-radius:20px; padding:5px 11px; font-size:12.5px; cursor:pointer; user-select:none; background:var(--bg); }
    .chip input { width:auto; margin:0; accent-color:var(--apricot); }
    .chip.on { border-color:var(--apricot); color:#fff; background:rgba(242,120,75,.16); }
    .chip.all { font-weight:700; }

    /* --- seznam existujících oznámení (vykresluje se z JS → is:global styly) --- */
    .item { border:1px solid var(--line); border-radius:12px; padding:12px 14px; margin:0 0 10px; background:var(--bg); }
    .item.dead { opacity:.6; }
    .item.bad { border-color:#6a2f2f; }
    .item-head { display:flex; align-items:flex-start; gap:10px; justify-content:space-between; flex-wrap:wrap; }
    .item-title { font-weight:700; font-size:14.5px; }
    .item-meta { font-size:11.5px; color:var(--muted); margin-top:5px; line-height:1.6; }
    .item-body { font-size:12.5px; color:var(--muted); margin-top:8px; white-space:pre-wrap; border-left:2px solid var(--line); padding-left:10px; }
    .item-acts { display:flex; gap:6px; flex-shrink:0; }
    .badge { display:inline-block; border-radius:20px; padding:1px 8px; font-size:10.5px; font-weight:700; margin-left:6px; vertical-align:middle; }
    .badge.live { background:#17351f; color:#7dd39a; border:1px solid #2c5c39; }
    .badge.gone { background:#2f2a33; color:var(--muted); border:1px solid var(--line); }
    .badge.bad  { background:#3a1c1c; color:#ff8a8a; border:1px solid #6a2f2f; }
    .badge.push { background:#1c2f3a; color:#8fd0e8; border:1px solid #2f5668; }

    /* --- push --- */
    .push-panel { border:1px solid #2f5668; }
    .push-panel h2 { color:#8fd0e8; }
    .seg { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
    .seg .field { margin:0; }
    .stat { display:inline-block; background:var(--bg); border:1px solid var(--line); border-radius:10px; padding:8px 12px; margin:4px 6px 4px 0; font-size:12.5px; }
    .stat b { font-size:16px; display:block; color:#fff; }
    .hist { border:1px solid var(--line); border-radius:12px; padding:10px 14px; margin:0 0 8px; background:var(--bg); font-size:12.5px; }
    .hist .h-top { display:flex; justify-content:space-between; gap:10px; flex-wrap:wrap; }
    .hist .h-meta { color:var(--muted); font-size:11.5px; margin-top:4px; line-height:1.6; }
    .st-queued, .st-counting, .st-sending, .st-scheduled { color:#e8c46a; } .st-done, .st-dry { color:#7dd39a; } .st-failed { color:#ff8a8a; } .st-cancelled { color:var(--muted); }

    @media(max-width:680px){ .cols, .cols3 { grid-template-columns:1fr; } }
  </style>
</head>
<body>
  <div id="login" class="center">
    <img src="/icon.png" class="logo" alt="Trypup" />
    <h1>Trypup · Oznámení</h1>
    <p class="muted" style="max-width:340px">Skrytý editor novinek a akcí v aplikaci. Přihlas se admin účtem Google.</p>
    <button id="signin">Přihlásit přes Google</button>
    <p id="login-err" class="err"></p>
  </div>

  <div id="app" class="wrap hidden">
    <header>
      <h1>Trypup · Oznámení <small id="who"></small></h1>
      <div class="toolbar">
        <a href="/admin" class="muted">← Analytika</a>
        <a href="/admin/content" class="muted">✏️ Obsah webu</a>
        <a href="/admin/shelters" class="muted">🐾 Útulky</a>
        <a href="/admin/articles" class="muted">📚 Články a zdroje</a>
        <button id="signout" class="ghost sm">Odhlásit</button>
      </div>
    </header>
    <p id="state" class="muted"></p>

    <!-- === NOVÁ ZPRÁVA === -->
    <div class="panel">
      <h2 id="form-title">Nová zpráva</h2>
      <p class="hint editing-only hidden" id="edit-hint"></p>
      <div class="cols">
        <div>
          <div class="field">
            <label><span class="flag">🇨🇿 Titulek (česky)</span><span class="count" id="c-cs-title"></span></label>
            <input id="cs-title" maxlength="120" placeholder="Sraz štěňat v Riegrových sadech" />
          </div>
          <div class="field">
            <label><span class="flag">🇨🇿 Text (česky)</span><span class="count" id="c-cs-body"></span></label>
            <textarea id="cs-body" rows="5" placeholder="V sobotu od 10:00 se scházíme…"></textarea>
          </div>
        </div>
        <div>
          <div class="field">
            <label><span class="flag">🇬🇧 Titulek (anglicky)</span><span class="count" id="c-en-title"></span></label>
            <input id="en-title" maxlength="120" placeholder="Puppy meetup in Riegrovy sady" />
          </div>
          <div class="field">
            <label><span class="flag">🇬🇧 Text (anglicky)</span><span class="count" id="c-en-body"></span></label>
            <textarea id="en-body" rows="5" placeholder="Saturday from 10:00 we meet…"></textarea>
          </div>
        </div>
      </div>
      <details class="more-langs" id="more-langs">
        <summary>Další jazyky aplikace <span class="muted">(sk, pl, de, es, fr, it, nl, pt, uk, bg; prázdný jazyk dostane anglickou verzi)</span></summary>
        <div class="cols" id="more-langs-box"></div>
      </details>

      <div class="cols3" style="margin-top:4px">
        <div class="field">
          <label>Datum a čas akce <span class="muted">(volitelné)</span></label>
          <input id="eventAt" type="datetime-local" />
        </div>
        <div class="field">
          <label>Zpráva zmizí z banneru <span class="muted">(volitelné)</span></label>
          <input id="expiresAt" type="datetime-local" />
        </div>
        <div class="field">
          <label>Odkaz <span class="muted">(volitelné, jen https://)</span></label>
          <input id="url" placeholder="https://…" />
        </div>
      </div>

      <div class="field">
        <label>Komu zprávu ukázat (země zařízení)</label>
        <div class="chips" id="countries"></div>
        <p class="hint">Aplikace zemi bere z nastavení telefonu a nikam ji neposílá – filtruje se na zařízení.
          Když zařízení zemi nehlásí, cílená zpráva se <strong>nezobrazí</strong> (proto „Všem" u obecných novinek).</p>
      </div>

      <div class="toolbar" style="margin-top:6px">
        <button id="publish">Zveřejnit zprávu</button>
        <button id="cancel-edit" class="ghost editing-only hidden">Zrušit úpravu</button>
        <button id="clear" class="ghost">Vyprázdnit formulář</button>
        <span id="msg" class="muted"></span>
      </div>
    </div>

    <!-- === PUSH (skryté, dokud se u zprávy neklikne „Poslat push") === -->
    <div class="panel push-panel hidden" id="push-panel">
      <h2>Push oznámení <span class="muted" id="push-for"></span></h2>
      <p class="hint" style="margin:0 0 12px">Push dostanou jen zařízení, která mají povolené notifikace a v Nastavení zapnuté „Novinky a akce push".
        Klepnutí otevře v aplikaci Novinky a akce – tam musí být zpráva, ke které push patří. Text pushe drž krátký (titulek ≤ 50, text ≤ 140 znaků).</p>
      <div class="cols" id="push-texts"></div>

      <div class="field">
        <label>Jazyk aplikace příjemce</label>
        <div class="chips" id="p-langs"></div>
        <p class="hint">Kdo má aplikaci v jazyce bez vlastního textu, dostane anglickou verzi (a bez ní první vyplněnou).</p>
      </div>
      <div class="field">
        <label>Země zařízení</label>
        <div class="chips" id="p-countries"></div>
      </div>
      <div class="seg">
        <div class="field">
          <label>Platforma</label>
          <div class="chips">
            <label class="chip on"><input type="checkbox" id="p-ios" checked /><span>iOS</span></label>
            <label class="chip on"><input type="checkbox" id="p-android" checked /><span>Android</span></label>
          </div>
        </div>
        <div class="field">
          <label>Aktivita</label>
          <select id="p-activity">
            <option value="">Všichni</option>
            <option value="active:7">Aktivní za posledních 7 dní</option>
            <option value="active:30">Aktivní za posledních 30 dní</option>
            <option value="inactive:3">Neaktivní 3 a více dní</option>
            <option value="inactive:7">Neaktivní 7 a více dní</option>
            <option value="inactive:30">Neaktivní 30 a více dní</option>
          </select>
        </div>
        <div class="field">
          <label>Neposílat tomu, kdo dostal push za posledních</label>
          <select id="p-quiet">
            <option value="">– bez omezení –</option>
            <option value="1">1 den</option>
            <option value="3" selected>3 dny</option>
            <option value="7">7 dní</option>
            <option value="14">14 dní</option>
          </select>
        </div>
        <div class="field">
          <label>Strop příjemců</label>
          <input id="p-max" type="number" min="1" max="200000" value="20000" />
        </div>
      </div>
      <div class="field" style="margin-top:12px">
        <label for="p-minver">Minimální verze aplikace <span class="muted">(volitelné, např. 2.0.0)</span></label>
        <input id="p-minver" placeholder="2.0.0" maxlength="20" autocomplete="off" spellcheck="false" />
        <p class="hint">Push dostanou jen zařízení s touto nebo vyšší verzí aplikace (porovnává se číselně, takže 1.10 je víc než 1.9).
          Zařízení, které verzi nehlásí, push <strong>nedostane</strong>. Prázdné = všechny verze. Novou verzi zařízení nahlásí, až v ní uživatel aplikaci otevře.</p>
      </div>
      <div class="field" style="margin-top:12px">
        <label>Kdy odeslat</label>
        <div class="seg">
          <select id="p-when">
            <option value="now">Hned</option>
            <option value="local">Naplánovat na místní čas zařízení</option>
          </select>
          <input id="p-date" type="date" class="hidden" />
          <input id="p-time" type="time" class="hidden" value="10:00" />
        </div>
        <p class="hint hidden" id="p-when-hint">Každé zařízení dostane push v tento čas <strong>podle svého časového pásma</strong> (zařízení bez pásma podle Prahy),
          nejpozději do 15 minut. Pásmo, kterému čas nastal před víc než 3 hodinami, se přeskočí. Naplánovanou kampaň jde v historii zrušit,
          dokud neodejde poslední vlna. Ostatní ostré pushe se od první vlny do konce kampaně zablokují.</p>
      </div>
      <div class="field" style="margin-top:12px">
        <label>Jen testovací zařízení <span class="muted">(ID zařízení z Nastavení aplikace, oddělená čárkou – ostatní filtry platí dál)</span></label>
        <input id="p-devices" placeholder="a3f1c2d4, 9b8e7f6a" />
      </div>
      <div class="toolbar" style="margin-top:6px">
        <button id="p-count" class="ghost">Spočítat příjemce</button>
        <button id="p-send">Odeslat push</button>
        <button id="p-close" class="ghost">Zavřít</button>
        <span id="p-msg" class="muted"></span>
      </div>
      <div id="p-result" style="margin-top:10px"></div>
    </div>

    <!-- === SEZNAM === -->
    <div class="panel">
      <h2>Zveřejněné zprávy <span id="cnt" class="muted"></span></h2>
      <div id="list"></div>
      <div class="toolbar" style="margin-top:10px">
        <button id="reload" class="ghost sm">Načíst znovu</button>
        <span id="listmsg" class="muted"></span>
      </div>
      <p class="hint">
        <strong>Smazání ≠ stažení zprávy.</strong> Kdo aplikaci už otevřel, má zprávu v archivu
        (Nastavení → Novinky a akce) a smazání z remote ji odtud neodebere. Chceš-li zprávu
        <em>sundat z banneru</em> i lidem, co ji už mají, použij <strong>„Ukončit teď"</strong>
        (nastaví expiraci na teď a app si opravu stáhne). „Smazat" ji jen přestane rozesílat dál.
      </p>
      <p class="hint">Aplikace si drží posledních 30 zpráv. Nové zprávy se u lidí objeví při dalším otevření aplikace – nebo hned, když k nim pošleš push („Poslat push" u zprávy).</p>
    </div>

    <!-- === HISTORIE PUSHŮ === -->
    <div class="panel">
      <h2>Push kampaně <span id="h-cnt" class="muted"></span></h2>
      <div class="toolbar" style="margin-bottom:10px">
        <button id="h-devices" class="ghost sm">Přehled registrovaných zařízení</button>
        <span id="h-msg" class="muted"></span>
      </div>
      <div id="h-devices-out"></div>
      <div id="hist"></div>
      <p class="hint">Ostrá kampaň jde nejvýš jednou za hodinu (pojistka proti dvojkliku); testovací rozeslání na konkrétní zařízení je z toho vyňaté.
        Neplatné tokeny (odinstalovaná aplikace) funkce po rozeslání sama maže.</p>
    </div>
  </div>

  <script type="module" is:inline>
    import { initializeApp } from 'https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js';
    import { getAuth, GoogleAuthProvider, signInWithPopup, signOut, onAuthStateChanged }
      from 'https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js';
    import { getFirestore, doc, getDoc, setDoc, updateDoc, serverTimestamp, collection, addDoc, query, orderBy, limit, onSnapshot }
      from 'https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js';

    const ADMIN_EMAIL = 'o.kliment@gmail.com';
    const COLLECTION = 'app_notice';
    const DOC_ID = 'current';
    const CAMPAIGNS = 'push_campaigns';
    /** Jazyky aplikace (musí sedět na SUPPORTED_LANGUAGES v src/locales/index.ts). */
    const APP_LANGS = ['cs','en','sk','pl','de','es','fr','it','nl','pt','uk','bg'];
    // Texty zprávy i pushe ve všech jazycích aplikace (aplikace bere text svého jazyka, jinak en).
    const LANG_META = { cs: ['🇨🇿', 'česky'], en: ['🇬🇧', 'anglicky'], sk: ['🇸🇰', 'slovensky'], pl: ['🇵🇱', 'polsky'], de: ['🇩🇪', 'německy'], es: ['🇪🇸', 'španělsky'],
      fr: ['🇫🇷', 'francouzsky'], it: ['🇮🇹', 'italsky'], nl: ['🇳🇱', 'nizozemsky'], pt: ['🇵🇹', 'portugalsky'], uk: ['🇺🇦', 'ukrajinsky'], bg: ['🇧🇬', 'bulharsky'] };
    const TEXT_LANGS = APP_LANGS;
    const EXTRA_LANGS = TEXT_LANGS.filter((l) => l !== 'cs' && l !== 'en');

    // Země, kam aplikace reálně míří (kopíruje 12 jazyků + sousední trhy). ISO-3166-1 alpha-2.
    const COUNTRIES = [
      { code:'CZ', name:'🇨🇿 Česko' },   { code:'SK', name:'🇸🇰 Slovensko' }, { code:'PL', name:'🇵🇱 Polsko' },
      { code:'DE', name:'🇩🇪 Německo' }, { code:'AT', name:'🇦🇹 Rakousko' },  { code:'CH', name:'🇨🇭 Švýcarsko' },
      { code:'GB', name:'🇬🇧 Británie' },{ code:'IE', name:'🇮🇪 Irsko' },     { code:'US', name:'🇺🇸 USA' },
      { code:'CA', name:'🇨🇦 Kanada' },  { code:'ES', name:'🇪🇸 Španělsko' }, { code:'FR', name:'🇫🇷 Francie' },
      { code:'IT', name:'🇮🇹 Itálie' },  { code:'NL', name:'🇳🇱 Nizozemsko' },{ code:'BE', name:'🇧🇪 Belgie' },
      { code:'PT', name:'🇵🇹 Portugalsko' }, { code:'UA', name:'🇺🇦 Ukrajina' }, { code:'BG', name:'🇧🇬 Bulharsko' },
    ];

    const app = initializeApp({ apiKey:'AIzaSyCrFi62rqFPVJuyFcS8HHuEGhZ1PfElgAs', authDomain:'trypupapp.firebaseapp.com', projectId:'trypupapp', storageBucket:'trypupapp.firebasestorage.app', messagingSenderId:'354782336728', appId:'1:354782336728:web:b14e119b183bf4d824e9ad' });
    const auth = getAuth(app); const db = getFirestore(app);
    const $ = (id) => document.getElementById(id);

    /** Aktuální obsah remote pole `items`. Zdroj pravdy pro každý zápis. */
    let items = [];

    // ------------------------------------------------------------------
    // Validace – KOPIE 1:1 z @stores/appNoticeStore.isValidNotice.
    // Když se store změní, změň i tohle. Zpráva, která tudy neprojde, by se
    // v aplikaci tiše zahodila, takže ji radši vůbec neuložíme.
    // ------------------------------------------------------------------
    function isValidText(t) {
      return !!t && typeof t.title === 'string' && !!t.title.trim() && typeof t.body === 'string';
    }
    function isValidNotice(n) {
      if (!n || typeof n.id !== 'string' || !n.id.trim()) return false;
      if (typeof n.publishedAt !== 'number' || !Number.isFinite(n.publishedAt)) return false;
      if (n.expiresAt !== undefined && typeof n.expiresAt !== 'number') return false;
      if (n.eventAt !== undefined && typeof n.eventAt !== 'number') return false;
      if (n.url !== undefined && (typeof n.url !== 'string' || !/^https:\/\//i.test(n.url))) return false;
      if (n.countries !== undefined) {
        if (!Array.isArray(n.countries)) return false;
        if (!n.countries.every((c) => typeof c === 'string' && c.length === 2)) return false;
      }
      if (!n.text || typeof n.text !== 'object' || Array.isArray(n.text)) return false;
      const langs = Object.keys(n.text);
      if (langs.length === 0) return false;
      return langs.every((l) => isValidText(n.text[l]));
    }

    // --- auth -----------------------------------------------------------
    $('signin').onclick = async () => {
      try { await signInWithPopup(auth, new GoogleAuthProvider()); }
      catch (e) { $('login-err').textContent = e.message; }
    };
    $('signout').onclick = () => signOut(auth);

    onAuthStateChanged(auth, (user) => {
      if (user && user.email === ADMIN_EMAIL) {
        $('login').classList.add('hidden'); $('app').classList.remove('hidden');
        $('who').textContent = '· ' + user.email;
        load();
        watchHistory();
      } else if (user) {
        $('login-err').textContent = 'Účet ' + user.email + ' nemá přístup.'; signOut(auth);
      } else {
        $('app').classList.add('hidden'); $('login').classList.remove('hidden');
      }
    });

    // --- cílení podle země ----------------------------------------------
    // „Všem" a konkrétní země se vzájemně vylučují; nevybráno nic = všem.
    function buildCountries() {
      const box = $('countries');
      const mkChip = (name, cls) => {
        const l = document.createElement('label');
        l.className = 'chip' + (cls ? ' ' + cls : '');
        const cb = document.createElement('input'); cb.type = 'checkbox';
        const sp = document.createElement('span'); sp.textContent = name;
        l.appendChild(cb); l.appendChild(sp);
        box.appendChild(l);
        return cb;
      };
      const all = mkChip('Všem (bez cílení)', 'all');
      all.id = 'c-all'; all.checked = true;
      all.onchange = () => {
        if (all.checked) oneBoxes().forEach((c) => { c.checked = false; });
        else if (!anyPicked()) all.checked = true;   // „nic" nedává smysl → zpátky na všem
        paintCountries();
      };
      COUNTRIES.forEach((c) => {
        const cb = mkChip(c.name);
        cb.className = 'c-one'; cb.value = c.code;
        cb.onchange = () => { all.checked = !anyPicked(); paintCountries(); };
      });
      paintCountries();
    }
    const oneBoxes = () => [...document.querySelectorAll('#countries input.c-one')];
    const anyPicked = () => oneBoxes().some((c) => c.checked);
    function paintCountries() {
      document.querySelectorAll('#countries .chip').forEach((l) => {
        l.classList.toggle('on', l.querySelector('input').checked);
      });
    }
    function pickedCountries() {
      return $('c-all').checked ? [] : oneBoxes().filter((c) => c.checked).map((c) => c.value);
    }

    // --- počítadla znaků (banner je úzký, dlouhý titulek se ořeže) --------
    function counter(inputId, outId, soft) {
      const el = $(inputId), out = $(outId);
      const upd = () => {
        const n = el.value.length;
        out.textContent = n ? n + ' / ~' + soft : '';
        out.classList.toggle('over', n > soft);
      };
      el.addEventListener('input', upd); upd();
    }

    // --- pomocné ---------------------------------------------------------
    /** datetime-local → ms epoch. '' = nevyplněno (undefined), nevalidní = NaN. */
    function toMs(v) {
      if (!v) return undefined;
      const t = new Date(v).getTime();
      return Number.isFinite(t) ? t : NaN;
    }
    function fmt(ms) {
      try { return new Date(ms).toLocaleString('cs-CZ', { dateStyle:'medium', timeStyle:'short' }); }
      catch { return String(ms); }
    }
    /** Nerecyklovatelné ID: timestamp + náhodná přípona, ověřené proti existujícím. */
    function newId() {
      let id;
      do { id = 'n_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7); }
      while (items.some((n) => n && n.id === id));
      return id;
    }

    // --- načtení / uložení ------------------------------------------------
    async function load() {
      $('state').textContent = 'Načítám…';
      try {
        const snap = await getDoc(doc(db, COLLECTION, DOC_ID));
        const raw = snap.exists() ? snap.data().items : null;
        items = Array.isArray(raw) ? raw.filter((n) => n && typeof n === 'object') : [];
        const u = snap.exists() ? snap.data().updatedAt : null;
        $('state').innerHTML = snap.exists()
          ? `<span class="ok">Remote dokument existuje</span> · ${items.length} zpráv${u ? ` · upraveno ${fmt(u)}` : ''}`
          : `<span class="muted">Dokument app_notice/current zatím neexistuje – vznikne prvním uložením.</span>`;
        render();
      } catch (e) {
        $('state').innerHTML = `<span class="err">Chyba načítání: ${e.message}</span>`;
      }
    }

    async function persist(next, okMsg, target) {
      const bad = next.find((n) => !isValidNotice(n));
      if (bad) {
        target.innerHTML = `<span class="err">Uložení zastaveno: zpráva „${(bad.id || '?')}" nesplňuje tvar, který aplikace přijímá.</span>`;
        return false;
      }
      target.textContent = 'Ukládám…';
      try {
        await setDoc(doc(db, COLLECTION, DOC_ID), {
          items: next,
          updatedAt: Date.now(),
          updatedBy: ADMIN_EMAIL,
          schema: 1,
          sentAt: serverTimestamp(),
        });
        items = next;
        render();
        target.innerHTML = `<span class="ok">${okMsg}</span>`;
        return true;
      } catch (e) {
        target.innerHTML = `<span class="err">Chyba ukládání: ${e.message}</span>`;
        return false;
      }
    }

    // --- seznam ------------------------------------------------------------
    function render() {
      const list = $('list'); list.innerHTML = '';
      $('cnt').textContent = items.length ? `(${items.length})` : '';
      if (!items.length) {
        const p = document.createElement('p'); p.className = 'muted';
        p.textContent = 'Zatím žádná zpráva.'; list.appendChild(p); return;
      }
      const now = Date.now();
      [...items]
        .sort((a, b) => (b.publishedAt || 0) - (a.publishedAt || 0))
        .forEach((n) => list.appendChild(card(n, now)));
    }

    function card(n, now) {
      const ok = isValidNotice(n);
      const expired = typeof n.expiresAt === 'number' && n.expiresAt <= now;
      const stazena = n.retracted === true;

      const el = document.createElement('div');
      el.className = 'item' + (expired || stazena ? ' dead' : '') + (ok || stazena ? '' : ' bad');

      const head = document.createElement('div'); head.className = 'item-head';
      const left = document.createElement('div');

      const title = document.createElement('div'); title.className = 'item-title';
      title.textContent = (n.text?.cs?.title) || (n.text?.en?.title) || '(bez titulku)';
      const badge = document.createElement('span');
      badge.className = 'badge ' + (stazena ? 'gone' : !ok ? 'bad' : expired ? 'gone' : 'live');
      badge.textContent = stazena ? 'staženo – mizí z archivů' : !ok ? 'aplikace zahodí' : expired ? 'ukončeno' : 'aktivní';
      title.appendChild(badge);
      left.appendChild(title);

      const meta = document.createElement('div'); meta.className = 'item-meta';
      const bits = [
        'zveřejněno ' + fmt(n.publishedAt),
        'jazyky: ' + (n.text ? Object.keys(n.text).join(', ') : '–'),
        'země: ' + (Array.isArray(n.countries) && n.countries.length ? n.countries.join(', ') : 'všem'),
      ];
      if (typeof n.eventAt === 'number') bits.push('akce ' + fmt(n.eventAt));
      if (typeof n.expiresAt === 'number') bits.push((expired ? 'ukončeno ' : 'skončí ') + fmt(n.expiresAt));
      if (n.url) bits.push('odkaz: ' + n.url);
      bits.push('id: ' + n.id);
      meta.textContent = bits.join(' · ');
      left.appendChild(meta);

      const bodyTxt = (n.text?.cs?.body) || (n.text?.en?.body) || '';
      if (bodyTxt) {
        const b = document.createElement('div'); b.className = 'item-body';
        b.textContent = bodyTxt; left.appendChild(b);
      }

      const acts = document.createElement('div'); acts.className = 'item-acts';
      if (!stazena) {
        const edit = document.createElement('button');
        edit.className = 'ghost sm'; edit.textContent = 'Upravit';
        edit.onclick = () => startEdit(n);
        acts.appendChild(edit);
        if (!expired) {
          if (ok) {
            const pushBtn = document.createElement('button');
            pushBtn.className = 'sm'; pushBtn.textContent = 'Poslat push';
            pushBtn.onclick = () => openPush(n);
            acts.appendChild(pushBtn);
          }
          const end = document.createElement('button');
          end.className = 'ghost sm'; end.textContent = 'Ukončit teď';
          end.onclick = () => endNow(n);
          acts.appendChild(end);
        }
        const ret = document.createElement('button');
        ret.className = 'danger sm'; ret.textContent = 'Stáhnout úplně';
        ret.onclick = () => retract(n);
        acts.appendChild(ret);
      }
      const del = document.createElement('button');
      del.className = 'danger sm'; del.textContent = 'Smazat';
      del.onclick = () => remove(n);
      acts.appendChild(del);

      head.appendChild(left); head.appendChild(acts);
      el.appendChild(head);
      return el;
    }

    /** Expirace na teď – banner zmizí i lidem, co zprávu už staženou mají. */
    async function endNow(n) {
      if (!confirm('Ukončit zprávu „' + ((n.text?.cs?.title) || n.id) + '"?\n\nBanner zmizí i lidem, co ji už mají. V archivu jim zůstane.')) return;
      const next = items.map((x) => (x.id === n.id ? { ...x, expiresAt: Date.now() } : x));
      await persist(next, 'Zpráva ukončena.', $('listmsg'));
    }

    /**
     * Stažení – jediná akce, která zprávu odstraní i z ARCHIVU lidem, co ji už mají.
     * Zpráva zůstává v remote s příznakem `retracted`, protože jinak by se app store
     * neměl o čem dozvědět (smazané položky nevidí). Smazat nadobro jde až potom.
     */
    async function retract(n) {
      if (!confirm('Stáhnout zprávu „' + ((n.text?.cs?.title) || n.id) + '" úplně?\n\nZmizí i z archivu lidem, kterým se už stáhla – jako by nikdy nebyla.\n\nZprávu tu nech aspoň pár dní, ať se stažení stihne rozšířit; teprve pak ji smaž nadobro.')) return;
      const next = items.map((x) => (x.id === n.id ? { ...x, retracted: true } : x));
      await persist(next, 'Zpráva stažena. Z archivů zmizí lidem při dalším otevření aplikace.', $('listmsg'));
    }

    /** Smazání z remote – nová zařízení ji už nedostanou, stará si ji nechají v archivu. */
    async function remove(n) {
      const stazena = n.retracted === true;
      const varovani = stazena
        ? '\n\nZpráva je stažená. Pokud ji smažeš dřív, než si stažení stáhnou všichni, zůstane jim v archivu natrvalo.'
        : '\n\nPozor: komu se už stáhla, tomu zůstane v archivu. Na odebrání z banneru je „Ukončit teď", na odstranění i z archivu „Stáhnout úplně".';
      if (!confirm('Smazat zprávu „' + ((n.text?.cs?.title) || n.id) + '"?' + varovani)) return;
      const next = items.filter((x) => x.id !== n.id);
      await persist(next, 'Zpráva smazána.', $('listmsg'));
    }

    // --- nová zpráva / úprava existující -------------------------------------

    /**
     * ID zprávy, kterou právě upravujeme (null = skládáme novou).
     *
     * Úprava ZÁMĚRNĚ zachovává `id` i `publishedAt`: app store bere remote jako
     * autoritu podle `id` (byId.set přepíše archivovanou kopii), takže se oprava
     * překlepu propíše i lidem, kterým se zpráva už stáhla. Nové `id` by u nich
     * naopak nechalo v archivu ležet původní chybnou verzi vedle opravené.
     */
    let editingId = null;

    /** Přepni formulář mezi „nová zpráva" a „úprava". */
    function setEditingUi(n) {
      editingId = n ? n.id : null;
      const on = !!n;
      document.querySelectorAll('.editing-only').forEach((el) => el.classList.toggle('hidden', !on));
      $('form-title').textContent = on ? 'Úprava zprávy' : 'Nová zpráva';
      $('publish').textContent = on ? 'Uložit změny' : 'Zveřejnit zprávu';
      $('edit-hint').textContent = on
        ? 'Oprava se propíše i lidem, kterým se zpráva už stáhla (zůstává stejné id ' + n.id +
          '). Kdo si ji ale zavřel křížkem, znovu ji v banneru neuvidí – najde ji opravenou v archivu.'
        : '';
    }

    function startEdit(n) {
      // VŠECHNY jazyky zprávy (dřív jen cs + en → uložení úpravy smazalo ostatní jazyky).
      for (const l of TEXT_LANGS) { $(`${l}-title`).value = n.text?.[l]?.title || ''; $(`${l}-body`).value = n.text?.[l]?.body || ''; }
      $('more-langs').open = EXTRA_LANGS.some((l) => n.text?.[l]);
      $('eventAt').value   = toLocalInput(n.eventAt);
      $('expiresAt').value = toLocalInput(n.expiresAt);
      $('url').value = n.url || '';

      const targeted = Array.isArray(n.countries) && n.countries.length > 0;
      oneBoxes().forEach((c) => { c.checked = targeted && n.countries.includes(c.value); });
      $('c-all').checked = !targeted;
      paintCountries();

      // Přepočítej počítadla znaků na načtený obsah.
      TEXT_LANGS.forEach((l) => ['title', 'body'].forEach((f) => $(`${l}-${f}`).dispatchEvent(new Event('input'))));

      setEditingUi(n);
      $('msg').textContent = '';
      $('form-title').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    /** ms epoch → hodnota pro <input type="datetime-local"> (lokální čas, bez zóny). */
    function toLocalInput(ms) {
      if (typeof ms !== 'number' || !Number.isFinite(ms)) return '';
      const d = new Date(ms);
      if (Number.isNaN(d.getTime())) return '';
      const pad = (x) => String(x).padStart(2, '0');
      return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
    }

    function clearForm() {
      [...TEXT_LANGS.flatMap((l) => [`${l}-title`, `${l}-body`]), 'eventAt', 'expiresAt', 'url'].forEach((id) => { $(id).value = ''; });
      oneBoxes().forEach((c) => { c.checked = false; });
      $('c-all').checked = true; paintCountries();
      TEXT_LANGS.flatMap((l) => [`c-${l}-title`, `c-${l}-body`]).forEach((id) => { $(id).textContent = ''; $(id).classList.remove('over'); });
      $('more-langs').open = false;
      setEditingUi(null);
    }
    $('clear').onclick = () => { clearForm(); $('msg').textContent = ''; };
    $('cancel-edit').onclick = () => { clearForm(); $('msg').textContent = ''; };
    $('reload').onclick = () => { $('listmsg').textContent = ''; load(); };

    $('publish').onclick = async () => {
      const msg = $('msg'); msg.textContent = '';
      const fail = (t) => { msg.innerHTML = `<span class="err">${t}</span>`; };

      const texts = Object.fromEntries(TEXT_LANGS.map((l) => [l, { title: $(`${l}-title`).value.trim(), body: $(`${l}-body`).value.trim() }]));

      // Titulek bez textu aplikace zobrazí (body smí být prázdné), ale titulek je povinný.
      if (!TEXT_LANGS.some((l) => texts[l].title)) return fail('Vyplň aspoň jeden titulek.');
      const noTitle = TEXT_LANGS.find((l) => texts[l].body && !texts[l].title);
      if (noTitle) return fail(`Text (${LANG_META[noTitle][1]}) má prázdný titulek – aplikace by celou zprávu zahodila.`);

      const eventAt = toMs($('eventAt').value);
      const expiresAt = toMs($('expiresAt').value);
      if (Number.isNaN(eventAt)) return fail('Datum akce nedává smysl.');
      if (Number.isNaN(expiresAt)) return fail('Datum expirace nedává smysl.');
      // Expirace v minulosti dává smysl JEN u úpravy zprávy, která UŽ ukončená byla –
      // opravit překlep v archivu musí jít, aniž by se znovu rozsvítila v banneru.
      // (Neporovnáváme s původní hodnotou na rovnost: `toLocalInput` ořezává na
      // minuty, takže po načtení do formuláře by se nikdy netrefila.)
      const puvodni = editingId ? items.find((x) => x.id === editingId) : null;
      if (editingId && !puvodni) {
        clearForm();
        return fail('Upravovaná zpráva už v seznamu není – někdo ji mezitím smazal. Načti seznam znovu.');
      }
      const jizBylaUkoncena =
        !!puvodni && typeof puvodni.expiresAt === 'number' && puvodni.expiresAt <= Date.now();
      if (typeof expiresAt === 'number' && expiresAt <= Date.now() && !jizBylaUkoncena)
        return fail('Expirace je v minulosti – zpráva by se nikomu neukázala.');

      const url = $('url').value.trim();
      if (url && !/^https:\/\//i.test(url)) return fail('Odkaz musí začínat https:// (http ani jiné schéma aplikace nepřijme).');

      const countries = pickedCountries();

      // Objekt skládáme podmíněně – Firestore neumí `undefined` a store čeká
      // buď platnou hodnotu, nebo chybějící klíč. Při úpravě držíme původní id
      // i datum zveřejnění (viz komentář u editingId); mění se jen obsah.
      const notice = puvodni
        ? { id: puvodni.id, publishedAt: puvodni.publishedAt, text: {} }
        : { id: newId(), publishedAt: Date.now(), text: {} };
      for (const l of TEXT_LANGS) if (texts[l].title) notice.text[l] = texts[l];
      if (typeof expiresAt === 'number') notice.expiresAt = expiresAt;
      if (typeof eventAt === 'number') notice.eventAt = eventAt;
      if (url) notice.url = url;
      if (countries.length) notice.countries = countries;

      if (!isValidNotice(notice)) return fail('Zpráva neprošla kontrolou tvaru – aplikace by ji tiše zahodila. Zkontroluj titulky, odkaz a data.');

      const slovesoQ = puvodni ? 'Uložit?' : 'Zveřejnit?';
      if (!notice.text.en && !confirm(`Zpráva nemá anglickou verzi.\n\nUvidí ji jen lidé s jazyky ${Object.keys(notice.text).join(', ')}; ostatní jazyky padají na angličtinu, a ta chybí. ` + slovesoQ)) return;
      if (!notice.text.cs && !confirm('Zpráva nemá českou verzi – Čechům se ukáže anglicky. ' + slovesoQ)) return;

      // Úprava zprávu ponechá na jejím místě v seznamu (řadí se stejně podle
      // publishedAt); nová jde na začátek.
      const next = puvodni
        ? items.map((x) => (x.id === puvodni.id ? notice : x))
        : [notice, ...items];
      const ok = await persist(
        next,
        puvodni
          ? 'Změny uloženy. Opravená verze se lidem propíše při dalším otevření aplikace.'
          : 'Zveřejněno. Lidem se to ukáže při dalším otevření aplikace.',
        msg
      );
      if (ok) clearForm();
    };

    // ======================================================================
    // PUSH kampaně (pawprint-mobile/docs/PUSH_PLAN.md)
    // ======================================================================
    let pushNotice = null;      // zpráva, ke které push skládáme
    let pushUnsub = null;       // onSnapshot běžící kampaně
    let lastCount = null;       // poslední dry-run pro AKTUÁLNÍ nastavení (otisk + výsledek)

    /** Chipy s možností „Všechny" (stejná logika jako země u zprávy). */
    function buildChips(boxId, allLabel, options, allId) {
      const box = $(boxId); box.innerHTML = '';
      const mk = (name, cls) => {
        const l = document.createElement('label'); l.className = 'chip' + (cls ? ' ' + cls : '');
        const cb = document.createElement('input'); cb.type = 'checkbox';
        const sp = document.createElement('span'); sp.textContent = name;
        l.appendChild(cb); l.appendChild(sp); box.appendChild(l); return cb;
      };
      const all = mk(allLabel, 'all'); all.id = allId; all.checked = true;
      const ones = () => [...box.querySelectorAll('input.one')];
      const paint = () => box.querySelectorAll('.chip').forEach((l) => l.classList.toggle('on', l.querySelector('input').checked));
      all.onchange = () => { if (all.checked) ones().forEach((c) => { c.checked = false; }); else if (!ones().some((c) => c.checked)) all.checked = true; paint(); };
      options.forEach((o) => { const cb = mk(o.name); cb.className = 'one'; cb.value = o.code; cb.onchange = () => { all.checked = !ones().some((c) => c.checked); paint(); }; });
      paint();
      return {
        set(values) { const v = Array.isArray(values) ? values : []; ones().forEach((c) => { c.checked = v.includes(c.value); }); all.checked = !v.length; paint(); },
        get() { return all.checked ? null : ones().filter((c) => c.checked).map((c) => c.value); },
      };
    }
    // Pole jazyků se generují: zpráva má cs a en v HTML, ostatní v „Další jazyky“; push má všech 12.
    function langBox(prefix, l, what, rows, boxId) {
      const [flag, name] = LANG_META[l];
      const box = document.createElement('div'); if (boxId) box.id = boxId;
      box.innerHTML = `<div class="field"><label><span class="flag">${flag} ${what === 'push' ? 'Titulek pushe' : 'Titulek'} (${name})</span><span class="count" id="c-${prefix}${l}-title"></span></label><input id="${prefix}${l}-title" maxlength="120" /></div>` +
        `<div class="field"><label><span class="flag">${flag} ${what === 'push' ? 'Text pushe' : 'Text'} (${name})</span><span class="count" id="c-${prefix}${l}-body"></span></label><textarea id="${prefix}${l}-body" rows="${rows}"${what === 'push' ? ' maxlength="300"' : ''}></textarea></div>`;
      return box;
    }
    for (const l of EXTRA_LANGS) $('more-langs-box').appendChild(langBox('', l, 'notice', 4));
    for (const l of TEXT_LANGS) $('push-texts').appendChild(langBox('p-', l, 'push', 3, `push-${l}-box`));

    const pLangs = buildChips('p-langs', 'Všechny jazyky', APP_LANGS.map((l) => ({ code: l, name: l })), 'p-l-all');
    const pCountries = buildChips('p-countries', 'Všechny země', COUNTRIES, 'p-c-all');
    ['p-ios', 'p-android'].forEach((id) => { $(id).onchange = () => $(id).closest('.chip').classList.toggle('on', $(id).checked); });
    for (const l of TEXT_LANGS) { counter(`p-${l}-title`, `c-p-${l}-title`, 50); counter(`p-${l}-body`, `c-p-${l}-body`, 140); }

    const shorten = (t, n) => { t = (t || '').replace(/\s+/g, ' ').trim(); return t.length <= n ? t : t.slice(0, n - 1).replace(/\s+\S*$/, '') + '…'; };

    function openPush(n) {
      pushNotice = n; lastCount = null;
      if (pushUnsub) { pushUnsub(); pushUnsub = null; }
      $('push-for').textContent = '· k zprávě „' + ((n.text?.cs?.title) || (n.text?.en?.title) || n.id) + '"';
      const has = TEXT_LANGS.filter((l) => !!n.text?.[l]);
      for (const l of TEXT_LANGS) {
        const on = has.includes(l);
        $(`push-${l}-box`).classList.toggle('hidden', !on);
        $(`p-${l}-title`).value = on ? shorten(n.text[l].title, 50) : '';
        $(`p-${l}-body`).value = on ? shorten(n.text[l].body, 140) : '';
        ['title', 'body'].forEach((f) => $(`p-${l}-${f}`).dispatchEvent(new Event('input')));
      }
      // Jazyky: s angličtinou míří zpráva na všechny (fallback), jinak jen na jazyky, které má.
      pLangs.set(has.includes('en') ? [] : has);
      pCountries.set(Array.isArray(n.countries) ? n.countries : []);
      $('p-ios').checked = true; $('p-android').checked = true;
      ['p-ios', 'p-android'].forEach((id) => $(id).closest('.chip').classList.add('on'));
      $('p-activity').value = ''; $('p-quiet').value = '3'; $('p-max').value = '20000'; $('p-devices').value = ''; $('p-minver').value = '';
      $('p-when').value = 'now'; $('p-date').value = pragueDate(Date.now() + 86_400_000); $('p-time').value = '10:00'; paintWhen();
      $('p-msg').textContent = ''; $('p-result').innerHTML = '';
      $('push-panel').classList.remove('hidden');
      $('push-panel').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    $('p-close').onclick = () => { $('push-panel').classList.add('hidden'); pushNotice = null; if (pushUnsub) { pushUnsub(); pushUnsub = null; } };

    /** Datum (YYYY-MM-DD) a čas (HH:MM) v Praze – výchozí pásmo plánovače (functions/push.js). */
    function pragueParts(ms) {
      const p = Object.fromEntries(new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Prague', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' })
        .formatToParts(new Date(ms)).map((x) => [x.type, x.value]));
      return { date: `${p.year}-${p.month}-${p.day}`, time: `${p.hour}:${p.minute}` };
    }
    const pragueDate = (ms) => pragueParts(ms).date;
    function paintWhen() {
      const local = $('p-when').value === 'local';
      ['p-date', 'p-time', 'p-when-hint'].forEach((id) => $(id).classList.toggle('hidden', !local));
      $('p-send').textContent = local ? 'Naplánovat push' : 'Odeslat push';
    }
    $('p-when').onchange = paintWhen;

    /** Složí kampaň z formuláře. Vrací { campaign } nebo { error }. */
    function buildCampaign(dryRun) {
      if (!pushNotice) return { error: 'Není vybraná zpráva.' };
      const text = {};
      for (const l of TEXT_LANGS) {
        if ($(`push-${l}-box`).classList.contains('hidden')) continue;
        const t = $(`p-${l}-title`).value.trim();
        if (t) text[l] = { title: t, body: $(`p-${l}-body`).value.trim() };
      }
      if (!Object.keys(text).length) return { error: 'Push potřebuje aspoň jeden titulek.' };
      const platforms = [$('p-ios').checked ? 'ios' : null, $('p-android').checked ? 'android' : null].filter(Boolean);
      if (!platforms.length) return { error: 'Vyber aspoň jednu platformu.' };
      const segment = {};
      const langs = pLangs.get(); if (langs) segment.langs = langs;
      const countries = pCountries.get(); if (countries) segment.countries = countries;
      if (platforms.length < 2) segment.platforms = platforms;
      const act = $('p-activity').value;
      if (act.startsWith('active:')) segment.activeWithinDays = Number(act.split(':')[1]);
      if (act.startsWith('inactive:')) segment.inactiveForDays = Number(act.split(':')[1]);
      if ($('p-quiet').value) segment.notPushedWithinDays = Number($('p-quiet').value);
      const max = Number($('p-max').value); if (Number.isFinite(max) && max > 0) segment.maxRecipients = Math.floor(max);
      // Stejné pravidlo jako parseVersion ve functions/push.js (jen čísla s tečkami, ne samé nuly).
      // Funkce by neplatnou verzi odmítla taky, tady to admin uvidí hned.
      const minVer = $('p-minver').value.trim();
      if (minVer) {
        if (!/^\d{1,6}(?:\.\d{1,6}){0,3}$/.test(minVer) || !minVer.split('.').some((x) => Number(x) > 0)) {
          return { error: 'Minimální verze musí být čísla oddělená tečkou, např. 2.0.0.' };
        }
        segment.minAppVersion = minVer;
      }
      const devices = $('p-devices').value.split(/[\s,;]+/).map((x) => x.trim()).filter(Boolean);
      if (devices.length) {
        if (devices.some((d) => d.length < 8)) return { error: 'ID zařízení musí mít aspoň 8 znaků (tolik ukazuje aplikace).' };
        segment.deviceIds = devices;
      }
      // Plán platí jen pro ostré odeslání; „Spočítat příjemce“ běží vždy hned (počty se nemění).
      let schedule = null;
      if (!dryRun && $('p-when').value === 'local') {
        const localDate = $('p-date').value, localTime = $('p-time').value;
        if (!/^\d{4}-\d{2}-\d{2}$/.test(localDate) || !/^([01]\d|2[0-3]):[0-5]\d$/.test(localTime)) return { error: 'Vyplň datum i čas odeslání.' };
        const now = pragueParts(Date.now());
        if (`${localDate} ${localTime}` <= `${now.date} ${now.time}`) return { error: 'Čas odeslání v Praze už minul. Zvol pozdější.' };
        if (localDate > pragueDate(Date.now() + 60 * 86_400_000)) return { error: 'Naplánovat jde nejvýš 60 dní dopředu.' };
        schedule = { localDate, localTime, fallbackTz: 'Europe/Prague' };
      }
      return { campaign: {
        status: schedule ? 'scheduled' : 'queued', ...(schedule ? { schedule } : {}), dryRun: !!dryRun, createdBy: ADMIN_EMAIL, createdAt: serverTimestamp(),
        noticeId: pushNotice.id, noticeTitle: (pushNotice.text?.cs?.title) || (pushNotice.text?.en?.title) || '',
        text, segment,
      } };
    }
    /** Otisk nastavení – „Odeslat" bez čerstvého dry-runu se zeptá navíc. */
    const settingsKey = (c) => JSON.stringify({ t: c.text, s: c.segment });

    function renderResult(c) {
      const r = c.result || {};
      const st = c.status;
      const line = (label, v) => `<span class="stat"><b>${v ?? '–'}</b>${label}</span>`;
      let html = `<p class="st-${st}" style="margin:0 0 6px;font-weight:700">${({ queued: 'Zařazeno…', counting: 'Počítám…', sending: 'Rozesílám…', dry: 'Spočítáno', done: 'Odesláno', failed: 'Selhalo', scheduled: 'Naplánováno', cancelled: 'Zrušeno' })[st] || st}${c.error ? ' – ' + c.error : ''}</p>`;
      if (c.schedule) html += `<p class="hint" style="margin:0 0 6px">${scheduleLine(c)}</p>`;
      if (st === 'dry' || st === 'done') {
        html += line('odpovídá segmentu', r.matched) + (r.capped ? line('po stropu', r.recipients) : '');
        if (st === 'done') html += line('doručeno do služby', r.sent) + line('selhalo', r.failed) + line('smazaných tokenů', r.pruned);
        html += line('zařízení celkem', r.totalDevices);
        // Klíče (jazyk, země, verze, chyba) pocházejí ze zařízení, do innerHTML jen escapované.
        const escK = (x) => String(x).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        const dict = (o) => Object.entries(o || {}).sort((a, b) => b[1] - a[1]).map(([k, v]) => `${escK(k)} ${escK(v)}`).join(' · ') || '–';
        html += `<p class="hint">platforma: ${dict(r.byPlatform)}<br/>jazyk: ${dict(r.byLang)}<br/>země: ${dict(r.byCountry)}` +
          (r.byVersion ? `<br/>verze aplikace: ${dict(r.byVersion)}` : '') +
          (r.failures && Object.keys(r.failures).length ? `<br/>chyby: ${dict(r.failures)}` : '') + '</p>';
      }
      return html;
    }

    const escH = (x) => String(x).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    /** Plán a průběh plánované kampaně (vlny po pásmech, co ještě čeká). */
    function scheduleLine(c) {
      const s = c.schedule || {}, r = c.result || {};
      const bits = [`plán ${escH(String(s.localDate || '').split('-').reverse().join('. '))} v ${escH(s.localTime || '')} místního času zařízení`];
      if (Array.isArray(r.waves) && r.waves.length) bits.push('vlny: ' + r.waves.map((w) => `${escH(fmt(Date.parse(w.at)))} ${escH((w.tzs || []).join(', ') || '–')} → ${escH(w.sent)}`).join(' · '));
      if (Array.isArray(r.pending) && r.pending.length) bits.push('čeká: ' + r.pending.map((g) => `${escH(g.tz)} ${escH(fmt(Date.parse(g.at)))} (${escH(g.count)})`).join(' · '));
      if (r.skippedLate) bits.push(`zmeškáno ${escH(r.skippedLate)}`);
      if (r.skippedRecentPush) bits.push(`push v poslední hodině ${escH(r.skippedRecentPush)}`);
      if (c.lastSkip && c.status === 'scheduled') bits.push(`odloženo (${escH(c.lastSkip.reason)})`);
      return bits.join('<br/>');
    }

    async function launch(dryRun) {
      const msg = $('p-msg'); msg.textContent = '';
      const built = buildCampaign(dryRun);
      if (built.error) { msg.innerHTML = `<span class="err">${built.error}</span>`; return; }
      const c = built.campaign;
      if (!dryRun) {
        const key = settingsKey(c);
        const fresh = lastCount && lastCount.key === key ? lastCount.result : null;
        // Minimální verze: funkce nasazená PŘED tímhle adminem neznámý klíč segmentu tiše
        // zahodí → push by šel všem verzím. Jen nová funkce vrací v souhrnu `byVersion`,
        // proto se s minimální verzí odesílá jen po čerstvém přepočtu, který ho obsahuje.
        if (c.segment.minAppVersion && !(fresh && fresh.byVersion)) {
          msg.innerHTML = `<span class="err">${fresh
            ? 'Funkce na serveru filtr verze ještě nezná (přepočet nevrátil počty podle verze). Push by šel všem verzím, nejdřív nasaď functions.'
            : 'S minimální verzí nejdřív „Spočítat příjemce“ (ověří i, že funkce na serveru filtr verze zná).'}</span>`;
          return;
        }
        const kolik = fresh ? `${fresh.recipients} zařízení` : 'NEZNÁMÝ počet zařízení (nejdřív „Spočítat příjemce")';
        const kdy = c.schedule ? ` ${c.schedule.localDate.split('-').reverse().join('. ')} v ${c.schedule.localTime} místního času zařízení` : '';
        if (!confirm(c.schedule
          ? `Naplánovat push „${(c.text.cs || c.text.en || Object.values(c.text)[0]).title}" na ${kolik}${kdy}?\n\nDo odeslání první vlny jde v historii zrušit.`
          : `Odeslat push „${(c.text.cs || c.text.en || Object.values(c.text)[0]).title}" na ${kolik}?\n\nTohle už nejde vzít zpět.`)) return;
        if (!fresh && !confirm('Opravdu bez spočítání? Pojistkou je jen strop příjemců.')) return;
      }
      msg.textContent = dryRun ? 'Počítám…' : 'Zakládám kampaň…';
      $('p-count').disabled = true; $('p-send').disabled = true;
      try {
        const ref = await addDoc(collection(db, CAMPAIGNS), c);
        if (pushUnsub) pushUnsub();
        pushUnsub = onSnapshot(doc(db, CAMPAIGNS, ref.id), (snap) => {
          const d = snap.data(); if (!d) return;
          $('p-result').innerHTML = renderResult(d);
          if (['dry', 'done', 'failed', 'scheduled', 'cancelled'].includes(d.status)) {
            $('p-count').disabled = false; $('p-send').disabled = false;
            msg.textContent = '';
            if (d.status === 'dry') lastCount = { key: settingsKey(c), result: d.result || {} };
            if (d.status === 'done') lastCount = null;
          }
        });
      } catch (e) {
        msg.innerHTML = `<span class="err">Chyba: ${e.message}</span>`;
        $('p-count').disabled = false; $('p-send').disabled = false;
      }
    }
    $('p-count').onclick = () => launch(true);
    $('p-send').onclick = () => launch(false);

    // Historie + přehled zařízení (dry-run bez filtru = kolik zařízení je registrovaných).
    function watchHistory() {
      const q = query(collection(db, CAMPAIGNS), orderBy('createdAt', 'desc'), limit(20));
      onSnapshot(q, (snap) => {
        const box = $('hist'); box.innerHTML = '';
        $('h-cnt').textContent = snap.size ? `(posledních ${snap.size})` : '';
        if (!snap.size) { box.innerHTML = '<p class="muted">Zatím žádná kampaň.</p>'; return; }
        snap.forEach((d) => {
          const c = d.data(); const r = c.result || {};
          const el = document.createElement('div'); el.className = 'hist';
          const when = c.createdAt && typeof c.createdAt.toMillis === 'function' ? fmt(c.createdAt.toMillis()) : '…';
          const seg = c.segment || {};
          const segBits = [
            seg.langs ? 'jazyk ' + seg.langs.join(',') : 'všechny jazyky',
            seg.countries ? 'země ' + seg.countries.join(',') : 'všechny země',
            seg.platforms ? seg.platforms.join('+') : 'iOS+Android',
            seg.activeWithinDays ? `aktivní ${seg.activeWithinDays} d` : '', seg.inactiveForDays ? `neaktivní ${seg.inactiveForDays}+ d` : '',
            seg.notPushedWithinDays ? `bez pushe ${seg.notPushedWithinDays} d` : '', seg.minAppVersion ? `verze ≥ ${seg.minAppVersion}` : '',
            seg.deviceIds ? `TEST ${seg.deviceIds.length} zař.` : '',
          ].filter(Boolean).join(' · ');
          const title = (c.text?.cs?.title) || (c.text?.en?.title) || c.noticeTitle || '(bez titulku)';
          el.innerHTML = `<div class="h-top"><div><strong>${c.dryRun ? '🔍 ' : (c.schedule ? '🕙 ' : '📣 ')}${title}</strong> <span class="st-${c.status}">${c.status}</span>${c.error ? ` <span class="err">${c.error}</span>` : ''}</div><div class="muted">${when}</div></div>
            <div class="h-meta">${segBits}<br/>${c.dryRun ? `odpovídá: ${r.matched ?? '–'}` : `odesláno ${r.sent ?? '–'} · selhalo ${r.failed ?? '–'} · smazané tokeny ${r.pruned ?? '–'} · segment ${r.matched ?? '–'}`} · zařízení celkem ${r.totalDevices ?? '–'}${c.noticeId ? ` · zpráva ${c.noticeId}` : ''}${c.schedule ? '<br/>' + scheduleLine(c) : ''}</div>`;
          if (c.status === 'scheduled') {
            const b = document.createElement('button'); b.className = 'ghost'; b.style.marginTop = '6px';
            b.textContent = 'Zrušit naplánovaný push';
            b.onclick = async () => {
              if (!confirm(`Zrušit naplánovaný push „${title}"?\n\nVlny, které už odešly, zůstanou odeslané; další už nepůjdou.`)) return;
              b.disabled = true;
              try { await updateDoc(doc(db, CAMPAIGNS, d.id), { status: 'cancelled', cancelledAt: serverTimestamp() }); }
              catch (e) { b.disabled = false; $('h-msg').innerHTML = `<span class="err">Zrušení: ${escH(e.message)}</span>`; }
            };
            el.appendChild(b);
          }
          box.appendChild(el);
        });
      }, (e) => { $('h-msg').innerHTML = `<span class="err">Historie: ${e.message}</span>`; });
    }
    $('h-devices').onclick = async () => {
      $('h-msg').textContent = 'Počítám…'; $('h-devices').disabled = true;
      try {
        const ref = await addDoc(collection(db, CAMPAIGNS), { status: 'queued', dryRun: true, createdBy: ADMIN_EMAIL, createdAt: serverTimestamp(), noticeId: null, noticeTitle: 'Přehled zařízení', text: { en: { title: 'inventory', body: '' } }, segment: {} });
        const un = onSnapshot(doc(db, CAMPAIGNS, ref.id), (snap) => {
          const d = snap.data(); if (!d) return;
          if (['dry', 'failed'].includes(d.status)) { un(); $('h-msg').textContent = ''; $('h-devices').disabled = false; $('h-devices-out').innerHTML = renderResult(d); }
        });
      } catch (e) { $('h-msg').innerHTML = `<span class="err">${e.message}</span>`; $('h-devices').disabled = false; }
    };

    // --- init ---------------------------------------------------------------
    buildCountries();
    for (const l of TEXT_LANGS) { counter(`${l}-title`, `c-${l}-title`, 60); counter(`${l}-body`, `c-${l}-body`, 220); }
  </script>
</body>
</html>
